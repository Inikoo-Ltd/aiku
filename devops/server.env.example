# Secrets consumed by setup-server.sh to render devops/ configs.
# Copy to devops/server.env (gitignored) and fill in real values.

# HAProxy stats page auth (bound on :8880) — used in haproxy.cfg
HAPROXY_STATS_USER=inikoo
HAPROXY_STATS_PASSWORD=change-me

# Varnish backend hosts — used in varnish/default.vcl.
# Production: the two web servers (boro=10.0.0.3:8080, litio=10.0.0.1:8090 — litio's
# nginx is on 8090 because Aurora's Apache holds 8080 there).
# Single-box / staging: point both at itself, e.g. 127.0.0.1 and 8080.
VARNISH_HOST_BORO=10.0.0.3
VARNISH_HOST_LITIO=10.0.0.1
VARNISH_PORT_LITIO=8090

# Port aiku's nginx site listens on for THIS host: 8090 on litio, 8080 elsewhere.
NGINX_PORT=8080

# Which app server this is: boro, litio or helio. Goes into the supervisor program names,
# which must stay unique per host — two hosts answering to the same program name is
# how you end up unable to tell which one you just restarted.
APP_HOST=boro

# Octane sizing for THIS host. boro is the bigger box (48/400), helio runs 24/500.
# Workers are processes, so this is the main lever on how much RAM Octane holds.
OCTANE_WORKERS=48
OCTANE_MAX_REQUESTS=400

# Install the Laravel scheduler crontab on THIS host? Exactly one host in the
# fleet must set this to 1 — two schedulers double every task. Default off.
INSTALL_SCHEDULER=0
