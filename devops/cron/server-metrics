# Per-minute CPU / memory / disk sample to aiku (DevOps dashboard > Servers).
# Install on every box (boro, litio, helio, neon), root-owned /etc/cron.d file:
#
#     install -m 755 devops/server-metrics.sh /usr/local/bin/aiku-server-metrics
#     install -m 644 devops/cron/server-metrics /etc/cron.d/server-metrics
#     printf 'SERVER_METRICS_TOKEN=<DEVOPS_TOKEN of prod .env>\n' > /etc/aiku-server-metrics.env
#     chmod 600 /etc/aiku-server-metrics.env
#     /usr/local/bin/aiku-server-metrics --dry-run
#
# Optional in that env file: SERVER_METRICS_SLUG (defaults to short hostname),
# SERVER_METRICS_URL (defaults to https://aiku.io/devops).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
* * * * * root /usr/local/bin/aiku-server-metrics
