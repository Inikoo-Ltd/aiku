# Disk usage alerting. Install on EVERY host that matters — at minimum helio and
# boro — as a /etc/cron.d file (root-owned, mode 644):
#
#     install -m 755 devops/disk-alert.sh /usr/local/bin/aiku-disk-alert
#     install -m 644 devops/cron/disk-alert /etc/cron.d/disk-alert
#
# Verify before trusting it, in this order:
#     /usr/local/bin/aiku-disk-alert --self-test          # logic, no side effects
#     /usr/local/bin/aiku-disk-alert --dry-run            # prints what it would send
#     DISK_ALERT_THRESHOLD=1 /usr/local/bin/aiku-disk-alert   # posts a REAL Slack message
#
# Why: on 27 Aug 2026 helio's root disk reached 99% with nobody paged. Redis could
# not write its RDB snapshot, refused every write (stop-writes-on-bgsave-error),
# and the entire site returned 500 until a snapshot succeeded. The disk had been
# filling for weeks — 132 GB of stale Deployer releases and 575 GB of Postgres,
# none of it watched. Alerting at 85% turns that outage into a Tuesday chore.
#
# Posts through Slack's chat.postMessage using SLACK_BOT_USER_OAUTH_TOKEN and
# SLACK_CHANNEL out of the app's .env — the credential the application already
# uses, so there is no second Slack secret to rotate or forget. Runs as root
# purely because that .env is not world-readable. Deliberately does not touch PHP,
# Redis or the Laravel scheduler: it has to work in exactly the situation where
# those are broken, and it falls back to syslog plus a cron mail to root if Slack
# is unreachable or rejects the message.
#
# Override the destination per host if needed, as lines above the schedule:
#     DISK_ALERT_SLACK_CHANNEL=#devops
#     DISK_ALERT_THRESHOLD=85
#
# Alerts once at 85%, again only if it worsens by 3 points or 6 hours pass, and
# once more when it recovers. Local filesystems only — NFS and backup mounts are
# excluded so they cannot drown the real signal.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/10 * * * * root /usr/local/bin/aiku-disk-alert
