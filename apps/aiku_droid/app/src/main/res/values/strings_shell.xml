    <string name="sync_kept_all_aiku">Kept all of Aiku’s</string>
    <string name="sync_conflicts_explanation">Like resolving a merge: open a record to choose line by line, or keep all of one side. Nothing you discard is lost: it stays in the sync history.</string>
