    <string name="sync_online_only_title">Finalise needs a connection</string>
    <string name="sync_online_only_body">Shipments, labels, finalise, dispatch, cancel and Mark as received talk to carriers, printers or customers, so they only work online. Your picking and packing are saved and upload when you’re back.</string>
