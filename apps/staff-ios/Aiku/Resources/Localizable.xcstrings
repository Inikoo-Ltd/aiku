          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A hivatkozás a rendelés hivatkozása. Jelöljön ki több Teendő szállítólevelet, hogy komissiózási munkamenetbe tegye őket."
          }
        },
        "id": {
          "stringUnit": {
