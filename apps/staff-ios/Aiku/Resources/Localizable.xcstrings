          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De code die je hebt gescand, is niet geaccepteerd. Het bericht hieronder komt van Aiku."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeskanowany kod nie został zaakceptowany. Poniższy komunikat pochodzi z Aiku."
          }
        },
        "pt": {
