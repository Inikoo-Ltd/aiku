    "what is picked is half-way home.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "каквото е комплектовано, е на половината път до дома."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "co je vychystané, je na půl cesty domů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "was kommissioniert ist, ist schon halb zu Hause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lo que está preparado ya está a medio camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ce qui est préparé est déjà à mi-chemin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जो पिक हो गया, वह आधा घर पहुँच गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "što je ubrano, na pola je puta do kuće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ami komissiózva van, az már félúton van hazafelé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "yang sudah diambil sudah setengah jalan pulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ciò che è prelevato è già a metà strada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピッキングされたものは、もう半分家に着いている。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kas nokomplektēts, tas jau pusceļā uz mājām."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिक भएको सामान आधा बाटो घर पुगिसक्यो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "wat gepickt is, is al halfweg thuis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "co skompletowane, jest w połowie drogi do domu."
          }
        },
        "pt": {
