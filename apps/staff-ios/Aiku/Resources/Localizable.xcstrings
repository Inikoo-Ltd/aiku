    "Try a SKO reference (SKO-00412), a location code (A-03-02) or a shorter word.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Versuchen Sie eine SKO-Referenz (SKO-00412), einen Lagerplatzcode (A-03-02) oder ein kürzeres Wort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pruebe con una referencia de SKO (SKO-00412), un código de ubicación (A-03-02) o una palabra más corta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essayez une référence de SKO (SKO-00412), un code d'emplacement (A-03-02) ou un mot plus court."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokušajte s referencom SKO-a (SKO-00412), kodom lokacije (A-03-02) ili kraćom riječi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Próbáljon SKO-hivatkozást (SKO-00412), helykódot (A-03-02) vagy rövidebb szót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coba referensi SKO (SKO-00412), kode lokasi (A-03-02), atau kata yang lebih pendek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provi un riferimento SKO (SKO-00412), un codice ubicazione (A-03-02) o una parola più breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKOの参照番号（SKO-00412）、ロケーションコード（A-03-02）、または短い語句を試してください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încearcă o referință SKO (SKO-00412), un cod de locație (A-03-02) sau un cuvânt mai scurt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skúste referenciu SKO (SKO-00412), kód lokácie (A-03-02) alebo kratšie slovo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir SKO referansı (SKO-00412), bir lokasyon kodu (A-03-02) ya da daha kısa bir kelime deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请尝试 SKO 参考号（SKO-00412）、库位编码（A-03-02）或更短的关键词。"
          }
        }
      }
    },
