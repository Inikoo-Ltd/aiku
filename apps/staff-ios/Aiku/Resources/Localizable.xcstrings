    "No PIN has been generated for you yet. Please contact HR.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím pro vás nebyl vygenerován žádný PIN. Kontaktujte prosím personální oddělení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde noch keine PIN für Sie generiert. Bitte wenden Sie sich an die Personalabteilung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha generado ningún PIN para usted. Póngase en contacto con Recursos Humanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun code PIN n'a encore été généré pour vous. Veuillez contacter les RH."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए अभी तक कोई PIN उत्पन्न नहीं किया गया है। कृपया HR से संपर्क करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za vas još nije generiran PIN. Obratite se HR-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önnek még nem generáltak PIN-kódot. Forduljon a HR-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada PIN yang dibuat untuk Anda. Silakan hubungi HR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora stato generato alcun PIN per Lei. Contatti le risorse umane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PINがまだ発行されていません。人事部に連絡してください。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका लागि अझै कुनै PIN बनाइएको छैन। कृपया HR लाई सम्पर्क गर्नुहोस्।"
          }
        },
        "pl": {
