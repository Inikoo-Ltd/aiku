    "Requests can only go back one month.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заявките могат да са само до един месец назад."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádosti lze podat pouze za poslední měsíc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen können nur einen Monat zurückreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes solo pueden ser de hasta un mes atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes ne peuvent remonter que d'un mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध केवल एक महीने पीछे जा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zahtjevi mogu ići samo mjesec dana unatrag."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kérés legfeljebb egy hónapra visszamenőleg adható be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan hanya dapat mundur hingga satu bulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le richieste possono risalire solo fino a un mese prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "申請は1か月前までしかさかのぼれません。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pieprasījumus var iesniegt tikai līdz vienam mēnesim atpakaļ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोधहरू एक महिनासम्म मात्र पछाडि जान सक्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verzoeken kunnen maar tot een maand teruggaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wnioski można składać najwyżej miesiąc wstecz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos só podem recuar um mês."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cererile pot merge înapoi cel mult o lună."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadosti možno podať najviac mesiac spätne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Förfrågningar kan bara gälla upp till en månad bakåt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Talepler yalnızca bir ay geriye gidebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запити можна подавати лише на місяць назад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请最多只能追溯一个月。"
          }
        }
      }
    },
    "Requests you send for days with missing clockings appear here.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тук се показват заявките, които изпращате за дни с липсващи отчитания."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zde se zobrazují žádosti, které odešlete za dny s chybějící docházkou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anfragen, die Sie für Tage mit fehlenden Zeiterfassungen senden, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquí aparecen las solicitudes que envíe para días con fichajes que faltan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les demandes que vous envoyez pour des jours avec des pointages manquants apparaissent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "छूटी हाज़िरी वाले दिनों के लिए आपके भेजे अनुरोध यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovdje se prikazuju zahtjevi koje pošaljete za dane s nedostajućim evidencijama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Itt jelennek meg a hiányzó blokkolású napokra küldött kérései."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permintaan yang Anda kirim untuk hari dengan absensi yang tidak lengkap muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qui compaiono le richieste che invia per i giorni con timbrature mancanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打刻が不足している日について送信した申請がここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šeit parādās jūsu pieprasījumi par dienām ar trūkstošiem pierakstiem."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्लकिङ छुटेका दिनहरूका लागि तपाईंले पठाएका अनुरोधहरू यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verzoeken die je stuurt voor dagen met ontbrekende klokregistraties, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutaj pojawiają się wnioski wysłane za dni z brakującymi rejestracjami czasu pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os pedidos que enviar para dias sem registos de ponto aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cererile pe care le trimiți pentru zilele cu pontaje lipsă apar aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu sa zobrazujú žiadosti, ktoré pošlete za dni s chýbajúcimi záznamami dochádzky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
