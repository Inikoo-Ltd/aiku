    "It goes back to dispatched. Only goods-in supervisors can do this.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Връща се в състояние „изпратена“. Само супервайзъри по приемане на стока могат да направят това."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrátí se do stavu odesláno. Mohou to udělat pouze vedoucí příjmu zboží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie wird wieder auf versendet gesetzt. Nur Wareneingangs-Aufsichten können das tun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a expedida. Solo los supervisores de recepción de mercancías pueden hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elle repasse à l'état expédiée. Seuls les superviseurs de la réception peuvent le faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह वापस डिस्पैच किया गया में चला जाता है। केवल माल प्राप्ति पर्यवेक्षक ही यह कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraća se u status poslano. To mogu samo nadzornici ulaza robe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visszakerül feladott állapotba. Ezt csak az áruátvételi felügyelők tehetik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Statusnya kembali ke terkirim. Hanya pengawas barang masuk yang dapat melakukan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Torna allo stato spedito. Solo i supervisori del ricevimento merci possono farlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "出荷済みに戻ります。この操作は入荷責任者のみ行えます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tā atgriežas statusā “nosūtīts”. To var izdarīt tikai preču pieņemšanas vadītāji."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो फेरि पठाइएको अवस्थामा फर्कन्छ। सामान प्राप्तिका सुपरभाइजरले मात्र यो गर्न सक्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hij gaat terug naar verzonden. Alleen leidinggevenden van goederenontvangst kunnen dit doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wraca do statusu Wysłano. Mogą to zrobić tylko kierownicy przyjęcia towarów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volta a expedida. Só os supervisores da receção de mercadorias o podem fazer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revine la expediat. Doar supervizorii de recepție marfă pot face acest lucru."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vráti sa do stavu odoslané. Môžu to urobiť iba vedúci príjmu tovaru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den går tillbaka till skickad. Endast arbetsledare för varumottagning kan göra detta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sevk edildi durumuna geri döner. Bunu yalnızca mal kabul süpervizörleri yapabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поставка повернеться в стан «Відправлено». Це можуть робити лише супервайзери приймання товарів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它将恢复为已发货。只有入库主管可以执行此操作。"
          }
        }
      }
    },
