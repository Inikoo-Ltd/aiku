    "Warehouse appears here when your account has access to it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Складът се показва тук, когато акаунтът ви има достъп до него."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sklad se zde zobrazí, jakmile k němu bude mít váš účet přístup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Lagerhaus erscheint hier, wenn Ihr Konto Zugriff darauf hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El almacén aparece aquí cuando su cuenta tiene acceso a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un entrepôt apparaît ici lorsque votre compte y a accès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब आपके खाते को गोदाम का एक्सेस मिलता है, तो वह यहाँ दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skladište se ovdje pojavljuje kada vaš račun ima pristup njemu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A raktár akkor jelenik meg itt, ha a fiókja hozzáfér."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gudang muncul di sini jika akun Anda memiliki akses ke gudang tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il magazzino compare qui quando il suo account vi ha accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントにアクセス権がある倉庫がここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noliktava šeit parādās, kad jūsu kontam ir piekļuve tai."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंको खातालाई पहुँच भएपछि गोदाम यहाँ देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een magazijn verschijnt hier wanneer je account er toegang toe heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Magazyn pojawi się tutaj, gdy Twoje konto uzyska do niego dostęp."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O armazém aparece aqui quando a sua conta tiver acesso a ele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depozitul apare aici când contul tău are acces la el."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sklad sa tu zobrazí, keď k nemu bude mať váš účet prístup."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lagret visas här när ditt konto har åtkomst till det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hesabınızın erişimi olduğunda depo burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Склад з’являється тут, коли ваш обліковий запис має до нього доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的账户获得访问权限后，仓库会显示在这里。"
          }
        }
      }
    },
