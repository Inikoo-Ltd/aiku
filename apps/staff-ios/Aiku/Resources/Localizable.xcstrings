    "Every delivery note has been dispatched.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всички стокови разписки са експедирани."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všechny dodací listy byly odeslány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Lieferschein wurde versendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se han expedido todos los albaranes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les bons de livraison ont été expédiés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर डिलीवरी नोट डिस्पैच हो चुका है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve otpremnice su otpremljene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden szállítólevél feladásra került."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semua surat jalan sudah dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutte le bolle di consegna sono state spedite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての納品書が出荷されました。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visas piegādes pavadzīmes ir nosūtītas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक डेलिभरी नोट पठाइसकिएको छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle pakbonnen zijn verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystkie dowody dostawy zostały wysłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todas as guias de remessa foram expedidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toate notele de livrare au fost expediate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všetky dodacie listy boli odoslané."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alla följesedlar har levererats ut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tüm irsaliyeler sevk edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усі накладні відправлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有发货单均已发货。"
          }
        }
      }
    },
    "Every delivery note is packed and the trolleys are free.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всички стокови разписки са опаковани и количките са свободни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všechny dodací listy jsou zabalené a vozíky volné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Lieferschein ist verpackt und die Wagen sind frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los albaranes están embalados y los carros están libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les bons de livraison sont emballés et les chariots sont libres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर डिलीवरी नोट पैक हो गया है और ट्रॉली खाली हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve otpremnice su spakirane i kolica su slobodna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden szállítólevél becsomagolva, és a kocsik szabadok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semua surat jalan sudah dikemas dan troli sudah kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutte le bolle di consegna sono imballate e i carrelli sono liberi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての納品書が梱包済みで、台車はすべて空いています。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visas piegādes pavadzīmes ir iepakotas, un ratiņi ir brīvi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक डेलिभरी नोट प्याक भएको छ र ट्रलीहरू खाली छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle pakbonnen zijn ingepakt en de trolleys zijn vrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystkie dowody dostawy są zapakowane, a wózki wolne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todas as guias de remessa estão embaladas e os carrinhos estão livres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toate notele de livrare sunt ambalate și cărucioarele sunt libere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všetky dodacie listy sú zabalené a vozíky sú voľné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alla följesedlar är packade och vagnarna är lediga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tüm irsaliyeler paketlendi ve toplama arabaları boş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усі накладні упаковано, а візки вільні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有发货单均已打包，拣货车均已空闲。"
          }
        }
      }
    },
    "Every hour, an SKO that has run out in a location loses that location. Active picking locations, current pick locations, locations marked “never remove empty SKOs”, SKOs with goods waiting to be placed and anything moved in the last hour are kept. Changing it needs stock edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всеки час SKO, който е свършил в дадена локация, губи тази локация. Запазват се активните локации за комплектоване, текущите локации за комплектоване, локациите с отметка „никога не премахвай празни SKO“, SKO със стоки, чакащи разполагане, и всичко преместено през последния час. Промяната изисква права за редакция на наличности."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každou hodinu přijde SKO, které v umístění došlo, o toto umístění. Zachovají se aktivní vychystávací místa, aktuální vychystávací místa, umístění označená “nikdy neodebírat prázdná SKOs”, SKOs se zbožím čekajícím na umístění a vše přesunuté za poslední hodinu. Změna vyžaduje oprávnění upravovat zásoby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stündlich verliert eine SKO, die an einem Lagerplatz aufgebraucht ist, diesen Lagerplatz. Aktive Kommissionierorte, aktuelle Kommissionierplätze, Lagerplätze mit „leere SKOs nie entfernen“, SKOs mit Ware, die auf das Einlagern wartet, und alles, was in der letzten Stunde verschoben wurde, bleiben erhalten. Zum Ändern sind Rechte zum Bearbeiten des Bestands nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada hora, un SKO que se ha agotado en una ubicación pierde esa ubicación. Se conservan las ubicaciones de preparación activas, las ubicaciones de preparación actuales, las ubicaciones marcadas con “no eliminar nunca SKOs vacíos”, los SKOs con mercancía pendiente de ubicar y todo lo que se haya movido en la última hora. Para cambiarlo se necesitan permisos de edición de stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toutes les heures, un SKO épuisé dans un emplacement perd cet emplacement. Les emplacements de préparation actifs, les emplacements de préparation en cours, les emplacements marqués « ne jamais retirer les SKO vides », les SKO avec des marchandises en attente de rangement et tout ce qui a été déplacé dans la dernière heure sont conservés. La modification nécessite les droits de modification du stock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर घंटे, जिस SKO का किसी लोकेशन में स्टॉक खत्म हो गया है, वह उस लोकेशन से हट जाता है। सक्रिय पिकिंग लोकेशन, मौजूदा पिक लोकेशन, “खाली SKOs कभी न हटाएँ” चिह्नित लोकेशन, रखे जाने की प्रतीक्षा में माल वाले SKOs और पिछले एक घंटे में ले जाई गई कोई भी चीज़ रखी जाती है। इसे बदलने के लिए स्टॉक संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svakog sata SKO koji je ostao bez zalihe na nekoj lokaciji gubi tu lokaciju. Zadržavaju se aktivne lokacije za branje, trenutne lokacije branja, lokacije označene „nikad ne uklanjaj prazne SKO-ove”, SKO-ovi s robom koja čeka uskladištenje i sve što je premješteno u zadnjih sat vremena. Za promjenu su potrebna prava uređivanja zaliha."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Óránként az az SKO, amely egy helyen elfogyott, elveszíti azt a helyet. Megmaradnak az aktív komissiózási helyek, az aktuális komissiózási helyek, a „soha ne távolítsa el az üres SKO-kat” jelölésű helyek, az elhelyezésre váró árut tartalmazó SKO-k és minden, amit az elmúlt órában áthelyeztek. A módosításhoz készletszerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap jam, SKO yang habis di suatu lokasi akan dilepas dari lokasi tersebut. Lokasi picking aktif, lokasi picking saat ini, lokasi bertanda “jangan pernah hapus SKO kosong”, SKO dengan barang yang menunggu ditempatkan, dan apa pun yang dipindahkan dalam satu jam terakhir tetap dipertahankan. Mengubahnya memerlukan hak edit stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni ora, uno SKO esaurito in un’ubicazione perde quell’ubicazione. Vengono mantenute le ubicazioni di prelievo attive, le ubicazioni di prelievo correnti, le ubicazioni contrassegnate “non rimuovere mai gli SKO vuoti”, gli SKO con merce in attesa di essere sistemata e tutto ciò che è stato spostato nell’ultima ora. Per modificarlo servono i permessi di modifica dello stock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1時間ごとに、ロケーションで在庫切れになったSKOはそのロケーションから外されます。有効なピッキングロケーション、現在のピッキングロケーション、「空のSKOを削除しない」に設定されたロケーション、格納待ちの商品があるSKO、過去1時間に移動したものは残ります。変更には在庫編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katru stundu SKO, kas vietā ir beidzies, zaudē šo vietu. Tiek saglabātas aktīvās komplektēšanas vietas, pašreizējās komplektēšanas vietas, vietas ar atzīmi “nekad nenoņemt tukšas SKO”, SKO ar precēm, kas gaida novietošanu, un viss, kas pārvietots pēdējās stundas laikā. Lai to mainītu, nepieciešamas krājumu labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक घण्टा, कुनै लोकेसनमा सकिएको SKO त्यो लोकेसनबाट हटाइन्छ। सक्रिय पिकिङ लोकेसन, हालका पिक लोकेसन, “खाली SKO हरू कहिल्यै नहटाउने” चिन्ह लगाइएका लोकेसन, राख्न बाँकी सामान भएका SKO हरू र पछिल्लो एक घण्टामा सारिएका कुनै पनि कुरा राखिन्छन्। यो बदल्न स्टक सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elk uur verliest een SKO die op een locatie op is, die locatie. Actieve picklocaties, huidige picklocaties, locaties gemarkeerd met “nooit lege SKOs verwijderen”, SKOs met goederen die nog geplaatst moeten worden en alles wat in het afgelopen uur is verplaatst, blijven behouden. Wijzigen vereist bewerkrechten voor voorraad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co godzinę SKO, którego zabrakło w lokalizacji, traci tę lokalizację. Zachowywane są aktywne lokalizacje kompletacji, bieżące lokalizacje kompletacji, lokalizacje oznaczone “nigdy nie usuwaj pustych SKOs”, SKOs z towarem oczekującym na rozlokowanie oraz wszystko, co przeniesiono w ciągu ostatniej godziny. Zmiana wymaga uprawnień do edycji zapasów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A cada hora, um SKO que esgotou numa localização perde essa localização. Mantêm-se as localizações de preparação ativas, as localizações de preparação atuais, as localizações marcadas com “nunca remover SKOs vazios”, os SKOs com mercadorias à espera de serem armazenadas e tudo o que foi movido na última hora. Alterar isto requer permissões de edição de stock."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "În fiecare oră, un SKO epuizat într-o locație pierde acea locație. Se păstrează locațiile de cules active, locațiile de cules curente, locațiile marcate „nu elimina niciodată SKO-urile goale”, SKO-urile cu mărfuri care așteaptă amplasarea și tot ce a fost mutat în ultima oră. Modificarea necesită drepturi de editare a stocului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každú hodinu SKO, ktoré sa v lokácii minulo, túto lokáciu stratí. Ponechajú sa aktívne lokácie vychystávania, aktuálne lokácie vychystávania, lokácie označené „nikdy neodstraňovať prázdne SKO“, SKO s tovarom čakajúcim na umiestnenie a všetko presunuté za poslednú hodinu. Zmena vyžaduje práva na úpravu zásob."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje timme förlorar en SKO som tagit slut på en lagerplats den lagerplatsen. Aktiva plockplatser, nuvarande plockplatser, lagerplatser markerade ”ta aldrig bort tomma SKO”, SKO med varor som väntar på att placeras och allt som flyttats den senaste timmen behålls. Att ändra detta kräver behörighet att redigera lager."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir lokasyonda tükenen SKO, her saat başı o lokasyondan kaldırılır. Aktif toplama lokasyonları, mevcut toplama lokasyonları, “boş SKO’ları asla kaldırma” olarak işaretlenen lokasyonlar, yerleştirilmeyi bekleyen malı olan SKO’lar ve son bir saatte taşınan her şey korunur. Değiştirmek için stok düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щогодини SKO, який закінчився в комірці, втрачає цю комірку. Зберігаються активні комірки комплектування, поточні комірки комплектування, комірки з позначкою «ніколи не видаляти порожні SKO», SKO з товарами, що очікують розміщення, і все, що переміщено за останню годину. Для зміни потрібні права на редагування запасів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每小时，库位中已用完的 SKO 会失去该库位。当前拣货库位、当前拣选库位、标记为“从不移除空 SKO”的库位、有待上架货物的 SKO，以及过去一小时内移动过的任何内容都会保留。更改此设置需要库存编辑权限。"
          }
        }
      }
    },
