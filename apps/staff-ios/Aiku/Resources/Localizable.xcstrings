    "Pack every line into a parcel and enter its dimensions. Then Set as packed appears.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Опаковайте всеки ред в колет и въведете размерите му. След това се появява Маркирай като опаковано."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zabalte každý řádek do balíku a zadejte jeho rozměry. Pak se zobrazí Označit jako zabalené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verpacken Sie jede Zeile in ein Paket und geben Sie dessen Maße ein. Dann erscheint Als verpackt markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Embale cada línea en un paquete e introduzca sus dimensiones. Después aparece Marcar como embalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emballez chaque ligne dans un colis et saisissez ses dimensions. Marquer comme emballé apparaît ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर लाइन को पार्सल में पैक करें और उसके आयाम दर्ज करें। फिर 'पैक किया के रूप में सेट करें' दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spakirajte svaki redak u paket i unesite njegove dimenzije. Tada se pojavljuje Označi kao spakirano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csomagoljon minden sort egy csomagba, és adja meg a méreteit. Ezután megjelenik a Becsomagoltnak jelölés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kemas setiap baris ke dalam paket dan masukkan dimensinya. Setelah itu Tandai sebagai sudah dikemas muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imballi ogni riga in un pacco e ne inserisca le dimensioni. Poi compare Imposta come imballato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての行を荷物に梱包し、寸法を入力してください。その後「梱包済みにする」が表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iepakojiet katru rindu pakā un ievadiet tās izmērus. Tad parādās Atzīmēt kā iepakotu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक लाइनलाई पार्सलमा प्याक गरी त्यसको नाप प्रविष्ट गर्नुहोस्। त्यसपछि 'प्याक गरिएको रूपमा सेट गर्नुहोस्' देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pak elke regel in een pakket in en voer de afmetingen in. Daarna verschijnt Als ingepakt markeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapakuj każdą pozycję do paczki i wprowadź jej wymiary. Wtedy pojawi się Oznacz jako zapakowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Embale cada linha num volume e introduza as dimensões. Depois aparece Marcar como embalado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ambalează fiecare linie într-un colet și introdu dimensiunile acestuia. Apoi apare Marchează ca ambalat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zabaľte každý riadok do balíka a zadajte jeho rozmery. Potom sa zobrazí Nastaviť ako zabalené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Packa varje rad i ett paket och ange dess mått. Sedan visas Markera som packad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her satırı bir pakete koyun ve paketin boyutlarını girin. Ardından Paketlendi olarak işaretle görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Упакуйте кожен рядок у посилку та введіть її розміри. Тоді з’явиться Встановити як упаковане."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将每一行打包到包裹中并输入其尺寸。之后会显示“设为已打包”。"
          }
        }
      }
    },
