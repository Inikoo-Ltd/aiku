    "Write to customer services below. They answer in Aiku, and replies show here.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пишете на обслужване на клиенти по-долу. Те отговарят в Aiku, а отговорите се показват тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napište níže zákaznickému servisu. Odpovídá v Aiku a odpovědi se zobrazí zde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schreiben Sie unten an den Kundendienst. Er antwortet in Aiku, und Antworten erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escriba abajo a servicio al cliente. Responden en Aiku y las respuestas aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Écrivez au service client ci-dessous. Il répond dans Aiku, et les réponses s’affichent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नीचे ग्राहक सेवा को लिखें। वे Aiku में जवाब देते हैं, और जवाब यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pišite korisničkoj službi u nastavku. Odgovaraju u Aikuu, a odgovori se prikazuju ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Írjon az ügyfélszolgálatnak lent. Az Aikuban válaszolnak, és a válaszok itt jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tulis ke layanan pelanggan di bawah. Mereka menjawab di Aiku, dan balasannya muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scriva al servizio clienti qui sotto. Risponde in Aiku e le risposte compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "下からカスタマーサービスにメッセージを送ってください。Aikuで回答され、返信はここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rakstiet klientu apkalpošanai zemāk. Viņi atbild Aiku, un atbildes parādās šeit."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तल ग्राहक सेवालाई लेख्नुहोस्। उनीहरू Aiku मा जवाफ दिन्छन्, र जवाफहरू यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schrijf hieronder aan de klantenservice. Ze antwoorden in Aiku en de antwoorden verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napisz poniżej do obsługi klienta. Odpowiada w Aiku, a odpowiedzi pojawiają się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escreva ao apoio ao cliente abaixo. As respostas são dadas no Aiku e aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scrie-i mai jos serviciului clienți. Ei răspund în Aiku, iar răspunsurile apar aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napíšte zákazníckemu servisu nižšie. Odpovedá v Aiku a odpovede sa zobrazia tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv till kundtjänst nedan. De svarar i Aiku och svaren visas här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aşağıdan müşteri hizmetlerine yazın. Aiku’da yanıtlarlar, yanıtlar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Напишіть у службу підтримки клієнтів нижче. Вони відповідають в Aiku, а відповіді з’являються тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在下方给客服留言。他们会在 Aiku 中回复，回复会显示在这里。"
          }
        }
      }
    },
