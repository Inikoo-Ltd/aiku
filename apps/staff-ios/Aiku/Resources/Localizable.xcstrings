        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen openstaande overwerkverzoeken kunnen worden bewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytować można tylko oczekujące wnioski o nadgodziny."
          }
        },
        "pt": {
