    "Status is operational or broken. Moving and removing need location edit rights. SKOs are added to a location from the SKO page.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Статусът е в експлоатация или повреден. Преместването и премахването изискват права за редакция на локации. SKO се добавят към локация от страницата на SKO."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stav je v provozu nebo rozbité. Přesun a odebrání vyžadují oprávnění upravovat umístění. SKOs se do umístění přidávají ze stránky SKO."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Status ist in Betrieb oder defekt. Verschieben und Entfernen erfordern Rechte zum Bearbeiten von Lagerplätzen. SKOs werden auf der SKO-Seite einem Lagerplatz hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El estado es operativo o roto. Mover y eliminar requieren permisos de edición de ubicaciones. Los SKOs se añaden a una ubicación desde la página del SKO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le statut est opérationnel ou défectueux. Déplacer et retirer nécessitent les droits de modification des emplacements. Les SKO sont ajoutés à un emplacement depuis la page du SKO."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्थिति चालू या टूटी हुई होती है। ले जाने और हटाने के लिए लोकेशन संपादन अधिकार चाहिए। SKOs को लोकेशन में SKO पेज से जोड़ा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Status je ispravno ili pokvareno. Premještanje i uklanjanje zahtijevaju prava uređivanja lokacija. SKO-ovi se dodaju na lokaciju sa stranice SKO-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az állapot működő vagy hibás. Az áthelyezéshez és eltávolításhoz helyszerkesztési jog szükséges. SKO-kat az SKO oldaláról lehet helyhez adni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Status beroperasi atau rusak. Memindahkan dan menghapus memerlukan hak edit lokasi. SKO ditambahkan ke lokasi dari halaman SKO."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo stato è operativo o guasto. Spostare e rimuovere richiede i permessi di modifica delle ubicazioni. Gli SKO si aggiungono a un’ubicazione dalla pagina dello SKO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "状態は稼働中または故障です。移動と削除にはロケーション編集権限が必要です。SKOはSKOページからロケーションに追加します。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Statuss ir darbojas vai bojāts. Pārvietošanai un noņemšanai nepieciešamas vietu labošanas tiesības. SKO vietai pievieno no SKO lapas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अवस्था सञ्चालनमा वा बिग्रिएको हुन्छ। सार्न र हटाउन लोकेसन सम्पादन अधिकार चाहिन्छ। SKO हरू SKO पृष्ठबाट लोकेसनमा थपिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De status is operationeel of kapot. Verplaatsen en verwijderen vereisen bewerkrechten voor locaties. SKOs worden aan een locatie toegevoegd vanaf de SKO-pagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Status to sprawna lub uszkodzona. Przenoszenie i usuwanie wymaga uprawnień do edycji lokalizacji. SKOs dodaje się do lokalizacji ze strony SKO."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O estado é operacional ou avariado. Mover e remover requerem permissões de edição de localizações. Os SKOs são adicionados a uma localização a partir da página do SKO."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starea este funcțională sau defectă. Mutarea și eliminarea necesită drepturi de editare a locațiilor. SKO-urile se adaugă într-o locație din pagina SKO-ului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stav je v prevádzke alebo nefunkčná. Presun a odstránenie vyžadujú práva na úpravu lokácií. SKO sa do lokácie pridávajú zo stránky SKO."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Status är i drift eller trasig. Att flytta och ta bort kräver redigeringsbehörighet för lagerplatser. SKO läggs till på en lagerplats från SKO-sidan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Durum çalışır veya arızalıdır. Taşıma ve kaldırma için lokasyon düzenleme yetkisi gerekir. SKO’lar bir lokasyona SKO sayfasından eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Статус: працює або зламано. Для переміщення та видалення потрібні права на редагування комірок. SKO додаються до комірки зі сторінки SKO."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "状态为运行中或损坏。移动和移除需要库位编辑权限。SKO 需在 SKO 页面添加到库位。"
          }
        }
      }
    },
