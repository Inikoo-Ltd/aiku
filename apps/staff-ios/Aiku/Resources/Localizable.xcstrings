    "Fast picking works while a delivery note is being picked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бързото комплектоване работи, докато стоковата разписка се комплектова."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rychlé vychystávání funguje, když se dodací list vychystává."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schnellkommissionierung funktioniert, während ein Lieferschein kommissioniert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La preparación rápida funciona mientras se prepara un albarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La préparation rapide fonctionne pendant la préparation d’un bon de livraison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ास्ट पिकिंग तभी काम करती है जब डिलीवरी नोट पिक हो रहा हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brzo branje radi dok je otpremnica u branju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A gyors komissiózás akkor működik, amikor egy szállítólevél komissiózása folyamatban van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Picking cepat berfungsi saat surat jalan sedang di-picking."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il prelievo rapido funziona mentre una bolla di consegna è in prelievo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "高速ピッキングは納品書のピッキング中に使用できます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ātrā komplektēšana darbojas, kamēr piegādes pavadzīme tiek komplektēta."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "छिटो पिकिङ डेलिभरी नोट पिक भइरहेको बेला मात्र काम गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snel picken werkt terwijl een pakbon wordt gepickt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szybka kompletacja działa podczas kompletowania dowodu dostawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A preparação rápida funciona enquanto uma guia de remessa está a ser preparada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culesul rapid funcționează cât timp o notă de livrare este în curs de cules."
