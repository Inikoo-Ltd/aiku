            "value": "A feladat Önhöz van rendelve. Az ügyfélszolgálat és a felügyelők a szállítólevélen látják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tugas ini ditugaskan kepada Anda. Layanan pelanggan dan pengawas melihatnya di surat jalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’attività è assegnata a lei. Il servizio clienti e i supervisori la vedono sulla bolla di consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タスクはあなたに割り当てられています。カスタマーサービスとスーパーバイザーは納品書でこれを確認できます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzdevums ir piešķirts jums. Klientu apkalpošana un vadītāji to redz piegādes pavadzīmē."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कार्य तपाईंलाई तोकिएको छ। ग्राहक सेवा र सुपरभाइजरले यसलाई डेलिभरी नोटमा देख्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De taak is aan jou toegewezen. Klantenservice en supervisors zien hem op de pakbon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadanie zostało przypisane do Ciebie. Obsługa klienta i kierownicy widzą je w dowodzie dostawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A tarefa está atribuída a si. O apoio ao cliente e os supervisores veem-na na guia de remessa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sarcina îți este atribuită. Serviciul clienți și supervizorii o văd pe nota de livrare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Úloha je priradená vám. Zákaznícky servis a vedúci ju vidia v dodacom liste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uppgiften är tilldelad dig. Kundtjänst och arbetsledare ser den på följesedeln."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Görev size atandı. Müşteri hizmetleri ve süpervizörler bunu irsaliyede görür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завдання призначено вам. Служба підтримки клієнтів і керівники бачать його в накладній."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任务已分配给你。客服和主管可在发货单上看到它。"
          }
        }
      }
    },
