    "No delivery notes are waiting for you. New ones appear here as soon as they are assigned.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Няма стокови разписки, които ви чакат. Новите се появяват тук веднага щом бъдат възложени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Žádné dodací listy na vás nečekají. Nové se zde objeví, jakmile budou přiřazeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Lieferscheine warten auf Sie. Neue erscheinen hier, sobald sie zugewiesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay albaranes esperándole. Los nuevos aparecerán aquí en cuanto se le asignen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun bon de livraison ne vous attend. Les nouveaux apparaissent ici dès qu’ils sont attribués."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई डिलीवरी नोट आपकी प्रतीक्षा में नहीं है। नए नोट असाइन होते ही यहाँ दिखेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedna otpremnica ne čeka na vas. Nove se ovdje pojavljuju čim budu dodijeljene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nem várja Önt szállítólevél. Az újak azonnal megjelennek itt, amint kiosztják őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak ada surat jalan yang menunggu Anda. Surat jalan baru muncul di sini begitu ditugaskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna bolla di consegna in attesa per lei. Le nuove compaiono qui non appena vengono assegnate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "待機中の納品書はありません。割り当てられるとすぐにここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jūs negaida neviena piegādes pavadzīme. Jaunās šeit parādās, tiklīdz tās ir piešķirtas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंलाई पर्खिरहेको कुनै डेलिभरी नोट छैन। नयाँहरू तोकिनासाथ यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er wachten geen pakbonnen op je. Nieuwe verschijnen hier zodra ze zijn toegewezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żadne dowody dostawy na Ciebie nie czekają. Nowe pojawią się tutaj, gdy tylko zostaną przypisane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não há guias de remessa à sua espera. As novas aparecem aqui assim que forem atribuídas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicio notă de livrare nu te așteaptă. Cele noi apar aici imediat ce sunt atribuite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nečakajú na vás žiadne dodacie listy. Nové sa tu zobrazia hneď po priradení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inga följesedlar väntar på dig. Nya visas här så snart de tilldelas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sizi bekleyen irsaliye yok. Yenileri atanır atanmaz burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає накладних, що очікують на вас. Нові з’являться тут, щойно їх буде призначено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有等待你处理的发货单。新发货单一经分配即会显示在这里。"
          }
        }
      }
    },
