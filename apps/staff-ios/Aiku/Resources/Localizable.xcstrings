    "You already have a pending adjustment request for this date.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вече имате чакаща заявка за корекция за тази дата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro toto datum již máte nevyřízenou žádost o úpravu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Datum liegt bereits ein Antrag auf Anpassung vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tiene una solicitud de ajuste pendiente para esta fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà une demande de modification en attente pour cette date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस तारीख के लिए आपका पहले से एक लंबित समायोजन अनुरोध है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već imate zahtjev za prilagodbu na čekanju za ovaj datum."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már van egy függőben lévő korrekciós kérelme erre a dátumra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah memiliki permintaan penyesuaian yang tertunda untuk tanggal ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha già una richiesta di modifica in sospeso per questa data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この日付にはすでに承認待ちの調整申請があります。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
