    "Dark is easier on the eyes in dim aisles and on night shifts.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тъмната тема натоварва по-малко очите в слабо осветени пътеки и при нощни смени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tmavý režim šetří oči v šeru mezi regály a na nočních směnách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dunkel schont die Augen in schwach beleuchteten Gängen und in Nachtschichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El modo oscuro cansa menos la vista en pasillos con poca luz y en turnos de noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mode sombre est plus reposant pour les yeux dans les allées peu éclairées et lors des postes de nuit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कम रोशनी वाले गलियारों में और रात की शिफ़्ट में डार्क आँखों के लिए आरामदायक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tamna tema je ugodnija za oči u slabo osvijetljenim prolazima i u noćnim smjenama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sötét téma kíméli a szemet a gyengén megvilágított sorok között és éjszakai műszakban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mode gelap lebih nyaman di mata di lorong yang redup dan saat shift malam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tema scuro affatica meno la vista nelle corsie poco illuminate e nei turni di notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ダークモードは薄暗い通路や夜勤で目に優しくなります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tumšais režīms ir saudzīgāks acīm vāji apgaismotās ejās un nakts maiņās."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मधुरो उज्यालो भएका गल्लीहरूमा र राति सिफ्टमा गाढा मोड आँखालाई सजिलो हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Donker is prettiger voor de ogen in schemerige gangpaden en tijdens nachtdiensten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ciemny motyw jest łagodniejszy dla oczu w słabo oświetlonych alejkach i na nocnych zmianach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O modo escuro é mais confortável para os olhos em corredores pouco iluminados e em turnos noturnos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modul întunecat e mai odihnitor pentru ochi pe culoarele slab luminate și în turele de noapte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tmavá téma je šetrnejšia k očiam v slabo osvetlených uličkách a na nočných zmenách."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mörkt är skonsammare för ögonen i dåligt upplysta gångar och på nattskift."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koyu tema, loş koridorlarda ve gece vardiyalarında gözü daha az yorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Темна тема легша для очей у темних проходах і на нічних змінах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "深色模式在昏暗的通道和夜班时更护眼。"
          }
        }
      }
    },
