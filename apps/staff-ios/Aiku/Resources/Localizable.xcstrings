    "When the customer picks it up, set it as collected. That is the collection version of Dispatch.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когато клиентът го вземе, задайте като взето. Това е вариантът на Експедиция при лично вземане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Když si ho zákazník vyzvedne, označte ho jako vyzvednutý. To je obdoba Expedice pro osobní odběr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn der Kunde es abholt, setzen Sie es auf abgeholt. Das ist die Abholversion von Versenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando el cliente lo recoja, márquelo como recogido. Es la versión para recogida de Expedir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lorsque le client vient le chercher, marquez-le comme retiré. C’est l’équivalent d’Expédier pour un retrait."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब ग्राहक इसे ले जाए, तो इसे एकत्र किया गया के रूप में सेट करें। यह डिस्पैच का कलेक्शन संस्करण है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada kupac preuzme, označite kao preuzeto. To je inačica otpreme za osobno preuzimanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Amikor az ügyfél átveszi, jelölje átvettnek. Ez a Feladás személyes átvételes változata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saat pelanggan mengambilnya, tandai sebagai diambil. Itulah versi Kirim untuk pengambilan sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando il cliente lo ritira, lo imposti come ritirato. È la versione per il ritiro di Spedisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顧客が引き取ったら、引き取り済みにしてください。これは出荷の引き取り版です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kad klients to izņem, atzīmējiet to kā izņemtu. Tā ir Nosūtīšanas versija pašizņemšanai."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्राहकले लगेपछि यसलाई सङ्कलन गरिएको भनी सेट गर्नुहोस्। यो प्रेषणको सङ्कलन संस्करण हो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zet het op afgehaald wanneer de klant het ophaalt. Dat is de afhaalversie van Verzenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy klient odbierze zamówienie, oznacz je jako odebrane. To odpowiednik Wysyłki przy odbiorze osobistym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando o cliente a recolher, marque-a como recolhida. É a versão de recolha de Expedir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Când clientul o ridică, marchează-o ca ridicată. Aceasta este varianta de ridicare a Expedierii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keď si ho zákazník vyzdvihne, nastavte ho ako vyzdvihnuté. Je to verzia Odoslať pre vyzdvihnutie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När kunden hämtar den markerar du den som hämtad. Det är upphämtningens motsvarighet till Utleverans."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Müşteri teslim aldığında teslim alındı olarak işaretleyin. Bu, Sevk et işleminin teslim alma karşılığıdır."
