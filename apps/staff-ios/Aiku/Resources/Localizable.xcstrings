    "Storing locations have a replenishment quantity instead of min and max. Needs stock edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einlagerungsplätze haben eine Nachfüllmenge statt Minimum und Maximum. Erfordert Rechte zum Bearbeiten des Bestands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las ubicaciones de almacenamiento tienen una cantidad de reposición en lugar de mínimo y máximo. Requiere permisos de edición de stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les emplacements de stockage ont une quantité de réapprovisionnement au lieu d'un min et d'un max. Nécessite les droits de modification du stock."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokacije za pohranu imaju količinu nadopune umjesto min. i maks. Potrebna su prava uređivanja zaliha."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A tárolási helyeken min. és max. helyett feltöltési mennyiség van. Készletszerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi penyimpanan memiliki jumlah pengisian ulang, bukan minimum dan maksimum. Memerlukan hak edit stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le ubicazioni di stoccaggio hanno una quantità di rifornimento invece di minimo e massimo. Servono i permessi di modifica dello stock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保管ロケーションには最小・最大の代わりに補充数量があります。在庫編集権限が必要です。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Locațiile de depozitare au o cantitate de reaprovizionare în loc de minim și maxim. Necesită drepturi de editare a stocului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skladovacie lokácie majú namiesto min. a max. množstvo na doplnenie. Vyžaduje práva na úpravu zásob."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depolama lokasyonlarında min. ve maks. yerine stok yenileme miktarı vardır. Stok düzenleme yetkisi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "存储库位使用补货数量，而非最小和最大库存。需要库存编辑权限。"
          }
        }
      }
    },
