          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La scansione preleva solo mentre è in corso il prelievo della bolla di consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スキャンによるピッキングは納品書のピッキング中のみ可能です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
