        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सुविधानुसार इसे इंस्टॉल करने के लिए अपने पर्यवेक्षक से कहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
