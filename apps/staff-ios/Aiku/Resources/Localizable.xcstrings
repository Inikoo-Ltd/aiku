    "Items show here once their checked quantity is placed in locations.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Артикулите се показват тук, след като провереното им количество бъде разположено в локации."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Položky se zde zobrazí, jakmile bude jejich zkontrolované množství uloženo do umístění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artikel erscheinen hier, sobald ihre geprüfte Menge an Lagerplätzen eingelagert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los artículos aparecen aquí cuando su cantidad comprobada está ubicada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les articles s’affichent ici une fois leur quantité vérifiée rangée dans les emplacements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आइटम यहाँ तब दिखते हैं जब उनकी जाँची गई मात्रा लोकेशन में रख दी जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artikli se ovdje prikazuju kada je njihova provjerena količina uskladištena na lokacijama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A tételek akkor jelennek meg itt, amikor az ellenőrzött mennyiségük el van helyezve a helyeken."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Barang muncul di sini setelah kuantitas yang diperiksa ditempatkan di lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli articoli compaiono qui quando la quantità verificata è sistemata nelle ubicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "確認数量がロケーションに格納されると、商品がここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preces šeit parādās, kad to pārbaudītais daudzums ir novietots vietās."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाँच गरिएको परिमाण लोकेसनमा राखेपछि वस्तुहरू यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artikelen verschijnen hier zodra hun gecontroleerde aantal op locaties is geplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozycje pojawią się tutaj, gdy ich sprawdzona ilość zostanie rozlokowana w lokalizacjach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os artigos aparecem aqui assim que a quantidade verificada for armazenada em localizações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Articolele apar aici după ce cantitatea lor verificată este amplasată în locații."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Položky sa tu zobrazia, keď sa ich skontrolované množstvo umiestni do lokácií."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artiklar visas här när deras kontrollerade antal har placerats på lagerplatser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ürünler, kontrol edilen miktarları lokasyonlara yerleştirildiğinde burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Товари з’являються тут, щойно їхню перевірену кількість розміщено в комірках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
