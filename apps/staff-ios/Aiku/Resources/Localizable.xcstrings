    "Count in units or in SKOs (outers), as set for the item. Purchasing resolves differences: recount, unit error, supplier claim or surplus accepted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zählen Sie in Einheiten oder in SKOs (Umverpackungen), wie für den Artikel festgelegt. Der Einkauf klärt Abweichungen: Nachzählung, Einheitenfehler, Lieferantenreklamation oder Überschuss akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuente en unidades o en SKOs (cajas exteriores), según esté configurado el artículo. Compras resuelve las diferencias: recuento, error de unidad, reclamación al proveedor o excedente aceptado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comptez en unités ou en SKO (cartons), selon le réglage de l’article. Les achats traitent les écarts : recomptage, erreur d’unité, réclamation fournisseur ou excédent accepté."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brojite u jedinicama ili u SKO-ovima (kutijama), kako je postavljeno za artikl. Nabava rješava razlike: ponovno brojanje, pogreška u jedinicama, reklamacija dobavljaču ili prihvaćeni višak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Számoljon egységben vagy SKO-ban (gyűjtőcsomagban), a tételnél beállítottak szerint. Az eltéréseket a beszerzés rendezi: újraszámlálás, egységhiba, beszállítói reklamáció vagy elfogadott többlet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitung dalam unit atau SKO (kemasan luar), sesuai pengaturan barang. Bagian pembelian menyelesaikan selisih: hitung ulang, kesalahan unit, klaim ke pemasok, atau kelebihan diterima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conta in unità o in SKO (confezioni), come impostato per l’articolo. L’ufficio acquisti risolve le differenze: riconteggio, errore di unità, reclamo al fornitore o eccedenza accettata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "商品の設定に従い、ユニット単位またはSKO（外箱）単位で数えてください。差異は購買が処理します：再カウント、単位の誤り、仕入先へのクレーム、または余剰の受け入れ。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numără în unități sau în SKO-uri (baxuri), după cum este setat pentru articol. Achizițiile rezolvă diferențele: renumărare, eroare de unitate, reclamație la furnizor sau surplus acceptat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Počítajte v kusoch alebo v SKO (obaloch), podľa nastavenia položky. Rozdiely rieši nákup: nové spočítanie, chyba jednotky, reklamácia u dodávateľa alebo prijatý prebytok."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ürün için ayarlandığı gibi birim veya SKO (dış koli) olarak sayın. Farkları satın alma ekibi çözer: yeniden sayım, birim hatası, tedarikçi talebi veya fazlanın kabulü."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按货品设置以件或 SKO（外箱）清点。采购部会处理差异：重新清点、单位错误、向供应商索赔或接受多余数量。"
          }
        }
      }
    },
