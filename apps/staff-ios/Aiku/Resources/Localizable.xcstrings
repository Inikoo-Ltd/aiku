    "When picking finishes with waiting lines, the delivery note moves to Waiting.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когато комплектоването приключи с чакащи редове, стоковата разписка преминава в Чакащи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Když vychystávání skončí s čekajícími řádky, dodací list přejde do stavu Čeká."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endet die Kommissionierung mit wartenden Zeilen, wechselt der Lieferschein zu Wartend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando la preparación termina con líneas en espera, el albarán pasa a En espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
