    "Scanning picks only while the delivery note is being picked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканирането комплектова само докато стоковата разписка се комплектова."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenování vychystává jen tehdy, když se dodací list vychystává."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen kommissioniert nur, während der Lieferschein kommissioniert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escaneo solo prepara mientras se está preparando el albarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le scan ne prépare que pendant la préparation du bon de livraison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्कैन से पिक केवल तब होता है जब डिलीवरी नोट पिक हो रहा हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skeniranje bere samo dok je otpremnica u branju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szkennelés csak akkor komissiózik, amikor a szállítólevél komissiózása folyamatban van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
