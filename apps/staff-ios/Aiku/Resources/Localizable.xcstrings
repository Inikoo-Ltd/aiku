    "make the next line on the list easier than this one.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "направи следващия ред в списъка по-лесен от този."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "udělej další řádek na seznamu snazší než tento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "mach die nächste Zeile auf der Liste leichter als diese."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "haga que la próxima línea de la lista sea más fácil que esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "rendez la prochaine ligne de la liste plus facile que celle-ci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सूची की अगली लाइन को इस लाइन से आसान बनाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "učini sljedeći redak na popisu lakšim od ovoga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tedd a lista következő sorát könnyebbé, mint ez volt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "buat baris berikutnya di daftar lebih mudah daripada yang ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "renda la prossima riga dell’elenco più facile di questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リストの次の行を、この行より楽にしよう。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "padariet nākamo saraksta rindu vieglāku par šo."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सूचीको अर्को लाइनलाई यो भन्दा सजिलो बनाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "maak de volgende regel op de lijst makkelijker dan deze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "spraw, by następny wiersz na liście był łatwiejszy niż ten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "torne a próxima linha da lista mais fácil do que esta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "fă următoarea linie din listă mai ușoară decât aceasta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "urob ďalší riadok v zozname ľahší ako tento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "gör nästa rad på listan enklare än den här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
