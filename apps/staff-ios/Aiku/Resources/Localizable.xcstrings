        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "都合のよいときにインストールするよう、責任者に依頼してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lūdziet savam vadītājam to instalēt, kad ērti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सुविधा अनुसार यसलाई इन्स्टल गर्न आफ्नो सुपरभाइजरलाई भन्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
