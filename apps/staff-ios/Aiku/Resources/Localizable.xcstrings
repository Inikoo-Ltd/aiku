    "nothing ships itself. thank you.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "нищо не се изпраща само. благодарим ти."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nic se neodešle samo. děkujeme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nichts verschickt sich von selbst. danke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nada se envía solo. gracias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "rien ne s’expédie tout seul. merci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुछ भी अपने आप नहीं भेजा जाता। धन्यवाद।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ništa se ne šalje samo. hvala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "semmi sem adja fel magát. köszönjük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tidak ada yang terkirim sendiri. terima kasih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "niente si spedisce da solo. grazie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ひとりでに出荷されるものはない。ありがとう。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nekas pats sevi nenosūta. paldies."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केही पनि आफैँ पठाइँदैन। धन्यवाद।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "niets verzendt zichzelf. bedankt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nic nie wysyła się samo. dziękujemy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nada se expede sozinho. obrigado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nimic nu se expediază singur. mulțumim."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nič sa neodošle samo. ďakujeme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "inget skickar sig självt. tack."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "hiçbir şey kendi kendine gönderilmez. teşekkürler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ніщо не відправляється саме. дякуємо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有什么会自己发货。谢谢你。"
