    "Pick, mark as not picked or set as waiting every line. Then Set as picked appears.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Комплектовайте, маркирайте като некомплектуван или задайте в изчакване всеки ред. След това се появява Маркирай като взето."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "U každého řádku proveďte vychystání, označení jako nevychystané nebo nastavení jako čekající. Pak se zobrazí Označit jako vychystané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommissionieren Sie jede Zeile, markieren Sie sie als nicht kommissioniert oder setzen Sie sie auf wartend. Dann erscheint Als kommissioniert markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepare, marque como no preparada o ponga en espera cada línea. Después aparece Marcar como preparado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Préparez, marquez comme non préparée ou mettez en attente chaque ligne. Marquer comme préparé apparaît ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर लाइन को पिक करें, पिक नहीं किया गया चिह्नित करें या प्रतीक्षा में सेट करें। फिर 'पिक किया के रूप में सेट करें' दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uberite, označite kao neubrano ili postavite na čekanje svaki redak. Tada se pojavljuje Označi kao ubrano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden sort komissiózzon, jelöljön nem komissiózottnak vagy állítson várakozóra. Ezután megjelenik a Komissiózottnak jelölés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ambil, tandai tidak diambil, atau tandai menunggu untuk setiap baris. Setelah itu Tandai sebagai sudah diambil muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prelevi, segni come non prelevata o imposti come in attesa ogni riga. Poi compare Imposta come prelevato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての行をピッキング、未ピッキング、または保留にしてください。その後「ピッキング済みにする」が表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katru rindu nokomplektējiet, atzīmējiet kā nenokomplektētu vai iestatiet kā gaidošu. Tad parādās Atzīmēt kā nokomplektētu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक लाइन पिक गर्नुहोस्, पिक नगरिएको चिन्ह लगाउनुहोस् वा प्रतीक्षामा सेट गर्नुहोस्। त्यसपछि 'पिक गरिएको रूपमा सेट गर्नुहोस्' देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pick elke regel, markeer hem als niet gepickt of zet hem op wachtend. Daarna verschijnt Als gepickt markeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skompletuj, oznacz jako nieskompletowaną lub ustaw jako oczekującą każdą pozycję. Wtedy pojawi się Oznacz jako skompletowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepare cada linha, marque-a como não preparada ou coloque-a em espera. Depois aparece Marcar como preparado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culege, marchează ca necules sau pune în așteptare fiecare linie. Apoi apare Marchează ca cules."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý riadok vychystajte, označte ako nevychystaný alebo nastavte ako čakajúci. Potom sa zobrazí Nastaviť ako vychystané."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plocka, markera som inte plockad eller sätt som väntande varje rad. Sedan visas Markera som plockad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her satırı toplayın, toplanmadı olarak işaretleyin veya bekliyor olarak ayarlayın. Ardından Toplandı olarak işaretle görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зберіть, позначте як не зібраний або встановіть як очікування кожен рядок. Тоді з’явиться Встановити як вибрано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "对每一行进行拣货、标记为未拣货或设为等待。之后会显示“设为已拣货”。"
          }
        }
      }
    },
