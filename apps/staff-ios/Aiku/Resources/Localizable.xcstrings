    "Picking locations can’t be changed here.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Локациите за комплектоване не могат да се променят тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávací místa zde nelze měnit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommissionierorte können hier nicht geändert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las ubicaciones de preparación no se pueden cambiar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les emplacements de préparation ne peuvent pas être modifiés ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिकिंग लोकेशन यहाँ नहीं बदली जा सकतीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokacije za branje ovdje se ne mogu mijenjati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózási helyek itt nem módosíthatók."
