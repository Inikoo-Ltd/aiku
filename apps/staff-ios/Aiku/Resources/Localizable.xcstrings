    "Saved as the incident report with your name and today’s date. The pallet’s location is cleared.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазено като доклад за инцидент с вашето име и днешна дата. Локацията на палета е изчистена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uloženo jako hlášení incidentu s vaším jménem a dnešním datem. Umístění palety se vymaže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als Vorfallbericht mit Ihrem Namen und dem heutigen Datum gespeichert. Der Lagerplatz der Palette wird geleert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se guarda como informe de incidente con su nombre y la fecha de hoy. Se borra la ubicación del palet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistré comme rapport d’incident avec votre nom et la date du jour. L’emplacement de la palette est effacé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके नाम और आज की तारीख के साथ घटना रिपोर्ट के रूप में सहेजा गया। पैलेट की लोकेशन हटा दी गई है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprema se kao prijava incidenta s vašim imenom i današnjim datumom. Lokacija palete se briše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Incidensjelentésként mentve az Ön nevével és a mai dátummal. A raklap helye törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disimpan sebagai laporan insiden dengan nama Anda dan tanggal hari ini. Lokasi palet dikosongkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salvato come segnalazione di incidente con il suo nome e la data di oggi. L’ubicazione del pallet viene azzerata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたの名前と今日の日付でインシデント報告として保存されます。パレットのロケーションはクリアされます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saglabāts kā incidenta ziņojums ar jūsu vārdu un šodienas datumu. Paletes vieta tiek notīrīta."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंको नाम र आजको मितिसहित घटना रिपोर्टको रूपमा सुरक्षित गरियो। प्यालेटको लोकेसन हटाइएको छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opgeslagen als incidentmelding met je naam en de datum van vandaag. De locatie van de pallet wordt gewist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapisano jako zgłoszenie incydentu z Twoim imieniem i nazwiskiem oraz dzisiejszą datą. Lokalizacja palety zostanie wyczyszczona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guardado como relatório de incidente com o seu nome e a data de hoje. A localização da palete é limpa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salvat ca raport de incident, cu numele tău și data de azi. Locația paletului este golită."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uložené ako hlásenie incidentu s vaším menom a dnešným dátumom. Lokácia palety sa vymaže."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sparas som incidentrapport med ditt namn och dagens datum. Pallens lagerplats rensas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adınız ve bugünün tarihiyle olay raporu olarak kaydedildi. Paletin lokasyonu temizlendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Збережено як звіт про інцидент із вашим ім’ям і сьогоднішньою датою. Комірку палета очищено."
          }
        },
        "zh-Hans": {
