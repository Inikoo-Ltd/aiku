    "Assigned to somebody else. Take it over so you can pick and pack it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Възложено е на друг. Поемете го, за да можете да го комплектовате и опаковате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přiřazeno někomu jinému. Převezměte ho, abyste ho mohli vychystat a zabalit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jemand anderem zugewiesen. Übernehmen Sie ihn, um ihn zu kommissionieren und zu packen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asignado a otra persona. Hágase cargo para poder prepararlo y embalarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attribué à quelqu’un d’autre. Prenez-le en charge pour pouvoir le préparer et l’emballer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी और को असाइन है। इसे अपने हाथ में लें ताकि आप इसे पिक और पैक कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodijeljeno nekom drugom. Preuzmite je kako biste je mogli ubrati i spakirati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valaki más kapta meg. Vegye át, hogy komissiózhassa és becsomagolhassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditugaskan ke orang lain. Ambil alih agar Anda dapat mengambil dan mengemasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assegnata a un’altra persona. La prenda in carico per poterla prelevare e imballare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "他の人に割り当てられています。ピッキングと梱包を行うには引き継いでください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piešķirts kādam citam. Pārņemiet to, lai varētu to nokomplektēt un iepakot."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अरू कसैलाई तोकिएको छ। पिक र प्याक गर्न यसलाई आफ्नो जिम्मामा लिनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toegewezen aan iemand anders. Neem het over om het te picken en in te pakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przypisano do kogoś innego. Przejmij, aby skompletować i zapakować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atribuída a outra pessoa. Assuma-a para a poder preparar e embalar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atribuită altcuiva. Preia-o ca să o poți culege și ambala."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Priradené niekomu inému. Prevezmite ho, aby ste ho mohli vychystať a zabaliť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilldelad någon annan. Ta över den så att du kan plocka och packa den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başka birine atanmış. Toplayıp paketleyebilmek için devralın."
          }
        },
        "uk": {
