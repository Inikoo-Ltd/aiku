    "Place each checked item. You can only place what was checked. When every item is placed the delivery becomes Booked in by itself.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Складирайте всеки проверен артикул. Можете да складирате само провереното. Когато всички артикули са складирани, доставката автоматично става „Заприходена“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umístěte každou zkontrolovanou položku. Umístit můžete jen to, co bylo zkontrolováno. Jakmile jsou umístěny všechny položky, dodávka se automaticky přepne do stavu Naskladněno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lagern Sie jeden geprüften Artikel ein. Sie können nur einlagern, was geprüft wurde. Sobald alle Artikel eingelagert sind, wird die Lieferung automatisch eingebucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ubique cada artículo comprobado. Solo puede ubicar lo que se ha comprobado. Cuando todos los artículos están ubicados, la entrega pasa sola a Entrada registrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rangez chaque article vérifié. Vous ne pouvez ranger que ce qui a été vérifié. Quand tous les articles sont rangés, la livraison passe automatiquement à Réceptionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर जाँचा गया आइटम रखें। आप केवल वही रख सकते हैं जो जाँचा गया है। जब हर आइटम रख दिया जाता है, तो डिलीवरी अपने आप बुक इन हो जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Smjestite svaku provjerenu stavku. Možete smjestiti samo ono što je provjereno. Kad je svaka stavka smještena, isporuka sama postaje Proknjiženo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Helyezzen el minden ellenőrzött tételt. Csak az ellenőrzött mennyiség helyezhető el. Ha minden tétel el van helyezve, a beszállítás magától Bevételezve állapotba kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tempatkan setiap item yang sudah diperiksa. Anda hanya dapat menempatkan yang sudah diperiksa. Setelah semua item ditempatkan, penerimaan otomatis menjadi Sudah masuk stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stocchi ogni articolo verificato. Può stoccare solo ciò che è stato verificato. Quando tutti gli articoli sono stoccati, la consegna diventa automaticamente Registrata in magazzino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "検品済みの各品目を格納してください。格納できるのは検品済みの数量のみです。すべての品目を格納すると、入荷は自動的に「入庫済み」になります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvietojiet katru pārbaudīto pozīciju. Var izvietot tikai to, kas ir pārbaudīts. Kad visas pozīcijas ir izvietotas, piegāde automātiski kļūst Iegrāmatota."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाँच गरिएका प्रत्येक वस्तु राख्नुहोस्। जाँच गरिएको मात्र राख्न सकिन्छ। सबै वस्तुहरू राखिएपछि डेलिभरी आफैँ स्टकमा दर्ता हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plaats elk gecontroleerd item. Je kunt alleen plaatsen wat is gecontroleerd. Zodra elk item is geplaatst, wordt de levering vanzelf Ingeboekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozlokuj każdy sprawdzony przedmiot. Można rozlokować tylko to, co sprawdzono. Gdy wszystkie przedmioty zostaną rozlokowane, dostawa sama otrzyma status Przyjęte na stan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coloque cada item verificado. Só pode colocar o que foi verificado. Quando todos os itens estiverem colocados, a entrega passa automaticamente a Rececionado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plasați fiecare articol verificat. Puteți plasa doar ce a fost verificat. Când toate articolele sunt plasate, livrarea devine automat Recepționată în stoc."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uložte každú skontrolovanú položku. Uložiť môžete iba to, čo bolo skontrolované. Keď sú uložené všetky položky, dodávka sa automaticky prepne do stavu Naskladnené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Placera varje kontrollerad artikel. Du kan bara placera det som har kontrollerats. När alla artiklar är placerade blir leveransen Inbokad automatiskt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrol edilen her kalemi yerleştirin. Yalnızca kontrol edileni yerleştirebilirsiniz. Tüm kalemler yerleştirildiğinde teslimat kendiliğinden Stoğa alındı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розмістіть кожен перевірений товар. Розміщувати можна лише перевірене. Коли всі товари розміщено, поставка автоматично стає оприбуткованою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "逐一上架已检查的货品。只能上架已检查的数量。所有货品上架后，到货单将自动变为“已入库”。"
          }
        }
      }
    },
    "Place part here and the rest in another location by lowering the quantity.": {
      "extractionState": "manual",
