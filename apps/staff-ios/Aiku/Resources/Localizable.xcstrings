            "value": "Az ezen a szállítólevélen végzett munkája ezen a telefonon marad, és elküldjük, amint újra online lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pekerjaan Anda pada surat jalan ini disimpan di ponsel ini dan dikirim saat Anda kembali online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo lavoro su questa bolla resta su questo telefono e viene inviato quando torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この納品書での作業はこの端末に保存され、オンラインに戻ると送信されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jūsu darbs ar šo pavadzīmi paliek šajā tālrunī un tiks nosūtīts, kad atkal būsiet tiešsaistē."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो डेलिभरी नोटमा तपाईंको काम यही फोनमा रहन्छ र फेरि अनलाइन हुँदा पठाइन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je werk aan deze pakbon blijft op deze telefoon en wordt verzonden zodra je weer online bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoja praca nad tym dokumentem zostaje na tym telefonie i zostanie wysłana, gdy wrócisz do sieci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O seu trabalho nesta guia fica neste telemóvel e é enviado quando voltar a estar online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Munca ta pe acest aviz rămâne pe acest telefon și este trimisă când revii online."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaša práca na tomto doklade zostáva v tomto telefóne a odošle sa, keď budete opäť online."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditt arbete med den här följesedeln finns kvar på telefonen och skickas när du är online igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu irsaliyedeki çalışmanız bu telefonda kalır ve yeniden çevrimiçi olduğunuzda gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваша робота з цією накладною залишається на цьому телефоні й буде надіслана, щойно ви знову будете онлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你在此发货单上的操作会保存在这部手机上，恢复网络后发送。"
          }
        }
      }
