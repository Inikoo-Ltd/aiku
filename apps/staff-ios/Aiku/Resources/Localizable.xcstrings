    "Scan to pick shows only when the organisation allows it. Tap a line for Pick all, another location, Not picked or Set as waiting.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Сканирайте за вземане“ се показва само ако организацията го позволява. Докоснете ред за „Вземи всичко“, друга локация, „Несъбрано“ или „Задай в изчакване“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenovat pro vychystání se zobrazí, jen pokud to organizace povoluje. Klepněte na řádek pro Vychystat vše, jinou lokaci, Nevychystáno nebo Nastavit jako čekající."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Scannen zum Kommissionieren“ wird nur angezeigt, wenn die Organisation es erlaubt. Tippen Sie auf eine Position für „Alle kommissionieren“, einen anderen Lagerplatz, „Nicht kommissioniert“ oder „Als wartend markieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escanear para preparar solo aparece si la organización lo permite. Toque una línea para Preparar todo, otra ubicación, No preparado o Marcar como en espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanner pour préparer n'apparaît que si l'organisation l'autorise. Touchez une ligne pour Tout préparer, un autre emplacement, Non préparé ou Définir comme en attente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिक करने के लिए स्कैन केवल तभी दिखता है जब संगठन इसकी अनुमति देता है। सब पिक करें, दूसरी लोकेशन, पिक नहीं किया गया या प्रतीक्षा में सेट करें के लिए किसी लाइन पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skeniraj za branje prikazuje se samo kad ga organizacija dopušta. Dodirnite redak za Uberi sve, drugu lokaciju, Nije ubrano ili Postavi kao čekanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A Beolvasás komissiózáshoz csak akkor jelenik meg, ha a szervezet engedélyezi. Koppintson egy sorra az Összes komissiózása, a másik raktárhely, a Nincs komissiózva vagy a Várakozóként beállítás lehetőségért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindai untuk mengambil hanya muncul jika organisasi mengizinkannya. Ketuk baris untuk Ambil semua, lokasi lain, Tidak diambil, atau Tandai sebagai menunggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scansiona per prelevare compare solo se l'organizzazione lo consente. Tocchi una riga per Preleva tutto, un'altra ubicazione, Non prelevato o Imposta come in attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「スキャンしてピッキング」は組織で許可されている場合のみ表示されます。明細をタップすると、全数ピッキング、別のロケーション、未ピッキング、待機中にするを選べます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenēšana komplektēšanai ir redzama tikai tad, ja organizācija to atļauj. Pieskarieties rindai, lai izvēlētos Komplektēt visu, citu vietu, Nav komplektēts vai Atzīmēt kā gaidošu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संस्थाले अनुमति दिएमा मात्र “पिक गर्न स्क्यान गर्नुहोस्” देखिन्छ। सबै पिक गर्न, अर्को लोकेसन, पिक नगरिएको वा प्रतीक्षारत रूपमा सेट गर्न लाइनमा ट्याप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen om te picken verschijnt alleen als de organisatie het toestaat. Tik op een regel voor Alles picken, een andere locatie, Niet gepickt of Instellen als wachtend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Skanuj, aby skompletować” jest widoczne tylko, gdy organizacja na to pozwala. Stuknij wiersz, aby wybrać Skompletuj wszystko, inną lokalizację, Nieskompletowane lub Ustaw jako oczekujące."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ler para preparar só aparece quando a organização o permite. Toque numa linha para Preparar tudo, outra localização, Não preparado ou Definir como em espera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Scanați pentru cules” apare doar când organizația permite acest lucru. Atingeți o linie pentru Culegeți tot, altă locație, Necules sau Setat ca în așteptare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenovať na vychystanie sa zobrazí, iba ak to organizácia povoľuje. Ťuknite na riadok pre Vychystať všetko, inú lokáciu, Nevychystané alebo Nastaviť ako čakajúce."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanna för att plocka visas bara när organisationen tillåter det. Tryck på en rad för Plocka alla, en annan lagerplats, Ej plockad eller Ställ in som väntande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplamak için tara yalnızca organizasyon izin verdiğinde görünür. Tümünü topla, başka bir lokasyon, Toplanmadı veya Beklemede olarak işaretle için bir satıra dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Скануйте, щоб зібрати» показується, лише якщо це дозволяє організація. Торкніться рядка, щоб вибрати «Зібрати все», іншу комірку, «Не зібрано» або «Встановити як очікування»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在组织允许时才显示“扫码拣货”。点按明细行可选择全部拣货、其他库位、未拣货或设为等待。"
          }
        }
      }
    },
