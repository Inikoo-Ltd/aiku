          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los artículos ubicados, así que la entrega queda con entrada registrada automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les articles sont rangés, la livraison est donc réceptionnée automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सभी आइटम रख दिए गए, इसलिए डिलीवरी अपने आप बुक इन हो गई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svi artikli su uskladišteni, pa isporuka sama prelazi u Rezervirano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden tétel elhelyezve, így a szállítás automatikusan Bevételezve állapotba kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semua barang sudah ditempatkan, jadi penerimaan otomatis menjadi Sudah masuk stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutti gli articoli sono stati sistemati, quindi la consegna viene registrata in magazzino automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての商品が格納されたため、入荷便は自動的に入庫済みになりました。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visas preces ir novietotas, tāpēc piegāde automātiski kļūst Pieņemta noliktavā."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सबै वस्तु राखियो, त्यसैले डेलिभरी आफैं स्टकमा दर्ता भयो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle artikelen zijn geplaatst, dus de levering is automatisch Ingeboekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystkie pozycje rozlokowane, więc dostawa automatycznie otrzymuje status Przyjęte na stan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
