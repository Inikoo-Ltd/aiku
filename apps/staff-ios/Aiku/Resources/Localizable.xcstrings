          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंको संस्थामा सक्रिय सिफ्ट भएमा मात्र देखिन्छ। नभए क्यामेरा तुरुन्तै खुल्छ।"
          }
        },
        "nl": {
          "stringUnit": {
