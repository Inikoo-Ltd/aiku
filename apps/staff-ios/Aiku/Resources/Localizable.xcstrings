        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· déjà rangé, non compté"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· पहले ही रखा गया, गिना नहीं गया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· već uskladišteno, nije prebrojano"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· már elhelyezve, nincs megszámolva"
