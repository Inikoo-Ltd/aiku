    "The pallet waits for customer service. They must resolve it before the return can be set as picked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Палетът чака обслужване на клиенти. Те трябва да решат въпроса, преди връщането да може да се маркира като комплектовано."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleta čeká na zákaznický servis. Ten to musí vyřešit, než bude možné vratku označit jako vychystanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Palette wartet auf den Kundendienst. Er muss es klären, bevor die Rückgabe als kommissioniert markiert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El palet queda a la espera de servicio al cliente. Deben resolverlo antes de poder marcar la devolución como preparada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La palette attend le service client. Il doit résoudre le problème avant que le retour puisse être marqué comme préparé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पैलेट ग्राहक सेवा की प्रतीक्षा करता है। वापसी को पिक किया गया सेट करने से पहले उन्हें इसे सुलझाना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleta čeka korisničku službu. Ona to mora riješiti prije nego što se povrat može označiti kao ubran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A raklap az ügyfélszolgálatra vár. Nekik kell rendezniük, mielőtt a visszaküldés komissiózottnak jelölhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palet menunggu layanan pelanggan. Mereka harus menyelesaikannya sebelum pengembalian dapat ditandai sudah diambil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il pallet attende il servizio clienti, che deve risolvere prima che il reso possa essere impostato come prelevato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パレットはカスタマーサービスの対応待ちです。返品をピッキング済みにする前に解決する必要があります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palete gaida klientu apkalpošanu. Tai tas jāatrisina, pirms atgriezumu var atzīmēt kā nokomplektētu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्यालेट ग्राहक सेवाको प्रतीक्षामा छ। फिर्तालाई पिक गरिएको भनी सेट गर्नुअघि उनीहरूले यसलाई समाधान गर्नुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De pallet wacht op de klantenservice. Die moet het oplossen voordat de retour als gepickt kan worden gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleta czeka na obsługę klienta. Musi ona rozwiązać problem, zanim zwrot będzie można oznaczyć jako skompletowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A palete aguarda o apoio ao cliente, que tem de resolver a situação antes de a devolução poder ser marcada como preparada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paletul așteaptă serviciul clienți. Aceștia trebuie să rezolve situația înainte ca returul să poată fi marcat ca cules."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleta čaká na zákaznícky servis. Ten to musí vyriešiť, kým bude možné vrátenie nastaviť ako vychystané."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pallen väntar på kundtjänst. De måste lösa det innan returen kan markeras som plockad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palet müşteri hizmetlerini bekliyor. İade toplandı olarak işaretlenmeden önce bunu çözmeleri gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Палет очікує на службу підтримки клієнтів. Вона має це вирішити, перш ніж повернення можна буде позначити як зібране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "托盘等待客服处理。客服必须先解决该问题，退货才能设为已拣货。"
          }
        }
      }
    },
    "The pick didn’t get an answer. Try again; it is not picked twice.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вземането не получи отговор. Опитайте отново; няма да се вземе два пъти."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystání nedostalo odpověď. Zkuste to znovu; nevychystá se dvakrát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf die Kommissionierung kam keine Antwort. Versuchen Sie es erneut; es wird nicht doppelt kommissioniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La preparación no ha recibido respuesta. Inténtelo de nuevo; no se prepara dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La préparation n'a pas reçu de réponse. Réessayez : elle ne sera pas faite deux fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिक का जवाब नहीं मिला। फिर से प्रयास करें; यह दो बार पिक नहीं होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Branje nije dobilo odgovor. Pokušajte ponovno; neće se ubrati dvaput."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózásra nem jött válasz. Próbálja újra; nem lesz kétszer komissiózva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengambilan tidak mendapat jawaban. Coba lagi; tidak akan diambil dua kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il prelievo non ha ricevuto risposta. Riprovi: non verrà prelevato due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピッキングに応答がありませんでした。もう一度お試しください。二重にピッキングされることはありません。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uz komplektēšanu netika saņemta atbilde. Mēģiniet vēlreiz; tas netiks komplektēts divreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिकको जवाफ आएन। फेरि प्रयास गर्नुहोस्; यो दुई पटक पिक हुँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De pick kreeg geen antwoord. Probeer het opnieuw; er wordt niet dubbel gepickt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompletacja nie otrzymała odpowiedzi. Spróbuj ponownie; nie zostanie skompletowane dwa razy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A preparação não obteve resposta. Tente novamente; não é preparada duas vezes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culegerea nu a primit răspuns. Încercați din nou; nu va fi culeasă de două ori."
