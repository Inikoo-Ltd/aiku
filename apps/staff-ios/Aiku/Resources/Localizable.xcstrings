    "Saved as the incident report with your name and today’s date. The pallet’s location is cleared.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазено като доклад за инцидент с вашето име и днешна дата. Локацията на палета е изчистена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
