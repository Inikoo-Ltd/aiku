    "**Swipe** to show the action buttons · **swipe all the way** to do it at once · right = Picked, left = Partial / Not picked": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Плъзнете**, за да покажете бутоните за действие · **плъзнете докрай**, за да го направите веднага · надясно = Комплектовано, наляво = Частично / Некомплектовано"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Přejetím** zobrazíte tlačítka akcí · **přejetím až na konec** akci provedete hned · doprava = Vychystáno, doleva = Částečně / Nevychystáno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Wischen** zeigt die Aktionsschaltflächen · **ganz durchwischen** führt die Aktion sofort aus · rechts = Kommissioniert, links = Teilweise / Nicht kommissioniert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Deslice** para mostrar los botones de acción · **deslice hasta el final** para hacerlo de una vez · derecha = Preparado, izquierda = Parcial / No preparado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Balayez** pour afficher les boutons d’action · **balayez jusqu’au bout** pour le faire d’un coup · droite = Préparé, gauche = Partiel / Non préparé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक्शन बटन दिखाने के लिए **स्वाइप** करें · एक बार में करने के लिए **पूरा स्वाइप** करें · दायाँ = पिक किया गया, बायाँ = आंशिक / पिक नहीं किया गया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Povucite** za prikaz gumba radnji · **povucite do kraja** za trenutačno izvršenje · desno = Ubrano, lijevo = Djelomično / Nije ubrano"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Húzza el** a műveletgombok megjelenítéséhez · **húzza végig** az azonnali végrehajtáshoz · jobbra = Komissiózva, balra = Részleges / Nincs komissiózva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Geser** untuk menampilkan tombol aksi · **geser sampai ujung** untuk langsung menjalankannya · kanan = Sudah diambil, kiri = Sebagian / Tidak diambil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Scorra** per mostrare i pulsanti di azione · **scorra fino in fondo** per farlo subito · destra = Prelevato, sinistra = Parziale / Non prelevato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**スワイプ**で操作ボタンを表示 · **最後までスワイプ**で一度に実行 · 右 = ピッキング済み、左 = 一部 / 未ピッキング"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Pavelciet**, lai parādītu darbību pogas · **pavelciet līdz galam**, lai to izdarītu uzreiz · pa labi = Nokomplektēts, pa kreisi = Daļēji / Nav nokomplektēts"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कार्य बटनहरू देखाउन **स्वाइप** गर्नुहोस् · एकैपटक गर्न **पूरै स्वाइप** गर्नुहोस् · दायाँ = पिक गरिएको, बायाँ = आंशिक / पिक नगरिएको"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Veeg** om de actieknoppen te tonen · **veeg helemaal door** om het meteen te doen · rechts = Gepickt, links = Gedeeltelijk / Niet gepickt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Przesuń**, aby pokazać przyciski akcji · **przesuń do końca**, aby wykonać od razu · w prawo = Skompletowane, w lewo = Częściowo / Nieskompletowane"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Deslize** para mostrar os botões de ação · **deslize até ao fim** para o fazer de uma vez · direita = Preparado, esquerda = Parcial / Não preparado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Glisează** pentru a afișa butoanele de acțiune · **glisează până la capăt** pentru a o face imediat · dreapta = Cules, stânga = Parțial / Necules"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Potiahnutím** zobrazíte tlačidlá akcií · **potiahnutím až na koniec** akciu vykonáte hneď · doprava = Vychystané, doľava = Čiastočne / Nevychystané"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Svep** för att visa åtgärdsknapparna · **svep hela vägen** för att göra det direkt · höger = Plockad, vänster = Delvis / Inte plockad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eylem düğmelerini göstermek için **kaydırın** · tek seferde yapmak için **sonuna kadar kaydırın** · sağ = Toplandı, sol = Kısmi / Toplanmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**Проведіть**, щоб показати кнопки дій · **проведіть до кінця**, щоб виконати одразу · праворуч = Зібрано, ліворуч = Частково / Не зібрано"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "**滑动**显示操作按钮 · **完全滑到底**可一次完成 · 右滑 = 已拣货，左滑 = 部分 / 未拣货"
          }
        }
      }
    },
