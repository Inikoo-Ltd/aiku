    "Scan to pack, or tap a line to pack part of it or unpack it. Every parcel needs its length, width and height before Set as packed.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканирайте за опаковане или докоснете ред, за да опаковате част от него или да го разопаковате. Всеки колет трябва да има дължина, ширина и височина, преди „Маркирай като опаковано“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenujte pro zabalení, nebo klepněte na řádek a zabalte jeho část či ho rozbalte. Každý balík musí mít před Nastavit jako zabalené zadanou délku, šířku a výšku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen Sie zum Packen oder tippen Sie auf eine Position, um sie teilweise zu packen oder auszupacken. Jedes Paket benötigt Länge, Breite und Höhe, bevor es als verpackt markiert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escanee para embalar o toque una línea para embalar una parte o desembalarla. Cada paquete necesita largo, ancho y alto antes de Marcar como embalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannez pour emballer, ou touchez une ligne pour en emballer une partie ou la déballer. Chaque colis doit avoir sa longueur, sa largeur et sa hauteur avant Marquer comme emballé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पैक करने के लिए स्कैन करें, या किसी लाइन का कुछ हिस्सा पैक या अनपैक करने के लिए उस पर टैप करें। पैक किया के रूप में सेट करने से पहले हर पार्सल की लंबाई, चौड़ाई और ऊँचाई ज़रूरी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenirajte za pakiranje ili dodirnite redak da ga djelomično spakirate ili raspakirate. Svaki paket treba duljinu, širinu i visinu prije Označi kao spakirano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Olvasson be a csomagoláshoz, vagy koppintson egy sorra részleges csomagoláshoz vagy kicsomagoláshoz. A Csomagoltnak jelölés előtt minden csomaghoz meg kell adni a hosszúságot, szélességet és magasságot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindai untuk mengemas, atau ketuk baris untuk mengemas sebagian atau membuka kemasannya. Setiap paket memerlukan panjang, lebar, dan tinggi sebelum Tandai sebagai sudah dikemas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scansioni per imballare, oppure tocchi una riga per imballarne una parte o disimballarla. Ogni pacco deve avere lunghezza, larghezza e altezza prima di Imposta come imballato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スキャンして梱包するか、明細をタップして一部を梱包または梱包解除します。「梱包済みにする」の前に、すべての荷物に長さ・幅・高さが必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenējiet, lai iepakotu, vai pieskarieties rindai, lai iepakotu daļu vai izpakotu. Katrai paciņai jānorāda garums, platums un augstums pirms Atzīmēt kā iepakotu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्याक गर्न स्क्यान गर्नुहोस्, वा लाइनको केही भाग प्याक गर्न वा खोल्न त्यसमा ट्याप गर्नुहोस्। प्याक गरिएको रूपमा सेट गर्नुअघि प्रत्येक पार्सलको लम्बाइ, चौडाइ र उचाइ चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scan om in te pakken, of tik op een regel om een deel in te pakken of uit te pakken. Elk pakket heeft een lengte, breedte en hoogte nodig voordat je Instellen als verpakt kunt gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanuj, aby spakować, lub stuknij wiersz, aby spakować jego część albo go rozpakować. Każda paczka musi mieć długość, szerokość i wysokość przed oznaczeniem jako zapakowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leia para embalar ou toque numa linha para embalar parte dela ou desembalá-la. Cada volume precisa de comprimento, largura e altura antes de Definir como embalado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanați pentru ambalare sau atingeți o linie pentru a ambala o parte din ea ori pentru a o despacheta. Fiecare colet are nevoie de lungime, lățime și înălțime înainte de Setați ca ambalat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenujte na zabalenie alebo ťuknite na riadok a zabaľte jeho časť či ho rozbaľte. Každý balík musí mať pred Nastaviť ako zabalené zadanú dĺžku, šírku a výšku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanna för att packa, eller tryck på en rad för att packa en del av den eller packa upp den. Varje kolli behöver längd, bredd och höjd innan Markera som packad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paketlemek için tarayın veya bir kısmını paketlemek ya da paketten çıkarmak için bir satıra dokunun. Paketlendi olarak işaretlemeden önce her paketin uzunluğu, genişliği ve yüksekliği girilmelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скануйте, щоб упакувати, або торкніться рядка, щоб упакувати його частину чи розпакувати. Перед «Позначити як упаковано» кожна посилка має мати довжину, ширину та висоту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫码打包，或点按明细行进行部分打包或撤销打包。设为已打包前，每个包裹都需要填写长、宽、高。"
          }
        }
      }
    },
