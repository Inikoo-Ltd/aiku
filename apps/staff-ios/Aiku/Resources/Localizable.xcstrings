    "Enter a quantity of 0 or more for each box.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geben Sie für jeden Karton eine Menge von 0 oder mehr ein."
          }
