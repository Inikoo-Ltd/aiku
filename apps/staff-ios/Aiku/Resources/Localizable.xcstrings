    "The camera can’t scan here. Close it and type or scan the barcode in the field.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Камерата не може да сканира тук. Затворете я и въведете или сканирайте баркода в полето."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fotoaparát zde nemůže skenovat. Zavřete ho a zadejte nebo naskenujte čárový kód do pole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kamera kann hier nicht scannen. Schließen Sie sie und geben Sie den Barcode im Feld ein oder scannen Sie ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cámara no puede escanear aquí. Ciérrela y escriba o escanee el código de barras en el campo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil photo ne peut pas scanner ici. Fermez-le et saisissez ou scannez le code-barres dans le champ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कैमरा यहाँ स्कैन नहीं कर सकता। इसे बंद करें और फ़ील्ड में बारकोड टाइप या स्कैन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamera ovdje ne može skenirati. Zatvorite je i upišite ili skenirajte barkod u polje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A kamera itt nem tud szkennelni. Zárja be, és írja be vagy szkennelje be a vonalkódot a mezőbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamera tidak dapat memindai di sini. Tutup kamera lalu ketik atau pindai barcode di kolom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fotocamera non può scansionare qui. La chiuda e digiti o scansioni il codice a barre nel campo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここではカメラでスキャンできません。カメラを閉じて、入力欄にバーコードを入力またはスキャンしてください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamera šeit nevar skenēt. Aizveriet to un ierakstiet vai noskenējiet svītrkodu laukā."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्यामेराले यहाँ स्क्यान गर्न सक्दैन। यसलाई बन्द गरी फिल्डमा बारकोड टाइप वा स्क्यान गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De camera kan hier niet scannen. Sluit hem en typ of scan de barcode in het veld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aparat nie może tutaj skanować. Zamknij go i wpisz lub zeskanuj kod kreskowy w polu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A câmara não consegue ler aqui. Feche-a e escreva ou leia o código de barras no campo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Camera nu poate scana aici. Închide-o și tastează sau scanează codul de bare în câmp."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fotoaparát tu nemôže skenovať. Zavrite ho a zadajte alebo naskenujte čiarový kód do poľa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kameran kan inte skanna här. Stäng den och skriv eller skanna streckkoden i fältet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamera burada tarayamaz. Kapatın ve barkodu alana yazın veya tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Камера тут не може сканувати. Закрийте її та введіть або відскануйте штрих-код у полі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此处无法使用相机扫描。请关闭相机，在输入框中输入或扫描条形码。"
