            "value": "Installi un’app di autenticazione, come Google Authenticator, poi riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google Authenticatorなどの認証アプリをインストールしてから、もう一度お試しください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
