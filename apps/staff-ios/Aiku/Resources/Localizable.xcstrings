        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komplektētāji šeit parādās, kamēr strādā."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिकरहरू काम गर्दा यहाँ देखिन्छन्।"
