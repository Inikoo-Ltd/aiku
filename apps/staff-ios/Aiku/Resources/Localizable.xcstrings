    "Aiku could not record these exactly as you did them. Open each one to see what to do.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku не можа да ги запише точно както ги направихте. Отворете всяко, за да видите какво да направите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku je nemohl zaznamenat přesně tak, jak jste je provedli. Otevřete každou a podívejte se, co dělat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku konnte diese nicht genau so erfassen, wie Sie sie ausgeführt haben. Öffnen Sie jede, um zu sehen, was zu tun ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku no pudo registrarlas exactamente como las hiciste. Abre cada una para ver qué hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku n’a pas pu les enregistrer exactement comme vous les avez faites. Ouvrez chacune pour voir quoi faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku इन्हें ठीक वैसे दर्ज नहीं कर सका जैसे आपने किया था। क्या करना है देखने के लिए हर एक खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku ih nije mogao zabilježiti točno kako ste ih napravili. Otvorite svaku da vidite što učiniti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Aiku nem tudta pontosan úgy rögzíteni ezeket, ahogy elvégezted. Nyisd meg mindegyiket, hogy lásd, mit kell tenni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku tidak dapat mencatat ini persis seperti yang Anda lakukan. Buka masing-masing untuk melihat apa yang harus dilakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku non ha potuto registrarle esattamente come le hai fatte. Apri ciascuna per vedere cosa fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku はこれらを実施どおりに記録できませんでした。それぞれを開いて対応を確認してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku nevarēja tās reģistrēt tieši tā, kā jūs tās veicāt. Atveriet katru, lai redzētu, kas jādara."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku ले यिनीहरूलाई तपाईंले गरेजस्तै ठ्याक्कै रेकर्ड गर्न सकेन। के गर्ने हेर्न प्रत्येक खोल्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku kon deze niet precies vastleggen zoals je ze deed. Open ze een voor een om te zien wat je moet doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku nie mógł zapisać ich dokładnie tak, jak je wykonano. Otwórz każdą, aby zobaczyć, co zrobić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Aiku não conseguiu registrá-las exatamente como você fez. Abra cada uma para ver o que fazer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku nu le-a putut înregistra exact cum le-ai făcut. Deschide-le pe fiecare ca să vezi ce ai de făcut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku ich nemohol zaznamenať presne tak, ako ste ich urobili. Otvorte každú a pozrite sa, čo robiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku kunde inte registrera dem exakt som du gjorde dem. Öppna var och en för att se vad du ska göra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku bunları tam yaptığınız gibi kaydedemedi. Ne yapmanız gerektiğini görmek için her birini açın."
