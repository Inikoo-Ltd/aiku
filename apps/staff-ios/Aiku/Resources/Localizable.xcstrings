    "You can only log out once the queue is synced or discarded.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Можете да излезете само след като опашката бъде синхронизирана или отхвърлена."
          }
        },
        "cs": {
          "stringUnit": {
