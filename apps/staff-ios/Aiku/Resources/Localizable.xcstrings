    "Ask your supervisor to install it when convenient.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Помолете вашия супервайзър да я инсталира, когато е удобно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Požádejte vedoucího, aby ji nainstaloval, až se mu to bude hodit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bitten Sie Ihren Vorgesetzten, sie bei Gelegenheit zu installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pida a su supervisor que la instale cuando le venga bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demandez à votre responsable de l'installer quand cela lui convient."
