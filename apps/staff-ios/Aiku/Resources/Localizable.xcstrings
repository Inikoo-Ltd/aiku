          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se avisa al transportista: cancele la etiqueta con él si ya estaba reservada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
