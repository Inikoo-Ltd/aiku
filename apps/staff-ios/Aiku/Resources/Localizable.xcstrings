        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब ग्राहक इसे ले जाए, तो इसे एकत्र किया गया के रूप में सेट करें। यह डिस्पैच का कलेक्शन संस्करण है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada kupac preuzme, označite kao preuzeto. To je inačica otpreme za osobno preuzimanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Amikor az ügyfél átveszi, jelölje átvettnek. Ez a Feladás személyes átvételes változata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saat pelanggan mengambilnya, tandai sebagai diambil. Itulah versi Kirim untuk pengambilan sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando il cliente lo ritira, lo imposti come ritirato. È la versione per il ritiro di Spedisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顧客が引き取ったら、引き取り済みにしてください。これは出荷の引き取り版です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kad klients to izņem, atzīmējiet to kā izņemtu. Tā ir Nosūtīšanas versija pašizņemšanai."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्राहकले लगेपछि यसलाई सङ्कलन गरिएको भनी सेट गर्नुहोस्। यो प्रेषणको सङ्कलन संस्करण हो।"
          }
        },
        "nl": {
          "stringUnit": {
