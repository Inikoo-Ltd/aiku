    "Shippers are the same as for delivery notes and are set up in the web app.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Куриерите са същите като за стоковите разписки и се настройват в уеб приложението."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přepravci jsou stejní jako u dodacích listů a nastavují se ve webové aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Versender sind dieselben wie bei Lieferscheinen und werden in der Web-App eingerichtet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los transportistas son los mismos que para los albaranes y se configuran en la aplicación web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les transporteurs sont les mêmes que pour les bons de livraison et se configurent dans l'application web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कूरियर वही हैं जो डिलीवरी नोट्स के लिए हैं और वेब ऐप में सेट किए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijevoznici su isti kao za otpremnice i postavljaju se u web aplikaciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A futárszolgálatok ugyanazok, mint a szállítóleveleknél, és a webes alkalmazásban állíthatók be."
          }
        },
        "id": {
          "stringUnit": {
