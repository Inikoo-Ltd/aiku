    "Pack every line into a parcel and enter its dimensions. Then Set as packed appears.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verpacken Sie jede Zeile in ein Paket und geben Sie dessen Maße ein. Dann erscheint Als verpackt markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Embale cada línea en un paquete e introduzca sus dimensiones. Después aparece Marcar como embalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emballez chaque ligne dans un colis et saisissez ses dimensions. Marquer comme emballé apparaît ensuite."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spakirajte svaki redak u paket i unesite njegove dimenzije. Tada se pojavljuje Označi kao spakirano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csomagoljon minden sort egy csomagba, és adja meg a méreteit. Ezután megjelenik a Becsomagoltnak jelölés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kemas setiap baris ke dalam paket dan masukkan dimensinya. Setelah itu Tandai sebagai sudah dikemas muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imballi ogni riga in un pacco e ne inserisca le dimensioni. Poi compare Imposta come imballato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての行を荷物に梱包し、寸法を入力してください。その後「梱包済みにする」が表示されます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ambalează fiecare linie într-un colet și introdu dimensiunile acestuia. Apoi apare Marchează ca ambalat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zabaľte každý riadok do balíka a zadajte jeho rozmery. Potom sa zobrazí Nastaviť ako zabalené."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her satırı bir pakete koyun ve paketin boyutlarını girin. Ardından Paketlendi olarak işaretle görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将每一行打包到包裹中并输入其尺寸。之后会显示“设为已打包”。"
          }
        }
      }
    },
