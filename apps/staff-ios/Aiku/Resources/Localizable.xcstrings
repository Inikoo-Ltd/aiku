    "Put each item back to stock, or set it as damaged or not returned. Then set the return as returned.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Върнете всеки артикул в наличност или го маркирайте като повреден или невърнат. След това маркирайте връщането като върнато."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každou položku vraťte na sklad, nebo ji nastavte jako poškozenou či nevrácenou. Poté nastavte vrácení jako vrácené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legen Sie jeden Artikel zurück in den Bestand oder markieren Sie ihn als beschädigt oder nicht zurückgegeben. Markieren Sie dann die Rücksendung als zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devuelva cada artículo al stock o márquelo como dañado o no devuelto. Después marque la devolución como devuelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remettez chaque article en stock, ou marquez-le comme endommagé ou non retourné. Marquez ensuite le retour comme retourné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर आइटम को वापस स्टॉक में रखें, या उसे क्षतिग्रस्त या वापस नहीं के रूप में सेट करें। फिर वापसी को वापस किया गया के रूप में सेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vratite svaku stavku na zalihu ili je označite kao oštećenu ili nevraćenu. Zatim označite povrat kao vraćen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tegyen vissza minden tételt a készletbe, vagy jelölje sérültnek, illetve vissza nem küldöttnek. Ezután jelölje a visszaküldést visszaküldöttnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kembalikan setiap barang ke stok, atau tandai rusak atau tidak dikembalikan. Lalu tandai pengembalian sebagai dikembalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rimetta a stock ogni articolo oppure lo imposti come danneggiato o non restituito. Poi imposti il reso come restituito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各品目を在庫に戻すか、破損または未返品にしてください。その後、返品を返品済みにします。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atgrieziet katru pozīciju krājumā vai atzīmējiet to kā bojātu vai neatgrieztu. Pēc tam atzīmējiet atgriezumu kā atgrieztu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रत्येक वस्तुलाई स्टकमा फिर्ता राख्नुहोस्, वा क्षतिग्रस्त वा फिर्ता नगरिएको रूपमा सेट गर्नुहोस्। त्यसपछि फिर्तालाई फिर्ता गरिएको रूपमा सेट गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zet elk item terug in de voorraad of stel het in als beschadigd of niet geretourneerd. Stel daarna de retour in als geretourneerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odłóż każdy przedmiot z powrotem na stan albo oznacz go jako uszkodzony lub niezwrócony. Następnie oznacz zwrot jako zwrócony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devolva cada item ao stock ou defina-o como danificado ou não devolvido. Depois defina a devolução como devolvida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puneți fiecare articol înapoi în stoc sau setați-l ca deteriorat ori nereturnat. Apoi setați returul ca returnat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každú položku vráťte na sklad alebo ju nastavte ako poškodenú či nevrátenú. Potom nastavte vrátenie ako vrátené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lägg tillbaka varje artikel i lager eller markera den som skadad eller ej returnerad. Markera sedan returen som returnerad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her ürünü stoğa geri koyun ya da hasarlı veya iade edilmedi olarak işaretleyin. Ardından iadeyi iade edildi olarak işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поверніть кожен товар на склад або позначте його як пошкоджений чи не повернений. Потім позначте повернення як повернене."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将每件货品退回库存，或设为已损坏或未退回。然后将退货设为已退回。"
          }
        }
      }
    },
