    "Newest first. A transfer shows as two movements: out of one location and into the other.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neueste zuerst. Eine Umbuchung erscheint als zwei Bewegungen: aus einem Lagerplatz heraus und in den anderen hinein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los más recientes primero. Un traslado aparece como dos movimientos: salida de una ubicación y entrada en la otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les plus récents d'abord. Un transfert apparaît comme deux mouvements : sortie d'un emplacement et entrée dans l'autre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najnovije prvo. Prijenos se prikazuje kao dva kretanja: izlaz s jedne lokacije i ulaz na drugu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legújabb elöl. Egy áthelyezés két mozgásként jelenik meg: ki az egyik helyről és be a másikra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terbaru dulu. Transfer ditampilkan sebagai dua pergerakan: keluar dari satu lokasi dan masuk ke lokasi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prima i più recenti. Un trasferimento appare come due movimenti: in uscita da un’ubicazione e in entrata nell’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しい順。移動は2件の在庫移動として表示されます：一方のロケーションからの出庫と、もう一方への入庫です。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cele mai noi primele. Un transfer apare ca două mișcări: ieșire dintr-o locație și intrare în cealaltă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najnovšie prvé. Presun sa zobrazuje ako dva pohyby: z jednej lokácie a do druhej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En yeni önce. Bir transfer iki hareket olarak görünür: bir lokasyondan çıkış ve diğerine giriş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最新的在前。一次转移显示为两条变动：从一个库位移出，并移入另一个库位。"
          }
        }
      }
    },
