        }
      }
    },
    "Only when the warehouse uses picked bays. With waiting lines, this is where the goods stay until the missing products arrive.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur wenn das Lagerhaus Bereitstellungszonen nutzt. Bei wartenden Zeilen bleibt die Ware hier, bis die fehlenden Produkte eintreffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo cuando el almacén usa zonas de preparados. Con líneas en espera, aquí es donde se queda la mercancía hasta que llegan los productos que faltan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uniquement si l'entrepôt utilise des zones des commandes préparées. Avec des lignes en attente, c'est là que les marchandises restent jusqu'à l'arrivée des produits manquants."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samo kada skladište koristi zone ubrane robe. S retcima na čekanju ovdje roba ostaje dok ne stignu proizvodi koji nedostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csak ha a raktár komissiózott rekeszeket használ. Várakozó sorok esetén itt marad az áru, amíg a hiányzó termékek meg nem érkeznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hanya jika gudang menggunakan bay hasil picking. Dengan baris yang menunggu, di sinilah barang disimpan sampai produk yang kurang tiba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo quando il magazzino usa aree di consolidamento. Con righe in attesa, è qui che la merce resta finché non arrivano i prodotti mancanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "倉庫でピッキング済み置き場を使用している場合のみです。保留中の行がある場合、不足商品が届くまで商品はここに置かれます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doar când depozitul folosește zone comenzi culese. Cu linii în așteptare, aici rămân mărfurile până sosesc produsele lipsă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Len ak sklad používa miesta pre vychystaný tovar. Pri čakajúcich riadkoch tu tovar zostáva, kým nedorazia chýbajúce produkty."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca depo toplanan siparişler alanlarını kullanıyorsa. Bekleyen satırlar varsa, eksik ürünler gelene kadar mallar burada kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅当仓库使用已拣货区时适用。有等待行时，货物会存放在这里，直到缺少的产品到货。"
          }
        }
      }
    },
    "Only when this warehouse uses trolleys. Otherwise Start picking begins straight away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur wenn dieses Lagerhaus Wagen nutzt. Andernfalls beginnt die Kommissionierung sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo cuando este almacén usa carros. Si no, Empezar a preparar comienza directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uniquement si cet entrepôt utilise des chariots. Sinon, Commencer la préparation démarre directement."
          }
