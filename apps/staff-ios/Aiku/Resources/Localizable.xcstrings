    "Start one with + and choose delivery notes that are waiting to be picked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Започнете с + и изберете стокови разписки, които чакат комплектоване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Založte ji pomocí + a vyberte dodací listy, které čekají na vychystání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starten Sie eine mit + und wählen Sie Lieferscheine, die auf die Kommissionierung warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cree una con + y elija albaranes que estén pendientes de preparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lancez-en une avec + et choisissez des bons de livraison en attente de préparation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ से एक शुरू करें और पिक होने की प्रतीक्षा वाले डिलीवरी नोट चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Započnite jednu pomoću + i odaberite otpremnice koje čekaju branje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indítson egyet a + gombbal, és válasszon komissiózásra váró szállítóleveleket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mulai dengan + lalu pilih surat jalan yang menunggu untuk di-picking."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne avvii una con + e scelga le bolle di consegna in attesa di prelievo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "＋で開始し、ピッキング待ちの納品書を選択してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sāciet sesiju ar + un izvēlieties piegādes pavadzīmes, kas gaida komplektēšanu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ बाट एउटा सुरु गर्नुहोस् र पिक हुन पर्खिरहेका डेलिभरी नोटहरू छान्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start er een met + en kies pakbonnen die wachten om gepickt te worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozpocznij nową przyciskiem + i wybierz dowody dostawy oczekujące na kompletację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicie uma com + e escolha guias de remessa à espera de preparação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pornește una cu + și alege note de livrare care așteaptă să fie culese."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Začnite ju tlačidlom + a vyberte dodacie listy čakajúce na vychystanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starta en med + och välj följesedlar som väntar på plockning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ ile bir oturum başlatın ve toplanmayı bekleyen irsaliyeleri seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
