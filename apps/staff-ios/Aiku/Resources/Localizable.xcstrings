            "value": "どこに入れますか？"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unde merge?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kam to patrí?"
          }
        },
        "tr": {
          "stringUnit": {
