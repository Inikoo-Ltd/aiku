    "Damaged and lost are reported from the pallet page. Other incidents come from pallets not picked in a return.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повредени и изгубени се докладват от страницата на палета. Другите инциденти идват от палети, които не са събрани при връщане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poškození a ztrátu nahlásíte na stránce palety. Ostatní incidenty pocházejí z palet, které nebyly vychystány při vrácení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beschädigt und verloren werden auf der Palettenseite gemeldet. Andere Vorfälle stammen von Paletten, die in einer Rücksendung nicht kommissioniert wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los daños y las pérdidas se notifican desde la página del palet. Los demás incidentes proceden de palets no preparados en una devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les palettes endommagées et perdues sont signalées depuis la page de la palette. Les autres incidents proviennent de palettes non préparées dans un retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्षतिग्रस्त और खोए हुए की रिपोर्ट पैलेट पेज से की जाती है। अन्य घटनाएँ उन पैलेट्स से आती हैं जो किसी वापसी में पिक नहीं किए गए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oštećenje i gubitak prijavljuju se na stranici palete. Ostali incidenti dolaze od paleta koje nisu ubrane u povratu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sérülést és az elvesztést a raklap oldalán lehet jelenteni. A többi incidens olyan raklapokból adódik, amelyeket egy visszaküldésnél nem komissióztak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rusak dan hilang dilaporkan dari halaman palet. Insiden lain berasal dari palet yang tidak diambil dalam pengembalian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Danneggiato e perduto si segnalano dalla pagina del pallet. Gli altri incidenti derivano da pallet non prelevati in un reso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "破損と紛失はパレットのページから報告されます。その他のインシデントは、返送でピッキングされなかったパレットによるものです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Par bojātām un pazaudētām paletēm ziņo paletes lapā. Citi incidenti rodas no paletēm, kas nav komplektētas atgriezumā."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्षतिग्रस्त र गुमेकाको रिपोर्ट प्यालेट पृष्ठबाट गरिन्छ। अन्य घटनाहरू फिर्तामा पिक नगरिएका प्यालेटहरूबाट आउँछन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beschadigd en kwijt worden gemeld vanaf de palletpagina. Andere incidenten komen van pallets die niet zijn gepickt in een retour."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uszkodzenie i zaginięcie zgłasza się na stronie palety. Pozostałe incydenty dotyczą palet nieskompletowanych w zwrocie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os danos e as perdas são comunicados a partir da página da palete. Os outros incidentes vêm de paletes não preparadas numa devolução."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deteriorările și pierderile se raportează din pagina paletului. Celelalte incidente provin din paleți neculeși într-un retur."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poškodenie a stratu nahlasujete na stránke palety. Ostatné incidenty pochádzajú z paliet, ktoré neboli vychystané pri vrátení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skadade och förlorade pallar rapporteras från pallsidan. Andra incidenter kommer från pallar som inte plockats i en retur."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hasarlı ve kayıp durumları palet sayfasından bildirilir. Diğer sorunlar, bir iadede toplanmayan paletlerden gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Про пошкодження та втрату повідомляють на сторінці палети. Інші інциденти походять від палет, не зібраних у поверненні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已损坏和丢失在托盘页面中报告。其他事件来自退回中未拣货的托盘。"
          }
        }
      }
    },
    "Damaged goods do not go back to stock.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повредените стоки не се връщат в наличност."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poškozené zboží se nevrací na sklad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beschädigte Ware geht nicht zurück in den Bestand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La mercancía dañada no vuelve al stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les marchandises endommagées ne sont pas remises en stock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्षतिग्रस्त माल वापस स्टॉक में नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
