    "The picker can then pick the waiting lines again. Goods already picked stay in %@.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "След това събирачът може отново да събере чакащите редове. Вече събраните стоки остават в %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávač pak může čekající řádky znovu vychystat. Již vychystané zboží zůstává v %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Kommissionierer kann die wartenden Positionen dann erneut kommissionieren. Bereits kommissionierte Ware bleibt in %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El preparador podrá volver a preparar las líneas en espera. La mercancía ya preparada se queda en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le préparateur peut alors préparer à nouveau les lignes en attente. Les marchandises déjà préparées restent dans %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसके बाद पिकर प्रतीक्षा वाली लाइनें फिर से पिक कर सकता है। पहले से पिक किया गया माल %@ में रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berač tada može ponovno ubrati retke na čekanju. Već ubrana roba ostaje na %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózó ezután újra komissiózhatja a várakozó sorokat. A már komissiózott áru itt marad: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Picker kemudian dapat mengambil baris yang menunggu lagi. Barang yang sudah diambil tetap di %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'addetto al prelievo può quindi prelevare di nuovo le righe in attesa. La merce già prelevata resta in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "その後、ピッカーは待機中の明細を再度ピッキングできます。ピッキング済みの商品は%@に残ります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pēc tam komplektētājs var atkal komplektēt gaidošās rindas. Jau komplektētās preces paliek vietā %@."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्यसपछि पिकरले प्रतीक्षारत लाइनहरू फेरि पिक गर्न सक्छ। पहिले नै पिक गरिएको सामान %@ मा रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De picker kan de wachtende regels dan opnieuw picken. Goederen die al zijn gepickt, blijven in %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompletujący może wtedy ponownie skompletować oczekujące wiersze. Już skompletowane towary zostają w %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O preparador poderá então preparar novamente as linhas em espera. A mercadoria já preparada fica em %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culegătorul poate apoi culege din nou liniile în așteptare. Mărfurile deja culese rămân în %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávač potom môže čakajúce riadky znova vychystať. Už vychystaný tovar zostáva v %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plockaren kan sedan plocka de väntande raderna igen. Varor som redan plockats stannar i %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplayıcı daha sonra bekleyen satırları tekrar toplayabilir. Önceden toplanan ürünler %@ içinde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тоді вибірник зможе знову зібрати рядки в очікуванні. Уже зібрані товари залишаються в %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "之后拣货员可以重新拣取等待中的明细行。已拣货物仍留在 %@。"
          }
        }
      }
    },
    "The picker can then pick the waiting lines again. Goods already picked stay in the picked bay.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тогава събирачът може отново да комплектова чакащите редове. Вече комплектованите стоки остават в пикинг зоната."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávač pak může čekající řádky znovu vychystat. Již vychystané zboží zůstává v odkládací pozici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Kommissionierer kann die wartenden Zeilen dann erneut kommissionieren. Bereits kommissionierte Ware bleibt in der Bereitstellungszone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El preparador podrá entonces volver a preparar las líneas en espera. La mercancía ya preparada se queda en la zona de preparados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le préparateur peut alors préparer à nouveau les lignes en attente. Les marchandises déjà préparées restent dans la zone des commandes préparées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसके बाद पिकर प्रतीक्षा वाली लाइनें फिर से पिक कर सकता है। पहले से पिक किया गया माल पिक्ड बे में ही रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berač tada može ponovno ubrati retke na čekanju. Već ubrana roba ostaje u zoni ubrane robe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózó ezután újra komissiózhatja a várakozó sorokat. A már komissiózott áru a komissiózott rekeszben marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Picker kemudian dapat mengambil lagi baris yang menunggu. Barang yang sudah diambil tetap di bay hasil picking."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’addetto al prelievo può quindi prelevare di nuovo le righe in attesa. La merce già prelevata resta nell’area di consolidamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "その後、ピッカーは保留中の行を再度ピッキングできます。すでにピッキングした商品はピッキング済み置き場に残ります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tad komplektētājs var vēlreiz komplektēt gaidošās rindas. Jau nokomplektētās preces paliek savākto preču vietā."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्यसपछि पिकरले प्रतीक्षामा रहेका लाइनहरू फेरि पिक गर्न सक्छ। पहिले नै पिक गरिएको सामान पिक गरिएको बेमै रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De picker kan de wachtende regels dan opnieuw picken. Al gepickte goederen blijven in het gepickt vak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompletujący może wtedy ponownie skompletować oczekujące wiersze. Już skompletowany towar zostaje w strefie skompletowanych zamówień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O preparador pode então voltar a preparar as linhas em espera. Os artigos já preparados ficam na zona de preparados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culegătorul poate apoi culege din nou liniile în așteptare. Mărfurile deja culese rămân în zona comenzi culese."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávač potom môže čakajúce riadky znova vychystať. Už vychystaný tovar zostáva na mieste pre vychystaný tovar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plockaren kan sedan plocka de väntande raderna igen. Varor som redan plockats stannar i plockfacket."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplayıcı daha sonra bekleyen satırları yeniden toplayabilir. Önceden toplanan mallar toplanan siparişler alanında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тоді комплектувальник зможе знову зібрати рядки, що очікують. Уже зібрані товари залишаються у відсіку зібраного."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "之后拣货员可以重新拣选等待中的行。已拣货品仍留在已拣货区。"
          }
        }
      }
    },
    "The picks are undone, so their stock counts as back in its locations at once. Put the goods back on the shelf now.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вземанията се отменят, така че наличността им веднага се отчита обратно в локациите. Върнете стоките на рафта сега."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystání se zruší, takže jejich zásoby se hned počítají jako vrácené na své lokace. Vraťte zboží do regálu hned teď."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kommissionierungen werden rückgängig gemacht, sodass ihr Bestand sofort wieder auf seinen Lagerplätzen zählt. Legen Sie die Ware jetzt zurück ins Regal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se deshacen las preparaciones, así que su stock cuenta de inmediato como devuelto a sus ubicaciones. Devuelva ahora la mercancía a la estantería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les préparations sont annulées : leur stock est immédiatement compté comme revenu dans ses emplacements. Remettez les marchandises en rayon maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिक पूर्ववत हो जाते हैं, इसलिए उनका स्टॉक तुरंत अपनी लोकेशन पर वापस गिना जाता है। अभी माल को वापस शेल्फ़ पर रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Branja se poništavaju pa se njihova zaliha odmah računa kao vraćena na lokacije. Sada vratite robu na policu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózások visszavonásra kerülnek, így a készletük azonnal visszakerül a raktárhelyükre. Most tegye vissza az árut a polcra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengambilan dibatalkan, sehingga stoknya langsung dihitung kembali di lokasinya. Kembalikan barang ke rak sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I prelievi vengono annullati, quindi il loro stock risulta subito rientrato nelle sue ubicazioni. Rimetta ora la merce sullo scaffale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピッキングが取り消されるため、在庫はすぐに元のロケーションに戻ったものとして計上されます。今すぐ商品を棚に戻してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komplektēšana tiek atsaukta, tāpēc to krājums uzreiz tiek uzskatīts par atgrieztu savās vietās. Novietojiet preces atpakaļ plauktā tagad."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिकहरू पूर्ववत हुन्छन्, त्यसैले तिनको स्टक तुरुन्तै आफ्नो लोकेसनमा फर्केको गनिन्छ। सामान अहिले नै र्‍याकमा फिर्ता राख्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De picks worden ongedaan gemaakt, dus de voorraad telt meteen weer mee op de locaties. Zet de goederen nu terug in het schap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompletacje zostaną cofnięte, więc ich zapas od razu liczy się jako z powrotem w swoich lokalizacjach. Odłóż teraz towary z powrotem na półkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As preparações são anuladas, por isso o respetivo stock conta de imediato como devolvido às suas localizações. Volte a colocar agora a mercadoria na prateleira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culegerile sunt anulate, astfel încât stocul lor este considerat imediat înapoi în locațiile sale. Puneți acum mărfurile înapoi pe raft."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystania sa zrušia, takže ich zásoby sa hneď počítajú ako vrátené na svoje lokácie. Vráťte tovar do regálu teraz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plockningarna ångras, så deras lager räknas direkt som tillbaka på sina lagerplatser. Lägg tillbaka varorna på hyllan nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplamalar geri alınır, bu yüzden stokları hemen lokasyonlarına dönmüş sayılır. Ürünleri şimdi rafa geri koyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Збори буде скасовано, тож їхній запас одразу вважатиметься поверненим у комірки. Поверніть товари на полицю зараз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拣货将被撤销，其库存会立即计为已回到原库位。请立即将货物放回货架。"
          }
        }
      }
    },
