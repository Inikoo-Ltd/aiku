    "Checking and placing items needs goods-in edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfen und Einlagern von Artikeln erfordert Rechte zum Bearbeiten des Wareneingangs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprobar y ubicar artículos requiere permisos de edición de recepción de mercancías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifier et ranger des articles nécessite les droits de modification de la réception."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provjera i uskladištenje artikala zahtijevaju prava uređivanja ulaza robe."
