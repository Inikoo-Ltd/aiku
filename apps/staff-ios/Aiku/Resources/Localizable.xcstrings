    "Same as Stocks management on the web. Only users who can edit stock can change it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Същото като Управление на наличности в уеб версията. Само потребители с права за редакция на наличности могат да го променят."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stejné jako Správa zásob na webu. Změnit ho mohou jen uživatelé, kteří smějí upravovat zásoby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie die Bestandsverwaltung im Web. Nur Benutzer, die den Bestand bearbeiten dürfen, können es ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Igual que Gestión de stock en la web. Solo los usuarios que pueden editar el stock pueden cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Identique à la gestion des stocks sur le web. Seuls les utilisateurs pouvant modifier le stock peuvent le changer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वेब पर स्टॉक प्रबंधन जैसा ही। केवल स्टॉक संपादित कर सकने वाले उपयोगकर्ता इसे बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isto kao Upravljanje zalihama na webu. Mijenjati mogu samo korisnici koji smiju uređivati zalihe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ugyanaz, mint a weben a Készletkezelés. Csak a készletszerkesztési joggal rendelkező felhasználók módosíthatják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sama seperti Manajemen stok di web. Hanya pengguna yang dapat mengedit stok yang dapat mengubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come Gestione stock sul web. Solo gli utenti che possono modificare lo stock possono cambiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Webの在庫管理と同じです。在庫を編集できるユーザーのみ変更できます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tas pats, kas Krājumu pārvaldība tīmeklī. Mainīt var tikai lietotāji, kuri drīkst labot krājumus."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वेबको स्टक व्यवस्थापन जस्तै। स्टक सम्पादन गर्न सक्ने प्रयोगकर्ताले मात्र यो बदल्न सक्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hetzelfde als Voorraadbeheer op het web. Alleen gebruikers die voorraad kunnen bewerken, kunnen dit wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tak samo jak Zarządzanie zapasami w wersji webowej. Zmieniać mogą tylko użytkownicy z uprawnieniami do edycji zapasów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Igual à Gestão de stocks na web. Só os utilizadores que podem editar stock o podem alterar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fel ca Gestionarea stocurilor de pe web. Doar utilizatorii care pot edita stocul îl pot modifica."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rovnaké ako Správa zásob na webe. Zmeniť to môžu len používatelia s právami na úpravu zásob."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samma som Lagerhantering på webben. Endast användare som kan redigera lager kan ändra det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Web’deki Stok yönetimi ile aynı. Yalnızca stok düzenleyebilen kullanıcılar değiştirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Те саме, що Керування запасами у вебверсії. Змінювати можуть лише користувачі з правами на редагування запасів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "与网页版的库存管理相同。只有可编辑库存的用户才能更改。"
          }
        }
      }
    },
