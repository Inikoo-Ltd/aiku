    "The scan of %@ didn’t get an answer. Try again; it is not counted twice.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканирането на %@ не получи отговор. Опитайте отново; няма да се преброи два пъти."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sken %@ nedostal odpověď. Zkuste to znovu; nezapočítá se dvakrát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf den Scan von %@ kam keine Antwort. Versuchen Sie es erneut; er wird nicht doppelt gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escaneo de %@ no ha recibido respuesta. Inténtelo de nuevo; no se cuenta dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le scan de %@ n'a pas reçu de réponse. Réessayez : il ne sera pas compté deux fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ के स्कैन का जवाब नहीं मिला। फिर से प्रयास करें; यह दो बार नहीं गिना जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skeniranje %@ nije dobilo odgovor. Pokušajte ponovno; neće se brojati dvaput."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A(z) %@ beolvasására nem jött válasz. Próbálja újra; nem számolódik kétszer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindaian %@ tidak mendapat jawaban. Coba lagi; tidak akan dihitung dua kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La scansione di %@ non ha ricevuto risposta. Riprovi: non verrà contata due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@のスキャンに応答がありませんでした。もう一度お試しください。二重にカウントされることはありません。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uz %@ skenējumu netika saņemta atbilde. Mēģiniet vēlreiz; tas netiks saskaitīts divreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ को स्क्यानको जवाफ आएन। फेरि प्रयास गर्नुहोस्; यो दुई पटक गनिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De scan van %@ kreeg geen antwoord. Probeer het opnieuw; hij wordt niet dubbel geteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skan %@ nie otrzymał odpowiedzi. Spróbuj ponownie; nie zostanie policzony dwa razy."
