    "every shelf remembers what it held.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "всеки рафт помни какво е държал."
          }
        },
        "cs": {
          "stringUnit": {
