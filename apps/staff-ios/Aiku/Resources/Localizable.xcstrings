        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha a komissiózás várakozó sorokkal fejeződik be, a szállítólevél Várakozik állapotba kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika picking selesai dengan baris yang menunggu, surat jalan berpindah ke Menunggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando il prelievo termina con righe in attesa, la bolla di consegna passa a In attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
