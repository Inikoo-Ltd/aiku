    "Authenticator on another phone? Scan this code with it, or type in the setup key.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Приложението за удостоверяване е на друг телефон? Сканирайте този код с него или въведете ключа за настройка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ověřovací aplikace na jiném telefonu? Naskenujte jí tento kód, nebo zadejte klíč pro nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authenticator auf einem anderen Telefon? Scannen Sie damit diesen Code oder geben Sie den Einrichtungsschlüssel ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Autenticador en otro teléfono? Escanee este código con él o escriba la clave de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authentificateur sur un autre téléphone ? Scannez ce code avec, ou saisissez la clé de configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authenticator दूसरे फ़ोन पर है? इस कोड को उससे स्कैन करें, या सेटअप कुंजी टाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autentifikator je na drugom telefonu? Skenirajte ovaj kôd njime ili upišite ključ za postavljanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitelesítő egy másik telefonon? Szkennelje be vele ezt a kódot, vagy írja be a beállítási kulcsot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authenticator ada di ponsel lain? Pindai kode ini dengan ponsel tersebut, atau ketik kunci penyiapannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App di autenticazione su un altro telefono? Scansioni questo codice con quella oppure inserisca la chiave di configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
