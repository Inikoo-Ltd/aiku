        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifică dacă toate articolele sunt culese și încheie așteptarea"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolovať, či sú všetky položky vychystané, a ukončiť čakanie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera om alla varor är plockade och avsluta väntan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kalemlerin toplanıp toplanmadığını kontrol edin ve beklemeyi bitirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
