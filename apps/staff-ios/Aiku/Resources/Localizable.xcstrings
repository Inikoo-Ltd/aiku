    "Duration must be greater than zero.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Продължителността трябва да е по-голяма от нула."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvání musí být větší než nula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dauer muss größer als null sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duración debe ser mayor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée doit être supérieure à zéro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवधि शून्य से अधिक होनी चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajanje mora biti veće od nule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időtartamnak nagyobbnak kell lennie, mint nulla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Durasi harus lebih besar dari nol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La durata deve essere maggiore di zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "時間は0より大きくしてください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ilgumam jābūt lielākam par nulli."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अवधि शून्यभन्दा बढी हुनुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De duur moet groter zijn dan nul."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas trwania musi być większy od zera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A duração deve ser maior que zero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Durata trebuie să fie mai mare decât zero."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvanie musí byť väčšie ako nula."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varaktigheten måste vara större än noll."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre sıfırdan büyük olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалість має бути більшою за нуль."
          }
        },
        "zh-Hans": {
