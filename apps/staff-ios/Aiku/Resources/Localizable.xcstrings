    "Set as waiting from the packing queue. A supervisor needs to look at it before packing.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зададено в изчакване от опашката за опаковане. Супервайзор трябва да го прегледа преди опаковане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nastaveno jako čekající z fronty balení. Před balením se na to musí podívat vedoucí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus der Verpackungswarteschlange auf wartend gesetzt. Eine Aufsicht muss es sich vor dem Verpacken ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puesto en espera desde la cola de embalaje. Un supervisor tiene que revisarlo antes de embalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mis en attente depuis la file d’emballage. Un superviseur doit l’examiner avant l’emballage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पैकिंग कतार से प्रतीक्षा में सेट किया गया। पैकिंग से पहले पर्यवेक्षक को इसे देखना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postavljeno na čekanje iz reda za pakiranje. Nadzornik to mora pogledati prije pakiranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A csomagolási sorból várakozóra állítva. Csomagolás előtt egy felügyelőnek meg kell néznie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditandai menunggu dari antrean pengemasan. Pengawas perlu memeriksanya sebelum dikemas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impostata come in attesa dalla coda di imballaggio. Un supervisore deve controllarla prima dell’imballaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "梱包キューから保留にしてください。梱包前にスーパーバイザーの確認が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iestatīts kā gaidošs no iepakošanas rindas. Pirms iepakošanas tas jāpārbauda vadītājam."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्याकिङ पङ्क्तिबाट प्रतीक्षामा सेट गरियो। प्याकिङअघि सुपरभाइजरले यसलाई हेर्नुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op wachtend gezet vanuit de inpakwachtrij. Een supervisor moet ernaar kijken vóór het inpakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ustawiono jako oczekujące z kolejki pakowania. Kierownik musi to sprawdzić przed pakowaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colocado em espera a partir da fila de embalagem. Um supervisor tem de o ver antes da embalagem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pus în așteptare din coada de ambalare. Un supervizor trebuie să îl verifice înainte de ambalare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nastavené ako čakajúce z radu balenia. Pred balením sa naň musí pozrieť vedúci."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markerad som väntande från packkön. En arbetsledare behöver titta på den före packning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paketleme kuyruğundan bekliyor olarak ayarlandı. Paketlemeden önce bir süpervizörün bakması gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Встановлено як очікування з черги пакування. Керівник має переглянути її перед пакуванням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
