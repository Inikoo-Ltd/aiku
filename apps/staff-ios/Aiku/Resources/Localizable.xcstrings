    "References follow the organisation format (SD + organisation + number). Suppliers and agents can have their own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referenzen folgen dem Format der Organisation (SD + Organisation + Nummer). Lieferanten und Agenten können eigene haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las referencias siguen el formato de la organización (SD + organización + número). Los proveedores y agentes pueden tener el suyo propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les références suivent le format de l'organisation (SD + organisation + numéro). Les fournisseurs et agents peuvent avoir le leur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reference slijede format organizacije (SD + organizacija + broj). Dobavljači i agenti mogu imati vlastite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A hivatkozások a szervezet formátumát követik (SD + szervezet + szám). A beszállítóknak és ügynököknek saját formátumuk is lehet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referensi mengikuti format organisasi (SD + organisasi + nomor). Pemasok dan agen dapat memiliki format sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I riferimenti seguono il formato dell’organizzazione (SD + organizzazione + numero). Fornitori e agenti possono avere il proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "参照番号は組織の形式（SD + 組織 + 番号）に従います。仕入先や代理店は独自の形式を持つこともあります。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referințele urmează formatul organizației (SD + organizație + număr). Furnizorii și agenții pot avea propriul format."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referencie sa riadia formátom organizácie (SD + organizácia + číslo). Dodávatelia a agenti môžu mať vlastné."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referanslar organizasyon biçimini izler (SD + organizasyon + numara). Tedarikçilerin ve acentelerin kendi biçimleri olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "参考号遵循组织格式（SD + 组织 + 编号）。供应商和代理人可以有各自的格式。"
          }
        }
      }
    },
