    "Not returned means it never came back. Nothing goes back to stock.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Невърнато“ означава, че никога не е било върнато. Нищо не се връща в наличност."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nevráceno znamená, že se zboží nikdy nevrátilo. Nic se nevrací na sklad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht zurückgegeben bedeutet, dass es nie zurückgekommen ist. Nichts geht zurück in den Bestand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No devuelto significa que nunca volvió. No vuelve nada al stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non retourné signifie qu'il n'est jamais revenu. Rien n'est remis en stock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वापस नहीं का मतलब है कि यह कभी वापस नहीं आया। कुछ भी वापस स्टॉक में नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije vraćeno znači da se nikad nije vratilo. Ništa se ne vraća na zalihu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A Nem küldték vissza azt jelenti, hogy soha nem érkezett vissza. Semmi sem kerül vissza a készletbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dikembalikan berarti barang tidak pernah kembali. Tidak ada yang dikembalikan ke stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non restituito significa che non è mai tornato. Niente torna a stock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「未返品」は返送されなかったことを意味します。在庫には何も戻りません。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nav atgriezts nozīmē, ka tas nekad neatgriezās. Nekas neatgriežas krājumā."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फिर्ता नगरिएको भनेको यो कहिल्यै फर्केन। केही पनि स्टकमा फर्कँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niet geretourneerd betekent dat het nooit is teruggekomen. Er gaat niets terug naar de voorraad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niezwrócone oznacza, że nigdy nie wróciło. Nic nie wraca na stan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não devolvido significa que nunca voltou. Nada volta ao stock."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nereturnat înseamnă că nu s-a mai întors niciodată. Nimic nu revine în stoc."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nevrátené znamená, že sa tovar nikdy nevrátil. Nič sa nevracia na sklad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ej returnerad betyder att den aldrig kom tillbaka. Inget går tillbaka till lager."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İade edilmedi, hiç geri gelmediği anlamına gelir. Stoğa hiçbir şey geri dönmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Не повернено» означає, що товар так і не повернувся. Нічого не повертається на склад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未退回表示货品从未退回。不会有任何货品退回库存。"
          }
        }
      }
    },
