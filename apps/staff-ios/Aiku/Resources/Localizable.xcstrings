          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palete gaida klientu apkalpošanu. Tai tas jāatrisina, pirms atgriezumu var atzīmēt kā nokomplektētu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्यालेट ग्राहक सेवाको प्रतीक्षामा छ। फिर्तालाई पिक गरिएको भनी सेट गर्नुअघि उनीहरूले यसलाई समाधान गर्नुपर्छ।"
          }
        },
        "nl": {
