    "Work you do offline shows here until it has synced.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Това, което правиш офлайн, се показва тук, докато се синхронизира."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co uděláte offline, se tu zobrazí, dokud se to nesynchronizuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was du offline erledigst, erscheint hier, bis es synchronisiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo que hagas sin conexión aparece aquí hasta que se sincronice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce que vous faites hors ligne s'affiche ici jusqu'à sa synchronisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑफ़लाइन किया गया काम सिंक होने तक यहाँ दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ono što radite izvan mreže prikazuje se ovdje dok se ne sinkronizira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Amit offline csinálsz, itt látszik, amíg nem szinkronizálódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pekerjaan yang Anda lakukan offline tampil di sini sampai tersinkron."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il lavoro fatto offline compare qui finché non è sincronizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインで行った作業は、同期されるまでここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tas, ko dari bezsaistē, ir redzams šeit, līdz tiek sinhronizēts."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अफलाइनमा गरेको काम सिङ्क नभएसम्म यहाँ देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wat je offline doet, staat hier tot het gesynchroniseerd is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To, co zrobisz offline, pojawia się tutaj, dopóki się nie zsynchronizuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que fizer offline aparece aqui até ser sincronizado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce faci offline apare aici până se sincronizează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Čo urobíte offline, sa tu zobrazí, kým sa to nesynchronizuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det du gör offline visas här tills det har synkats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çevrimdışı yaptıkların senkronize edilene kadar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Те, що ви робите офлайн, показується тут, доки не синхронізується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "离线完成的工作会显示在这里，直到同步完成。"
          }
        }
      }
