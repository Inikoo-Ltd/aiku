    "Choose a new password for your Aiku account. Other phones signed in to your account will be signed out; this one stays signed in.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изберете нова парола за акаунта си в Aiku. Другите телефони, влезли в акаунта ви, ще бъдат отписани; този остава вписан."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zvolte nové heslo pro svůj účet Aiku. Ostatní telefony přihlášené k vašemu účtu budou odhlášeny; tento zůstane přihlášený."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wählen Sie ein neues Passwort für Ihr Aiku-Konto. Andere Telefone, die mit Ihrem Konto angemeldet sind, werden abgemeldet; dieses bleibt angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elija una contraseña nueva para su cuenta de Aiku. Se cerrará la sesión en los demás teléfonos conectados a su cuenta; en este se mantendrá abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un nouveau mot de passe pour votre compte Aiku. Les autres téléphones connectés à votre compte seront déconnectés ; celui-ci reste connecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने Aiku खाते के लिए नया पासवर्ड चुनें। आपके खाते में साइन इन अन्य फ़ोन साइन आउट हो जाएँगे; यह फ़ोन साइन इन रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite novu lozinku za svoj Aiku račun. Drugi telefoni prijavljeni na vaš račun bit će odjavljeni; ovaj ostaje prijavljen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Válasszon új jelszót az Aiku-fiókjához. A fiókjába bejelentkezett többi telefon kijelentkezik; ez bejelentkezve marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih kata sandi baru untuk akun Aiku Anda. Ponsel lain yang masuk ke akun Anda akan dikeluarkan; ponsel ini tetap masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scelga una nuova password per il suo account Aiku. Gli altri telefoni collegati al suo account verranno disconnessi; questo resta connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aikuアカウントの新しいパスワードを選択してください。アカウントにサインインしている他のスマートフォンはサインアウトされます。このスマートフォンはサインインしたままです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvēlieties jaunu paroli savam Aiku kontam. Citi tālruņi, kuros esat pierakstījies savā kontā, tiks izrakstīti; šis paliks pierakstīts."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आफ्नो Aiku खाताका लागि नयाँ पासवर्ड छान्नुहोस्। तपाईंको खातामा साइन इन भएका अन्य फोनहरू साइन आउट हुनेछन्; यो फोन साइन इन नै रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies een nieuw wachtwoord voor je Aiku-account. Andere telefoons die op je account zijn ingelogd, worden uitgelogd; deze blijft ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz nowe hasło do konta Aiku. Inne telefony zalogowane na Twoje konto zostaną wylogowane; ten pozostanie zalogowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha uma nova palavra-passe para a sua conta Aiku. Os outros telemóveis com sessão iniciada na sua conta terão a sessão terminada; este mantém a sessão iniciada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alege o parolă nouă pentru contul tău Aiku. Celelalte telefoane conectate la contul tău vor fi deconectate; acesta rămâne conectat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zvoľte nové heslo pre svoj účet Aiku. Ostatné telefóny prihlásené do vášho účtu sa odhlásia; tento zostane prihlásený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välj ett nytt lösenord för ditt Aiku-konto. Andra telefoner som är inloggade på ditt konto loggas ut; den här förblir inloggad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku hesabınız için yeni bir şifre seçin. Hesabınızda oturum açmış diğer telefonların oturumu kapatılır; bu telefonda oturumunuz açık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть новий пароль для облікового запису Aiku. На інших телефонах буде виконано вихід із вашого облікового запису; на цьому вхід збережеться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为你的 Aiku 账户设置新密码。登录你账户的其他手机将被退出登录；本机保持登录。"
          }
        }
      }
    },
