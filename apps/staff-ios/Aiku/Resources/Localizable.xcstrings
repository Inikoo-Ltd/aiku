    "Auditing needs stock edit rights; moving and removing SKOs need location edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für die Prüfung sind Rechte zum Bearbeiten des Bestands nötig; zum Umlagern und Entfernen von SKOs Rechte zum Bearbeiten von Lagerplätzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auditar requiere permisos para editar stock; mover y retirar SKOs requiere permisos para editar ubicaciones."
