    "Set as not picked. Customer service must resolve it before the return can be set as picked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Маркирано като некомплектовано. Обслужване на клиенти трябва да го реши, преди връщането да може да се маркира като комплектовано."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označeno jako nevychystané. Zákaznický servis to musí vyřešit, než bude možné vratku označit jako vychystanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als nicht kommissioniert markiert. Der Kundendienst muss es klären, bevor die Rückgabe als kommissioniert markiert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marcado como no preparado. Servicio al cliente debe resolverlo antes de poder marcar la devolución como preparada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marqué comme non préparé. Le service client doit le résoudre avant que le retour puisse être marqué comme préparé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिक नहीं किया गया के रूप में सेट। वापसी को पिक किया गया सेट करने से पहले ग्राहक सेवा को इसे सुलझाना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označeno kao neubrano. Korisnička služba to mora riješiti prije nego što se povrat može označiti kao ubran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nem komissiózottként jelölve. Az ügyfélszolgálatnak rendeznie kell, mielőtt a visszaküldés komissiózottnak jelölhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditandai tidak diambil. Layanan pelanggan harus menyelesaikannya sebelum pengembalian dapat ditandai sudah diambil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impostato come non prelevato. Il servizio clienti deve risolverlo prima che il reso possa essere impostato come prelevato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未ピッキングにしました。返品をピッキング済みにする前に、カスタマーサービスが解決する必要があります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atzīmēts kā nenokomplektēts. Klientu apkalpošanai tas jāatrisina, pirms atgriezumu var atzīmēt kā nokomplektētu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिक नगरिएको भनी सेट गरियो। फिर्तालाई पिक गरिएको भनी सेट गर्नुअघि ग्राहक सेवाले यसलाई समाधान गर्नुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als niet gepickt gemarkeerd. De klantenservice moet dit oplossen voordat de retour als gepickt kan worden gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oznaczono jako nieskompletowane. Obsługa klienta musi to rozwiązać, zanim zwrot będzie można oznaczyć jako skompletowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marcado como não preparado. O apoio ao cliente tem de resolver isto antes de a devolução poder ser marcada como preparada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marcat ca necules. Serviciul clienți trebuie să rezolve situația înainte ca returul să poată fi marcat ca cules."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označené ako nevychystané. Zákaznícky servis to musí vyriešiť, kým bude možné vrátenie nastaviť ako vychystané."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markerad som inte plockad. Kundtjänst måste lösa det innan returen kan markeras som plockad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplanmadı olarak işaretlendi. İade toplandı olarak işaretlenebilmeden önce müşteri hizmetleri bunu çözmelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позначено як не зібране. Служба підтримки клієнтів має це вирішити, перш ніж повернення можна буде позначити як зібране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已设为未拣货。客服必须先解决该问题，退货才能设为已拣货。"
          }
        }
      }
    },
