    "Not received yet. Marking it as received needs goods-in edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch nicht erhalten. Als erhalten markieren erfordert Rechte zum Bearbeiten des Wareneingangs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no recibida. Para marcarla como recibida se necesitan permisos de edición de recepción de mercancías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas encore reçue. La marquer comme reçue nécessite les droits de modification de la réception."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nije primljeno. Za označavanje kao primljeno potrebna su prava uređivanja ulaza robe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Még nem érkezett be. A beérkezettként jelöléshez áruátvételi szerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum diterima. Menandainya sebagai diterima memerlukan hak edit barang masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non ancora ricevuto. Per segnarlo come ricevuto servono i permessi di modifica del ricevimento merci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まだ受領されていません。受領済みにするには入荷編集権限が必要です。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încă neprimită. Marcarea ca primită necesită drepturi de editare pentru intrări de mărfuri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatiaľ neprijaté. Označenie ako prijaté vyžaduje práva na úpravu príjmu tovaru."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz teslim alınmadı. Teslim alındı olarak işaretlemek için mal kabul düzenleme yetkisi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚未收到。标记为已收到需要入库编辑权限。"
          }
        }
      }
    },
