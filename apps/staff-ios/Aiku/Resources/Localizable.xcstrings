          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waga musi być większa niż 0 i wynosić najwyżej 1000 kg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O peso tem de ser superior a 0 e no máximo 1000 kg."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Greutatea trebuie să fie peste 0 și cel mult 1000 kg."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hmotnosť musí byť väčšia ako 0 a najviac 1000 kg."
          }
        },
