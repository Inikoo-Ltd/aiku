        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque PDF s’ouvre dans la visionneuse du téléphone, où vous pouvez l’imprimer ou le partager."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर PDF फ़ोन के व्यूअर में खुलता है, जहाँ आप उसे प्रिंट या शेयर कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki PDF otvara se u pregledniku telefona, gdje ga možete ispisati ili podijeliti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden PDF a telefon megjelenítőjében nyílik meg, ahol kinyomtathatja vagy megoszthatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap PDF terbuka di penampil ponsel, tempat Anda dapat mencetak atau membagikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni PDF si apre nel visualizzatore del telefono, dove può stamparlo o condividerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各PDFはスマートフォンのビューアで開き、印刷や共有ができます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katrs PDF atveras tālruņa skatītājā, kur to var izdrukāt vai kopīgot."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक PDF फोनको भ्युअरमा खुल्छ, जहाँ तपाईं प्रिन्ट वा सेयर गर्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke PDF opent in de viewer van de telefoon, waar je hem kunt afdrukken of delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy plik PDF otwiera się w przeglądarce telefonu, gdzie można go wydrukować lub udostępnić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada PDF abre no visualizador do telemóvel, onde o pode imprimir ou partilhar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fiecare PDF se deschide în vizualizatorul telefonului, de unde îl poți tipări sau partaja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každé PDF sa otvorí v prehliadači telefónu, kde ho môžete vytlačiť alebo zdieľať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje PDF öppnas i telefonens visare, där du kan skriva ut eller dela den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her PDF, yazdırabileceğiniz veya paylaşabileceğiniz telefonun görüntüleyicisinde açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожен PDF відкривається в переглядачі телефона, де його можна надрукувати або поширити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个 PDF 都会在手机的查看器中打开，可在其中打印或分享。"
          }
        }
      }
    },
    "Each box number must be from 1 to %lld.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Номерът на всеки кашон трябва да е от 1 до %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Číslo každé krabice musí být od 1 do %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Boxnummer muss zwischen 1 und %lld liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada número de caja debe estar entre 1 y %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque numéro de boîte doit être compris entre 1 et %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर बॉक्स नंबर 1 से %lld तक होना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
