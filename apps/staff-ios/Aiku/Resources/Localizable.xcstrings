            "state": "translated",
            "value": "Nie wygenerowano jeszcze dla Ciebie kodu PIN. Skontaktuj się z działem HR."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi gerado nenhum PIN para si. Contacte os RH."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu a fost generat un PIN pentru dvs. Vă rugăm să contactați departamentul de resurse umane."
          }
        },
        "sk": {
