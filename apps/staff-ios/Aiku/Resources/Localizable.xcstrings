    "The connection dropped before aiku answered. Try again: aiku places it only once.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Връзката прекъсна, преди aiku да отговори. Опитайте отново: aiku го складира само веднъж."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojení se přerušilo dříve, než aiku odpovědělo. Zkuste to znovu: aiku zboží umístí jen jednou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung brach ab, bevor aiku geantwortet hat. Versuchen Sie es erneut: aiku lagert es nur einmal ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conexión se cortó antes de que aiku respondiera. Inténtelo de nuevo: aiku solo lo ubica una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion a été coupée avant la réponse d'aiku. Réessayez : aiku ne le range qu'une seule fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "aiku के जवाब देने से पहले कनेक्शन टूट गया। फिर से प्रयास करें: aiku इसे केवल एक बार रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veza je prekinuta prije nego što je aiku odgovorio. Pokušajte ponovno: aiku ga smješta samo jednom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A kapcsolat megszakadt, mielőtt az aiku válaszolt. Próbálja újra: az aiku csak egyszer helyezi el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koneksi terputus sebelum aiku menjawab. Coba lagi: aiku hanya menempatkannya sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connessione si è interrotta prima della risposta di aiku. Riprovi: aiku lo stocca una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "aikuが応答する前に接続が切れました。もう一度お試しください。aikuが格納するのは1回だけです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Savienojums pārtrūka, pirms aiku atbildēja. Mēģiniet vēlreiz: aiku to izvieto tikai vienu reizi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "aiku ले जवाफ दिनुअघि जडान टुट्यो। फेरि प्रयास गर्नुहोस्: aiku ले यसलाई एक पटक मात्र राख्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De verbinding viel weg voordat aiku antwoordde. Probeer het opnieuw: aiku plaatst het maar één keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenie zostało przerwane, zanim aiku odpowiedziało. Spróbuj ponownie: aiku umieści to tylko raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A ligação caiu antes de o aiku responder. Tente novamente: o aiku só o coloca uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conexiunea s-a întrerupt înainte ca aiku să răspundă. Încercați din nou: aiku îl plasează o singură dată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pripojenie sa prerušilo skôr, ako aiku odpovedalo. Skúste to znova: aiku tovar uloží iba raz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslutningen bröts innan aiku svarade. Försök igen: aiku placerar den bara en gång."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "aiku yanıt vermeden bağlantı koptu. Tekrar deneyin: aiku bunu yalnızca bir kez yerleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З'єднання обірвалося до того, як aiku відповів. Спробуйте ще раз: aiku розміщує лише один раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 aiku 响应前连接已断开。请重试：aiku 只会上架一次。"
          }
        }
      }
    },
    "The counted quantities are applied to pallet %@. Items not counted stay as they are.": {
