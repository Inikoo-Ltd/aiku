    "Changes the app language for you only. Product names, customer names and notes stay as they are in Aiku.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Променя езика на приложението само за вас. Имената на продукти, имената на клиенти и бележките остават както са в Aiku."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změní jazyk aplikace jen pro vás. Názvy produktů, jména zákazníků a poznámky zůstanou tak, jak jsou v Aiku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändert die App-Sprache nur für Sie. Produktnamen, Kundennamen und Notizen bleiben so, wie sie in Aiku sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia el idioma de la app solo para usted. Los nombres de productos, los nombres de clientes y las notas se mantienen como están en Aiku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Change la langue de l’application pour vous uniquement. Les noms de produits, noms de clients et notes restent tels qu’ils sont dans Aiku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऐप की भाषा केवल आपके लिए बदलता है। उत्पाद नाम, ग्राहक नाम और नोट्स वैसे ही रहते हैं जैसे Aiku में हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mijenja jezik aplikacije samo za vas. Nazivi proizvoda, imena kupaca i bilješke ostaju kakvi su u Aikuu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csak az Ön számára módosítja az alkalmazás nyelvét. A terméknevek, ügyfélnevek és megjegyzések úgy maradnak, ahogy az Aikuban szerepelnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengubah bahasa aplikasi hanya untuk Anda. Nama produk, nama pelanggan, dan catatan tetap seperti di Aiku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia la lingua dell’app solo per lei. Nomi dei prodotti, nomi dei clienti e note restano come sono in Aiku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのアプリの言語のみを変更します。商品名、顧客名、メモはAikuでの表記のままです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maina lietotnes valodu tikai jums. Produktu nosaukumi, klientu vārdi un piezīmes paliek tādi paši kā Aiku."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एपको भाषा तपाईंका लागि मात्र बदल्छ। उत्पादनका नाम, ग्राहकका नाम र नोटहरू Aiku मा जस्तै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wijzigt de app-taal alleen voor jou. Productnamen, klantnamen en notities blijven zoals ze in Aiku staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmienia język aplikacji tylko dla Ciebie. Nazwy produktów, nazwy klientów i notatki pozostają takie jak w Aiku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altera o idioma da aplicação apenas para si. Os nomes de produtos, os nomes de clientes e as notas ficam como estão no Aiku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schimbă limba aplicației doar pentru tine. Numele produselor, numele clienților și notele rămân așa cum sunt în Aiku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmení jazyk aplikácie len pre vás. Názvy produktov, mená zákazníkov a poznámky zostanú tak, ako sú v Aiku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändrar appens språk bara för dig. Produktnamn, kundnamn och anteckningar förblir som de är i Aiku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygulama dilini yalnızca sizin için değiştirir. Ürün adları, müşteri adları ve notlar Aiku’daki gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Змінює мову застосунку лише для вас. Назви товарів, імена клієнтів і примітки залишаються такими, як в Aiku."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅为你更改应用语言。产品名称、客户名称和备注保持 Aiku 中的原样。"
          }
        }
      }
    },
    "Changes the language of your Aiku account, on the web and in the app. Notifications follow it too. Product names, customer names and notes stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сменя езика на акаунта ви в Aiku – в уеб версията и в приложението. Известията също го следват. Имената на продуктите, имената на клиентите и бележките остават както са."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změní jazyk vašeho účtu Aiku na webu i v aplikaci. Řídí se jím i oznámení. Názvy produktů, jména zákazníků a poznámky zůstanou beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändert die Sprache Ihres Aiku-Kontos im Web und in der App. Auch Benachrichtigungen folgen ihr. Produktnamen, Kundennamen und Notizen bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia el idioma de su cuenta de Aiku, en la web y en la aplicación. Las notificaciones también lo siguen. Los nombres de productos, los nombres de clientes y las notas se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Change la langue de votre compte Aiku, sur le web et dans l'application. Les notifications la suivent aussi. Les noms de produits, les noms de clients et les notes restent inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके Aiku खाते की भाषा बदलता है, वेब पर भी और ऐप में भी। सूचनाएं भी इसी भाषा में आती हैं। उत्पाद नाम, ग्राहक नाम और नोट्स वैसे ही रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mijenja jezik vašeg Aiku računa, na webu i u aplikaciji. Obavijesti ga također slijede. Nazivi proizvoda, imena kupaca i bilješke ostaju kakvi jesu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Aiku-fiókja nyelvét módosítja, a weben és az alkalmazásban is. Az értesítések is ezt a nyelvet követik. A terméknevek, az ügyfélnevek és a megjegyzések változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengubah bahasa akun Aiku Anda, di web dan di aplikasi. Pemberitahuan juga mengikutinya. Nama produk, nama pelanggan, dan catatan tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia la lingua del suo account Aiku, sul web e nell'app. Anche le notifiche la seguono. I nomi dei prodotti, i nomi dei clienti e le note restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aikuアカウントの言語を変更します（Webとアプリの両方）。通知もこの言語に従います。商品名、顧客名、メモはそのままです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maina jūsu Aiku konta valodu tīmeklī un lietotnē. Arī paziņojumi seko šai valodai. Produktu nosaukumi, klientu vārdi un piezīmes paliek nemainīti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंको Aiku खाताको भाषा वेब र एप दुवैमा परिवर्तन गर्छ। सूचनाहरू पनि यही भाषामा आउँछन्। उत्पादनका नाम, ग्राहकका नाम र नोटहरू जस्ताको तस्तै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wijzigt de taal van je Aiku-account, op het web en in de app. Meldingen volgen die taal ook. Productnamen, klantnamen en notities blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmienia język konta Aiku w wersji internetowej i w aplikacji. Powiadomienia też są wysyłane w tym języku. Nazwy produktów, nazwy klientów i notatki pozostają bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altera o idioma da sua conta Aiku, na web e na aplicação. As notificações também o seguem. Os nomes de produtos, os nomes de clientes e as notas ficam como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schimbă limba contului Aiku, pe web și în aplicație. Și notificările o urmează. Numele produselor, numele clienților și notele rămân neschimbate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmení jazyk vášho účtu Aiku na webe aj v aplikácii. Riadia sa ním aj upozornenia. Názvy produktov, mená zákazníkov a poznámky zostanú bez zmeny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändrar språket för ditt Aiku-konto, på webben och i appen. Aviseringar följer det också. Produktnamn, kundnamn och anteckningar förblir oförändrade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku hesabınızın dilini web'de ve uygulamada değiştirir. Bildirimler de bu dili kullanır. Ürün adları, müşteri adları ve notlar olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Змінює мову вашого облікового запису Aiku — у вебверсії та в застосунку. Сповіщення теж надходять цією мовою. Назви продуктів, імена клієнтів і примітки залишаються без змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改您的 Aiku 账户语言，网页和应用均适用。通知也会使用该语言。产品名称、客户名称和备注保持不变。"
          }
        }
      }
    },
    "Changing your password needs internet — check Wi-Fi and try again.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За смяна на паролата е нужен интернет — проверете Wi-Fi и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změna hesla vyžaduje internet – zkontrolujte Wi-Fi a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Ändern Ihres Passworts wird Internet benötigt – prüfen Sie das WLAN und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para cambiar la contraseña se necesita internet: compruebe el wifi e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Changer votre mot de passe nécessite Internet : vérifiez le Wi-Fi et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पासवर्ड बदलने के लिए इंटरनेट चाहिए — Wi-Fi जाँचें और फिर से प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za promjenu lozinke potreban je internet – provjerite Wi-Fi i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A jelszó módosításához internet kell – ellenőrizze a Wi-Fit, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengubah kata sandi memerlukan internet — periksa Wi-Fi lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per cambiare la password serve internet: controlli il Wi-Fi e riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードの変更にはインターネット接続が必要です。Wi-Fiを確認して、もう一度お試しください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paroles maiņai nepieciešams internets — pārbaudiet Wi-Fi un mēģiniet vēlreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पासवर्ड परिवर्तन गर्न इन्टरनेट चाहिन्छ — Wi-Fi जाँच गरी फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voor het wijzigen van je wachtwoord is internet nodig — controleer de wifi en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiana hasła wymaga internetu — sprawdź Wi-Fi i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para alterar a palavra-passe é necessária internet — verifique o Wi-Fi e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schimbarea parolei necesită internet — verificați Wi-Fi-ul și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmena hesla vyžaduje internet – skontrolujte Wi-Fi a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Byte av lösenord kräver internet – kontrollera wifi och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şifre değiştirmek için internet gerekli — Wi-Fi bağlantısını kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
