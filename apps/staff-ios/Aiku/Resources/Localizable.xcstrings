    "Auditing needs stock edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одитът изисква права за редакция на наличности."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Audit vyžaduje oprávnění upravovat zásoby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für die Prüfung sind Rechte zum Bearbeiten des Bestands nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auditar requiere permisos para editar stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’audit nécessite les droits de modification du stock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑडिट के लिए स्टॉक संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revizija zahtijeva prava uređivanja zaliha."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az ellenőrzéshez készletszerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Audit memerlukan hak edit stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La verifica richiede i permessi di modifica dello stock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "棚卸しには在庫編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auditam nepieciešamas krājumu labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अडिटका लागि स्टक सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleren vereist bewerkrechten voor voorraad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Audyt wymaga uprawnień do edycji zapasów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A auditoria requer permissões de edição de stock."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auditul necesită drepturi de editare a stocului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inventúra vyžaduje práva na úpravu zásob."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Granskning kräver behörighet att redigera lager."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sayım için stok düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для аудиту потрібні права на редагування запасів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "盘点需要库存编辑权限。"
          }
        }
      }
    },
    "Auditing needs stock edit rights; moving and removing SKOs need location edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одитът изисква права за редакция на наличности; преместването и премахването на SKO изискват права за редакция на локации."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Audit vyžaduje oprávnění upravovat zásoby; přesun a odebrání SKOs vyžaduje oprávnění upravovat umístění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für die Prüfung sind Rechte zum Bearbeiten des Bestands nötig; zum Umlagern und Entfernen von SKOs Rechte zum Bearbeiten von Lagerplätzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auditar requiere permisos para editar stock; mover y retirar SKOs requiere permisos para editar ubicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’audit nécessite les droits de modification du stock ; déplacer et retirer des SKO nécessite les droits de modification des emplacements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑडिट के लिए स्टॉक संपादन अधिकार चाहिए; SKOs ले जाने और हटाने के लिए लोकेशन संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revizija zahtijeva prava uređivanja zaliha; premještanje i uklanjanje SKO-a zahtijeva prava uređivanja lokacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az ellenőrzéshez készletszerkesztési jog, az SKO-k áthelyezéséhez és eltávolításához helyszerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Audit memerlukan hak edit stok; memindahkan dan menghapus SKO memerlukan hak edit lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La verifica richiede i permessi di modifica dello stock; spostare e rimuovere SKO richiede i permessi di modifica delle ubicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "棚卸しには在庫編集権限が、SKOの移動と削除にはロケーション編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auditam nepieciešamas krājumu labošanas tiesības; SKO pārvietošanai un noņemšanai — vietu labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अडिटका लागि स्टक सम्पादन अधिकार चाहिन्छ; SKO हरू सार्न र हटाउन लोकेसन सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleren vereist bewerkrechten voor voorraad; SKOs verplaatsen en verwijderen vereist bewerkrechten voor locaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Audyt wymaga uprawnień do edycji zapasów; przenoszenie i usuwanie SKOs wymaga uprawnień do edycji lokalizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A auditoria requer permissões de edição de stock; mover e remover SKOs requer permissões de edição de localizações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auditul necesită drepturi de editare a stocului; mutarea și eliminarea SKO-urilor necesită drepturi de editare a locațiilor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inventúra vyžaduje práva na úpravu zásob; presun a odstránenie SKO vyžaduje práva na úpravu lokácií."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Granskning kräver behörighet att redigera lager; att flytta och ta bort SKO kräver behörighet att redigera lagerplatser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sayım için stok düzenleme yetkisi gerekir; SKO taşımak ve kaldırmak için lokasyon düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для аудиту потрібні права на редагування запасів; для переміщення та видалення SKO — права на редагування комірок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "盘点需要库存编辑权限；移动和移除 SKO 需要库位编辑权限。"
          }
        }
      }
    },
