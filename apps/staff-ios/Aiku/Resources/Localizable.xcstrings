    "No internet connection. Scans and counts are saved on this phone and will sync automatically when you’re back online.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Няма интернет връзка. Сканиранията и преброяванията се запазват на този телефон и ще се синхронизират автоматично, когато отново сте онлайн."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bez připojení k internetu. Skeny a počty se ukládají do tohoto telefonu a automaticky se synchronizují, jakmile budete znovu online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Internetverbindung. Scans und Zählungen werden auf diesem Telefon gespeichert und automatisch synchronisiert, wenn Sie wieder online sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin conexión a internet. Los escaneos y recuentos se guardan en este teléfono y se sincronizarán automáticamente cuando vuelva a tener conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas de connexion Internet. Les scans et comptages sont enregistrés sur ce téléphone et se synchroniseront automatiquement quand vous serez de nouveau en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इंटरनेट कनेक्शन नहीं है। स्कैन और गिनती इस फ़ोन पर सहेजी जाती हैं और ऑनलाइन वापस आने पर अपने आप सिंक हो जाएँगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nema internetske veze. Skeniranja i brojanja spremaju se na ovaj telefon i automatski će se sinkronizirati kada ponovno budete na mreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nincs internetkapcsolat. A szkennelések és számlálások ezen a telefonon mentődnek, és automatikusan szinkronizálódnak, amikor újra online lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak ada koneksi internet. Pindaian dan hitungan disimpan di ponsel ini dan akan disinkronkan otomatis saat Anda kembali online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna connessione internet. Scansioni e conteggi vengono salvati su questo telefono e si sincronizzeranno automaticamente quando tornerà online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "インターネットに接続されていません。スキャンとカウントはこのスマートフォンに保存され、オンラインに戻ると自動的に同期されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nav interneta savienojuma. Skenējumi un skaitījumi tiek saglabāti šajā tālrunī un automātiski sinhronizēsies, kad atkal būsiet tiešsaistē."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इन्टरनेट जडान छैन। स्क्यान र गन्ती यो फोनमा सुरक्षित हुन्छन् र अनलाइन फर्केपछि आफैं सिंक हुनेछन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen internetverbinding. Scans en tellingen worden op deze telefoon opgeslagen en automatisch gesynchroniseerd zodra je weer online bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak połączenia z internetem. Skany i liczenia są zapisywane w tym telefonie i zsynchronizują się automatycznie, gdy wrócisz do trybu online."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sem ligação à internet. As leituras e contagens são guardadas neste telemóvel e sincronizadas automaticamente quando voltar a estar online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fără conexiune la internet. Scanările și numărătorile sunt salvate pe acest telefon și se vor sincroniza automat când revii online."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bez internetového pripojenia. Skenovania a počty sa ukladajú v tomto telefóne a po opätovnom pripojení sa automaticky synchronizujú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen internetanslutning. Skanningar och räkningar sparas på den här telefonen och synkas automatiskt när du är online igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İnternet bağlantısı yok. Taramalar ve sayımlar bu telefona kaydedilir ve tekrar çevrimiçi olduğunuzda otomatik olarak senkronize edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає підключення до інтернету. Сканування та підрахунки зберігаються на цьому телефоні й синхронізуються автоматично, коли ви знову будете онлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无网络连接。扫描和清点会保存在此手机上，恢复联网后会自动同步。"
          }
        }
      }
    },
