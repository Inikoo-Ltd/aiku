          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanda terkirim dibatalkan. Kini kembali ke bagian pembelian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stato spedito annullato. È di nuovo in carico all’ufficio acquisti."
