    "Enter your username or email and we’ll email you a 6-digit code to reset your password.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Въведете потребителското си име или имейл и ще ви изпратим 6-цифрен код по имейл за нулиране на паролата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadejte své uživatelské jméno nebo e-mail a pošleme vám 6místný kód pro obnovení hesla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geben Sie Ihren Benutzernamen oder Ihre E-Mail ein, und wir senden Ihnen einen 6-stelligen Code zum Zurücksetzen Ihres Passworts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduzca su nombre de usuario o correo electrónico y le enviaremos un código de 6 dígitos para restablecer su contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez votre nom d’utilisateur ou votre e-mail et nous vous enverrons un code à 6 chiffres pour réinitialiser votre mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपना यूज़रनेम या ईमेल दर्ज करें, हम आपको पासवर्ड रीसेट करने के लिए 6 अंकों का कोड ईमेल करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unesite korisničko ime ili e-poštu i poslat ćemo vam 6-znamenkasti kôd za ponovno postavljanje lozinke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adja meg a felhasználónevét vagy e-mail-címét, és e-mailben küldünk egy 6 jegyű kódot a jelszava visszaállításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masukkan nama pengguna atau email Anda dan kami akan mengirimkan kode 6 digit untuk mengatur ulang kata sandi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inserisca nome utente o email e le invieremo via email un codice di 6 cifre per reimpostare la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ユーザー名またはメールアドレスを入力してください。パスワードをリセットするための6桁のコードをメールでお送りします。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ievadiet lietotājvārdu vai e-pastu, un mēs nosūtīsim jums 6 ciparu kodu paroles atiestatīšanai."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आफ्नो प्रयोगकर्ता नाम वा इमेल प्रविष्ट गर्नुहोस्, हामी पासवर्ड रिसेट गर्न 6 अङ्कको कोड इमेल गर्नेछौं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voer je gebruikersnaam of e-mailadres in en we mailen je een 6-cijferige code om je wachtwoord opnieuw in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wprowadź nazwę użytkownika lub e-mail, a wyślemy Ci 6-cyfrowy kod do zresetowania hasła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduza o seu nome de utilizador ou email e enviaremos um código de 6 dígitos para repor a palavra-passe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introdu numele de utilizator sau e-mailul și îți vom trimite prin e-mail un cod de 6 cifre pentru resetarea parolei."
