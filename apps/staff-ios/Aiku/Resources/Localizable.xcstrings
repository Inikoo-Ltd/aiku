          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las mismas cifras que el panel de inventario de la web. SKOs actuales, Anomalías, por debajo del mínimo y stocks negativos abren la lista de SKOs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mêmes chiffres que le tableau de bord de l’inventaire sur le web. SKO actuels, Anomalies, sous le minimum et stocks négatifs ouvrent la liste des SKO."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
