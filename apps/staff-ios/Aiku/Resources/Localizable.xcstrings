    "Pickers appear here while they work.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Събирачите се показват тук, докато работят."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávači se zde zobrazují, když pracují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommissionierer erscheinen hier, während sie arbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los preparadores aparecen aquí mientras trabajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les préparateurs apparaissent ici pendant qu’ils travaillent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिकर काम करते समय यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berači se ovdje prikazuju dok rade."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózók munka közben jelennek meg itt."
