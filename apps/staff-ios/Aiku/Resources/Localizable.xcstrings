    "Some of your work on this note needs you before this can be done.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Част от работата ви по тази разписка изисква вас, преди това да е възможно."
