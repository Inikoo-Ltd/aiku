    "Arriving means dispatched by the supplier. Tap a source or a figure to open its list.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Пристигащи“ означава изпратени от доставчика. Докоснете източник или число, за да отворите списъка му."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na cestě znamená, že dodavatel zboží odeslal. Klepněte na zdroj nebo číslo a otevře se jeho seznam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ankunft bedeutet: vom Lieferanten versendet. Tippen Sie auf eine Quelle oder eine Zahl, um die Liste zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Llegando significa expedido por el proveedor. Toque un origen o una cifra para abrir su lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« En route » signifie expédié par le fournisseur. Touchez une source ou un chiffre pour ouvrir sa liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आ रहा है का मतलब है कि आपूर्तिकर्ता ने डिस्पैच कर दिया है। उसकी सूची खोलने के लिए किसी स्रोत या आँकड़े पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "U dolasku znači da ju je dobavljač poslao. Dodirnite izvor ili broj da otvorite popis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Úton azt jelenti, hogy a beszállító feladta. Koppintson egy forrásra vagy számra a lista megnyitásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akan tiba berarti sudah dikirim oleh pemasok. Ketuk sumber atau angka untuk membuka daftarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In arrivo significa spedito dal fornitore. Tocchi un'origine o un numero per aprirne l'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「入荷予定」はサプライヤーが出荷済みであることを意味します。供給元や数値をタップするとリストが開きます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“Ceļā” nozīmē, ka piegādātājs to ir nosūtījis. Pieskarieties avotam vai skaitlim, lai atvērtu tā sarakstu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आइपुग्दै भनेको आपूर्तिकर्ताले पठाइसकेको हो। सूची खोल्न कुनै स्रोत वा अङ्कमा ट्याप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onderweg betekent verzonden door de leverancier. Tik op een bron of een getal om de lijst te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„W drodze” oznacza wysłane przez dostawcę. Stuknij źródło lub liczbę, aby otworzyć listę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A chegar significa expedido pelo fornecedor. Toque numa origem ou num valor para abrir a respetiva lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„În sosire” înseamnă expediat de furnizor. Atingeți o sursă sau o cifră pentru a deschide lista."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na ceste znamená, že dodávateľ tovar odoslal. Ťuknite na zdroj alebo číslo a otvorí sa jeho zoznam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "På väg betyder skickad av leverantören. Tryck på en källa eller en siffra för att öppna dess lista."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yolda, tedarikçi tarafından sevk edilmiş demektir. Listesini açmak için bir kaynağa veya sayıya dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Прибуває» означає, що постачальник уже відправив. Торкніться джерела або числа, щоб відкрити його список."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“即将到达”表示供应商已发货。点按来源或数字可打开其列表。"
          }
        }
      }
    },
