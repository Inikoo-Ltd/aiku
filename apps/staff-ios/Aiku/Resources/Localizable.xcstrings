    "Open the location again to see its stock movements.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отворете локацията отново, за да видите движенията на наличностите ѝ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Znovu otevřete umístění, abyste viděli jeho pohyby zásob."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnen Sie den Lagerplatz erneut, um seine Bestandsbewegungen zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelva a abrir la ubicación para ver sus movimientos de stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rouvrez l’emplacement pour voir ses mouvements de stock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसके स्टॉक मूवमेंट देखने के लिए लोकेशन फिर से खोलें।"
          }
