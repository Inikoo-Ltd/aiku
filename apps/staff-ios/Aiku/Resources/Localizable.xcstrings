    "leave the bay tidier than you found it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "остави зоната по-подредена, отколкото си я заварил."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nech pozici uklizenější, než jsi ji našel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "hinterlass den Platz ordentlicher, als du ihn vorgefunden hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "deje la zona más ordenada de lo que la encontró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "laissez la zone plus rangée que vous ne l’avez trouvée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बे को जैसा पाया था, उससे ज़्यादा साफ़-सुथरा छोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ostavi mjesto urednijim nego što si ga zatekao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "hagyd rendezettebben a rekeszt, mint ahogy találtad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tinggalkan bay lebih rapi daripada saat Anda menemukannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lasci la zona più in ordine di come l’ha trovata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "置き場は来たときよりもきれいにして去ろう。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "atstājiet vietu kārtīgāku, nekā to atradāt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बेलाई भेट्दाभन्दा सफा छोडेर जानुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "laat het vak netter achter dan je het aantrof."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "zostaw stanowisko czystsze, niż je zastałeś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "deixe a zona mais arrumada do que a encontrou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lasă zona mai ordonată decât ai găsit-o."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nechaj miesto upratanejšie, ako si ho našiel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lämna facket snyggare än du hittade det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "alanı bulduğunuzdan daha düzenli bırakın."
          }
        },
