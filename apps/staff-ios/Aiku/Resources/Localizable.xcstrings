    "Everything assigned to you, from every module you can open. Oldest and blocked first.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всичко, възложено на вас, от всеки модул, до който имате достъп. Първо най-старите и блокираните."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vše, co je vám přiřazeno, ze všech modulů, které můžete otevřít. Nejstarší a blokované jako první."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles, was Ihnen zugewiesen ist, aus jedem Modul, das Sie öffnen können. Älteste und blockierte zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo lo que tiene asignado, de todos los módulos que puede abrir. Primero lo más antiguo y lo bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout ce qui vous est attribué, dans chaque module auquel vous avez accès. Les plus anciens et les bloqués d’abord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपको असाइन किया गया सब कुछ, उन सभी मॉड्यूल से जिन्हें आप खोल सकते हैं। सबसे पुराने और रुके हुए पहले।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve što vam je dodijeljeno, iz svakog modula koji možete otvoriti. Najstarije i blokirano prvo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden, ami Önhöz van rendelve, az összes megnyitható modulból. A legrégebbiek és az elakadtak elöl."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semua yang ditugaskan kepada Anda, dari setiap modul yang dapat Anda buka. Yang terlama dan terblokir lebih dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutto ciò che le è assegnato, da ogni modulo a cui ha accesso. Prima i più vecchi e i bloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開けるすべてのモジュールから、あなたに割り当てられたものすべて。古いものとブロック中のものが先に表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viss, kas jums piešķirts, no katra moduļa, ko varat atvērt. Vispirms vecākie un bloķētie."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंले खोल्न सक्ने हरेक मोड्युलबाट तपाईंलाई तोकिएका सबै काम। पुरानो र अवरुद्ध पहिले।"
