    "Items show here once their checked quantity is placed in locations.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Артикулите се показват тук, след като провереното им количество бъде разположено в локации."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Položky se zde zobrazí, jakmile bude jejich zkontrolované množství uloženo do umístění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artikel erscheinen hier, sobald ihre geprüfte Menge an Lagerplätzen eingelagert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los artículos aparecen aquí cuando su cantidad comprobada está ubicada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les articles s’affichent ici une fois leur quantité vérifiée rangée dans les emplacements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आइटम यहाँ तब दिखते हैं जब उनकी जाँची गई मात्रा लोकेशन में रख दी जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artikli se ovdje prikazuju kada je njihova provjerena količina uskladištena na lokacijama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A tételek akkor jelennek meg itt, amikor az ellenőrzött mennyiségük el van helyezve a helyeken."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Barang muncul di sini setelah kuantitas yang diperiksa ditempatkan di lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli articoli compaiono qui quando la quantità verificata è sistemata nelle ubicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "確認数量がロケーションに格納されると、商品がここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preces šeit parādās, kad to pārbaudītais daudzums ir novietots vietās."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाँच गरिएको परिमाण लोकेसनमा राखेपछि वस्तुहरू यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artikelen verschijnen hier zodra hun gecontroleerde aantal op locaties is geplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozycje pojawią się tutaj, gdy ich sprawdzona ilość zostanie rozlokowana w lokalizacjach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os artigos aparecem aqui assim que a quantidade verificada for armazenada em localizações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Articolele apar aici după ce cantitatea lor verificată este amplasată în locații."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Položky sa tu zobrazia, keď sa ich skontrolované množstvo umiestni do lokácií."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artiklar visas här när deras kontrollerade antal har placerats på lagerplatser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ürünler, kontrol edilen miktarları lokasyonlara yerleştirildiğinde burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Товари з’являються тут, щойно їхню перевірену кількість розміщено в комірках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "货品的已检查数量上架到库位后，会显示在这里。"
          }
        }
      }
    },
    "Its pallets are set as returned and leave the warehouse.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Палетите му се маркират като върнати и напускат склада."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeho palety budou označeny jako vrácené a opustí sklad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihre Paletten werden auf zurückgegeben gesetzt und verlassen das Lagerhaus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sus palets se marcan como devueltos y salen del almacén."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ses palettes sont marquées comme retournées et quittent l’entrepôt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसके पैलेट लौटाए गए के रूप में सेट होते हैं और गोदाम से निकल जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Njegove palete označavaju se kao vraćene i napuštaju skladište."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A raklapjai visszaküldöttként lesznek jelölve, és elhagyják a raktárt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paletnya ditandai sebagai dikembalikan dan meninggalkan gudang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I suoi pallet sono impostati come restituiti e lasciano il magazzino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パレットが返品済みになり、倉庫から出ます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tās paletes tiek atzīmētas kā atgrieztas un atstāj noliktavu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यसका प्यालेटहरू फिर्ता गरिएको रूपमा सेट हुन्छन् र गोदामबाट निस्कन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De pallets worden op geretourneerd gezet en verlaten het magazijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jego palety zostaną oznaczone jako zwrócone i opuszczą magazyn."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As suas paletes são marcadas como devolvidas e saem do armazém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleții săi sunt marcați ca returnați și părăsesc depozitul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
