          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संदर्भ ऑर्डर का संदर्भ है। पिकिंग सत्र में डालने के लिए कई 'करना है' नोट चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
