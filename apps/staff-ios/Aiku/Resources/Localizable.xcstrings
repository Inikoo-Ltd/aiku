          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir toplama oturumunda olabilir ya da yalnızca görüntüleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
