    "Every delivery note is packed and the trolleys are free.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всички стокови разписки са опаковани и количките са свободни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všechny dodací listy jsou zabalené a vozíky volné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Lieferschein ist verpackt und die Wagen sind frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los albaranes están embalados y los carros están libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les bons de livraison sont emballés et les chariots sont libres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर डिलीवरी नोट पैक हो गया है और ट्रॉली खाली हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve otpremnice su spakirane i kolica su slobodna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden szállítólevél becsomagolva, és a kocsik szabadok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
