    "The chat needs internet. Check Wi-Fi and try again.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чатът изисква интернет. Проверете Wi-Fi и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chat vyžaduje internet. Zkontrolujte Wi-Fi a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Chat braucht Internet. Prüfen Sie das WLAN und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El chat necesita internet. Compruebe la wifi y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conversation nécessite Internet. Vérifiez le Wi-Fi et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चैट के लिए इंटरनेट चाहिए। Wi-Fi जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Razgovor zahtijeva internet. Provjerite Wi-Fi i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A csevegéshez internet szükséges. Ellenőrizze a Wi-Fit, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chat memerlukan internet. Periksa Wi-Fi dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La chat richiede internet. Controlli il Wi-Fi e riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャットにはインターネット接続が必要です。Wi-Fiを確認してもう一度お試しください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tērzēšanai nepieciešams internets. Pārbaudiet Wi-Fi un mēģiniet vēlreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "च्याटका लागि इन्टरनेट चाहिन्छ। Wi-Fi जाँच गरी फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De chat vereist internet. Controleer de wifi en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czat wymaga internetu. Sprawdź Wi-Fi i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conversa precisa de internet. Verifique o Wi-Fi e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conversația necesită internet. Verifică Wi-Fi-ul și încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chat vyžaduje internet. Skontrolujte Wi-Fi a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chatten kräver internet. Kontrollera wifi och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sohbet için internet gerekir. Wi-Fi’yi kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для чату потрібен інтернет. Перевірте Wi-Fi і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聊天需要联网。请检查 Wi-Fi 后重试。"
          }
        }
      }
    },
    "The check-out time must be after the check-in time.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Часът на изход трябва да е след часа на вход."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Čas odchodu musí být po čase příchodu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Ausstempelzeit muss nach der Einstempelzeit liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de salida debe ser posterior a la hora de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure de sortie doit être postérieure à l'heure d'entrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेक-आउट समय चेक-इन समय के बाद होना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrijeme odlaska mora biti nakon vremena dolaska."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A távozás időpontjának az érkezés időpontja után kell lennie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu check-out harus setelah waktu check-in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’ora di uscita deve essere successiva all’ora di entrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "退勤時刻は出勤時刻より後にしてください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiziešanas laikam jābūt pēc ierašanās laika."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "चेक-आउट समय चेक-इन समयपछि हुनुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De uitkloktijd moet na de inkloktijd liggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina wyjścia musi być późniejsza niż godzina wejścia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora de saída tem de ser posterior à hora de entrada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora de ieșire trebuie să fie după ora de intrare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas odchodu musí byť neskôr ako čas príchodu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utcheckningstiden måste vara efter incheckningstiden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çıkış saati giriş saatinden sonra olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Час виходу має бути пізніше за час приходу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "下班打卡时间必须晚于上班打卡时间。"
          }
        }
      }
    },
    "The code you scanned was not accepted. The message below comes from Aiku.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканираният код не беше приет. Съобщението по-долу е от Aiku."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenovaný kód nebyl přijat. Zpráva níže pochází z Aiku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der gescannte Code wurde nicht akzeptiert. Die Meldung unten stammt von Aiku."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se aceptó el código que ha escaneado. El mensaje de abajo viene de Aiku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le code scanné n’a pas été accepté. Le message ci-dessous provient d’Aiku."
