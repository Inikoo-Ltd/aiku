    "Placed. This is its final state, nothing left to do.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разположено. Това е крайното състояние, няма какво повече да се прави."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umístěno. Toto je konečný stav, už není co dělat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
