    "Your account needs two-factor authentication. Add Aiku to an authenticator app, then enter the 6-digit code it shows.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Акаунтът ви изисква двуфакторно удостоверяване. Добавете Aiku в приложение за удостоверяване, след което въведете 6-цифрения код, който то показва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Váš účet vyžaduje dvoufaktorové ověření. Přidejte Aiku do ověřovací aplikace a pak zadejte 6místný kód, který zobrazí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihr Konto erfordert eine Zwei-Faktor-Authentifizierung. Fügen Sie Aiku zu einer Authenticator-App hinzu und geben Sie dann den angezeigten 6-stelligen Code ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su cuenta necesita autenticación en dos pasos. Añada Aiku a una aplicación de autenticación y luego introduzca el código de 6 dígitos que muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte exige l'authentification à deux facteurs. Ajoutez Aiku à une application d'authentification, puis saisissez le code à 6 chiffres qu'elle affiche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके खाते के लिए दो-कारक प्रमाणीकरण आवश्यक है। Aiku को किसी ऑथेंटिकेटर ऐप में जोड़ें, फिर उसमें दिखाया गया 6-अंकों का कोड दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaš račun zahtijeva dvofaktorsku autentifikaciju. Dodajte Aiku u aplikaciju za autentifikaciju, zatim unesite 6-znamenkasti kôd koji ona prikaže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fiókjához kétfaktoros hitelesítés szükséges. Adja hozzá az Aikut egy hitelesítő alkalmazáshoz, majd írja be az ott megjelenő 6 jegyű kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akun Anda memerlukan autentikasi dua faktor. Tambahkan Aiku ke aplikasi autentikator, lalu masukkan kode 6 digit yang ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il suo account richiede l'autenticazione a due fattori. Aggiunga Aiku a un'app di autenticazione, poi inserisca il codice a 6 cifre che mostra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このアカウントには2要素認証が必要です。認証アプリにAikuを追加し、表示された6桁のコードを入力してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jūsu kontam nepieciešama divfaktoru autentifikācija. Pievienojiet Aiku autentifikācijas lietotnei un pēc tam ievadiet tajā redzamo 6 ciparu kodu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंको खातामा दुई-तहको प्रमाणीकरण आवश्यक छ। Aiku लाई अथेन्टिकेटर एपमा थप्नुहोस्, त्यसपछि त्यसले देखाएको 6-अङ्कको कोड राख्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je account vereist tweestapsverificatie. Voeg Aiku toe aan een authenticator-app en vul daarna de 6-cijferige code in die de app toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoje konto wymaga uwierzytelniania dwuskładnikowego. Dodaj Aiku do aplikacji uwierzytelniającej, a następnie wpisz wyświetlony w niej 6-cyfrowy kod."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sua conta necessita de autenticação de dois fatores. Adicione o Aiku a uma aplicação de autenticação e depois introduza o código de 6 dígitos que ela mostra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contul dvs. necesită autentificare cu doi factori. Adăugați Aiku într-o aplicație de autentificare, apoi introduceți codul de 6 cifre afișat de aceasta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Váš účet vyžaduje dvojfaktorové overenie. Pridajte Aiku do overovacej aplikácie a potom zadajte 6-miestny kód, ktorý zobrazí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditt konto kräver tvåfaktorsautentisering. Lägg till Aiku i en autentiseringsapp och ange sedan den 6-siffriga koden som visas."
          }
        },
        "tr": {
