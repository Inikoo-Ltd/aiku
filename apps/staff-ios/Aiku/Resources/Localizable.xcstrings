    "Camera access is off. Allow it in Settings, or type the code.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Достъпът до камерата е изключен. Разрешете го в Настройки или въведете кода."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přístup k fotoaparátu je vypnutý. Povolte ho v Nastavení, nebo zadejte kód."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Kamerazugriff ist aus. Erlauben Sie ihn in den Einstellungen oder geben Sie den Code ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso a la cámara está desactivado. Permítalo en Ajustes o escriba el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès à l’appareil photo est désactivé. Autorisez-le dans Réglages, ou saisissez le code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कैमरा एक्सेस बंद है। इसे सेटिंग्स में चालू करें, या कोड टाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pristup kameri je isključen. Dopustite ga u Postavkama ili upišite kod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A kamera-hozzáférés ki van kapcsolva. Engedélyezze a Beállításokban, vagy írja be a kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses kamera nonaktif. Izinkan di Pengaturan, atau ketik kodenya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso alla fotocamera è disattivato. Lo consenta in Impostazioni oppure digiti il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラへのアクセスがオフです。設定で許可するか、コードを入力してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piekļuve kamerai ir izslēgta. Atļaujiet to Iestatījumos vai ierakstiet kodu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्यामेरा पहुँच बन्द छ। सेटिङमा अनुमति दिनुहोस्, वा कोड टाइप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cameratoegang staat uit. Sta het toe in Instellingen of typ de code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dostęp do aparatu jest wyłączony. Zezwól na niego w Ustawieniach lub wpisz kod."
          }
        },
        "pt": {
          "stringUnit": {
