    "Moving and removing SKOs need location edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Преместването и премахването на SKO изискват права за редакция на локации."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přesouvání a odebírání SKO vyžaduje oprávnění k úpravám umístění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Verschieben und Entfernen von SKOs sind Rechte zum Bearbeiten von Lagerplätzen nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mover y retirar SKOs requiere permisos para editar ubicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacer et retirer des SKO nécessite les droits de modification des emplacements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKOs ले जाने और हटाने के लिए लोकेशन संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premještanje i uklanjanje SKO-ova zahtijeva prava uređivanja lokacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az SKO-k áthelyezéséhez és eltávolításához helyszerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memindahkan dan menghapus SKO memerlukan hak edit lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spostare e rimuovere SKO richiede i permessi di modifica delle ubicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKOの移動と削除にはロケーションの編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO pārvietošanai un noņemšanai nepieciešamas vietu labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO हरू सार्न र हटाउन लोकेसन सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voor het verplaatsen en verwijderen van SKOs zijn bewerkrechten voor locaties nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przenoszenie i usuwanie SKO wymaga uprawnień do edycji lokalizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mover e remover SKOs requer permissões de edição de localizações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mutarea și eliminarea SKO-urilor necesită drepturi de editare a locațiilor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Presúvanie a odstraňovanie SKO vyžaduje oprávnenie na úpravu lokácií."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Att flytta och ta bort SKO kräver behörighet att redigera lagerplatser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO taşımak ve kaldırmak için lokasyon düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для переміщення та видалення SKO потрібні права на редагування комірок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "移动和移除 SKO 需要库位编辑权限。"
          }
        }
      }
    },
