    "The reference is the order reference. Select several To do notes to put them in a picking session.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Референцията е референцията на поръчката. Изберете няколко разписки от За вършене, за да ги сложите в пикинг сесия."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reference je reference objednávky. Vyberte několik listů K vyřízení a vložte je do relace vychystávání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Referenz ist die Bestellreferenz. Wählen Sie mehrere Lieferscheine unter „Zu erledigen“, um sie in eine Kommissioniersitzung aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La referencia es la del pedido. Seleccione varios albaranes Por hacer para ponerlos en una sesión de picking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
