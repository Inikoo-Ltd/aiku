          "stringUnit": {
            "state": "needs_review",
            "value": "Weź to z tej lokalizacji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retire-o desta localização"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ia-l din această locație"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrať z tejto lokácie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta den från den här lagerplatsen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu lokasyondan alın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Взяти з цієї комірки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此库位取货"
          }
        }
      }
    },
    "Take the goods off the trolley or bay. If the order is sent again, the new delivery note can reuse them.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Свалете стоките от количката или зоната. Ако поръчката бъде изпратена отново, новата стокова разписка може да ги използва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sundejte zboží z vozíku nebo z odkládací pozice. Pokud se objednávka odešle znovu, nový dodací list ho může znovu použít."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nehmen Sie die Ware vom Wagen oder aus der Zone. Wird die Bestellung erneut versendet, kann der neue Lieferschein sie wiederverwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saque la mercancía del carro o de la zona. Si el pedido se vuelve a enviar, el nuevo albarán puede reutilizarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retirez les marchandises du chariot ou de la zone. Si la commande est renvoyée, le nouveau bon de livraison peut les réutiliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "माल को ट्रॉली या बे से उतारें। अगर ऑर्डर फिर से भेजा जाता है, तो नया डिलीवरी नोट इसका फिर से उपयोग कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skinite robu s kolica ili iz zone. Ako se narudžba ponovno pošalje, nova otpremnica može je ponovno iskoristiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vegye le az árut a kocsiról vagy a rekeszből. Ha a rendelést újra elküldik, az új szállítólevél felhasználhatja őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Turunkan barang dari troli atau bay. Jika pesanan dikirim ulang, surat jalan baru dapat memakainya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tolga la merce dal carrello o dall’area. Se l’ordine viene rispedito, la nuova bolla di consegna può riutilizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "台車または置き場から商品を下ろしてください。注文が再送される場合、新しい納品書で再利用できます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noņemiet preces no ratiņiem vai savākto preču vietas. Ja pasūtījums tiek nosūtīts vēlreiz, jaunā piegādes pavadzīme var tās izmantot atkārtoti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सामान ट्रली वा बेबाट निकाल्नुहोस्। अर्डर फेरि पठाइएमा, नयाँ डेलिभरी नोटले यसलाई पुनः प्रयोग गर्न सक्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haal de goederen van de trolley of uit het vak. Als de bestelling opnieuw wordt verzonden, kan de nieuwe pakbon ze hergebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zdejmij towar z wózka lub ze strefy. Jeśli zamówienie zostanie wysłane ponownie, nowy dowód dostawy może go ponownie wykorzystać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retire os artigos do carrinho ou da zona. Se a encomenda for enviada novamente, a nova guia de remessa pode reutilizá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scoate mărfurile de pe cărucior sau din zonă. Dacă comanda este trimisă din nou, noua notă de livrare le poate refolosi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zložte tovar z vozíka alebo miesta. Ak sa objednávka odošle znova, nový dodací list ho môže znova použiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta av varorna från vagnen eller facket. Om ordern skickas igen kan den nya följesedeln återanvända dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ürünleri toplama arabasından veya alandan alın. Sipariş yeniden gönderilirse yeni irsaliye bunları kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зніміть товари з візка або відсіку. Якщо замовлення буде відправлено знову, нова накладна зможе їх використати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将货物从拣货车或货区取下。如果订单重新发货，新发货单可以重复使用它们。"
          }
        }
      }
    },
