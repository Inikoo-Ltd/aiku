    "Conflicts show up here after the queue syncs.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Конфликтите се показват тук след синхронизиране на опашката."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konflikty se zde zobrazí po synchronizaci fronty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konflikte erscheinen hier, nachdem die Warteschlange synchronisiert wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los conflictos aparecen aquí cuando se sincroniza la cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les conflits apparaissent ici après la synchronisation de la file d’attente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कतार सिंक होने के बाद टकराव यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sukobi se ovdje prikazuju nakon sinkronizacije reda čekanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az ütközések itt jelennek meg a sor szinkronizálása után."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konflik muncul di sini setelah antrean disinkronkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I conflitti compaiono qui dopo la sincronizzazione della coda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キューの同期後に競合がここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konflikti šeit parādās pēc rindas sinhronizēšanas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पङ्क्ति सिंक भएपछि द्वन्द्वहरू यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conflicten verschijnen hier nadat de wachtrij is gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konflikty pojawią się tutaj po synchronizacji kolejki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os conflitos aparecem aqui depois de a fila sincronizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conflictele apar aici după sincronizarea cozii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konflikty sa tu zobrazia po synchronizácii radu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konflikter visas här efter att kön synkats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
