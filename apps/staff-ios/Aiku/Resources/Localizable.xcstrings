    "These actions done offline could not be recorded exactly as you did them. Do what each one says, then mark it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тези действия, извършени офлайн, не можаха да се запишат точно както ги направи. Направи това, което пише при всяко, и после го отбележи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tyto akce provedené offline se nepodařilo zaznamenat přesně tak, jak jste je udělali. Udělejte, co u každé stojí, a pak ji označte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese offline erledigten Aktionen konnten nicht genau so erfasst werden, wie du sie gemacht hast. Tu, was jeweils dasteht, und markiere sie dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estas acciones hechas sin conexión no se pudieron registrar tal como las hiciste. Haz lo que indica cada una y luego márcala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces actions faites hors ligne n'ont pas pu être enregistrées exactement comme vous les avez faites. Faites ce que chacune indique, puis marquez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑफ़लाइन की गई ये कार्रवाइयाँ ठीक वैसे दर्ज नहीं हो सकीं जैसे आपने कीं। हर एक में जो लिखा है वह करें, फिर उसे चिह्नित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ove radnje obavljene izvan mreže nisu se mogle zabilježiti točno onako kako ste ih obavili. Učinite što piše uz svaku, a zatim je označite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ezeket az offline végzett műveleteket nem lehetett pontosan úgy rögzíteni, ahogy csináltad. Tedd meg, ami mindegyiknél áll, aztán jelöld meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tindakan offline ini tidak bisa dicatat persis seperti yang Anda lakukan. Lakukan yang tertulis di masing-masing, lalu tandai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Queste azioni fatte offline non sono state registrate esattamente come le hai fatte. Fai ciò che indica ciascuna, poi segnala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインで行ったこれらの操作は、そのとおりには記録できませんでした。それぞれの指示どおりに対応してから、完了にしてください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šīs bezsaistē veiktās darbības nevarēja reģistrēt tieši tā, kā tu tās veici. Izdari to, kas rakstīts pie katras, un tad atzīmē to."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अफलाइनमा गरिएका यी कार्यहरू तपाईंले गरेजस्तै दर्ता गर्न सकिएन। प्रत्येकमा लेखिएको गर्नुहोस्, अनि चिन्ह लगाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze offline gedane acties konden niet precies zo worden vastgelegd als je ze deed. Doe wat er bij elke actie staat en markeer hem dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tych akcji wykonanych offline nie udało się zapisać dokładnie tak, jak je wykonałeś. Zrób to, co jest przy każdej, a potem ją oznacz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estas ações feitas offline não puderam ser registadas exatamente como as fez. Faça o que cada uma indica e depois marque-a."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aceste acțiuni făcute offline nu au putut fi înregistrate exact cum le-ai făcut. Fă ce scrie la fiecare, apoi marcheaz-o."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieto akcie urobené offline sa nepodarilo zaznamenať presne tak, ako ste ich urobili. Urobte, čo pri každej stojí, a potom ju označte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dessa åtgärder som gjordes offline kunde inte registreras exakt som du gjorde dem. Gör det som står vid varje och markera den sedan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çevrimdışı yapılan bu işlemler tam yaptığın gibi kaydedilemedi. Her birinde yazanı yap, sonra işaretle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ці дії, виконані офлайн, не вдалося записати точно так, як ви їх зробили. Зробіть те, що вказано біля кожної, а потім позначте її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这些离线操作无法完全按你所做的记录。请按每条的说明处理，然后标记。"
          }
        }
      }
    },
