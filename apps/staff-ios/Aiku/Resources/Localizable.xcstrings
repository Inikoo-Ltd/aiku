          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kérje meg a felettesét, hogy telepítse, amikor alkalmas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minta pengawas Anda untuk memasangnya saat ada waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chieda al suo supervisore di installarla quando possibile."
