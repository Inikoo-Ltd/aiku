          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्लकिङ मेसिनको QR कोड स्क्यान गर्नुहोस्। तपाईंले कहाँ क्लक गर्नुभयो भन्ने मेसिनले निर्धारण गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
