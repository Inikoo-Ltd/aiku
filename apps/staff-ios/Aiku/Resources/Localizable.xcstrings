    "The carrier is not told: cancel the label with them if it was already booked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Превозвачът не се уведомява: откажете етикета при него, ако вече е заявен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
