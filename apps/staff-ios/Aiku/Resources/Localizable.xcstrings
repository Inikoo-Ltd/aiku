    "Its pallets are set as returned and leave the warehouse.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Палетите му се маркират като върнати и напускат склада."
          }
        },
        "cs": {
