        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब पिकिंग प्रतीक्षारत लाइनों के साथ खत्म होती है, तो डिलीवरी नोट 'प्रतीक्षा में' चला जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada branje završi s retcima na čekanju, otpremnica prelazi u Na čekanju."
