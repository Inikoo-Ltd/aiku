          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numer każdego pudełka musi mieścić się w zakresie od 1 do %lld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada número de caixa tem de estar entre 1 e %lld."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numărul fiecărei cutii trebuie să fie între 1 și %lld."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Číslo každej krabice musí byť od 1 do %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
