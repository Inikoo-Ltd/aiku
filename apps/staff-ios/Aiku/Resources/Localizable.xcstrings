    "Changes apply to this delivery note’s shipping only. A banned delivery address (listed in Shop settings) is flagged with a warning.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Änderungen gelten nur für den Versand dieses Lieferscheins. Eine gesperrte Lieferadresse (in den Shop-Einstellungen aufgeführt) wird mit einer Warnung markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los cambios solo afectan al envío de este albarán. Una dirección de entrega bloqueada (indicada en los ajustes de la tienda) se marca con un aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les modifications ne s’appliquent qu’à l’expédition de ce bon de livraison. Une adresse de livraison interdite (listée dans les paramètres de la boutique) est signalée par un avertissement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Promjene vrijede samo za dostavu ove otpremnice. Zabranjena adresa dostave (navedena u postavkama trgovine) označena je upozorenjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A módosítások csak ennek a szállítólevélnek a szállítására vonatkoznak. A tiltott szállítási címet (a Bolt beállításaiban felsorolva) figyelmeztetés jelzi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perubahan hanya berlaku untuk pengiriman surat jalan ini. Alamat pengiriman yang diblokir (tercantum di pengaturan Toko) ditandai dengan peringatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modifiche valgono solo per la spedizione di questa bolla di consegna. Un indirizzo di consegna vietato (elencato nelle impostazioni del negozio) viene segnalato con un avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更はこの納品書の配送にのみ適用されます。禁止された配送先住所（ショップ設定に記載）には警告が表示されます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modificările se aplică doar expedierii acestei note de livrare. O adresă de livrare interzisă (listată în Setările magazinului) este semnalată cu un avertisment."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmeny sa týkajú len dopravy tohto dodacieho listu. Zakázaná dodacia adresa (uvedená v nastaveniach obchodu) je označená upozornením."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değişiklikler yalnızca bu irsaliyenin gönderimi için geçerlidir. Yasaklı bir teslimat adresi (Mağaza ayarlarında listelenen) uyarıyla işaretlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改仅适用于此发货单的配送。被禁止的收货地址（列于店铺设置中）会显示警告标记。"
          }
        }
      }
    },
    "Changes the app language for you only.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändert die App-Sprache nur für Sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia el idioma de la app solo para usted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Change la langue de l’app pour vous uniquement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mijenja jezik aplikacije samo za vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csak az Ön számára módosítja az alkalmazás nyelvét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengubah bahasa aplikasi hanya untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia la lingua dell’app solo per lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのアプリの言語のみを変更します。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schimbă limba aplicației doar pentru tine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmení jazyk aplikácie len pre vás."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygulama dilini yalnızca sizin için değiştirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅为你更改应用语言。"
          }
        }
      }
    },
    "Changes the app language for you only. Product names, customer names and notes stay as they are in Aiku.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändert die App-Sprache nur für Sie. Produktnamen, Kundennamen und Notizen bleiben so, wie sie in Aiku sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia el idioma de la app solo para usted. Los nombres de productos, los nombres de clientes y las notas se mantienen como están en Aiku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Change la langue de l’app pour vous uniquement. Les noms de produits, noms de clients et notes restent tels qu’ils sont dans Aiku."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mijenja jezik aplikacije samo za vas. Nazivi proizvoda, imena kupaca i bilješke ostaju kakvi su u Aikuu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csak az Ön számára módosítja az alkalmazás nyelvét. A terméknevek, ügyfélnevek és megjegyzések úgy maradnak, ahogy az Aikuban szerepelnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengubah bahasa aplikasi hanya untuk Anda. Nama produk, nama pelanggan, dan catatan tetap seperti di Aiku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia la lingua dell’app solo per lei. Nomi dei prodotti, nomi dei clienti e note restano come sono in Aiku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのアプリの言語のみを変更します。商品名、顧客名、メモはAikuでの表記のままです。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schimbă limba aplicației doar pentru tine. Numele produselor, numele clienților și notele rămân așa cum sunt în Aiku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmení jazyk aplikácie len pre vás. Názvy produktov, mená zákazníkov a poznámky zostanú tak, ako sú v Aiku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygulama dilini yalnızca sizin için değiştirir. Ürün adları, müşteri adları ve notlar Aiku’daki gibi kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅为你更改应用语言。产品名称、客户名称和备注保持 Aiku 中的原样。"
          }
        }
      }
    },
