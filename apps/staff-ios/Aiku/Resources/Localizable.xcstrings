        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O verificare eșuată necesită o notă. Departamentul de achiziții urmărește diferențele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neúspešná kontrola vyžaduje poznámku. Rozdiely rieši nákup."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En underkänd kontroll kräver en anteckning. Inköp följer upp avvikelserna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başarısız bir kontrol için not gerekir. Farkları satın alma ekibi takip eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для невдалої перевірки потрібна примітка. Відділ закупівель опрацює розбіжності."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检查未通过时需要填写备注。采购部会跟进差异。"
          }
        }
      }
    },
    "A location with no stock can’t be chosen. To change which location is the picking location, use Change picking location (needs stock edit rights).": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не може да се избере локация без наличност. За да смените локацията за комплектоване, използвайте Смени локацията за комплектоване (изисква права за редакция на наличности)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umístění bez zásob nelze vybrat. Pro změnu vychystávacího místa použijte Změnit vychystávací místo (vyžaduje oprávnění upravovat zásoby)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Lagerplatz ohne Bestand kann nicht gewählt werden. Um den Kommissionierort zu ändern, nutzen Sie „Kommissionierort ändern“ (erfordert Rechte zum Bearbeiten des Bestands)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede elegir una ubicación sin stock. Para cambiar la ubicación de preparación, use Cambiar ubicación de preparación (requiere permisos para editar stock)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un emplacement sans stock ne peut pas être choisi. Pour changer l’emplacement de préparation, utilisez Changer l’emplacement de préparation (droits de modification du stock requis)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बिना स्टॉक वाली लोकेशन नहीं चुनी जा सकती। पिकिंग लोकेशन बदलने के लिए 'पिकिंग लोकेशन बदलें' का उपयोग करें (स्टॉक संपादन अधिकार चाहिए)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokacija bez zalihe ne može se odabrati. Za promjenu lokacije za branje koristite Promijeni lokaciju za branje (potrebna su prava uređivanja zaliha)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Készlet nélküli hely nem választható. A komissiózási hely módosításához használja a Komissiózási hely módosítása funkciót (készletszerkesztési jog szükséges)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi tanpa stok tidak dapat dipilih. Untuk mengganti lokasi picking, gunakan Ganti lokasi picking (memerlukan hak edit stok)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è possibile scegliere un’ubicazione senza stock. Per cambiare l’ubicazione di prelievo, usi Cambia ubicazione di prelievo (servono i permessi di modifica dello stock)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在庫のないロケーションは選択できません。ピッキングロケーションを変更するには、「ピッキングロケーションを変更」を使用してください（在庫編集権限が必要です）。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vietu bez krājumiem nevar izvēlēties. Lai mainītu komplektēšanas vietu, izmantojiet Mainīt komplektēšanas vietu (nepieciešamas krājumu labošanas tiesības)."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टक नभएको लोकेसन छान्न सकिँदैन। पिकिङ लोकेसन बदल्न 'पिकिङ लोकेसन बदल्नुहोस्' प्रयोग गर्नुहोस् (स्टक सम्पादन अधिकार चाहिन्छ)।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een locatie zonder voorraad kan niet worden gekozen. Gebruik Picklocatie wijzigen om de picklocatie te wijzigen (vereist bewerkrechten voor voorraad)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można wybrać lokalizacji bez zapasów. Aby zmienić lokalizację kompletacji, użyj opcji Zmień lokalizację kompletacji (wymaga uprawnień do edycji zapasów)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível escolher uma localização sem stock. Para mudar a localização de preparação, use Alterar localização de preparação (requer permissões de edição de stock)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O locație fără stoc nu poate fi aleasă. Pentru a schimba locația de cules, folosește Schimbă locația de cules (necesită drepturi de editare a stocului)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokáciu bez zásob nemožno vybrať. Ak chcete zmeniť lokáciu vychystávania, použite Zmeniť lokáciu vychystávania (vyžaduje práva na úpravu zásob)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En lagerplats utan lager kan inte väljas. För att ändra vilken lagerplats som är plockplats, använd Byt plockplats (kräver behörighet att redigera lager)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stoğu olmayan bir lokasyon seçilemez. Toplama lokasyonunu değiştirmek için Toplama lokasyonunu değiştir’i kullanın (stok düzenleme yetkisi gerekir)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Комірку без запасу вибрати не можна. Щоб змінити комірку комплектування, скористайтеся функцією Змінити комірку комплектування (потрібні права на редагування запасів)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无库存的库位无法选择。如需更改拣货库位，请使用“更改拣货库位”（需要库存编辑权限）。"
          }
        }
      }
    },
    "A locked or preferred shipper is chosen for you. Choosing another one asks a supervisor to confirm. If the customer chose the shipper, customer services must change it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заключеният или предпочитаният куриер се избира вместо вас. Изборът на друг изисква потвърждение от супервайзър. Ако клиентът е избрал куриера, обслужване на клиенти трябва да го смени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzamčený nebo preferovaný přepravce se vybere automaticky. Výběr jiného vyžaduje potvrzení vedoucího. Pokud přepravce vybral zákazník, změnit ho musí zákaznický servis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein gesperrter oder bevorzugter Versender wird für Sie gewählt. Wenn Sie einen anderen wählen, muss eine Aufsicht bestätigen. Hat der Kunde den Versender gewählt, muss der Kundendienst ihn ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se elige por usted un transportista bloqueado o preferido. Si elige otro, se pide la confirmación de un supervisor. Si el cliente eligió el transportista, debe cambiarlo atención al cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un transporteur verrouillé ou préféré est choisi pour vous. En choisir un autre demande la confirmation d'un superviseur. Si le client a choisi le transporteur, c'est le service client qui doit le changer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लॉक या पसंदीदा कूरियर आपके लिए चुना जाता है। कोई दूसरा चुनने पर पर्यवेक्षक से पुष्टि माँगी जाती है। अगर ग्राहक ने कूरियर चुना है, तो ग्राहक सेवा को इसे बदलना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaključani ili preferirani prijevoznik odabire se za vas. Odabir drugoga traži potvrdu nadzornika. Ako je kupac odabrao prijevoznika, mora ga promijeniti korisnička služba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A zárolt vagy előnyben részesített futárszolgálat automatikusan ki van választva. Másik választásához felettesi jóváhagyás kell. Ha az ügyfél választotta a futárszolgálatot, csak az ügyfélszolgálat módosíthatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekspedisi yang terkunci atau diutamakan dipilihkan untuk Anda. Memilih yang lain memerlukan konfirmasi pengawas. Jika pelanggan yang memilih ekspedisi, layanan pelanggan yang harus mengubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viene scelto per Lei un corriere bloccato o preferito. Sceglierne un altro richiede la conferma di un supervisore. Se il corriere l'ha scelto il cliente, deve cambiarlo il servizio clienti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ロックされた配送業者または優先配送業者が自動で選ばれます。別の業者を選ぶと責任者の確認が必要です。顧客が配送業者を指定した場合は、カスタマーサービスが変更する必要があります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloķēts vai vēlamais pārvadātājs tiek izvēlēts automātiski. Ja izvēlaties citu, to jāapstiprina vadītājam. Ja pārvadātāju izvēlējās klients, to jāmaina klientu apkalpošanai."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लक गरिएको वा रुचाइएको ढुवानीकर्ता तपाईंका लागि छानिन्छ। अर्को छान्दा सुपरभाइजरलाई पुष्टि गर्न अनुरोध गरिन्छ। ग्राहकले ढुवानीकर्ता छानेको भए, ग्राहक सेवाले यसलाई परिवर्तन गर्नुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een vergrendelde of voorkeursverzender wordt voor je gekozen. Kies je een andere, dan moet een leidinggevende dat bevestigen. Als de klant de verzender heeft gekozen, moet de klantenservice die wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zablokowany lub preferowany przewoźnik jest wybierany automatycznie. Wybór innego wymaga potwierdzenia przez kierownika. Jeśli przewoźnika wybrał klient, zmienić go musi obsługa klienta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma transportadora bloqueada ou preferida é escolhida por si. Escolher outra pede a confirmação de um supervisor. Se o cliente escolheu a transportadora, tem de ser o apoio ao cliente a mudá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un transportator blocat sau preferat este ales pentru dvs. Alegerea altuia necesită confirmarea unui supervizor. Dacă transportatorul a fost ales de client, serviciul clienți trebuie să îl schimbe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzamknutý alebo preferovaný prepravca sa vyberie automaticky. Výber iného vyžaduje potvrdenie vedúceho. Ak prepravcu vybral zákazník, zmeniť ho musí zákaznícky servis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ett låst eller föredraget fraktbolag väljs åt dig. Om du väljer ett annat måste en arbetsledare bekräfta. Om kunden valde fraktbolaget måste kundtjänst ändra det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kilitli veya tercih edilen kargo firması sizin için seçilir. Başka bir firma seçerseniz bir süpervizörün onaylaması gerekir. Kargo firmasını müşteri seçtiyse müşteri hizmetlerinin değiştirmesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заблокованого або бажаного перевізника вибрано за вас. Якщо вибрати іншого, супервайзер має це підтвердити. Якщо перевізника вибрав клієнт, змінити його може лише служба підтримки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已锁定或首选的承运商会自动为您选择。选择其他承运商需要主管确认。如果承运商由客户选择，则必须由客服更改。"
          }
        }
      }
    },
    "A part of a set sold only complete was not found": {
