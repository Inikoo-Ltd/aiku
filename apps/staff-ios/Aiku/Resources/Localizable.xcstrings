    "Mark it as received when it arrives at goods in. Checking starts after that. Needs goods-in edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Маркирайте го като получено, когато пристигне в приемане на стока. След това започва проверката. Изисква права за редакция в приемане на стока."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označte ji jako přijatou, až dorazí na příjem zboží. Poté začne kontrola. Vyžaduje oprávnění upravovat příjem zboží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markieren Sie sie als erhalten, wenn sie im Wareneingang ankommt. Danach beginnt die Prüfung. Erfordert Rechte zum Bearbeiten des Wareneingangs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Márquela como recibida cuando llegue a recepción de mercancías. La comprobación empieza después. Requiere permisos de edición de recepción de mercancías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marquez-la comme reçue à son arrivée à la réception des marchandises. La vérification commence ensuite. Nécessite les droits de modification de la réception."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "माल प्राप्ति पर पहुँचने पर इसे प्राप्त के रूप में चिह्नित करें। उसके बाद जाँच शुरू होती है। माल प्राप्ति संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označite je kao primljenu kada stigne na ulaz robe. Provjera počinje nakon toga. Potrebna su prava uređivanja ulaza robe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jelölje beérkezettnek, amikor megérkezik az áruátvételhez. Ezután kezdődik az ellenőrzés. Áruátvételi szerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tandai sebagai diterima saat tiba di barang masuk. Pemeriksaan dimulai setelah itu. Memerlukan hak edit barang masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo segni come ricevuto quando arriva al ricevimento merci. Il controllo inizia dopo. Richiede i permessi di modifica del ricevimento merci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入荷に到着したら受領済みにしてください。その後確認が始まります。入荷編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atzīmējiet to kā saņemtu, kad tas pienāk preču pieņemšanā. Pēc tam sākas pārbaude. Nepieciešamas preču pieņemšanas labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सामान प्राप्तिमा आइपुगेपछि यसलाई प्राप्त भनी चिन्ह लगाउनुहोस्। त्यसपछि जाँच सुरु हुन्छ। सामान प्राप्ति सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markeer het als ontvangen wanneer het bij Goederen in aankomt. Daarna begint het controleren. Vereist bewerkrechten voor Goederen in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oznacz jako otrzymaną, gdy dotrze do przyjęcia towarów. Potem rozpocznie się sprawdzanie. Wymaga uprawnień do edycji przyjęć towarów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marque-a como recebida quando chegar à receção de mercadorias. A verificação começa depois disso. Requer permissões de edição da receção de mercadorias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marchează-o ca primită când ajunge la intrarea de mărfuri. Verificarea începe după aceea. Necesită drepturi de editare pentru intrări de mărfuri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označte ju ako prijatú, keď dorazí na príjem tovaru. Potom sa začne kontrola. Vyžaduje práva na úpravu príjmu tovaru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markera den som mottagen när den kommer till varor in. Kontrollen börjar efter det. Kräver redigeringsbehörighet för varor in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mal kabule ulaştığında teslim alındı olarak işaretleyin. Kontrol bundan sonra başlar. Mal kabul düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позначте як отримане, коли воно надійде на приймання товарів. Після цього починається перевірка. Потрібні права на редагування приймання товарів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "到达入库区时将其标记为已收到。之后开始检查。需要入库编辑权限。"
          }
        }
      }
    },
