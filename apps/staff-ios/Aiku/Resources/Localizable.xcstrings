    "Booked in. Purchasing sets it as placed when costing starts.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заприходено. Отдел „Покупки“ го маркира като складирано, когато започне калкулирането на разходите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskladněno. Nákup ho označí jako umístěné, jakmile začne kalkulace nákladů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eingebucht. Der Einkauf setzt sie auf eingelagert, wenn die Kostenkalkulation beginnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entrada registrada. Compras la marca como ubicada cuando empieza el cálculo de costes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réceptionné. Les achats le marquent comme rangé au début du calcul des coûts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बुक इन हो गया। लागत निर्धारण शुरू होने पर खरीद विभाग इसे रखा गया के रूप में सेट करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rezervirano. Nabava ga postavlja kao uskladišteno kada počne obračun troškova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bevételezve. A beszerzés akkor állítja elhelyezettre, amikor a költségszámítás elkezdődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sudah masuk stok. Bagian pembelian menandainya sebagai ditempatkan saat perhitungan biaya dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registrato in magazzino. L’ufficio acquisti lo imposta come sistemato quando inizia il calcolo dei costi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入庫済みです。原価計算が始まると購買が格納済みに設定します。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pieņemts noliktavā. Iepirkumu nodaļa to atzīmē kā novietotu, kad sākas izmaksu aprēķins."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टकमा दर्ता भयो। लागत गणना सुरु हुँदा खरिद विभागले यसलाई राखिएको रूपमा सेट गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingeboekt. Inkoop zet het op geplaatst wanneer de kostprijsberekening begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przyjęte na stan. Dział zakupów oznaczy je jako rozlokowane, gdy rozpocznie się kalkulacja kosztów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rececionado. As Compras marcam-no como armazenado quando o custeio começa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recepționat în stoc. Achizițiile îl marchează ca Depozitat când începe calculul costurilor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskladnené. Nákup ju označí ako umiestnenú, keď začne kalkulácia nákladov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bokat in. Inköp markerar den som placerad när kostnadsberäkningen börjar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stoğa alındı. Maliyetlendirme başladığında satın alma ekibi yerleştirildi olarak işaretler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оприбутковано. Відділ закупівель позначить її як розміщену, коли почнеться калькуляція."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已入库。采购部开始核算成本时会将其设为已上架。"
          }
        }
      }
    },
    "Booked-in pallets start storing at their locations. Pallets set as not received stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заприходените палети започват да се съхраняват в своите локации. Палетите, маркирани като неполучени, остават без промяна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskladněné palety se začnou skladovat ve svých umístěních. Palety označené jako nepřijaté zůstanou beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eingebuchte Paletten werden an ihren Lagerplätzen eingelagert. Als nicht erhalten markierte Paletten bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los palets con entrada registrada empiezan a almacenarse en sus ubicaciones. Los palets marcados como no recibidos quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les palettes réceptionnées passent en stockage à leurs emplacements. Les palettes marquées comme non reçues restent inchangées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बुक इन किए गए पैलेट अपनी लोकेशन पर भंडारण में चले जाते हैं। प्राप्त नहीं हुआ के रूप में सेट पैलेट जैसे हैं वैसे ही रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rezervirane palete počinju se pohranjivati na svojim lokacijama. Palete označene kao neprimljene ostaju kakve jesu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A bevételezett raklapok a helyükön tárolásba kerülnek. A nem beérkezettként jelölt raklapok változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palet yang sudah masuk stok mulai disimpan di lokasinya. Palet yang ditandai tidak diterima tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I pallet registrati in magazzino passano in conservazione nelle loro ubicazioni. I pallet impostati come non ricevuti restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入庫済みのパレットは各ロケーションで保管が始まります。未受領に設定されたパレットはそのままです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pieņemtās paletes sāk uzglabāt to vietās. Paletes, kas atzīmētas kā nesaņemtas, paliek nemainīgas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टकमा दर्ता गरिएका प्यालेटहरू आफ्नो लोकेसनमा भण्डारण हुन थाल्छन्। प्राप्त नभएको भनी सेट गरिएका प्यालेटहरू जस्ताको तस्तै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingeboekte pallets worden opgeslagen op hun locaties. Pallets die als niet ontvangen zijn gemarkeerd, blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palety przyjęte na stan zaczynają być przechowywane w swoich lokalizacjach. Palety oznaczone jako nieotrzymane pozostają bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As paletes rececionadas passam a ficar armazenadas nas suas localizações. As paletes marcadas como não recebidas ficam como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleții recepționați în stoc intră în depozitare în locațiile lor. Paleții marcați ca nerecepționați rămân neschimbați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskladnené palety sa začnú skladovať na svojich lokáciách. Palety označené ako neprijaté zostanú bez zmeny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inbokade pallar börjar lagras på sina lagerplatser. Pallar markerade som ej mottagna förblir oförändrade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stoğa alınan paletler lokasyonlarında depolanmaya başlar. Teslim alınmadı olarak işaretlenen paletler olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оприбутковані палети починають зберігатися у своїх комірках. Палети, позначені як не отримані, залишаються без змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已入库的托盘会在其库位开始存储。设为未收到的托盘保持不变。"
          }
        }
      }
    },
