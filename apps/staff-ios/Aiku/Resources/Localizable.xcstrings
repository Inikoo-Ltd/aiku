    "No clocking method is currently enabled for your organisation. Please contact HR.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vaši organizaci není momentálně povolena žádná metoda sledování času. Kontaktujte prosím personální oddělení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Ihre Organisation ist derzeit keine Zeiterfassungsmethode aktiviert. Bitte wenden Sie sich an die Personalabteilung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente no hay ningún método de fichaje activado para su organización. Póngase en contacto con Recursos Humanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune méthode de pointage n'est actuellement activée pour votre organisation. Veuillez contacter les RH."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संगठन के लिए अभी कोई हाज़िरी विधि सक्षम नहीं है। कृपया HR से संपर्क करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za vašu organizaciju trenutačno nije omogućen nijedan način evidentiranja. Obratite se HR-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szervezetében jelenleg nincs engedélyezve blokkolási mód. Forduljon a HR-hez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini tidak ada metode absensi yang diaktifkan untuk organisasi Anda. Silakan hubungi HR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è abilitato alcun metodo di timbratura per la sua organizzazione. Contatti le risorse umane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在、組織で有効な打刻方法がありません。人事部に連絡してください。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको संस्थाका लागि हाल कुनै क्लकिङ विधि सक्षम छैन। कृपया HR लाई सम्पर्क गर्नुहोस्।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Twojej organizacji nie jest obecnie włączona żadna metoda rejestracji czasu pracy. Skontaktuj się z działem HR."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum método de registo de ponto está atualmente ativo para a sua organização. Contacte os RH."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio metodă de pontaj nu este activată în prezent pentru organizația dvs. Vă rugăm să contactați departamentul de resurse umane."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vašu organizáciu nie je momentálne povolený žiadny spôsob zaznamenávania dochádzky. Kontaktujte personálne oddelenie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizasyonunuz için şu anda etkin bir puantaj yöntemi yok. Lütfen İK ile iletişime geçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的组织目前未启用任何打卡方式。请联系人力资源部。"
          }
        }
      }
    },
