    "Links removed by the hourly run because the SKO ran out in that location.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Връзки, премахнати от ежечасната проверка, защото SKO е свършило в тази локация."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Propojení odebraná hodinovým během, protože SKO v daném umístění došlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verknüpfungen, die der stündliche Lauf entfernt hat, weil die SKO an diesem Lagerplatz aufgebraucht war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vínculos eliminados por el proceso horario porque el SKO se agotó en esa ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liens retirés par le traitement horaire parce que le SKO était épuisé dans cet emplacement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रति घंटा चलने वाली प्रक्रिया द्वारा हटाए गए लिंक, क्योंकि उस लोकेशन में SKO खत्म हो गया था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veze uklonjene satnim pokretanjem jer je SKO-a ponestalo na toj lokaciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az óránkénti futás által eltávolított kapcsolatok, mert az SKO elfogyott azon a helyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tautan yang dihapus oleh proses per jam karena SKO habis di lokasi tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collegamenti rimossi dall’elaborazione oraria perché lo SKO si è esaurito in quell’ubicazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "そのロケーションでSKOがなくなったため、毎時の処理で削除された紐付け。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saites, ko noņēma ikstundas apstrāde, jo SKO šajā vietā beidzās."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्यो लोकेसनमा SKO सकिएकाले प्रतिघण्टा चल्ने प्रक्रियाले हटाएका लिङ्कहरू।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppelingen die door de uurlijkse run zijn verwijderd omdat de SKO op die locatie op was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Powiązania usunięte przez cogodzinne zadanie, ponieważ SKO skończyło się w tej lokalizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ligações removidas pelo processo horário porque o SKO esgotou nessa localização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legături eliminate de rularea orară deoarece SKO-ul s-a epuizat în acea locație."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepojenia odstránené hodinovým behom, pretože SKO v danej lokácii došlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopplingar som togs bort av den timvisa körningen eftersom SKO:n tog slut på den lagerplatsen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO o lokasyonda tükendiği için saatlik çalıştırmayla kaldırılan bağlantılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зв’язки, видалені щогодинним запуском, бо SKO закінчився в цій комірці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "因该库位中的 SKO 已用完而被每小时任务移除的关联。"
          }
        }
      }
    },
