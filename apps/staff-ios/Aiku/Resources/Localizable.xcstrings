    "Dispatch needs every customer insert printed and, unless the customer collects, a shipment.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За изпращане трябва всички вложки за клиента да са отпечатани и, освен ако клиентът не го взема лично, да има пратка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "K odeslání musí být vytištěny všechny vložky zákazníka a, pokud si zákazník zboží nevyzvedne, musí existovat zásilka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für den Versand müssen alle Kundenbeilagen gedruckt sein und, sofern der Kunde nicht selbst abholt, eine Sendung vorhanden sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para expedir es necesario imprimir todos los insertos del cliente y, salvo que recoja el cliente, un envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'envoi nécessite que tous les encarts client soient imprimés et, sauf retrait par le client, une expédition."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डिस्पैच के लिए हर ग्राहक इन्सर्ट प्रिंट होना चाहिए और, जब तक ग्राहक स्वयं न ले जाए, एक शिपमेंट होना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za otpremu svi umetci kupca moraju biti ispisani i, osim ako kupac sam preuzima, potrebna je pošiljka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A feladáshoz minden ügyfélbetétet ki kell nyomtatni, és – ha nem az ügyfél viszi el – szállítmány is kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengiriman memerlukan semua sisipan pelanggan sudah dicetak dan, kecuali pelanggan mengambil sendiri, sebuah kiriman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per spedire servono tutti gli inserti cliente stampati e, salvo ritiro da parte del cliente, una spedizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "出荷するには、すべての顧客同梱物を印刷し、顧客引き取りでない場合は配送も必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nosūtīšanai jābūt izdrukātiem visiem klienta ieliktņiem un, ja vien klients neizņem pats, jābūt sūtījumam."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पठाउनका लागि सबै ग्राहक इन्सर्टहरू प्रिन्ट भएको हुनुपर्छ र, ग्राहक आफैँ नलैजाने भए, ढुवानी चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voor verzending moeten alle klantbijlagen zijn afgedrukt en, tenzij de klant ophaalt, moet er een zending zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysyłka wymaga wydrukowania wszystkich wkładek klienta oraz przesyłki, chyba że klient odbiera osobiście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A expedição exige todos os encartes do cliente impressos e, salvo se o cliente recolher, um envio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Expedierea necesită tipărirea tuturor inserțiilor clientului și, cu excepția cazului în care clientul ridică, o expediție."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na odoslanie musia byť vytlačené všetky vložky zákazníka a, ak si zákazník tovar nevyzdvihne, musí existovať zásielka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "För utleverans måste alla kundbilagor vara utskrivna och, om inte kunden hämtar, en försändelse finnas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sevkiyat için tüm müşteri eklerinin yazdırılmış olması ve müşteri kendisi teslim almıyorsa bir gönderi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для відправлення потрібно надрукувати всі вкладиші клієнта та, якщо клієнт не забирає сам, додати відвантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发货前须打印所有客户插页，并且除客户自提外还需添加货件。"
          }
        }
      }
    },
