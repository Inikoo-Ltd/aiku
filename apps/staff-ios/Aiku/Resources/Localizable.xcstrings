    "Checked quantities match the delivered quantities so far.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверените количества засега съвпадат с доставените."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
