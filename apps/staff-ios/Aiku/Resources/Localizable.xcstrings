    "slow is smooth, smooth is fast.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "бавното е гладко, гладкото е бързо."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "pomalu je plynule, plynule je rychle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "langsam ist sauber, sauber ist schnell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "despacio es fluido, fluido es rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lent, c’est fluide ; fluide, c’est rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "धीमा मतलब सहज, सहज मतलब तेज़।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "polako je glatko, glatko je brzo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "a lassú egyenletes, az egyenletes gyors."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "pelan berarti lancar, lancar berarti cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lento è fluido, fluido è veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ゆっくりは確実、確実は速い。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lēni ir vienmērīgi, vienmērīgi ir ātri."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बिस्तारै भनेको सहज, सहज भनेको छिटो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "langzaam is soepel, soepel is snel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "powoli znaczy płynnie, płynnie znaczy szybko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "devagar é fluido, fluido é rápido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "încet înseamnă lin, lin înseamnă rapid."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "pomaly je plynulo, plynulo je rýchlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "långsamt är smidigt, smidigt är snabbt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "yavaş olan akıcıdır, akıcı olan hızlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "повільно — це плавно, плавно — це швидко."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "慢即是稳，稳即是快。"
          }
        }
      }
    },
    "small things, sent far, arrive as big things.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "малките неща, изпратени далеч, пристигат като големи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "malé věci poslané daleko dorazí jako velké věci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kleine Dinge, weit verschickt, kommen als große an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "las cosas pequeñas, enviadas lejos, llegan como cosas grandes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "les petites choses, envoyées loin, arrivent comme de grandes choses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "छोटी चीज़ें, दूर भेजी जाएँ, तो बड़ी बनकर पहुँचती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "male stvari, poslane daleko, stižu kao velike stvari."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "a messzire küldött apróságok nagy dologként érkeznek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "hal kecil, dikirim jauh, tiba sebagai hal besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "le piccole cose, spedite lontano, arrivano come grandi cose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "小さなものも、遠くへ送れば大きなものとして届く。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "mazas lietas, sūtītas tālu, pienāk kā lielas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "साना कुराहरू, टाढा पठाइँदा, ठूला बनेर पुग्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kleine dingen, ver verstuurd, komen aan als grote dingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "małe rzeczy wysłane daleko docierają jako wielkie rzeczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "as coisas pequenas, enviadas para longe, chegam como coisas grandes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lucrurile mici, trimise departe, ajung ca lucruri mari."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "malé veci poslané ďaleko dorazia ako veľké veci."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "små saker, skickade långt, kommer fram som stora saker."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "uzağa gönderilen küçük şeyler, büyük şeyler olarak varır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "маленькі речі, надіслані далеко, приходять як великі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "小小的物件，寄往远方，便成了大大的心意。"
          }
        }
      }
    },
