    "Aiku needs the camera to scan barcodes. Turn it on in your phone settings, or use a scanner device instead.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku се нуждае от камерата, за да сканира баркодове. Включете я в настройките на телефона или използвайте скенер."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku potřebuje fotoaparát ke skenování čárových kódů. Zapněte ho v nastavení telefonu, nebo použijte skener."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku braucht die Kamera, um Barcodes zu scannen. Aktivieren Sie sie in den Telefoneinstellungen oder verwenden Sie stattdessen einen Scanner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku necesita la cámara para escanear códigos de barras. Actívela en los ajustes del teléfono o use un escáner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku a besoin de l’appareil photo pour scanner les codes-barres. Activez-le dans les réglages du téléphone, ou utilisez plutôt un scanner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बारकोड स्कैन करने के लिए Aiku को कैमरा चाहिए। इसे फ़ोन की सेटिंग्स में चालू करें, या इसके बजाय स्कैनर डिवाइस का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku treba kameru za skeniranje barkodova. Uključite je u postavkama telefona ili umjesto toga koristite skener."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Aikunak szüksége van a kamerára a vonalkódok szkenneléséhez. Kapcsolja be a telefon beállításaiban, vagy használjon helyette szkennereszközt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku memerlukan kamera untuk memindai barcode. Aktifkan di pengaturan ponsel Anda, atau gunakan perangkat pemindai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku ha bisogno della fotocamera per scansionare i codici a barre. La attivi nelle impostazioni del telefono oppure usi uno scanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aikuでバーコードをスキャンするにはカメラが必要です。スマートフォンの設定でオンにするか、スキャナー端末を使用してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku vajag kameru, lai skenētu svītrkodus. Ieslēdziet to tālruņa iestatījumos vai izmantojiet skenera ierīci."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बारकोड स्क्यान गर्न Aiku लाई क्यामेरा चाहिन्छ। फोनको सेटिङमा यसलाई सक्रिय गर्नुहोस्, वा यसको सट्टा स्क्यानर उपकरण प्रयोग गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku heeft de camera nodig om barcodes te scannen. Zet deze aan in de instellingen van je telefoon of gebruik een scanner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku potrzebuje aparatu do skanowania kodów kreskowych. Włącz go w ustawieniach telefonu lub użyj skanera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Aiku precisa da câmara para ler códigos de barras. Ative-a nas definições do telemóvel ou use um leitor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku are nevoie de cameră pentru a scana coduri de bare. Activeaz-o din setările telefonului sau folosește un scaner."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku potrebuje fotoaparát na skenovanie čiarových kódov. Zapnite ho v nastaveniach telefónu alebo namiesto toho použite skener."
          }
        },
        "sv": {
          "stringUnit": {
