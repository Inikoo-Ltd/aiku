          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रतीक्षारत लाइनहरूसहित पिकिङ सकिँदा डेलिभरी नोट 'प्रतीक्षामा' सर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als het picken eindigt met wachtende regels, gaat de pakbon naar Wachtend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy kompletacja kończy się z oczekującymi pozycjami, dowód dostawy przechodzi do statusu Oczekuje."
          }
        },
        "pt": {
          "stringUnit": {
