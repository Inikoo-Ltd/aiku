    "The weight must be above 0 and at most 1000 kg.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Теглото трябва да е над 0 и най-много 1000 kg."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hmotnost musí být větší než 0 a nejvýše 1000 kg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Gewicht muss über 0 und höchstens 1000 kg sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El peso debe ser mayor que 0 y como máximo de 1000 kg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le poids doit être supérieur à 0 et d’au plus 1000 kg."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वज़न 0 से अधिक और अधिकतम 1000 kg होना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Težina mora biti veća od 0 i najviše 1000 kg."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A súlynak 0-nál nagyobbnak és legfeljebb 1000 kg-nak kell lennie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berat harus lebih dari 0 dan paling banyak 1000 kg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il peso deve essere superiore a 0 e al massimo di 1000 kg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重量は0より大きく、1000 kg以下にしてください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaram jābūt lielākam par 0 un ne vairāk kā 1000 kg."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तौल 0 भन्दा बढी र बढीमा 1000 kg हुनुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
