        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Când comanda nu are încă factură"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keď objednávka ešte nemá faktúru"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När ordern inte har någon faktura ännu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siparişin henüz faturası yoksa"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коли для замовлення ще немає рахунку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当订单尚未开具发票时"
          }
        }
      }
    },
    "When work is assigned to you, taken over, cancelled or changed, you’ll see it here.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когато работа ви бъде възложена, поета, отказана или променена, ще я видите тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Když vám bude práce přiřazena, převzata, zrušena nebo změněna, uvidíte to zde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn Ihnen Arbeit zugewiesen, übernommen, storniert oder geändert wird, sehen Sie es hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando se le asigne trabajo, se le quite, se cancele o cambie, lo verá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lorsqu’un travail vous est attribué, repris, annulé ou modifié, vous le verrez ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब कोई काम आपको असाइन किया जाता है, आपसे ले लिया जाता है, रद्द किया जाता है या बदला जाता है, तो आप उसे यहाँ देखेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada vam se posao dodijeli, preuzme, otkaže ili promijeni, vidjet ćete to ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Itt látja, ha feladatot rendelnek Önhöz, átveszik, törlik vagy módosítják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika pekerjaan ditugaskan kepada Anda, diambil alih, dibatalkan, atau diubah, Anda akan melihatnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qui vedrà quando un lavoro le viene assegnato, preso in carico, annullato o modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "作業が割り当てられたり、引き継がれたり、取り消されたり、変更されたりすると、ここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kad jums tiek piešķirts, pārņemts, atcelts vai mainīts darbs, jūs to redzēsiet šeit."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "काम तपाईंलाई तोकिँदा, अरूले लिँदा, रद्द हुँदा वा परिवर्तन हुँदा यहाँ देख्नुहुनेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wanneer werk aan je wordt toegewezen, wordt overgenomen, geannuleerd of gewijzigd, zie je dat hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy praca zostanie Ci przypisana, przejęta, anulowana lub zmieniona, zobaczysz to tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando lhe for atribuído trabalho, ou quando for assumido, cancelado ou alterado, verá isso aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Când ți se atribuie, ți se preia, se anulează sau se modifică o activitate, o vei vedea aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keď vám bude práca priradená, prevzatá, zrušená alebo zmenená, uvidíte to tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När arbete tilldelas dig, tas över, avbryts eller ändras ser du det här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Size iş atandığında, devralındığında, iptal edildiğinde veya değiştiğinde burada görürsünüz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коли роботу вам призначать, передадуть іншому, скасують або змінять, ви побачите це тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当工作被分配给你、被接管、取消或更改时，会显示在这里。"
          }
        }
      }
    },
    "Where does it go?": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Къде отива?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kam to patří?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wohin kommt es?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Dónde va?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Où va-t-il ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह कहाँ जाता है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamo ide?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hová kerül?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ke mana barang ini ditempatkan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dove va?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どこに入れますか？"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kur tas jānovieto?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो कहाँ जान्छ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waar moet het heen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdzie to trafia?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para onde vai?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unde merge?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kam to patrí?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vart ska den?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nereye gidiyor?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Куди це покласти?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要放到哪里？"
          }
        }
      }
    },
    "While any insert is unprinted, Finalise is blocked: “Print every insert before continuing”. If the carrier refuses, the label error shows its answer.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Докато има неотпечатана вложка, Финализиране е блокирано: „Отпечатайте всички вложки, преди да продължите“. Ако превозвачът откаже, грешката на етикета показва отговора му."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dokud je některá vložka nevytištěná, Finalizovat je zablokováno: “Před pokračováním vytiskněte všechny vložky”. Pokud přepravce odmítne, chyba štítku zobrazí jeho odpověď."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solange ein Einleger nicht gedruckt ist, ist Abschließen gesperrt: „Drucken Sie alle Einleger aus, bevor Sie fortfahren.“ Lehnt der Versanddienstleister ab, zeigt der Etikettfehler seine Antwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mientras haya algún inserto sin imprimir, Finalizar está bloqueado: “Imprima todos los insertos antes de continuar”. Si el transportista lo rechaza, el error de la etiqueta muestra su respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tant qu’un encart n’est pas imprimé, Finaliser est bloqué : « Imprimez tous les encarts avant de continuer ». Si le transporteur refuse, l’erreur d’étiquette affiche sa réponse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब तक कोई इंसर्ट प्रिंट नहीं हुआ है, अंतिम रूप देना अवरुद्ध रहता है: “जारी रखने से पहले हर इंसर्ट प्रिंट करें”। अगर कूरियर मना करता है, तो लेबल त्रुटि उसका जवाब दिखाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dok god neki umetak nije ispisan, Finaliziraj je blokirano: „Ispišite sve umetke prije nastavka”. Ako prijevoznik odbije, pogreška naljepnice prikazuje njegov odgovor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Amíg van nem nyomtatott betétlap, a Véglegesítés blokkolva van: „Folytatás előtt nyomtasson ki minden betétlapot”. Ha a fuvarozó elutasítja, a címkehiba mutatja a válaszát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selama masih ada sisipan yang belum dicetak, Selesaikan diblokir: “Cetak setiap sisipan sebelum melanjutkan”. Jika kurir menolak, kesalahan label menampilkan jawabannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finché un inserto non è stampato, Finalizza è bloccato: “Stampi tutti gli inserti prima di continuare”. Se il corriere rifiuta, l’errore dell’etichetta mostra la sua risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未印刷の同梱物がある間は確定がブロックされます：「続行する前にすべての同梱物を印刷してください」。配送業者が拒否した場合は、ラベルエラーにその応答が表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamēr kāds ieliktnis nav izdrukāts, Pabeigt ir bloķēts: “Pirms turpināt, izdrukājiet visus ieliktņus”. Ja pārvadātājs atsaka, etiķetes kļūda rāda tā atbildi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुनै इन्सर्ट प्रिन्ट नभएसम्म अन्तिम रूप दिने अवरुद्ध हुन्छ: “अगाडि बढ्नुअघि हरेक इन्सर्ट प्रिन्ट गर्नुहोस्”। ढुवानीकर्ताले अस्वीकार गरेमा, लेबल त्रुटिले उसको जवाफ देखाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zolang een insert niet is afgedrukt, is Afronden geblokkeerd: “Druk alle inserts af voordat je verdergaat”. Als de vervoerder weigert, toont de labelfout het antwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopóki jakakolwiek wkładka nie jest wydrukowana, Zakończ jest zablokowane: “Wydrukuj wszystkie wkładki przed kontynuowaniem”. Jeśli przewoźnik odmówi, błąd etykiety pokaże jego odpowiedź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enquanto houver um folheto por imprimir, Finalizar fica bloqueado: “Imprima todos os folhetos antes de continuar”. Se a transportadora recusar, o erro da etiqueta mostra a resposta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cât timp un insert nu este tipărit, Finalizarea este blocată: „Tipărește fiecare insert înainte de a continua”. Dacă transportatorul refuză, eroarea etichetei afișează răspunsul lui."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kým je niektorá príloha nevytlačená, Finalizovať je zablokované: „Pred pokračovaním vytlačte všetky prílohy“. Ak prepravca odmietne, chyba štítka zobrazí jeho odpoveď."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Så länge någon bilaga inte är utskriven är Slutför blockerad: ”Skriv ut alla bilagor innan du fortsätter”. Om transportören nekar visar etikettfelet deras svar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yazdırılmamış bir ek varken Kesinleştir engellenir: “Devam etmeden önce tüm ekleri yazdırın”. Kargo firması reddederse etiket hatası yanıtını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поки будь-яку вкладку не надруковано, Фіналізувати заблоковано: «Надрукуйте всі вкладки, перш ніж продовжити». Якщо перевізник відмовляє, помилка етикетки показує його відповідь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只要有插页未打印，就无法完成：“继续前请打印所有插页”。如果承运商拒绝，标签错误会显示其回复。"
          }
        }
      }
    },
