        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सुविधानुसार इसे इंस्टॉल करने के लिए अपने पर्यवेक्षक से कहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamolite nadzornika da je instalira kad mu odgovara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kérje meg a felettesét, hogy telepítse, amikor alkalmas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minta pengawas Anda untuk memasangnya saat ada waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chieda al suo supervisore di installarla quando possibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "都合のよいときにインストールするよう、責任者に依頼してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lūdziet savam vadītājam to instalēt, kad ērti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सुविधा अनुसार यसलाई इन्स्टल गर्न आफ्नो सुपरभाइजरलाई भन्नुहोस्।"
