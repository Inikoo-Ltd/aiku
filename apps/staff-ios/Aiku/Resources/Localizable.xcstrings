    "Stock actions need stock edit rights. Move stock needs at least two locations.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Действията с наличности изискват права за редакция на наличности. Премести наличност изисква поне две локации."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akce se zásobami vyžadují oprávnění upravovat zásoby. Přesun zásob vyžaduje alespoň dvě umístění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bestandsaktionen erfordern Rechte zum Bearbeiten des Bestands. Bestand verschieben braucht mindestens zwei Lagerplätze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las acciones de stock requieren permisos de edición de stock. Mover stock requiere al menos dos ubicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les actions sur le stock nécessitent les droits de modification du stock. Déplacer du stock nécessite au moins deux emplacements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टॉक कार्रवाइयों के लिए स्टॉक संपादन अधिकार चाहिए। स्टॉक ले जाने के लिए कम से कम दो लोकेशन चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radnje sa zalihom zahtijevaju prava uređivanja zaliha. Premještanje zalihe zahtijeva barem dvije lokacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A készletműveletekhez készletszerkesztési jog szükséges. A készlet áthelyezéséhez legalább két hely kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aksi stok memerlukan hak edit stok. Memindahkan stok memerlukan minimal dua lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le azioni sullo stock richiedono i permessi di modifica dello stock. Per spostare lo stock servono almeno due ubicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在庫の操作には在庫編集権限が必要です。在庫の移動には2か所以上のロケーションが必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krājumu darbībām nepieciešamas krājumu labošanas tiesības. Krājumu pārvietošanai nepieciešamas vismaz divas vietas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टक कार्यहरूका लागि स्टक सम्पादन अधिकार चाहिन्छ। स्टक सार्न कम्तीमा दुई लोकेसन चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voorraadacties vereisen bewerkrechten voor voorraad. Voorraad verplaatsen vereist minstens twee locaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akcje zapasów wymagają uprawnień do edycji zapasów. Przeniesienie zapasów wymaga co najmniej dwóch lokalizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As ações de stock requerem permissões de edição de stock. Mover stock requer pelo menos duas localizações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acțiunile de stoc necesită drepturi de editare a stocului. Mutarea stocului necesită cel puțin două locații."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akcie zásob vyžadujú práva na úpravu zásob. Presun zásob vyžaduje aspoň dve lokácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lageråtgärder kräver behörighet att redigera lager. Flytta lager kräver minst två lagerplatser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stok işlemleri için stok düzenleme yetkisi gerekir. Stok taşımak için en az iki lokasyon gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для дій із запасами потрібні права на редагування запасів. Для переміщення запасу потрібно щонайменше дві комірки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "库存操作需要库存编辑权限。移动库存至少需要两个库位。"
          }
        }
      }
    },
