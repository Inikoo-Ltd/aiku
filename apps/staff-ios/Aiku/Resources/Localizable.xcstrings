          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytować można tylko oczekujące wnioski o nadgodziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só os pedidos de horas extra pendentes podem ser editados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar cererile de ore suplimentare în așteptare pot fi editate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravovať je možné iba čakajúce žiadosti o nadčasy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast väntande övertidsförfrågningar kan redigeras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bekleyen fazla mesai talepleri düzenlenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна редагувати лише запити на понаднормову роботу, що очікують розгляду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能编辑待处理的加班申请。"
          }
        }
      }
    },
    "Only shown when your organisation has active shifts. Otherwise the camera opens straight away.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показва се само когато организацията ви има активни смени. В противен случай камерата се отваря веднага."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zobrazí se jen tehdy, když má vaše organizace aktivní směny. Jinak se fotoaparát otevře hned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird nur angezeigt, wenn Ihre Organisation aktive Schichten hat. Andernfalls öffnet sich die Kamera sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo se muestra cuando su organización tiene turnos activos. Si no, la cámara se abre directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiché uniquement si votre organisation a des horaires actifs. Sinon, l’appareil photo s’ouvre directement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल तभी दिखता है जब आपके संगठन में सक्रिय शिफ़्ट हों। नहीं तो कैमरा सीधे खुल जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazuje se samo kada vaša organizacija ima aktivne smjene. Inače se kamera odmah otvara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csak akkor jelenik meg, ha a szervezetében vannak aktív műszakok. Különben a kamera azonnal megnyílik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hanya ditampilkan jika organisasi Anda memiliki shift aktif. Jika tidak, kamera langsung terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostrato solo quando la sua organizzazione ha turni attivi. Altrimenti la fotocamera si apre subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "組織に有効なシフトがある場合のみ表示されます。それ以外の場合はすぐにカメラが開きます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiek rādīts tikai tad, ja jūsu organizācijai ir aktīvas maiņas. Citādi kamera atveras uzreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंको संस्थामा सक्रिय सिफ्ट भएमा मात्र देखिन्छ। नभए क्यामेरा तुरुन्तै खुल्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alleen getoond als je organisatie actieve diensten heeft. Anders opent de camera meteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyświetlane tylko, gdy Twoja organizacja ma aktywne zmiany. W przeciwnym razie aparat otworzy się od razu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só aparece quando a sua organização tem turnos ativos. Caso contrário, a câmara abre de imediato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afișat doar când organizația ta are ture active. Altfel, camera se deschide imediat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zobrazuje sa len vtedy, keď má vaša organizácia aktívne zmeny. Inak sa fotoaparát otvorí hneď."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visas bara när din organisation har aktiva skift. Annars öppnas kameran direkt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca organizasyonunuzun aktif vardiyaları olduğunda gösterilir. Aksi halde kamera hemen açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показується лише тоді, коли у вашій організації є активні зміни. Інакше камера відкривається одразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在你的组织有生效的班次时显示。否则会直接打开相机。"
          }
        }
      }
    },
    "Only the picker can put the set parts back.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Само събирачът може да върне частите на комплекта."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Části sady může vrátit jen vychystávač."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur der Kommissionierer kann die Set-Teile zurücklegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo el preparador puede volver a dejar las piezas del juego."
