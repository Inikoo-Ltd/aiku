    "Picking sessions need internet. Check Wi-Fi and try again.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пикинг сесиите изискват интернет. Проверете Wi-Fi и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relace vychystávání vyžadují internet. Zkontrolujte Wi-Fi a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommissioniersitzungen brauchen Internet. Prüfen Sie das WLAN und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las sesiones de picking necesitan internet. Compruebe la wifi y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sessions de préparation nécessitent Internet. Vérifiez le Wi-Fi et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिकिंग सत्रों के लिए इंटरनेट चाहिए। Wi-Fi जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesije branja zahtijevaju internet. Provjerite Wi-Fi i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózási munkamenetekhez internet szükséges. Ellenőrizze a Wi-Fit, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesi picking memerlukan internet. Periksa Wi-Fi dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sessioni di prelievo richiedono internet. Controlli il Wi-Fi e riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピッキングセッションにはインターネット接続が必要です。Wi-Fiを確認してもう一度お試しください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komplektēšanas sesijām nepieciešams internets. Pārbaudiet Wi-Fi un mēģiniet vēlreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिकिङ सत्रहरूका लागि इन्टरनेट चाहिन्छ। Wi-Fi जाँच गरी फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Picksessies vereisen internet. Controleer de wifi en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesje kompletacji wymagają internetu. Sprawdź Wi-Fi i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As sessões de preparação precisam de internet. Verifique o Wi-Fi e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesiunile de cules necesită internet. Verifică Wi-Fi-ul și încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relácie vychystávania vyžadujú internet. Skontrolujte Wi-Fi a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plockningssessioner kräver internet. Kontrollera wifi och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplama oturumları için internet gerekir. Wi-Fi’yi kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для сесій комплектування потрібен інтернет. Перевірте Wi-Fi і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拣货批次需要联网。请检查 Wi-Fi 后重试。"
          }
        }
      }
    },
