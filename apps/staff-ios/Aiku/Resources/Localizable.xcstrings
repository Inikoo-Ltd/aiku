    "Collection is set on the order. On a replacement delivery note it can be switched on the delivery note itself. Finalise for collection leaves it ready for the customer.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Личното вземане се задава в поръчката. При заместваща стокова разписка то може да се включи в самата стокова разписка. Финализиране за лично вземане я оставя готова за клиента."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osobní odběr se nastavuje v objednávce. U náhradního dodacího listu jej lze zapnout přímo v dodacím listu. Dokončit pro osobní odběr ho připraví pro zákazníka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Abholung wird in der Bestellung festgelegt. Bei einem Ersatz-Lieferschein kann sie im Lieferschein selbst eingeschaltet werden. Für die Abholung abschließen legt ihn für den Kunden bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La recogida se establece en el pedido. En un albarán de sustitución se puede activar en el propio albarán. Finalizar para recogida lo deja listo para el cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le retrait est défini sur la commande. Sur un bon de livraison de remplacement, il peut être activé sur le bon de livraison lui-même. Finaliser pour retrait le laisse prêt pour le client."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कलेक्शन ऑर्डर पर सेट होता है। रिप्लेसमेंट डिलीवरी नोट पर इसे डिलीवरी नोट पर ही चालू किया जा सकता है। कलेक्शन के लिए अंतिम रूप देने से यह ग्राहक के लिए तैयार हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osobno preuzimanje postavlja se na narudžbi. Na zamjenskoj otpremnici može se uključiti na samoj otpremnici. Finaliziraj za preuzimanje ostavlja je spremnom za kupca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A személyes átvétel a rendelésen van beállítva. Pótszállítólevél esetén magán a szállítólevélen is bekapcsolható. A Véglegesítés személyes átvételhez az ügyfél számára készre állítja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengambilan sendiri diatur pada pesanan. Pada surat jalan pengganti, opsi ini dapat diaktifkan di surat jalan itu sendiri. Selesaikan untuk diambil menyiapkannya untuk diambil pelanggan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il ritiro è impostato sull’ordine. Su una bolla di consegna sostitutiva può essere attivato sulla bolla stessa. Finalizza per il ritiro la lascia pronta per il cliente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "引き取りは注文で設定されます。再送の納品書では、納品書で切り替えることができます。「引き取り用に確定」にすると、顧客への引き渡し準備が完了します。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pašizņemšanu iestata pasūtījumā. Aizstājējai piegādes pavadzīmei to var ieslēgt pašā piegādes pavadzīmē. Pabeigšana pašizņemšanai atstāj to gatavu klientam."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सङ्कलन अर्डरमा सेट गरिन्छ। प्रतिस्थापन डेलिभरी नोटमा यसलाई डेलिभरी नोटमै सक्रिय गर्न सकिन्छ। सङ्कलनका लागि अन्तिम रूप दिँदा यो ग्राहकका लागि तयार हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afhalen wordt ingesteld op de bestelling. Bij een vervangende pakbon kan het op de pakbon zelf worden ingeschakeld. Afronden voor afhalen zet hem klaar voor de klant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odbiór osobisty ustawia się w zamówieniu. W zastępczym dowodzie dostawy można go włączyć w samym dowodzie. Zakończ do odbioru przygotowuje go dla klienta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A recolha é definida na encomenda. Numa guia de remessa de substituição, pode ser ativada na própria guia. Finalizar para recolha deixa-a pronta para o cliente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ridicarea personală este setată pe comandă. Pe o notă de livrare de înlocuire poate fi activată chiar pe nota de livrare. Finalizează pentru ridicare o lasă pregătită pentru client."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyzdvihnutie sa nastavuje v objednávke. Pri náhradnom dodacom liste ho možno zapnúť priamo v dodacom liste. Finalizovať na vyzdvihnutie ho pripraví pre zákazníka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upphämtning anges på ordern. På en ersättningsföljesedel kan den slås på direkt på följesedeln. Slutför för upphämtning gör den klar för kunden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teslim alma, siparişte ayarlanır. Yedek gönderi irsaliyesinde irsaliyenin kendisinden açılabilir. Teslim alma için kesinleştir, irsaliyeyi müşteri için hazır bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Самовивіз задається в замовленні. Для накладної на заміну його можна ввімкнути безпосередньо в накладній. Фіналізація для самовивозу залишає її готовою для клієнта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自提在订单上设置。补发的发货单可以直接在发货单上切换。“完成以供自提”会将其备妥，等待客户自提。"
          }
        }
      }
    },
