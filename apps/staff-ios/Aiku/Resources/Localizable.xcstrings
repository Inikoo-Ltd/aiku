    "The delivery note goes back to packing, so its lines and parcels can be changed.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стоковата разписка се връща към опаковане, за да могат редовете и колетите ѝ да се променят."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodací list se vrátí do balení, takže lze změnit jeho řádky a balíky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Lieferschein geht zurück zum Verpacken, damit seine Zeilen und Pakete geändert werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El albarán vuelve a embalaje, para poder cambiar sus líneas y paquetes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le bon de livraison repasse en emballage : ses lignes et ses colis peuvent donc être modifiés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डिलीवरी नोट पैकिंग पर वापस जाता है, ताकि उसकी लाइनें और पार्सल बदले जा सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otpremnica se vraća na pakiranje, pa se njezini retci i paketi mogu mijenjati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szállítólevél visszakerül csomagolásra, így a sorai és csomagjai módosíthatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Surat jalan kembali ke pengemasan, sehingga baris dan paketnya dapat diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La bolla di consegna torna all’imballaggio, così le sue righe e i pacchi possono essere modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "納品書は梱包に戻り、行と荷物を変更できるようになります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piegādes pavadzīme atgriežas iepakošanā, lai varētu mainīt tās rindas un pakas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डेलिभरी नोट प्याकिङमा फर्किन्छ, ताकि यसका लाइन र पार्सलहरू बदल्न सकियोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De pakbon gaat terug naar inpakken, zodat de regels en pakketten kunnen worden gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dowód dostawy wraca do pakowania, więc można zmienić jego pozycje i paczki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A guia de remessa volta à embalagem, para que as linhas e os volumes possam ser alterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nota de livrare revine la ambalare, astfel încât liniile și coletele ei pot fi modificate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodací list sa vráti na balenie, takže jeho riadky a balíky možno zmeniť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Följesedeln går tillbaka till packning, så dess rader och paket kan ändras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İrsaliye paketlemeye geri döner, böylece satırları ve paketleri değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Накладна повертається на пакування, тож її рядки й посилки можна змінити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发货单将退回打包，以便更改其行和包裹。"
          }
        }
      }
    },
    "The delivery note is picked again. If something on it is still waiting, it is set as waiting instead.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стоковата разписка се комплектова отново. Ако нещо в нея все още чака, тя се задава в изчакване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodací list se znovu nastaví jako vychystaný. Pokud na něm stále něco čeká, nastaví se místo toho jako čekající."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Lieferschein wird wieder kommissioniert. Wartet darauf noch etwas, wird er stattdessen auf wartend gesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El albarán vuelve a estar preparado. Si algo sigue en espera, se pone en espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le bon de livraison est de nouveau préparé. Si un élément est encore en attente, il est mis en attente à la place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डिलीवरी नोट फिर से पिक हो जाता है। अगर उस पर कुछ अभी भी प्रतीक्षा में है, तो इसके बजाय उसे प्रतीक्षा में सेट किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otpremnica je ponovno ubrana. Ako nešto na njoj još čeka, umjesto toga postavlja se na čekanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szállítólevél újra komissiózott állapotba kerül. Ha rajta valami még várakozik, helyette várakozó állapotba kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Surat jalan ditandai sudah diambil lagi. Jika masih ada yang menunggu, surat jalan ditandai menunggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La bolla di consegna torna prelevata. Se qualcosa è ancora in attesa, viene invece impostata come in attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "納品書は再度ピッキング済みになります。まだ保留中のものがある場合は、代わりに保留になります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piegādes pavadzīme tiek nokomplektēta vēlreiz. Ja kaut kas tajā joprojām gaida, tā tiek iestatīta kā gaidoša."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डेलिभरी नोट फेरि पिक गरिएको हुन्छ। यसमा केही अझै प्रतीक्षामा भए, यसको सट्टा प्रतीक्षामा सेट गरिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De pakbon wordt opnieuw gepickt. Als er nog iets op wacht, wordt hij in plaats daarvan op wachtend gezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dowód dostawy zostanie ponownie skompletowany. Jeśli coś w nim nadal oczekuje, zostanie ustawiony jako oczekujący."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A guia de remessa volta a ser preparada. Se algo nela ainda estiver em espera, é colocada em espera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nota de livrare este culeasă din nou. Dacă ceva de pe ea este încă în așteptare, este pusă în așteptare în schimb."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodací list sa znova vychystá. Ak na ňom ešte niečo čaká, nastaví sa namiesto toho ako čakajúci."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Följesedeln plockas igen. Om något på den fortfarande väntar markeras den i stället som väntande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İrsaliye yeniden toplandı olur. Üzerinde hâlâ bekleyen bir şey varsa bunun yerine bekliyor olarak işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Накладна знову комплектується. Якщо щось у ній ще очікує, її натомість буде встановлено як очікування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发货单将重新设为已拣货。如果其中仍有等待项，则改为设为等待。"
          }
        }
      }
    },
