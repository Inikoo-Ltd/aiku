          "stringUnit": {
            "state": "needs_review",
            "value": "За това ви е необходима интернет връзка. Проверете връзката и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "K tomu potřebujete připojení k internetu. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dafür benötigen Sie eine Internetverbindung. Prüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Necesita conexión a internet para hacer esto. Compruebe la conexión y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez besoin d’une connexion Internet pour faire cela. Vérifiez la connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह करने के लिए आपको इंटरनेट कनेक्शन चाहिए। कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za ovo vam je potrebna internetska veza. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ehhez internetkapcsolat szükséges. Ellenőrizze a kapcsolatot, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda memerlukan koneksi internet untuk melakukan ini. Periksa koneksi dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Serve una connessione internet per farlo. Controlli la connessione e riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この操作にはインターネット接続が必要です。接続を確認してもう一度お試しください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lai to izdarītu, nepieciešams interneta savienojums. Pārbaudiet savienojumu un mēģiniet vēlreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो गर्न तपाईंलाई इन्टरनेट जडान चाहिन्छ। जडान जाँच गरी फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je hebt een internetverbinding nodig om dit te doen. Controleer de verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Do tego potrzebujesz połączenia z internetem. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Precisa de ligação à internet para fazer isto. Verifique a ligação e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ai nevoie de o conexiune la internet pentru asta. Verifică conexiunea și încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na to potrebujete pripojenie na internet. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du behöver en internetanslutning för att göra detta. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu yapmak için internet bağlantısı gerekir. Bağlantıyı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для цього потрібне підключення до інтернету. Перевірте з’єднання і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作需要网络连接。请检查连接后重试。"
          }
        }
      }
    },
    "You need stock edit rights to change the stock.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Необходими са ви права за редакция на наличности, за да промените наличността."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ke změně zásob potřebujete oprávnění k úpravám zásob."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie benötigen Rechte zum Bearbeiten des Bestands, um den Bestand zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Necesita permisos de edición de stock para cambiar el stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez besoin des droits de modification du stock pour modifier le stock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टॉक बदलने के लिए आपको स्टॉक संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za promjenu zalihe potrebna su vam prava uređivanja zalihe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A készlet módosításához készletszerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda memerlukan hak edit stok untuk mengubah stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Servono i permessi di modifica dello stock per cambiare lo stock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在庫を変更するには在庫の編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lai mainītu krājumus, nepieciešamas krājumu labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टक बदल्न तपाईंलाई स्टक सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je hebt bewerkrechten voor voorraad nodig om de voorraad te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby zmienić zapasy, potrzebujesz uprawnień do edycji zapasów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Precisa de permissões de edição de stock para alterar o stock."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ai nevoie de drepturi de editare a stocului pentru a modifica stocul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na zmenu zásob potrebujete oprávnenie na úpravu zásob."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du behöver behörighet att redigera lager för att ändra lagret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stoğu değiştirmek için stok düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щоб змінити запас, потрібні права на редагування запасів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改库存需要库存编辑权限。"
          }
        }
      }
    },
    "You no longer have the right to do this": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вече нямаш право да правиш това"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na tohle už nemáte oprávnění"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast dafür keine Berechtigung mehr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya no tienes permiso para hacer esto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous n'avez plus le droit de faire ceci"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अब आपके पास यह करने का अधिकार नहीं है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Više nemate pravo to učiniti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Már nincs jogod ehhez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda tidak lagi punya hak untuk ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non hai più il permesso per farlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この操作の権限がなくなりました"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tev vairs nav tiesību to darīt"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अब तपाईंसँग यो गर्ने अधिकार छैन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je hebt hier geen recht meer op"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie masz już uprawnień, żeby to zrobić"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Já não tem permissão para fazer isto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu mai ai dreptul să faci asta"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na toto už nemáte oprávnenie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du har inte längre rätt att göra detta"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artık bunu yapma yetkin yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У вас більше немає права це робити"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你已没有执行此操作的权限"
          }
        }
      }
    },
    "Your account can’t open **%@** in **%@**. Ask your warehouse manager to add the permission in Aiku.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вашият акаунт не може да отвори **%@** в **%@**. Помолете мениджъра на склада да добави разрешението в Aiku."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Váš účet nemůže otevřít **%1$@** v **%2$@**. Požádejte vedoucího skladu, aby oprávnění přidal v Aiku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihr Konto kann **%1$@** in **%2$@** nicht öffnen. Bitten Sie Ihre Lagerleitung, die Berechtigung in Aiku hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su cuenta no puede abrir **%1$@** en **%2$@**. Pida a su responsable de almacén que añada el permiso en Aiku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre compte ne peut pas ouvrir **%1$@** dans **%2$@**. Demandez à votre responsable d’entrepôt d’ajouter l’autorisation dans Aiku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका खाता **%2$@** में **%1$@** नहीं खोल सकता। अपने गोदाम मैनेजर से Aiku में अनुमति जोड़ने के लिए कहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaš račun ne može otvoriti **%1$@** u **%2$@**. Zamolite voditelja skladišta da doda dopuštenje u Aikuu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fiókja nem nyithatja meg ezt: **%@**, itt: **%@**. Kérje meg a raktárvezetőt, hogy adja hozzá a jogosultságot az Aiku rendszerben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akun Anda tidak dapat membuka **%@** di **%@**. Minta manajer gudang Anda untuk menambahkan izin di Aiku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il suo account non può aprire **%1$@** in **%2$@**. Chieda al responsabile del magazzino di aggiungere il permesso in Aiku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "お使いのアカウントでは **%2$@** の **%1$@** を開けません。倉庫マネージャーにAikuで権限を追加するよう依頼してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jūsu konts nevar atvērt **%@** noliktavā **%@**. Lūdziet noliktavas vadītājam pievienot atļauju Aiku."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंको खाताले **%2$@** मा **%1$@** खोल्न सक्दैन। आफ्नो गोदाम प्रबन्धकलाई Aiku मा अनुमति थप्न भन्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je account kan **%1$@** in **%2$@** niet openen. Vraag je magazijnmanager om de rechten in Aiku toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoje konto nie może otworzyć **%1$@** w **%2$@**. Poproś kierownika magazynu o dodanie uprawnienia w Aiku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sua conta não pode abrir **%1$@** em **%2$@**. Peça ao seu responsável de armazém para adicionar a permissão no Aiku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contul tău nu poate deschide **%@** în **%@**. Cere managerului de depozit să adauge permisiunea în Aiku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Váš účet nemôže otvoriť **%1$@** v **%2$@**. Požiadajte vedúceho skladu, aby oprávnenie pridal v Aiku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditt konto kan inte öppna **%1$@** i **%2$@**. Be din lagerchef att lägga till behörigheten i Aiku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hesabınız **%@** bölümünü **%@** deposunda açamıyor. Depo yöneticinizden Aiku’da izni eklemesini isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваш обліковий запис не може відкрити **%@** у **%@**. Попросіть керівника складу додати дозвіл в Aiku."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的账户无法打开 **%2$@** 中的 **%1$@**。请让仓库经理在 Aiku 中添加权限。"
          }
        }
      }
    },
