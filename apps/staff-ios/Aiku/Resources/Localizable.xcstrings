    "Not received yet. Marking it as received needs goods-in edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все още не е получено. Маркирането като получено изисква права за редакция в приемане на стока."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatím nepřijato. Označení jako přijaté vyžaduje oprávnění upravovat příjem zboží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch nicht erhalten. Als erhalten markieren erfordert Rechte zum Bearbeiten des Wareneingangs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no recibida. Para marcarla como recibida se necesitan permisos de edición de recepción de mercancías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas encore reçue. La marquer comme reçue nécessite les droits de modification de la réception."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी प्राप्त नहीं हुआ। इसे प्राप्त के रूप में चिह्नित करने के लिए माल प्राप्ति संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još nije primljeno. Za označavanje kao primljeno potrebna su prava uređivanja ulaza robe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Még nem érkezett be. A beérkezettként jelöléshez áruátvételi szerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum diterima. Menandainya sebagai diterima memerlukan hak edit barang masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non ancora ricevuto. Per segnarlo come ricevuto servono i permessi di modifica del ricevimento merci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まだ受領されていません。受領済みにするには入荷編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vēl nav saņemts. Lai atzīmētu kā saņemtu, nepieciešamas preču pieņemšanas labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अहिलेसम्म प्राप्त भएको छैन। प्राप्त भनी चिन्ह लगाउन सामान प्राप्ति सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog niet ontvangen. Als ontvangen markeren vereist bewerkrechten voor Goederen in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeszcze nie otrzymano. Oznaczenie jako otrzymane wymaga uprawnień do edycji przyjęć towarów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não recebida. Marcá-la como recebida requer permissões de edição da receção de mercadorias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Încă neprimită. Marcarea ca primită necesită drepturi de editare pentru intrări de mărfuri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatiaľ neprijaté. Označenie ako prijaté vyžaduje práva na úpravu príjmu tovaru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inte mottagen ännu. Att markera den som mottagen kräver redigeringsbehörighet för varor in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henüz teslim alınmadı. Teslim alındı olarak işaretlemek için mal kabul düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ще не отримано. Щоб позначити як отримане, потрібні права на редагування приймання товарів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚未收到。标记为已收到需要入库编辑权限。"
          }
        }
      }
    },
