    "a barcode is a tiny poem only the scanner can read.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "баркодът е малко стихотворение, което само скенерът може да прочете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "čárový kód je malá báseň, kterou přečte jen skener."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ein Barcode ist ein kleines Gedicht, das nur der Scanner lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "un código de barras es un pequeño poema que solo el escáner sabe leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "un code-barres est un petit poème que seul le scanner sait lire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बारकोड एक छोटी-सी कविता है, जिसे केवल स्कैनर पढ़ सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "crtični kod je mala pjesma koju može pročitati samo skener."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "a vonalkód apró vers, amit csak a szkenner tud elolvasni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "barcode adalah puisi mungil yang hanya bisa dibaca pemindai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
