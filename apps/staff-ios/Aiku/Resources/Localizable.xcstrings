        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सबै वस्तुहरू पिक भए कि भएनन् जाँच गर्नुहोस् र प्रतीक्षा समाप्त गर्नुहोस्"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of alle artikelen gepickt zijn en rond het wachten af"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdź, czy wszystkie pozycje zostały skompletowane, i zakończ oczekiwanie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar se todos os artigos estão preparados e terminar a espera"
          }
