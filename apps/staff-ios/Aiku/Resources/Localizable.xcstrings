    "Changes apply to this delivery note’s shipping only, not to the order. The address can’t be changed once a shipment exists.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Промените важат само за доставката по тази стокова разписка, не и за поръчката. Адресът не може да се променя, след като има пратка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změny se týkají pouze dopravy tohoto dodacího listu, ne objednávky. Adresu nelze změnit, jakmile existuje zásilka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Änderungen gelten nur für den Versand dieses Lieferscheins, nicht für die Bestellung. Die Adresse kann nicht mehr geändert werden, sobald eine Sendung existiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los cambios solo se aplican al envío de este albarán, no al pedido. La dirección no se puede cambiar una vez que existe un envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les modifications ne s'appliquent qu'à l'expédition de ce bon de livraison, pas à la commande. L'adresse ne peut plus être modifiée une fois qu'une expédition existe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बदलाव केवल इस डिलीवरी नोट की शिपिंग पर लागू होते हैं, ऑर्डर पर नहीं। शिपमेंट बन जाने के बाद पता नहीं बदला जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Promjene vrijede samo za dostavu ove otpremnice, ne i za narudžbu. Adresa se ne može promijeniti nakon što postoji pošiljka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A módosítások csak ennek a szállítólevélnek a szállítására vonatkoznak, a rendelésre nem. A cím nem módosítható, ha már van szállítmány."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perubahan hanya berlaku untuk pengiriman surat jalan ini, bukan untuk pesanan. Alamat tidak dapat diubah setelah ada kiriman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modifiche valgono solo per la spedizione di questa bolla di consegna, non per l'ordine. L'indirizzo non si può più cambiare una volta creata una spedizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更はこの出荷伝票の配送にのみ適用され、注文には反映されません。配送が作成された後は住所を変更できません。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izmaiņas attiecas tikai uz šīs piegādes pavadzīmes piegādi, nevis uz pasūtījumu. Adresi nevar mainīt, kad sūtījums jau ir izveidots."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिवर्तनहरू अर्डरमा होइन, यो डेलिभरी नोटको ढुवानीमा मात्र लागू हुन्छन्। ढुवानी बनिसकेपछि ठेगाना परिवर्तन गर्न सकिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wijzigingen gelden alleen voor de verzending van deze leveringsbon, niet voor de bestelling. Het adres kan niet meer worden gewijzigd zodra er een zending is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiany dotyczą tylko wysyłki tego dowodu dostawy, a nie zamówienia. Adresu nie można zmienić, gdy istnieje już przesyłka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As alterações aplicam-se apenas ao envio desta guia de remessa, não à encomenda. O endereço não pode ser alterado depois de existir um envio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modificările se aplică doar livrării acestei note de livrare, nu și comenzii. Adresa nu mai poate fi schimbată după ce există o expediție."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmeny sa týkajú iba dopravy tohto dodacieho listu, nie objednávky. Adresu nemožno zmeniť, keď už existuje zásielka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändringarna gäller endast frakten för den här följesedeln, inte ordern. Adressen kan inte ändras när en försändelse finns."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değişiklikler siparişe değil, yalnızca bu irsaliyenin gönderimine uygulanır. Bir gönderi oluşturulduktan sonra adres değiştirilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зміни стосуються лише доставки цієї накладної, а не замовлення. Після створення відвантаження адресу змінити не можна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改仅适用于此发货单的运输，不影响订单。一旦存在货件，地址将无法更改。"
          }
        }
      }
    },
    "Changes apply to this delivery note’s shipping only. A banned delivery address (listed in Shop settings) is flagged with a warning.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Промените се отнасят само за доставката по тази стокова разписка. Забранен адрес за доставка (посочен в настройките на магазина) се маркира с предупреждение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změny platí pouze pro dopravu tohoto dodacího listu. Zakázaná doručovací adresa (uvedená v nastavení obchodu) je označena varováním."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Änderungen gelten nur für den Versand dieses Lieferscheins. Eine gesperrte Lieferadresse (in den Shop-Einstellungen aufgeführt) wird mit einer Warnung markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los cambios solo afectan al envío de este albarán. Una dirección de entrega bloqueada (indicada en los ajustes de la tienda) se marca con un aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les modifications ne s’appliquent qu’à l’expédition de ce bon de livraison. Une adresse de livraison interdite (listée dans les paramètres de la boutique) est signalée par un avertissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बदलाव केवल इस डिलीवरी नोट की शिपिंग पर लागू होते हैं। प्रतिबंधित डिलीवरी पता (शॉप सेटिंग्स में सूचीबद्ध) चेतावनी के साथ चिह्नित होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Promjene vrijede samo za dostavu ove otpremnice. Zabranjena adresa dostave (navedena u postavkama trgovine) označena je upozorenjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A módosítások csak ennek a szállítólevélnek a szállítására vonatkoznak. A tiltott szállítási címet (a Bolt beállításaiban felsorolva) figyelmeztetés jelzi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perubahan hanya berlaku untuk pengiriman surat jalan ini. Alamat pengiriman yang diblokir (tercantum di pengaturan Toko) ditandai dengan peringatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modifiche valgono solo per la spedizione di questa bolla di consegna. Un indirizzo di consegna vietato (elencato nelle impostazioni del negozio) viene segnalato con un avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更はこの納品書の配送にのみ適用されます。禁止された配送先住所（ショップ設定に記載）には警告が表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izmaiņas attiecas tikai uz šīs piegādes pavadzīmes piegādi. Aizliegta piegādes adrese (norādīta veikala iestatījumos) tiek atzīmēta ar brīdinājumu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिवर्तन यो डेलिभरी नोटको ढुवानीमा मात्र लागू हुन्छ। प्रतिबन्धित डेलिभरी ठेगाना (पसल सेटिङमा सूचीबद्ध) चेतावनीसहित चिन्ह लगाइन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wijzigingen gelden alleen voor de verzending van deze pakbon. Een geblokkeerd afleveradres (vermeld in de winkelinstellingen) wordt met een waarschuwing gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiany dotyczą tylko wysyłki tego dowodu dostawy. Zablokowany adres dostawy (wymieniony w ustawieniach sklepu) jest oznaczany ostrzeżeniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As alterações aplicam-se apenas ao envio desta guia de remessa. Uma morada de entrega proibida (indicada nas definições da loja) é assinalada com um aviso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modificările se aplică doar expedierii acestei note de livrare. O adresă de livrare interzisă (listată în Setările magazinului) este semnalată cu un avertisment."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmeny sa týkajú len dopravy tohto dodacieho listu. Zakázaná dodacia adresa (uvedená v nastaveniach obchodu) je označená upozornením."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändringarna gäller bara frakten för den här följesedeln. En spärrad leveransadress (listad i butiksinställningarna) flaggas med en varning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değişiklikler yalnızca bu irsaliyenin gönderimi için geçerlidir. Yasaklı bir teslimat adresi (Mağaza ayarlarında listelenen) uyarıyla işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зміни стосуються лише доставки за цією накладною. Заборонену адресу доставки (зазначену в налаштуваннях магазину) буде позначено попередженням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改仅适用于此发货单的配送。被禁止的收货地址（列于店铺设置中）会显示警告标记。"
          }
        }
      }
    },
