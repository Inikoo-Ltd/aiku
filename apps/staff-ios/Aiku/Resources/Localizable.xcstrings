    " to do it at once · right = Picked, left = Partial / Not picked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": " für sofortige Ausführung · rechts = Kommissioniert, links = Teilweise / Nicht kommissioniert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " para hacerlo de una vez · derecha = Preparado, izquierda = Parcial / No preparado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " pour tout faire d’un coup · droite = Préparé, gauche = Partiel / Non préparé"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " da to obavite odjednom · desno = Ubrano, lijevo = Djelomično / Nije ubrano"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": " az azonnali végrehajtáshoz · jobbra = Komissiózva, balra = Részleges / Nincs komissiózva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": " untuk langsung menjalankannya · kanan = Sudah diambil, kiri = Sebagian / Tidak diambil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " per farlo in un colpo solo · destra = Prelevato, sinistra = Parziale / Non prelevato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": " で一度に実行 · 右 = ピッキング済み、左 = 一部 / 未ピッキング"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": " pentru a acționa imediat · dreapta = Cules, stânga = Parțial / Necules"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": " – urobíte to naraz · doprava = Vychystané, doľava = Čiastočne / Nevychystané"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " tek seferde yapın · sağ = Toplandı, sol = Kısmi / Toplanmadı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": " 可一次完成 · 右滑 = 已拣货，左滑 = 部分 / 未拣货"
          }
        }
      }
    },
