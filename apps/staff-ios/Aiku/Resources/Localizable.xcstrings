    "The customer collects it from the warehouse. No shipping, no shipment.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Клиентът го взема лично от склада. Без доставка, без пратка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zákazník si ho vyzvedne ve skladu. Bez přepravy, bez zásilky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Kunde holt es im Lagerhaus ab. Kein Versand, keine Sendung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El cliente lo recoge en el almacén. Sin envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le client le retire à l’entrepôt. Pas de livraison, pas d’expédition."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्राहक इसे गोदाम से ले जाता है। कोई शिपिंग नहीं, कोई शिपमेंट नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kupac to preuzima iz skladišta. Bez dostave, bez pošiljke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az ügyfél a raktárból veszi át. Nincs szállítás, nincs szállítmány."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pelanggan mengambilnya sendiri dari gudang. Tanpa pengiriman, tanpa kiriman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il cliente lo ritira dal magazzino. Nessuna spedizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顧客が倉庫から引き取ります。配送はありません。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klients to izņem pats noliktavā. Bez piegādes, bez sūtījuma."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ग्राहकले गोदामबाटै लैजान्छ। ढुवानी हुँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De klant haalt het af in het magazijn. Geen verzending, geen zending."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klient odbiera zamówienie z magazynu. Bez wysyłki, bez przesyłki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cliente recolhe-a no armazém. Sem transporte, sem envio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clientul o ridică din depozit. Fără expediere, fără expediție."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
