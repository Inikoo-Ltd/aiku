          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanarea %@ nu a primit răspuns. Încercați din nou; nu va fi numărată de două ori."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sken %@ nedostal odpoveď. Skúste to znova; nezapočíta sa dvakrát."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanningen av %@ fick inget svar. Försök igen; den räknas inte två gånger."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ taramasına yanıt alınamadı. Tekrar deneyin; iki kez sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканування %@ не отримало відповіді. Спробуйте ще раз; двічі не порахується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 的扫描未收到响应。请重试，不会重复计数。"
          }
        }
      }
    },
    "The session finishes packing by itself when every delivery note is packed, and the trolleys are freed.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сесията приключва опаковането автоматично, когато всички стокови разписки са опаковани, и количките се освобождават."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relace ukončí balení sama, jakmile jsou zabaleny všechny dodací listy, a vozíky se uvolní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Sitzung beendet das Packen automatisch, wenn alle Lieferscheine gepackt sind, und die Wagen werden freigegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sesión termina el embalaje sola cuando todos los albaranes están embalados, y los carros quedan libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La session termine l'emballage d'elle-même quand tous les bons de livraison sont emballés, et les chariots sont libérés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब हर डिलीवरी नोट पैक हो जाता है, तो सत्र अपने आप पैकिंग समाप्त कर देता है, और ट्रॉलियाँ खाली हो जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesija sama završava pakiranje kad je svaka otpremnica spakirana, a kolica se oslobađaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A munkamenet magától befejezi a csomagolást, amikor minden szállítólevél be van csomagolva, és a kocsik felszabadulnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesi menyelesaikan pengemasan secara otomatis saat semua surat jalan sudah dikemas, dan troli dikosongkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sessione termina l'imballaggio da sola quando tutte le bolle di consegna sono imballate, e i carrelli vengono liberati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての出荷伝票が梱包されるとセッションの梱包は自動で完了し、カートが空きになります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesija pati pabeidz iepakošanu, kad visas piegādes pavadzīmes ir iepakotas, un ratiņi tiek atbrīvoti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सबै डेलिभरी नोटहरू प्याक भएपछि सत्रले आफैँ प्याकिङ सकाउँछ, र ट्रलीहरू खाली हुन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De sessie rondt het inpakken vanzelf af wanneer elke leveringsbon is ingepakt, en de trolleys komen vrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesja sama kończy pakowanie, gdy każdy dowód dostawy jest spakowany, a wózki zostają zwolnione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sessão termina a embalagem automaticamente quando todas as guias de remessa estiverem embaladas, e os carrinhos ficam livres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesiunea finalizează singură ambalarea când toate notele de livrare sunt ambalate, iar cărucioarele sunt eliberate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relácia ukončí balenie sama, keď sú zabalené všetky dodacie listy, a vozíky sa uvoľnia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sessionen avslutar packningen automatiskt när alla följesedlar är packade, och vagnarna frigörs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tüm irsaliyeler paketlendiğinde oturum paketlemeyi kendiliğinden bitirir ve toplama arabaları boşa çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сесія автоматично завершує пакування, коли всі накладні упаковано, і візки звільняються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有发货单打包完成后，批次会自动结束打包，拣货车也会被释放。"
          }
        }
      }
    },
    "The shipment and its label come from %@. If it isn’t there yet, try again in a moment. Then print the label and finalise as usual.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пратката и етикетът ѝ идват от %@. Ако все още ги няма, опитайте отново след малко. След това отпечатайте етикета и финализирайте както обикновено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zásilka a její štítek pocházejí z %@. Pokud tam ještě nejsou, zkuste to znovu za chvíli. Pak vytiskněte štítek a finalizujte jako obvykle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Sendung und ihr Etikett kommen von %@. Falls sie noch nicht da ist, versuchen Sie es gleich noch einmal. Drucken Sie dann das Etikett und schließen Sie wie gewohnt ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El envío y su etiqueta proceden de %@. Si aún no están, inténtelo de nuevo en un momento. Después imprima la etiqueta y finalice como de costumbre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'expédition et son étiquette proviennent de %@. Si elle n'y est pas encore, réessayez dans un instant. Imprimez ensuite l'étiquette et finalisez comme d'habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "शिपमेंट और उसका लेबल %@ से आते हैं। अगर यह अभी तक नहीं आया है, तो थोड़ी देर में फिर से प्रयास करें। फिर लेबल प्रिंट करें और हमेशा की तरह अंतिम रूप दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pošiljka i njezina naljepnica dolaze s %@. Ako još nisu tamo, pokušajte ponovno za trenutak. Zatim ispišite naljepnicu i završite kao i obično."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szállítmány és a címkéje innen származik: %@. Ha még nincs ott, próbálja újra egy perc múlva. Ezután nyomtassa ki a címkét, és véglegesítse a szokásos módon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiriman dan labelnya berasal dari %@. Jika belum ada, coba lagi sebentar lagi. Lalu cetak label dan finalisasi seperti biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La spedizione e la sua etichetta provengono da %@. Se non è ancora disponibile, riprovi tra un momento. Poi stampi l'etichetta e finalizzi come al solito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配送とそのラベルは%@から取得されます。まだない場合は、しばらくしてからもう一度お試しください。その後、ラベルを印刷していつもどおり確定してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sūtījums un tā etiķete nāk no %@. Ja tas vēl nav pieejams, mēģiniet vēlreiz pēc brīža. Pēc tam izdrukājiet etiķeti un pabeidziet kā parasti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ढुवानी र त्यसको लेबल %@ बाट आउँछ। अझै आएको छैन भने, केही बेरमा फेरि प्रयास गर्नुहोस्। त्यसपछि लेबल प्रिन्ट गरी सधैँझैँ अन्तिम रूप दिनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De zending en het label komen van %@. Als die er nog niet is, probeer het zo opnieuw. Druk daarna het label af en rond af zoals gewoonlijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przesyłka i jej etykieta pochodzą z %@. Jeśli jeszcze ich tam nie ma, spróbuj ponownie za chwilę. Następnie wydrukuj etykietę i zakończ jak zwykle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O envio e a respetiva etiqueta vêm de %@. Se ainda não estiverem lá, tente novamente daqui a pouco. Depois imprima a etiqueta e finalize como habitualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Expediția și eticheta ei provin din %@. Dacă nu sunt încă acolo, încercați din nou peste câteva momente. Apoi tipăriți eticheta și finalizați ca de obicei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zásielka a jej štítok pochádzajú z %@. Ak tam ešte nie sú, skúste to znova o chvíľu. Potom vytlačte štítok a finalizujte ako zvyčajne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Försändelsen och dess etikett kommer från %@. Om den inte finns där än, försök igen om en stund. Skriv sedan ut etiketten och slutför som vanligt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönderi ve etiketi %@ üzerinden gelir. Henüz yoksa birazdan tekrar deneyin. Ardından etiketi yazdırıp her zamanki gibi kesinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відвантаження та його етикетка надходять із %@. Якщо їх ще немає, спробуйте ще раз за мить. Потім надрукуйте етикетку та завершіть як зазвичай."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "货件及其标签来自 %@。如果尚未生成，请稍后重试。然后打印标签并照常完成。"
          }
        }
      }
    },
    "The shipment and its label come from the platform. If it isn’t there yet, try again in a moment. Then print the label and finalise as usual.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пратката и етикетът ѝ идват от платформата. Ако още я няма, опитайте отново след малко. След това отпечатайте етикета и финализирайте както обикновено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zásilka i její štítek přicházejí z platformy. Pokud tam ještě nejsou, zkuste to za chvíli znovu. Pak vytiskněte štítek a finalizujte jako obvykle."
          }
