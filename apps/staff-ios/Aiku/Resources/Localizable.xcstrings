    "Each PDF opens in the phone’s viewer, where you can print or share it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всеки PDF се отваря в програмата за преглед на телефона, където можете да го отпечатате или споделите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každé PDF se otevře v prohlížeči telefonu, kde ho můžete vytisknout nebo sdílet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedes PDF öffnet sich im Viewer des Telefons, wo Sie es drucken oder teilen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada PDF se abre en el visor del teléfono, desde donde puede imprimirlo o compartirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque PDF s’ouvre dans la visionneuse du téléphone, où vous pouvez l’imprimer ou le partager."
