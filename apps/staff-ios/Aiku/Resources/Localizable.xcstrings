    "Mark it as received when it arrives at goods in. Checking starts after that.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Маркирайте я като получена, когато пристигне в приемането на стока. Проверката започва след това."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Až dorazí na příjem zboží, označte ji jako přijatou. Poté začne kontrola."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markieren Sie sie als erhalten, wenn sie im Wareneingang ankommt. Danach beginnt die Prüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Márquela como recibida cuando llegue a recepción de mercancías. Después empieza la comprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marquez-la comme reçue quand elle arrive à la réception. La vérification commence ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "माल प्राप्ति पर पहुँचने पर इसे प्राप्त के रूप में चिह्नित करें। उसके बाद जाँच शुरू होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označite je kao primljenu kad stigne na ulaz robe. Provjera počinje nakon toga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jelölje beérkezettnek, amikor megérkezik az áruátvételre. Az ellenőrzés ezután kezdődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tandai sebagai diterima saat tiba di barang masuk. Pemeriksaan dimulai setelah itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La segni come ricevuta quando arriva al ricevimento merci. La verifica inizia dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入荷場に到着したら受領済みにしてください。その後に検品が始まります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atzīmējiet kā saņemtu, kad tā pienāk preču pieņemšanā. Pēc tam sākas pārbaude."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सामान प्राप्तिमा आइपुगेपछि यसलाई प्राप्त भनी चिन्ह लगाउनुहोस्। त्यसपछि जाँच सुरु हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
