    "Keep scanning to count one by one · the panel updates in place": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продължете да сканирате, за да броите един по един · панелът се обновява на място"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
