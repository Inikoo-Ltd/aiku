    " to do it at once · right = Picked, left = Partial / Not picked": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": " за да го направите наведнъж · надясно = Комплектовано, наляво = Частично / Некомплектовано"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": " pro okamžité provedení · doprava = Vychystáno, doleva = Částečně / Nevychystáno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": " für sofortige Ausführung · rechts = Kommissioniert, links = Teilweise / Nicht kommissioniert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " para hacerlo de una vez · derecha = Preparado, izquierda = Parcial / No preparado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " pour tout faire d’un coup · droite = Préparé, gauche = Partiel / Non préparé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": " से तुरंत हो जाएगा · दायाँ = पिक किया गया, बायाँ = आंशिक / पिक नहीं किया गया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " da to obavite odjednom · desno = Ubrano, lijevo = Djelomično / Nije ubrano"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": " az azonnali végrehajtáshoz · jobbra = Komissiózva, balra = Részleges / Nincs komissiózva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": " untuk langsung menjalankannya · kanan = Sudah diambil, kiri = Sebagian / Tidak diambil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " per farlo in un colpo solo · destra = Prelevato, sinistra = Parziale / Non prelevato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": " で一度に実行 · 右 = ピッキング済み、左 = 一部 / 未ピッキング"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": " lai to izdarītu uzreiz · pa labi = Nokomplektēts, pa kreisi = Daļēji / Nav nokomplektēts"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": " गर्दा तुरुन्तै हुन्छ · दायाँ = पिक गरिएको, बायाँ = आंशिक / पिक नगरिएको"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " om het in één keer te doen · rechts = Gepickt, links = Gedeeltelijk / Niet gepickt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " aby zrobić to od razu · w prawo = Skompletowane, w lewo = Częściowo / Nieskompletowane"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": " para o fazer de uma vez · direita = Preparado, esquerda = Parcial / Não preparado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": " pentru a acționa imediat · dreapta = Cules, stânga = Parțial / Necules"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": " – urobíte to naraz · doprava = Vychystané, doľava = Čiastočne / Nevychystané"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": " för att göra det direkt · höger = Plockad, vänster = Delvis / Inte plockad"
