        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fuvarozó nem kap értesítést: ha a címkét már lefoglalták, törölje náluk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurir tidak diberi tahu: batalkan label dengan kurir jika sudah dipesan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il corriere non viene avvisato: se l’etichetta era già stata prenotata, la annulli presso il corriere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配送業者には通知されません。すでに予約済みの場合は、配送業者側でラベルを取り消してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pārvadātājam netiek paziņots: ja etiķete jau bija rezervēta, atceliet to pie pārvadātāja."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ढुवानीकर्तालाई जानकारी दिइँदैन: लेबल पहिल्यै बुक भइसकेको भए उनीहरूसँग रद्द गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vervoerder wordt niet ingelicht: annuleer het label bij hen als het al was geboekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przewoźnik nie zostanie powiadomiony: anuluj u niego etykietę, jeśli została już zarezerwowana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A transportadora não é avisada: cancele a etiqueta junto dela se já tiver sido reservada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transportatorul nu este anunțat: anulează eticheta la el dacă a fost deja rezervată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepravca nie je informovaný: ak už bol štítok zarezervovaný, zrušte ho u neho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transportören meddelas inte: avboka etiketten hos dem om den redan var bokad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kargo firmasına bildirilmez: etiket zaten oluşturulduysa onlar üzerinden iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перевізника не повідомляють: скасуйте етикетку в нього, якщо її вже замовлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不会通知承运商：如果已预订标签，请与承运商取消。"
          }
        }
      }
    },
    "The change is copied to the order too": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Промяната се копира и в поръчката"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změna se zkopíruje i do objednávky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Änderung wird auch in die Bestellung übernommen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El cambio también se copia en el pedido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La modification est aussi reportée sur la commande"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बदलाव ऑर्डर में भी कॉपी हो जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Promjena se kopira i na narudžbu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A módosítás a rendelésre is átmásolódik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perubahan juga disalin ke pesanan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La modifica viene copiata anche sull’ordine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更は注文にもコピーされます"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izmaiņa tiek nokopēta arī pasūtījumā"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिवर्तन अर्डरमा पनि कपी हुन्छ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De wijziging wordt ook naar de bestelling gekopieerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiana zostanie skopiowana również do zamówienia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A alteração também é copiada para a encomenda"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modificarea este copiată și în comandă"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmena sa skopíruje aj do objednávky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändringen kopieras även till ordern"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değişiklik siparişe de kopyalanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зміну також буде скопійовано в замовлення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改也会同步到订单"
          }
        }
      }
    },
