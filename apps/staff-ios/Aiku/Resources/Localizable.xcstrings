    "Completing the audit applies the counted quantities to this pallet. Items not counted stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завършването на одита прилага преброените количества към този палет. Непреброените артикули остават без промяна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dokončením auditu se na tuto paletu použijí spočítaná množství. Nespočítané položky zůstanou beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Abschließen der Prüfung übernimmt die gezählten Mengen für diese Palette. Nicht gezählte Artikel bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al completar la auditoría se aplican las cantidades contadas a este palet. Los artículos no contados se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminer l’audit applique les quantités comptées à cette palette. Les articles non comptés restent inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑडिट पूरा करने पर गिनी गई मात्राएँ इस पैलेट पर लागू होती हैं। जो आइटम नहीं गिने गए वे वैसे ही रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dovršetak revizije primjenjuje prebrojane količine na ovu paletu. Neprebrojani artikli ostaju kakvi jesu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az ellenőrzés befejezése alkalmazza a megszámolt mennyiségeket erre a raklapra. A meg nem számolt tételek változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyelesaikan audit menerapkan kuantitas yang dihitung ke palet ini. Barang yang tidak dihitung tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Completare la verifica applica le quantità contate a questo pallet. Gli articoli non contati restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "棚卸しを完了すると、数えた数量がこのパレットに反映されます。数えていない商品はそのままです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pabeidzot auditu, saskaitītie daudzumi tiek piemēroti šai paletei. Neskaitītās preces paliek nemainīgas."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अडिट पूरा गर्दा गनिएका परिमाण यो प्यालेटमा लागू हुन्छन्। नगनिएका वस्तुहरू जस्ताको तस्तै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Door de controle te voltooien worden de getelde aantallen op deze pallet toegepast. Niet-getelde artikelen blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zakończenie audytu zastosuje policzone ilości do tej palety. Niepoliczone pozycje pozostaną bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Concluir a auditoria aplica as quantidades contadas a esta palete. Os artigos não contados ficam como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finalizarea auditului aplică acestui palet cantitățile numărate. Articolele nenumărate rămân neschimbate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dokončením inventúry sa na túto paletu použijú spočítané množstvá. Nespočítané položky zostanú bez zmeny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När granskningen slutförs tillämpas de räknade antalen på den här pallen. Artiklar som inte räknats förblir oförändrade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sayımı tamamlamak, sayılan miktarları bu palete uygular. Sayılmayan ürünler olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершення аудиту застосовує підраховані кількості до цього палета. Непідраховані товари залишаються без змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完成盘点会将清点数量应用到此托盘。未清点的货品保持不变。"
          }
        }
      }
    },
