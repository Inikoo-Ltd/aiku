          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeskanuj kod QR na urządzeniu do rejestracji czasu pracy. Urządzenie określa, gdzie została zarejestrowana Twoja obecność."
          }
        },
        "pt": {
