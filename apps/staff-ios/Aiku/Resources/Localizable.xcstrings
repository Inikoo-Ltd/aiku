    "Picking a whole pallet also returns its stored items. A pallet that can’t be picked is set as not picked and waits for customer service.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При събиране на цял палет се връщат и съхранените му артикули. Палет, който не може да се събере, се маркира като несъбран и чака обслужване на клиенти."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystáním celé palety se vrátí i její uskladněné položky. Paleta, kterou nelze vychystat, se nastaví jako nevychystaná a čeká na zákaznický servis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Kommissionieren einer ganzen Palette werden auch ihre eingelagerten Artikel zurückgegeben. Eine Palette, die nicht kommissioniert werden kann, wird als nicht kommissioniert markiert und wartet auf den Kundendienst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preparar un palet completo también devuelve sus artículos almacenados. Un palet que no se puede preparar se marca como no preparado y queda en espera de atención al cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Préparer une palette entière retourne aussi ses articles stockés. Une palette qui ne peut pas être préparée est marquée comme non préparée et attend le service client."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पूरा पैलेट पिक करने पर उसके संग्रहीत आइटम भी वापस हो जाते हैं। जो पैलेट पिक नहीं हो सकता, वह पिक नहीं किया गया के रूप में सेट होकर ग्राहक सेवा की प्रतीक्षा करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Branje cijele palete vraća i njezine pohranjene artikle. Paleta koja se ne može ubrati označava se kao nije ubrana i čeka korisničku službu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Egy teljes raklap komissiózása a tárolt tételeit is visszaküldi. A nem komissiózható raklap nem komissiózottnak lesz jelölve, és az ügyfélszolgálatra vár."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengambil palet utuh juga mengembalikan barang tersimpannya. Palet yang tidak dapat diambil ditandai tidak diambil dan menunggu layanan pelanggan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prelevare un pallet intero restituisce anche i suoi articoli in giacenza. Un pallet che non si può prelevare viene impostato come non prelevato e attende il servizio clienti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パレットごとピッキングすると、その保管品も返送されます。ピッキングできないパレットは未ピッキングになり、カスタマーサービスの対応待ちになります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komplektējot veselu paleti, tiek atgriezti arī tās uzglabātie vienumi. Palete, ko nevar komplektēt, tiek atzīmēta kā nekomplektēta un gaida klientu apkalpošanu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पूरा प्यालेट पिक गर्दा त्यसका भण्डारण गरिएका वस्तुहरू पनि फिर्ता हुन्छन्। पिक गर्न नसकिने प्यालेट पिक नगरिएको रूपमा सेट भई ग्राहक सेवाको प्रतीक्षामा रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als je een hele pallet pickt, gaan de opgeslagen items erop ook retour. Een pallet die niet gepickt kan worden, wordt ingesteld als niet gepickt en wacht op de klantenservice."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skompletowanie całej palety zwraca też jej przechowywane przedmioty. Paleta, której nie można skompletować, zostaje oznaczona jako nieskompletowana i czeka na obsługę klienta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preparar uma palete completa também devolve os seus itens armazenados. Uma palete que não pode ser preparada é definida como não preparada e fica a aguardar o apoio ao cliente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culegerea unui palet întreg returnează și articolele sale depozitate. Un palet care nu poate fi cules este setat ca necules și așteaptă serviciul clienți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystaním celej palety sa vrátia aj jej uskladnené položky. Paleta, ktorú nemožno vychystať, sa nastaví ako nevychystaná a čaká na zákaznícky servis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om du plockar en hel pall returneras även dess lagrade artiklar. En pall som inte kan plockas markeras som ej plockad och väntar på kundtjänst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bütün bir paleti toplamak, üzerindeki depolanan ürünleri de iade eder. Toplanamayan bir palet toplanmadı olarak işaretlenir ve müşteri hizmetlerini bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Збір цілої палети також повертає її збережені товари. Палету, яку не можна зібрати, позначають як не зібрану, і вона очікує на службу підтримки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拣取整个托盘时，其存储货品也会一并退回。无法拣取的托盘将设为未拣货并等待客服处理。"
          }
        }
      }
    },
