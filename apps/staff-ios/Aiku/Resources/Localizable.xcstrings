    },
    "Aiku didn’t respond. Your last action was not saved. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku hat nicht geantwortet. Ihre letzte Aktion wurde nicht gespeichert. Versuchen Sie es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku no respondió. Su última acción no se ha guardado. Inténtelo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku n’a pas répondu. Votre dernière action n’a pas été enregistrée. Réessayez dans un instant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku nije odgovorio. Vaša zadnja radnja nije spremljena. Pokušajte ponovno za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Aiku nem válaszolt. Az utolsó művelete nem lett mentve. Próbálja újra egy kis idő múlva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku tidak merespons. Aksi terakhir Anda tidak disimpan. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku non ha risposto. L’ultima azione non è stata salvata. Riprovi tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aikuから応答がありませんでした。最後の操作は保存されていません。しばらくしてからもう一度お試しください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku nu a răspuns. Ultima ta acțiune nu a fost salvată. Încearcă din nou peste câteva momente."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku neodpovedá. Vaša posledná akcia sa neuložila. Skúste to znova o chvíľu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku yanıt vermedi. Son işleminiz kaydedilmedi. Biraz sonra tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku 没有响应。你的上一步操作未保存。请稍后重试。"
          }
        }
      }
    },
    "Aiku needs the camera to scan barcodes. Turn it on in your phone settings, or use a scanner device instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku braucht die Kamera, um Barcodes zu scannen. Aktivieren Sie sie in den Telefoneinstellungen oder verwenden Sie stattdessen einen Scanner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku necesita la cámara para escanear códigos de barras. Actívela en los ajustes del teléfono o use un escáner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku a besoin de l’appareil photo pour scanner les codes-barres. Activez-le dans les réglages du téléphone, ou utilisez plutôt un scanner."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku treba kameru za skeniranje barkodova. Uključite je u postavkama telefona ili umjesto toga koristite skener."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Aikunak szüksége van a kamerára a vonalkódok szkenneléséhez. Kapcsolja be a telefon beállításaiban, vagy használjon helyette szkennereszközt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku memerlukan kamera untuk memindai barcode. Aktifkan di pengaturan ponsel Anda, atau gunakan perangkat pemindai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku ha bisogno della fotocamera per scansionare i codici a barre. La attivi nelle impostazioni del telefono oppure usi uno scanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aikuでバーコードをスキャンするにはカメラが必要です。スマートフォンの設定でオンにするか、スキャナー端末を使用してください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku are nevoie de cameră pentru a scana coduri de bare. Activeaz-o din setările telefonului sau folosește un scaner."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku potrebuje fotoaparát na skenovanie čiarových kódov. Zapnite ho v nastaveniach telefónu alebo namiesto toho použite skener."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku’nun barkod taramak için kameraya ihtiyacı var. Telefon ayarlarınızdan açın veya bunun yerine bir tarayıcı cihaz kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku 需要使用相机扫描条码。请在手机设置中开启，或改用扫描设备。"
          }
        }
      }
    },
