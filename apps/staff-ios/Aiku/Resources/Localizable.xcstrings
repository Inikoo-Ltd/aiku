    "Aiku checks the machine’s QR code when you scan, so clocking needs a connection. Nothing was saved.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku проверява QR кода на машината при сканиране, затова отчитането изисква връзка. Нищо не е запазено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku při skenování ověřuje QR kód zařízení, takže docházka vyžaduje připojení. Nic nebylo uloženo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku prüft beim Scannen den QR-Code des Geräts, daher braucht die Zeiterfassung eine Verbindung. Es wurde nichts gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku comprueba el código QR de la máquina al escanear, así que el fichaje necesita conexión. No se ha guardado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku vérifie le code QR de la pointeuse lors du scan : le pointage nécessite donc une connexion. Rien n’a été enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्कैन करते समय Aiku मशीन का QR कोड जाँचता है, इसलिए हाज़िरी के लिए कनेक्शन चाहिए। कुछ भी सहेजा नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku provjerava QR kôd uređaja kada skenirate, pa evidentiranje zahtijeva vezu. Ništa nije spremljeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Aiku szkenneléskor ellenőrzi a gép QR-kódját, ezért a blokkoláshoz kapcsolat szükséges. Semmi sem lett mentve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku memeriksa kode QR mesin saat Anda memindai, jadi absensi memerlukan koneksi. Tidak ada yang disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku verifica il codice QR del terminale durante la scansione, quindi la timbratura richiede una connessione. Non è stato salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スキャン時にAikuが打刻機のQRコードを確認するため、打刻には接続が必要です。何も保存されていません。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku skenēšanas brīdī pārbauda iekārtas QR kodu, tāpēc pierakstam nepieciešams savienojums. Nekas netika saglabāts."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्क्यान गर्दा Aiku ले मेसिनको QR कोड जाँच्छ, त्यसैले क्लकिङका लागि जडान चाहिन्छ। केही पनि सुरक्षित भएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku controleert de QR-code van de machine wanneer je scant, dus klokken vereist een verbinding. Er is niets opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku sprawdza kod QR urządzenia podczas skanowania, więc rejestracja czasu pracy wymaga połączenia. Nic nie zostało zapisane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Aiku verifica o código QR da máquina quando faz a leitura, por isso o registo de ponto precisa de ligação. Nada foi guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku verifică codul QR al terminalului când scanezi, așa că pontajul necesită conexiune. Nu s-a salvat nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku pri skenovaní overuje QR kód terminálu, preto záznam dochádzky vyžaduje pripojenie. Nič sa neuložilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku kontrollerar maskinens QR-kod när du skannar, så stämpling kräver en anslutning. Inget sparades."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku tarama sırasında cihazın QR kodunu kontrol eder, bu yüzden puantaj için bağlantı gerekir. Hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aiku перевіряє QR-код пристрою під час сканування, тому для відмітки потрібне з’єднання. Нічого не збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫描时 Aiku 会核验考勤机的二维码，因此打卡需要联网。未保存任何内容。"
          }
        }
      }
    },
