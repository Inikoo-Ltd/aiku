            "value": "जब यह SKO की एकमात्र लोकेशन हो, तो डिफ़ॉल्ट रूप से टिक किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unaprijed označeno kada bi ovo bila jedina lokacija SKO-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alapértelmezetten be van jelölve, ha ez lenne az SKO egyetlen helye."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dicentang secara default jika ini akan menjadi satu-satunya lokasi SKO."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selezionato per impostazione predefinita quando sarebbe l’unica ubicazione dello SKO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKOの唯一のロケーションになる場合は、デフォルトでチェックされます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atzīmēts pēc noklusējuma, ja šī būtu vienīgā SKO vieta."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो SKO को एकमात्र लोकेसन हुने भए पूर्वनिर्धारित रूपमा टिक गरिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Standaard aangevinkt als dit de enige locatie van de SKO zou zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaznaczone domyślnie, gdy byłaby to jedyna lokalizacja SKO."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
