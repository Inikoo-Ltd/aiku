    "· already placed, not counted": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· вече разположено, не е преброено"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· už umístěno, nepočítá se"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· bereits eingelagert, nicht gezählt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· ya ubicado, no contado"
