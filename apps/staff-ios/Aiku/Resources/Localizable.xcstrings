    "If shipping rules lock a shipper, it is pre-selected and changing it asks “Override the locked shipper?”. If the customer chose the shipper, customer services must change it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ако правилата за доставка заключват превозвач, той е предварително избран и смяната му пита „Да се замени ли заключеният превозвач?“. Ако клиентът е избрал превозвача, обслужване на клиенти трябва да го смени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokud pravidla dopravy uzamknou přepravce, je předvybrán a jeho změna se zeptá “Přepsat uzamčeného přepravce?”. Pokud přepravce zvolil zákazník, musí ho změnit zákaznický servis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn Versandregeln einen Versanddienstleister sperren, ist er vorausgewählt und eine Änderung fragt „Sperre des Versenders aufheben?“. Hat der Kunde den Versanddienstleister gewählt, muss der Kundendienst ihn ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si las reglas de envío fijan un transportista, se preselecciona y al cambiarlo se pregunta “¿Cambiar el transportista fijado?”. Si el cliente eligió el transportista, debe cambiarlo servicio al cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si les règles d’expédition verrouillent un transporteur, il est présélectionné et le changer demande « Remplacer le transporteur verrouillé ? ». Si le client a choisi le transporteur, le service client doit le changer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर शिपिंग नियम किसी कूरियर को लॉक करते हैं, तो वह पहले से चुना होता है और उसे बदलने पर पूछा जाता है “लॉक किए गए कूरियर को ओवरराइड करें?”। अगर ग्राहक ने कूरियर चुना है, तो ग्राहक सेवा को उसे बदलना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ako pravila dostave zaključaju prijevoznika, on je unaprijed odabran, a njegova promjena pita „Zaobići zaključanog prijevoznika?”. Ako je prijevoznika odabrao kupac, mora ga promijeniti korisnička služba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha a szállítási szabályok zárolnak egy futárszolgálatot, az előre ki van választva, és módosításakor megjelenik a kérdés: „Felülírja a zárolt futárszolgálatot?”. Ha az ügyfél választotta a futárszolgálatot, az ügyfélszolgálatnak kell módosítania."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika aturan pengiriman mengunci ekspedisi, ekspedisi itu sudah dipilih dan menggantinya akan menanyakan “Ganti ekspedisi yang terkunci?”. Jika pelanggan yang memilih ekspedisi, layanan pelanggan yang harus menggantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se le regole di spedizione bloccano un corriere, questo è preselezionato e cambiarlo chiede “Sostituire il corriere bloccato?”. Se il cliente ha scelto il corriere, deve cambiarlo il servizio clienti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配送ルールで配送業者が固定されている場合は事前に選択され、変更すると「固定された配送業者を上書きしますか？」と確認されます。顧客が配送業者を選んだ場合は、カスタマーサービスが変更する必要があります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja piegādes noteikumi bloķē pārvadātāju, tas ir iepriekš izvēlēts, un, to mainot, tiek jautāts “Aizstāt bloķēto pārvadātāju?”. Ja pārvadātāju izvēlējās klients, tas jāmaina klientu apkalpošanai."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ढुवानी नियमले कुनै ढुवानीकर्ता लक गरेमा, त्यो पहिले नै छानिएको हुन्छ र बदल्दा “लक गरिएको ढुवानी कम्पनी ओभरराइड गर्ने?” भनी सोधिन्छ। ग्राहकले ढुवानीकर्ता छानेको भए, ग्राहक सेवाले बदल्नुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als verzendregels een vervoerder vastzetten, is die vooraf geselecteerd en vraagt wijzigen “De vastgezette vervoerder overschrijven?”. Als de klant de vervoerder heeft gekozen, moet de klantenservice die wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeśli reguły wysyłki blokują przewoźnika, jest on wstępnie wybrany, a jego zmiana wywołuje pytanie “Ominąć zablokowanego przewoźnika?”. Jeśli przewoźnika wybrał klient, zmienić go musi obsługa klienta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se as regras de envio bloquearem uma transportadora, ela fica pré-selecionada e alterá-la pergunta “Substituir a transportadora bloqueada?”. Se o cliente escolheu a transportadora, o apoio ao cliente tem de a alterar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dacă regulile de expediere blochează un transportator, acesta este preselectat, iar schimbarea lui întreabă „Înlocuiești transportatorul blocat?”. Dacă transportatorul a fost ales de client, serviciul clienți trebuie să-l schimbe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ak pravidlá dopravy uzamknú prepravcu, je vopred vybraný a pri jeho zmene sa zobrazí otázka „Prepísať uzamknutého prepravcu?“. Ak prepravcu zvolil zákazník, musí ho zmeniť zákaznícky servis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om fraktregler låser en transportör är den förvald och om du byter den får du frågan ”Åsidosätt den låsta transportören?”. Om kunden valde transportören måste kundtjänst ändra den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönderim kuralları bir kargo firmasını kilitliyorsa, o firma önceden seçilir ve değiştirmek “Kilitli kargo firması geçersiz kılınsın mı?” sorusunu sorar. Kargo firmasını müşteri seçtiyse, değişikliği müşteri hizmetleri yapmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Якщо правила доставки фіксують перевізника, його вибрано заздалегідь, а під час зміни з’явиться запит «Замінити зафіксованого перевізника?». Якщо перевізника вибрав клієнт, змінити його має служба підтримки клієнтів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果配送规则锁定了承运商，则会预先选中，更改时会询问“覆盖锁定的承运商？”。如果承运商是客户选择的，则必须由客服更改。"
          }
        }
      }
    },
    "If the order is replaced, these picks can be reused on the new delivery note. Cancelling needs a dispatching supervisor, an org admin, or order/CRM edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ако поръчката бъде заменена, тези комплектовани артикули могат да се използват отново в новата стокова разписка. Отказът изисква супервайзор по експедиция, администратор на организацията или права за редакция на поръчки/CRM."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokud bude objednávka nahrazena, lze tato vychystání znovu použít v novém dodacím listu. Zrušení vyžaduje vedoucího expedice, správce organizace nebo oprávnění upravovat objednávky/CRM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird die Bestellung ersetzt, können diese Kommissionierungen im neuen Lieferschein wiederverwendet werden. Stornieren erfordert einen Versandleiter, einen Org-Admin oder Rechte zum Bearbeiten von Bestellungen/CRM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si se sustituye el pedido, estas preparaciones se pueden reutilizar en el nuevo albarán. Para cancelar se necesita un supervisor de expedición, un administrador de la organización o permisos de edición de pedidos/CRM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si la commande est remplacée, ces préparations peuvent être réutilisées sur le nouveau bon de livraison. L’annulation nécessite un superviseur de l’expédition, un administrateur de l’organisation ou des droits de modification commandes/CRM."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर ऑर्डर बदला जाता है, तो ये पिक नए डिलीवरी नोट पर फिर से उपयोग हो सकते हैं। रद्द करने के लिए डिस्पैचिंग पर्यवेक्षक, संगठन प्रशासक, या ऑर्डर/CRM संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ako se narudžba zamijeni, ova branja mogu se ponovno iskoristiti na novoj otpremnici. Za otkazivanje je potreban nadzornik otpreme, administrator organizacije ili prava uređivanja narudžbi/CRM-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha a rendelést pótolják, ezek a komissiózások felhasználhatók az új szállítólevélen. A törléshez kiszállítási felügyelő, szervezeti adminisztrátor vagy rendelés/CRM-szerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika pesanan diganti, hasil picking ini dapat dipakai ulang di surat jalan baru. Pembatalan memerlukan pengawas pengiriman, admin organisasi, atau hak edit pesanan/CRM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se l’ordine viene sostituito, questi prelievi possono essere riutilizzati sulla nuova bolla di consegna. L’annullamento richiede un supervisore della spedizione, un amministratore dell’organizzazione o i permessi di modifica ordini/CRM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "注文が再送される場合、これらのピッキングは新しい納品書で再利用できます。取消には出荷スーパーバイザー、組織管理者、または注文/CRMの編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja pasūtījums tiek aizstāts, šīs nokomplektētās preces var izmantot jaunajā piegādes pavadzīmē. Atcelšanai nepieciešams nosūtīšanas vadītājs, organizācijas administrators vai pasūtījumu/CRM labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अर्डर प्रतिस्थापन भएमा, यी पिकहरू नयाँ डेलिभरी नोटमा पुनः प्रयोग गर्न सकिन्छ। रद्द गर्न प्रेषण सुपरभाइजर, संस्था प्रशासक, वा अर्डर/CRM सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als de bestelling wordt vervangen, kunnen deze picks op de nieuwe pakbon worden hergebruikt. Annuleren vereist een verzendsupervisor, een org-beheerder of bewerkrechten voor bestellingen/CRM."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeśli zamówienie zostanie zastąpione, te skompletowane pozycje można wykorzystać ponownie w nowym dowodzie dostawy. Anulowanie wymaga kierownika wysyłki, administratora organizacji lub uprawnień do edycji zamówień/CRM."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se a encomenda for substituída, estas preparações podem ser reutilizadas na nova guia de remessa. Cancelar requer um supervisor de expedição, um administrador da organização ou permissões de edição de encomendas/CRM."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dacă comanda este înlocuită, aceste culegeri pot fi refolosite pe noua notă de livrare. Anularea necesită un supervizor de expediere, un administrator al organizației sau drepturi de editare comenzi/CRM."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ak sa objednávka nahradí, tieto vychystania možno znova použiť v novom dodacom liste. Zrušenie vyžaduje vedúceho expedície, správcu organizácie alebo práva na úpravu objednávok/CRM."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om ordern ersätts kan dessa plock återanvändas på den nya följesedeln. Att avbryta kräver en utleveransansvarig, en organisationsadministratör eller redigeringsbehörighet för order/CRM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sipariş yedek gönderiyle değiştirilirse, bu toplamalar yeni irsaliyede yeniden kullanılabilir. İptal etmek için sevkiyat süpervizörü, organizasyon yöneticisi veya sipariş/CRM düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Якщо замовлення замінять, ці зібрані позиції можна використати в новій накладній. Для скасування потрібен керівник відправлення, адміністратор організації або права на редагування замовлень/CRM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果订单被替换，这些拣货可在新发货单上重复使用。取消需要发货主管、组织管理员或订单/CRM 编辑权限。"
          }
        }
      }
    },
    "Image sent in the conversation": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изображение, изпратено в разговора"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obrázek odeslaný v konverzaci"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In der Unterhaltung gesendetes Bild"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imagen enviada en la conversación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Image envoyée dans la conversation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बातचीत में भेजी गई छवि"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
