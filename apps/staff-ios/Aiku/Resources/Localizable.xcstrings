    "The carrier is not told: cancel the label with them if it was already booked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Превозвачът не се уведомява: откажете етикета при него, ако вече е заявен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přepravce nebude informován: pokud byl štítek už rezervován, zrušte ho u něj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Versanddienstleister wird nicht benachrichtigt: Stornieren Sie das Etikett bei ihm, falls es bereits gebucht wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se avisa al transportista: cancele la etiqueta con él si ya estaba reservada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le transporteur n’est pas prévenu : annulez l’étiquette auprès de lui si elle a déjà été réservée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कूरियर को सूचना नहीं दी जाती: अगर लेबल पहले से बुक है तो उनके साथ उसे रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijevoznik nije obaviješten: otkažite naljepnicu kod njega ako je već rezervirana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fuvarozó nem kap értesítést: ha a címkét már lefoglalták, törölje náluk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurir tidak diberi tahu: batalkan label dengan kurir jika sudah dipesan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il corriere non viene avvisato: se l’etichetta era già stata prenotata, la annulli presso il corriere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配送業者には通知されません。すでに予約済みの場合は、配送業者側でラベルを取り消してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pārvadātājam netiek paziņots: ja etiķete jau bija rezervēta, atceliet to pie pārvadātāja."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ढुवानीकर्तालाई जानकारी दिइँदैन: लेबल पहिल्यै बुक भइसकेको भए उनीहरूसँग रद्द गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vervoerder wordt niet ingelicht: annuleer het label bij hen als het al was geboekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przewoźnik nie zostanie powiadomiony: anuluj u niego etykietę, jeśli została już zarezerwowana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A transportadora não é avisada: cancele a etiqueta junto dela se já tiver sido reservada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transportatorul nu este anunțat: anulează eticheta la el dacă a fost deja rezervată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepravca nie je informovaný: ak už bol štítok zarezervovaný, zrušte ho u neho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transportören meddelas inte: avboka etiketten hos dem om den redan var bokad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kargo firmasına bildirilmez: etiket zaten oluşturulduysa onlar üzerinden iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
