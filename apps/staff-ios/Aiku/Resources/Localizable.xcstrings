    "Pick it, mark it not picked or set it as waiting. Then Set as picked appears.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вземете го, маркирайте го като несъбрано или го задайте в изчакване. След това се появява „Маркирай като събрано“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystejte ho, označte jako nevychystaný, nebo nastavte jako čekající. Poté se zobrazí Nastavit jako vychystané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommissionieren Sie sie, markieren Sie sie als nicht kommissioniert oder als wartend. Dann erscheint „Als kommissioniert markieren“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepárela, márquela como no preparada o márquela como en espera. Después aparece Marcar como preparado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Préparez-la, marquez-la comme non préparée ou définissez-la comme en attente. Marquer comme préparé apparaît ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे पिक करें, पिक नहीं किया गया चिह्नित करें या प्रतीक्षा में सेट करें। फिर पिक किया के रूप में सेट करें दिखाई देगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uberite, označite kao nije ubrano ili postavite kao čekanje. Tada se pojavljuje Označi kao ubrano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komissiózza, jelölje nem komissiózottnak, vagy állítsa várakozóra. Ezután megjelenik a Komissiózottnak jelölés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ambil, tandai tidak diambil, atau tandai sebagai menunggu. Setelah itu Tandai sebagai sudah diambil akan muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La prelevi, la segni come non prelevata o la imposti come in attesa. Poi compare Imposta come prelevato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピッキングするか、未ピッキングにするか、待機中にしてください。すると「ピッキング済みにする」が表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komplektējiet to, atzīmējiet kā nekomplektētu vai kā gaidošu. Tad parādīsies Atzīmēt kā komplektētu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यसलाई पिक गर्नुहोस्, पिक नगरिएको भनी चिन्ह लगाउनुहोस् वा प्रतीक्षारत रूपमा सेट गर्नुहोस्। त्यसपछि “पिक गरिएको रूपमा सेट गर्नुहोस्” देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pick hem, markeer hem als niet gepickt of stel hem in als wachtend. Daarna verschijnt Instellen als gepickt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skompletuj, oznacz jako nieskompletowane lub ustaw jako oczekujące. Wtedy pojawi się Ustaw jako skompletowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepare-a, marque-a como não preparada ou defina-a como em espera. Depois aparece Definir como preparado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culegeți-o, marcați-o ca neculeasă sau setați-o ca în așteptare. Apoi apare Setați ca cules."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystajte ho, označte ako nevychystané alebo nastavte ako čakajúce. Potom sa zobrazí Nastaviť ako vychystané."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plocka den, markera den som ej plockad eller ställ in den som väntande. Då visas Markera som plockad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplayın, toplanmadı olarak işaretleyin veya beklemeye alın. Ardından Toplandı olarak işaretle görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зберіть його, позначте як не зібране або встановіть як очікування. Тоді з'явиться «Позначити як зібрано»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拣货、标记为未拣货或设为等待，之后会出现“设为已拣货”。"
          }
        }
      }
    },
