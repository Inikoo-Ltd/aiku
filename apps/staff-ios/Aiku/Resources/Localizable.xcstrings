    "Ticked by default when this would be the SKO’s only location.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отметнато по подразбиране, когато това би била единствената локация на SKO."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ve výchozím stavu zaškrtnuto, pokud by to bylo jediné umístění SKO."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
