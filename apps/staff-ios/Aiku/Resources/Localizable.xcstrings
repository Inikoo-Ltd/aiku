            "value": "Len kým nie je nič umiestnené"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bara så länge inget är placerat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
