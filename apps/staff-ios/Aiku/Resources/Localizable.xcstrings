          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不会通知承运商：如果已预订标签，请与承运商取消。"
          }
        }
      }
    },
    "The carrier refused this address. Fix it, then the shipment is tried again with the same shipper. Changes apply to this delivery note’s shipping only.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Куриерът отказа този адрес. Коригирайте го и пратката ще се опита отново със същия куриер. Промените важат само за доставката по тази стокова разписка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopravce tuto adresu odmítl. Opravte ji a zásilka se zkusí znovu se stejným přepravcem. Změny se týkají pouze dopravy tohoto dodacího listu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Versanddienstleister hat diese Adresse abgelehnt. Korrigieren Sie sie, dann wird die Sendung mit demselben Versender erneut versucht. Änderungen gelten nur für den Versand dieses Lieferscheins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El transportista ha rechazado esta dirección. Corríjala y el envío se volverá a intentar con el mismo transportista. Los cambios solo se aplican al envío de este albarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le transporteur a refusé cette adresse. Corrigez-la : l'expédition sera ensuite retentée avec le même transporteur. Les modifications ne s'appliquent qu'à l'expédition de ce bon de livraison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कूरियर ने यह पता अस्वीकार कर दिया। इसे ठीक करें, फिर उसी कूरियर के साथ शिपमेंट फिर से आज़माया जाएगा। बदलाव केवल इस डिलीवरी नोट की शिपिंग पर लागू होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijevoznik je odbio ovu adresu. Ispravite je, a zatim se pošiljka ponovno pokušava s istim prijevoznikom. Promjene vrijede samo za dostavu ove otpremnice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A futárszolgálat elutasította ezt a címet. Javítsa ki, majd a szállítmány újra megpróbálkozik ugyanazzal a futárszolgálattal. A módosítások csak ennek a szállítólevélnek a szállítására vonatkoznak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurir menolak alamat ini. Perbaiki, lalu kiriman akan dicoba lagi dengan ekspedisi yang sama. Perubahan hanya berlaku untuk pengiriman surat jalan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il corriere ha rifiutato questo indirizzo. Lo corregga: la spedizione verrà poi ritentata con lo stesso corriere. Le modifiche valgono solo per la spedizione di questa bolla di consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配送業者がこの住所を受け付けませんでした。修正すると、同じ配送業者で配送を再試行します。変更はこの出荷伝票の配送にのみ適用されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pārvadātājs noraidīja šo adresi. Izlabojiet to, un sūtījums tiks mēģināts vēlreiz ar to pašu pārvadātāju. Izmaiņas attiecas tikai uz šīs piegādes pavadzīmes piegādi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुरियरले यो ठेगाना अस्वीकार गर्यो। यसलाई सच्याउनुहोस्, त्यसपछि उही ढुवानीकर्तासँग ढुवानी फेरि प्रयास गरिन्छ। परिवर्तनहरू यो डेलिभरी नोटको ढुवानीमा मात्र लागू हुन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vervoerder heeft dit adres geweigerd. Corrigeer het, daarna wordt de zending opnieuw geprobeerd met dezelfde verzender. Wijzigingen gelden alleen voor de verzending van deze leveringsbon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przewoźnik odrzucił ten adres. Popraw go, a przesyłka zostanie ponownie utworzona u tego samego przewoźnika. Zmiany dotyczą tylko wysyłki tego dowodu dostawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A transportadora recusou este endereço. Corrija-o e o envio será tentado novamente com a mesma transportadora. As alterações aplicam-se apenas ao envio desta guia de remessa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transportatorul a refuzat această adresă. Corectați-o, apoi expediția este încercată din nou cu același transportator. Modificările se aplică doar livrării acestei note de livrare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopravca túto adresu odmietol. Opravte ju a zásielka sa skúsi znova s rovnakým prepravcom. Zmeny sa týkajú iba dopravy tohto dodacieho listu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transportören godkände inte den här adressen. Rätta den, så görs ett nytt försök med försändelsen hos samma fraktbolag. Ändringarna gäller endast frakten för den här följesedeln."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kargo firması bu adresi reddetti. Düzeltin; ardından gönderi aynı kargo firmasıyla yeniden denenir. Değişiklikler yalnızca bu irsaliyenin gönderimine uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перевізник відхилив цю адресу. Виправте її, і відвантаження буде створено повторно з тим самим перевізником. Зміни стосуються лише доставки цієї накладної."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "承运商拒绝了此地址。修正后将使用同一承运商重新尝试创建货件。更改仅适用于此发货单的运输。"
          }
        }
      }
    },
    "The change is copied to the order too": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Промяната се копира и в поръчката"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změna se zkopíruje i do objednávky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Änderung wird auch in die Bestellung übernommen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El cambio también se copia en el pedido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La modification est aussi reportée sur la commande"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बदलाव ऑर्डर में भी कॉपी हो जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Promjena se kopira i na narudžbu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A módosítás a rendelésre is átmásolódik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perubahan juga disalin ke pesanan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La modifica viene copiata anche sull’ordine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更は注文にもコピーされます"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izmaiņa tiek nokopēta arī pasūtījumā"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिवर्तन अर्डरमा पनि कपी हुन्छ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De wijziging wordt ook naar de bestelling gekopieerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiana zostanie skopiowana również do zamówienia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A alteração também é copiada para a encomenda"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modificarea este copiată și în comandă"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmena sa skopíruje aj do objednávky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändringen kopieras även till ordern"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değişiklik siparişe de kopyalanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зміну також буде скопійовано в замовлення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改也会同步到订单"
          }
        }
      }
    },
