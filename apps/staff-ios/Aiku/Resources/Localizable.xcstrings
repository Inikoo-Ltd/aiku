          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poproś kierownika o jej zainstalowanie, gdy będzie to możliwe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peça ao seu supervisor para a instalar quando for conveniente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rugați-l pe supervizor să o instaleze când este posibil."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Požiadajte vedúceho, aby ju nainštaloval, keď sa mu to bude hodiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Be din arbetsledare att installera den när det passar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygun olduğunda yüklemesini süpervizörünüzden isteyin."
