    "Packing is undone, the trolley and picked bay are freed, and the order is rolled back unless it is already invoiced.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Опаковането се отменя, количката и пикинг зоната се освобождават, а поръчката се връща назад, освен ако вече не е фактурирана."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Balení se zruší, vozík a odkládací pozice se uvolní a objednávka se vrátí zpět, pokud už není vyfakturovaná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Verpacken wird rückgängig gemacht, Wagen und Bereitstellungszone werden freigegeben, und die Bestellung wird zurückgesetzt, sofern sie nicht bereits in Rechnung gestellt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se deshace el embalaje, se liberan el carro y la zona de preparados, y el pedido se revierte salvo que ya esté facturado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’emballage est annulé, le chariot et la zone des commandes préparées sont libérés, et la commande est rétablie sauf si elle est déjà facturée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पैकिंग पूर्ववत हो जाती है, ट्रॉली और पिक्ड बे खाली हो जाते हैं, और ऑर्डर वापस ले लिया जाता है जब तक उसका इनवॉइस न बन चुका हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pakiranje se poništava, kolica i zona ubrane robe oslobađaju se, a narudžba se vraća unatrag osim ako je već fakturirana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A csomagolás visszavonásra kerül, a kocsi és a komissiózott rekesz felszabadul, a rendelés pedig visszaáll, hacsak nincs már kiszámlázva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengemasan dibatalkan, troli dan bay hasil picking dikosongkan, dan pesanan dikembalikan kecuali sudah ditagih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’imballaggio viene annullato, il carrello e l’area di consolidamento vengono liberati e l’ordine viene ripristinato, a meno che non sia già stato fatturato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "梱包が取り消され、台車とピッキング済み置き場が解放され、請求書が作成済みでない限り注文は元に戻されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iepakošana tiek atsaukta, ratiņi un savākto preču vieta tiek atbrīvoti, un pasūtījums tiek atgriezts iepriekšējā stāvoklī, ja vien par to jau nav izrakstīts rēķins."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्याकिङ पूर्ववत हुन्छ, ट्रली र पिक गरिएको बे खाली हुन्छन्, र इनभ्वाइस बनिसकेको छैन भने अर्डर पहिलेको अवस्थामा फर्काइन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het inpakken wordt ongedaan gemaakt, de trolley en het gepickte vak worden vrijgegeven en de bestelling wordt teruggedraaid, tenzij die al is gefactureerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pakowanie zostanie cofnięte, wózek i strefa skompletowanych zamówień zostaną zwolnione, a zamówienie zostanie wycofane, chyba że zostało już zafakturowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A embalagem é anulada, o carrinho e a zona de preparados são libertados e a encomenda é revertida, exceto se já estiver faturada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ambalarea este anulată, căruciorul și zona comenzi culese sunt eliberate, iar comanda este readusă la starea anterioară, dacă nu este deja facturată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Balenie sa vráti späť, vozík a miesto pre vychystaný tovar sa uvoľnia a objednávka sa vráti späť, ak ešte nie je fakturovaná."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Packningen ångras, vagnen och plockfacket frigörs och ordern återställs om den inte redan är fakturerad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paketleme geri alınır, toplama arabası ve toplanan siparişler alanı boşaltılır ve sipariş, faturalanmadıysa geri alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пакування скасовується, візок і відсік зібраного звільняються, а замовлення відкочується, якщо за ним ще не виставлено рахунок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将撤销打包，释放拣货车和已拣货区，订单会回滚（已开具发票的除外）。"
          }
        }
      }
    },
