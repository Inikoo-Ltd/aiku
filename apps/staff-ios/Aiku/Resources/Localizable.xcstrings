    "Checking and placing items needs goods-in edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверката и разполагането на артикули изискват права за редакция в приемане на стока."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrola a umisťování položek vyžaduje oprávnění upravovat příjem zboží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfen und Einlagern von Artikeln erfordert Rechte zum Bearbeiten des Wareneingangs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprobar y ubicar artículos requiere permisos de edición de recepción de mercancías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifier et ranger des articles nécessite les droits de modification de la réception."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आइटम जाँचने और रखने के लिए माल प्राप्ति संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provjera i uskladištenje artikala zahtijevaju prava uređivanja ulaza robe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A tételek ellenőrzéséhez és elhelyezéséhez áruátvételi szerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memeriksa dan menempatkan barang memerlukan hak edit barang masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verificare e sistemare gli articoli richiede i permessi di modifica del ricevimento merci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "商品の確認と格納には入荷編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preču pārbaudei un novietošanai nepieciešamas preču pieņemšanas labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वस्तु जाँच गर्न र राख्न सामान प्राप्ति सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artikelen controleren en plaatsen vereist bewerkrechten voor Goederen in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdzanie i rozlokowywanie pozycji wymaga uprawnień do edycji przyjęć towarów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verificar e armazenar artigos requer permissões de edição da receção de mercadorias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verificarea și amplasarea articolelor necesită drepturi de editare pentru intrări de mărfuri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrola a umiestňovanie položiek vyžaduje práva na úpravu príjmu tovaru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
