    "You already have a pending adjustment request for this date.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вече имате чакаща заявка за корекция за тази дата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro toto datum již máte nevyřízenou žádost o úpravu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für dieses Datum haben Sie bereits einen ausstehenden Korrekturantrag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tiene una solicitud de ajuste pendiente para esta fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà une demande de modification en attente pour cette date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस तारीख के लिए आपका पहले से एक लंबित समायोजन अनुरोध है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već imate zahtjev za prilagodbu na čekanju za ovaj datum."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már van egy függőben lévő korrekciós kérelme erre a dátumra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah memiliki permintaan penyesuaian yang tertunda untuk tanggal ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha già una richiesta di rettifica in sospeso per questa data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この日付にはすでに承認待ちの調整申請があります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jums jau ir gaidošs korekcijas pieprasījums par šo datumu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो मितिका लागि तपाईंको समायोजन अनुरोध पहिले नै बाँकी छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je hebt al een openstaand correctieverzoek voor deze datum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz już oczekujący wniosek o korektę na tę datę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já tem um pedido de ajuste pendente para esta data."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ai deja o solicitare de ajustare în așteptare pentru această dată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre tento dátum už máte čakajúcu žiadosť o úpravu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har redan en väntande justeringsbegäran för detta datum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarih için zaten bekleyen bir düzeltme talebiniz var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас уже є запит на коригування, що очікує розгляду, на цю дату."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你在此日期已有待处理的调整申请。"
          }
        }
