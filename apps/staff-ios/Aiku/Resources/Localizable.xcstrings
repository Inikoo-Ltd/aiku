            "state": "needs_review",
            "value": "Skanning plockar bara medan följesedeln plockas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarama yalnızca irsaliye toplanırken toplama yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
