    "Picked bays need internet. Check Wi-Fi and try again.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пикинг зоните изискват интернет. Проверете Wi-Fi и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odkládací pozice vyžadují internet. Zkontrolujte Wi-Fi a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereitstellungszonen brauchen Internet. Prüfen Sie das WLAN und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las zonas de preparados necesitan internet. Compruebe la wifi y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les zones des commandes préparées nécessitent Internet. Vérifiez le Wi-Fi et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिक्ड बे के लिए इंटरनेट चाहिए। Wi-Fi जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zone ubrane robe zahtijevaju internet. Provjerite Wi-Fi i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózott rekeszekhez internet szükséges. Ellenőrizze a Wi-Fit, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bay hasil picking memerlukan internet. Periksa Wi-Fi dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le aree di consolidamento richiedono internet. Controlli il Wi-Fi e riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピッキング済み置き場にはインターネット接続が必要です。Wi-Fiを確認してもう一度お試しください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Savākto preču vietām nepieciešams internets. Pārbaudiet Wi-Fi un mēģiniet vēlreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिक गरिएका बेहरूका लागि इन्टरनेट चाहिन्छ। Wi-Fi जाँच गरी फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gepickte vakken vereisen internet. Controleer de wifi en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strefy skompletowanych zamówień wymagają internetu. Sprawdź Wi-Fi i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As zonas de preparados precisam de internet. Verifique o Wi-Fi e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zonele comenzi culese necesită internet. Verifică Wi-Fi-ul și încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miesta pre vychystaný tovar vyžadujú internet. Skontrolujte Wi-Fi a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plockfack kräver internet. Kontrollera wifi och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplanan siparişler alanları için internet gerekir. Wi-Fi’yi kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для відсіків зібраного потрібен інтернет. Перевірте Wi-Fi і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已拣货区需要联网。请检查 Wi-Fi 后重试。"
          }
        }
      }
    },
