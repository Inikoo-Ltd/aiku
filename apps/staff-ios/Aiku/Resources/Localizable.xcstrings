    "That setup expired, so here is a new key. Add it to your authenticator app, then enter the code it shows.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тази настройка е изтекла, затова ето нов ключ. Добавете го в приложението за удостоверяване, след което въведете кода, който то показва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Platnost nastavení vypršela, proto zde je nový klíč. Přidejte ho do ověřovací aplikace a pak zadejte kód, který zobrazí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Einrichtung ist abgelaufen, daher erhalten Sie hier einen neuen Schlüssel. Fügen Sie ihn Ihrer Authenticator-App hinzu und geben Sie dann den angezeigten Code ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esa configuración ha caducado, así que aquí tiene una clave nueva. Añádala a su aplicación de autenticación y luego introduzca el código que muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette configuration a expiré, voici donc une nouvelle clé. Ajoutez-la à votre application d'authentification, puis saisissez le code qu'elle affiche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह सेटअप समाप्त हो गया था, इसलिए यह नई कुंजी है। इसे अपने ऑथेंटिकेटर ऐप में जोड़ें, फिर उसमें दिखाया गया कोड दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To je postavljanje isteklo pa evo novog ključa. Dodajte ga u aplikaciju za autentifikaciju, zatim unesite kôd koji ona prikaže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ez a beállítás lejárt, ezért itt egy új kulcs. Adja hozzá a hitelesítő alkalmazáshoz, majd írja be az ott megjelenő kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Penyiapan tersebut sudah kedaluwarsa, jadi ini kunci baru. Tambahkan ke aplikasi autentikator Anda, lalu masukkan kode yang ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quella configurazione è scaduta, quindi ecco una nuova chiave. La aggiunga all'app di autenticazione, poi inserisca il codice che mostra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "セットアップの有効期限が切れたため、新しいキーを発行しました。認証アプリに追加して、表示されたコードを入力してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iepriekšējās iestatīšanas derīgums beidzās, tāpēc šeit ir jauna atslēga. Pievienojiet to autentifikācijas lietotnei un ievadiet tajā redzamo kodu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "त्यो सेटअपको म्याद सकियो, त्यसैले यो नयाँ कुञ्जी हो। यसलाई आफ्नो अथेन्टिकेटर एपमा थप्नुहोस्, त्यसपछि त्यसले देखाएको कोड राख्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die instelling is verlopen, dus hier is een nieuwe sleutel. Voeg hem toe aan je authenticator-app en vul daarna de code in die de app toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poprzednia konfiguracja wygasła, więc oto nowy klucz. Dodaj go do aplikacji uwierzytelniającej, a następnie wpisz wyświetlony kod."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essa configuração expirou, por isso aqui está uma chave nova. Adicione-a à sua aplicação de autenticação e depois introduza o código que ela mostra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configurarea anterioară a expirat, așa că iată o cheie nouă. Adăugați-o în aplicația de autentificare, apoi introduceți codul afișat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Platnosť nastavenia vypršala, preto tu je nový kľúč. Pridajte ho do overovacej aplikácie a potom zadajte kód, ktorý zobrazí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den konfigurationen har gått ut, så här är en ny nyckel. Lägg till den i din autentiseringsapp och ange sedan koden som visas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kurulumun süresi doldu, işte yeni bir anahtar. Doğrulama uygulamanıza ekleyin, ardından gösterdiği kodu girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Термін дії налаштування минув, тому ось новий ключ. Додайте його до застосунку автентифікації, а потім введіть код, який він покаже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "该设置已过期，这是新的密钥。请将其添加到身份验证器应用，然后输入显示的验证码。"
          }
        }
      }
    },
