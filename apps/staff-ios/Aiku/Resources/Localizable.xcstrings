    "Boxes must be a whole number of 1 or more.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кашоните трябва да са цяло число, 1 или повече."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Počet krabic musí být celé číslo 1 nebo více."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boxen müssen eine ganze Zahl von 1 oder mehr sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las cajas deben ser un número entero de 1 o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le nombre de boîtes doit être un nombre entier égal ou supérieur à 1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बॉक्स 1 या उससे अधिक की पूर्ण संख्या होनी चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Broj kutija mora biti cijeli broj od 1 ili više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A dobozok száma 1 vagy annál nagyobb egész szám legyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jumlah kotak harus bilangan bulat 1 atau lebih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le scatole devono essere un numero intero pari o superiore a 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "箱数は1以上の整数にしてください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kastu skaitam jābūt veselam skaitlim 1 vai vairāk."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बाकसहरू 1 वा सोभन्दा बढीको पूर्ण सङ्ख्या हुनुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozen moet een heel getal van 1 of meer zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liczba pudełek musi być liczbą całkowitą równą 1 lub większą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As caixas têm de ser um número inteiro igual ou superior a 1."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numărul de cutii trebuie să fie un număr întreg de 1 sau mai mare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Počet krabíc musí byť celé číslo 1 alebo viac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Antalet lådor måste vara ett heltal på 1 eller mer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kutu sayısı 1 veya daha büyük bir tam sayı olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кількість коробок має бути цілим числом від 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "箱数必须是 1 或以上的整数。"
          }
        }
      }
    },
