    "No email on your account? Ask your manager to reset your password.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Няма имейл в акаунта ви? Помолете мениджъра си да нулира паролата ви."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nemáte u účtu e-mail? Požádejte nadřízeného o obnovení hesla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine E-Mail in Ihrem Konto? Bitten Sie Ihren Vorgesetzten, Ihr Passwort zurückzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Su cuenta no tiene correo electrónico? Pida a su gerente que restablezca su contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas d’e-mail sur votre compte ? Demandez à votre responsable de réinitialiser votre mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके खाते में ईमेल नहीं है? अपने मैनेजर से अपना पासवर्ड रीसेट करने को कहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nemate e-poštu na računu? Zamolite voditelja da vam ponovno postavi lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nincs e-mail-cím a fiókjában? Kérje meg a vezetőjét, hogy állítsa vissza a jelszavát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak ada email di akun Anda? Minta manajer Anda untuk mengatur ulang kata sandi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna email nel suo account? Chieda al suo responsabile di reimpostare la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントにメールアドレスがありませんか？マネージャーにパスワードのリセットを依頼してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jūsu kontā nav e-pasta? Lūdziet vadītājam atiestatīt paroli."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंको खातामा इमेल छैन? आफ्नो म्यानेजरलाई पासवर्ड रिसेट गर्न भन्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen e-mailadres op je account? Vraag je leidinggevende om je wachtwoord opnieuw in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak e-maila na koncie? Poproś przełożonego o zresetowanie hasła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não tem email na sua conta? Peça ao seu responsável para repor a palavra-passe."
          }
        },
        "ro": {
          "stringUnit": {
