    "Shipments are added once the delivery note is packed.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пратките се добавят, след като стоковата разписка бъде опакована."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zásilky se přidávají, jakmile je dodací list zabalený."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sendungen werden hinzugefügt, sobald der Lieferschein verpackt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los envíos se añaden cuando el albarán está embalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les expéditions sont ajoutées une fois le bon de livraison emballé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डिलीवरी नोट पैक होने के बाद शिपमेंट जोड़े जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pošiljke se dodaju nakon što je otpremnica spakirana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szállítmányok a szállítólevél becsomagolása után adhatók hozzá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiriman ditambahkan setelah surat jalan dikemas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le spedizioni si aggiungono quando la bolla di consegna è imballata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配送は納品書が梱包済みになると追加されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sūtījumi tiek pievienoti, kad piegādes pavadzīme ir iepakota."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डेलिभरी नोट प्याक भएपछि ढुवानी थपिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zendingen worden toegevoegd zodra de pakbon is ingepakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przesyłki są dodawane po zapakowaniu dowodu dostawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os envios são adicionados assim que a guia de remessa estiver embalada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Expedițiile se adaugă după ce nota de livrare este ambalată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zásielky sa pridávajú, keď je dodací list zabalený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Försändelser läggs till när följesedeln är packad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönderiler, irsaliye paketlendikten sonra eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відправлення додаються після пакування накладної."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发货单打包后即可添加货件。"
          }
        }
      }
    },
    "Shipments are added while the return is being picked or is picked, unless the customer collects.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пратките се добавят, докато връщането се комплектова или е комплектовано, освен ако клиентът не го взема лично."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zásilky se přidávají, když se vratka vychystává nebo je vychystaná, pokud si ji zákazník nevyzvedne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sendungen werden hinzugefügt, während die Rückgabe kommissioniert wird oder kommissioniert ist, außer der Kunde holt ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los envíos se añaden mientras la devolución se está preparando o ya está preparada, salvo que la recoja el cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les expéditions sont ajoutées pendant ou après la préparation du retour, sauf si le client vient le retirer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "शिपमेंट तब जोड़े जाते हैं जब वापसी पिक हो रही हो या पिक हो चुकी हो, जब तक ग्राहक खुद न ले जाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pošiljke se dodaju dok je povrat u branju ili je ubran, osim ako ga kupac preuzima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szállítmányok a visszaküldés komissiózása közben vagy után adhatók hozzá, kivéve, ha az ügyfél veszi át."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiriman ditambahkan saat pengembalian sedang di-picking atau sudah di-picking, kecuali pelanggan mengambil sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le spedizioni si aggiungono mentre il reso è in prelievo o è prelevato, a meno che il cliente non lo ritiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顧客が引き取る場合を除き、配送は返品のピッキング中またはピッキング済みのときに追加されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sūtījumi tiek pievienoti, kamēr atgriezums tiek komplektēts vai ir nokomplektēts, ja vien klients to neizņem pats."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फिर्ता पिक हुँदै गर्दा वा पिक भइसकेपछि ढुवानी थपिन्छ, ग्राहक आफैं लिन नआउने भएमा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zendingen worden toegevoegd terwijl de retour wordt gepickt of gepickt is, tenzij de klant afhaalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przesyłki są dodawane, gdy zwrot jest w trakcie kompletacji lub jest skompletowany, chyba że klient odbiera osobiście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os envios são adicionados enquanto a devolução está a ser preparada ou já preparada, exceto se o cliente recolher."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Expedițiile se adaugă cât timp returul este în curs de cules sau este cules, cu excepția cazului în care clientul îl ridică."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zásielky sa pridávajú počas vychystávania vrátenia alebo po jeho vychystaní, ak si ho zákazník nevyzdvihne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Försändelser läggs till medan returen plockas eller är plockad, om inte kunden hämtar själv."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönderiler, müşteri teslim almayacaksa iade toplanırken veya toplandığında eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відправлення додаються, поки повернення комплектується або вже зібране, якщо тільки клієнт не забирає його сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "退货在拣货中或已拣货时可添加货件，客户自提的除外。"
          }
        }
      }
    },
    "Shipments can’t be added to this delivery note now.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
