    "Trolleys are created in the web app.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Количките се създават в уеб приложението."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vozíky se vytvářejí ve webové aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wagen werden in der Web-App angelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los carros se crean en la aplicación web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les chariots se créent dans l'application web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ट्रॉलियाँ वेब ऐप में बनाई जाती हैं।"
          }
        },
        "hr": {
