    "Setting it as booked in needs the right to edit this fulfilment shop.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За маркиране като заприходена е нужно право за редактиране на този фулфилмънт магазин."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "K nastavení jako naskladněné potřebujete právo upravovat tento fulfilmentový obchod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Markieren als eingebucht benötigen Sie das Recht, diesen Fulfillment-Shop zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para marcarla como entrada registrada se necesita permiso para editar esta tienda de logística."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour la marquer comme réceptionnée, il faut le droit de modifier cette boutique logistique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे बुक इन के रूप में सेट करने के लिए इस फ़ुलफ़िलमेंट शॉप को संपादित करने का अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za označavanje kao uskladišteno potrebno je pravo uređivanja ove fulfilment trgovine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A bevételezettnek jelöléshez szerkesztési jog kell ehhez a fulfilment-áruházhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menandainya sudah masuk stok memerlukan hak untuk mengedit toko fulfillment ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per impostarla come registrata serve il permesso di modificare questo negozio logistica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入庫済みにするには、このフルフィルメントショップの編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lai atzīmētu kā iegrāmatotu, nepieciešamas tiesības labot šo fulfilment veikalu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यसलाई स्टकमा दर्ता गरिएको रूपमा सेट गर्न यो फुलफिलमेन्ट पसल सम्पादन गर्ने अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om dit als ingeboekt in te stellen, heb je het recht nodig om deze fulfilmentshop te bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oznaczenie jako przyjęte na stan wymaga uprawnień do edycji tego sklepu fulfilment."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para a definir como rececionada é necessária permissão para editar esta loja de logística."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setarea ca recepționat în stoc necesită dreptul de a edita acest magazin fulfilment."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na nastavenie ako naskladnené potrebujete právo upravovať tento fulfillmentový obchod."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
