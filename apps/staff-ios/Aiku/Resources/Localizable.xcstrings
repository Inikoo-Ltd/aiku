    "Only a dispatching supervisor, an org admin, or someone with order or CRM edit rights can cancel. Dispatched notes can’t be cancelled. Picks already made can be reused if the order gets a replacement delivery note.": {
      "extractionState": "manual"
    },
    "Only actions allowed for its state and your rights are shown": {
      "extractionState": "manual"
    },
    "Only delivery notes waiting to be picked, outside any picking session, can be chosen": {
      "extractionState": "manual"
    },
    "Only dispatching supervisors and org admins can send it back to picking. Resume picking (“nothing is waiting on this delivery note any more, carry on picking it”) appears once nothing is waiting.": {
      "extractionState": "manual"
    },
    "Only free trolleys can be added": {
      "extractionState": "manual"
    },
    "Only organisations and warehouses you have permission for are listed. Every screen, list and scan follows your choice.": {
      "extractionState": "manual"
    },
    "Only pending overtime requests can be edited.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само чакащи заявки за извънреден труд могат да бъдат редактирани."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravovat lze pouze nevyřízené žádosti o přesčasy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es können nur noch ausstehende Überstundenanträge bearbeitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se pueden editar las solicitudes de horas extra pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les demandes d'heures supplémentaires en attente peuvent être modifiées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल लंबित ओवरटाइम अनुरोध संपादित किए जा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogu se uređivati ​​samo zahtjevi za prekovremeni rad koji su na čekanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a függőben lévő túlórakérelmek szerkeszthetők."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pengajuan lembur yang tertunda yang dapat diedit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile modificare solo le richieste di straordinario in sospeso."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बाँकी ओभरटाइम अनुरोधहरू मात्र सम्पादन गर्न सकिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen openstaande overwerkverzoeken kunnen worden bewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytować można tylko oczekujące wnioski o nadgodziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os pedidos de horas extraordinárias pendentes podem ser editados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar cererile de ore suplimentare în așteptare pot fi editate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravovať je možné iba čakajúce žiadosti o nadčasy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast väntande övertidsförfrågningar kan redigeras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bekleyen fazla mesai talepleri düzenlenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна редагувати лише запити на понаднормову роботу, що очікують розгляду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能编辑待处理的加班申请。"
          }
        }
      }
    },
