    "Changes apply to this delivery note’s shipping only. A banned delivery address (listed in Shop settings) is flagged with a warning.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Промените се отнасят само за доставката по тази стокова разписка. Забранен адрес за доставка (посочен в настройките на магазина) се маркира с предупреждение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změny platí pouze pro dopravu tohoto dodacího listu. Zakázaná doručovací adresa (uvedená v nastavení obchodu) je označena varováním."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Änderungen gelten nur für den Versand dieses Lieferscheins. Eine gesperrte Lieferadresse (in den Shop-Einstellungen aufgeführt) wird mit einer Warnung markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los cambios solo afectan al envío de este albarán. Una dirección de entrega bloqueada (indicada en los ajustes de la tienda) se marca con un aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les modifications ne s’appliquent qu’à l’expédition de ce bon de livraison. Une adresse de livraison interdite (listée dans les paramètres de la boutique) est signalée par un avertissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बदलाव केवल इस डिलीवरी नोट की शिपिंग पर लागू होते हैं। प्रतिबंधित डिलीवरी पता (शॉप सेटिंग्स में सूचीबद्ध) चेतावनी के साथ चिह्नित होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Promjene vrijede samo za dostavu ove otpremnice. Zabranjena adresa dostave (navedena u postavkama trgovine) označena je upozorenjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A módosítások csak ennek a szállítólevélnek a szállítására vonatkoznak. A tiltott szállítási címet (a Bolt beállításaiban felsorolva) figyelmeztetés jelzi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perubahan hanya berlaku untuk pengiriman surat jalan ini. Alamat pengiriman yang diblokir (tercantum di pengaturan Toko) ditandai dengan peringatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modifiche valgono solo per la spedizione di questa bolla di consegna. Un indirizzo di consegna vietato (elencato nelle impostazioni del negozio) viene segnalato con un avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更はこの納品書の配送にのみ適用されます。禁止された配送先住所（ショップ設定に記載）には警告が表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izmaiņas attiecas tikai uz šīs piegādes pavadzīmes piegādi. Aizliegta piegādes adrese (norādīta veikala iestatījumos) tiek atzīmēta ar brīdinājumu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "परिवर्तन यो डेलिभरी नोटको ढुवानीमा मात्र लागू हुन्छ। प्रतिबन्धित डेलिभरी ठेगाना (पसल सेटिङमा सूचीबद्ध) चेतावनीसहित चिन्ह लगाइन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wijzigingen gelden alleen voor de verzending van deze pakbon. Een geblokkeerd afleveradres (vermeld in de winkelinstellingen) wordt met een waarschuwing gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiany dotyczą tylko wysyłki tego dowodu dostawy. Zablokowany adres dostawy (wymieniony w ustawieniach sklepu) jest oznaczany ostrzeżeniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As alterações aplicam-se apenas ao envio desta guia de remessa. Uma morada de entrega proibida (indicada nas definições da loja) é assinalada com um aviso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modificările se aplică doar expedierii acestei note de livrare. O adresă de livrare interzisă (listată în Setările magazinului) este semnalată cu un avertisment."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmeny sa týkajú len dopravy tohto dodacieho listu. Zakázaná dodacia adresa (uvedená v nastaveniach obchodu) je označená upozornením."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändringarna gäller bara frakten för den här följesedeln. En spärrad leveransadress (listad i butiksinställningarna) flaggas med en varning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değişiklikler yalnızca bu irsaliyenin gönderimi için geçerlidir. Yasaklı bir teslimat adresi (Mağaza ayarlarında listelenen) uyarıyla işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зміни стосуються лише доставки за цією накладною. Заборонену адресу доставки (зазначену в налаштуваннях магазину) буде позначено попередженням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改仅适用于此发货单的配送。被禁止的收货地址（列于店铺设置中）会显示警告标记。"
          }
        }
      }
    },
    "Changes the app language for you only.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Променя езика на приложението само за вас."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změní jazyk aplikace jen pro vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändert die App-Sprache nur für Sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia el idioma de la app solo para usted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Change la langue de l’application pour vous uniquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऐप की भाषा केवल आपके लिए बदलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mijenja jezik aplikacije samo za vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csak az Ön számára módosítja az alkalmazás nyelvét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengubah bahasa aplikasi hanya untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia la lingua dell’app solo per lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのアプリの言語のみを変更します。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maina lietotnes valodu tikai jums."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एपको भाषा तपाईंका लागि मात्र बदल्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wijzigt de app-taal alleen voor jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmienia język aplikacji tylko dla Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altera o idioma da aplicação apenas para si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schimbă limba aplicației doar pentru tine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmení jazyk aplikácie len pre vás."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändrar appens språk bara för dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygulama dilini yalnızca sizin için değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Змінює мову застосунку лише для вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅为你更改应用语言。"
          }
        }
      }
    },
    "Changes the app language for you only. Product names, customer names and notes stay as they are in Aiku.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Променя езика на приложението само за вас. Имената на продукти, имената на клиенти и бележките остават както са в Aiku."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změní jazyk aplikace jen pro vás. Názvy produktů, jména zákazníků a poznámky zůstanou tak, jak jsou v Aiku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändert die App-Sprache nur für Sie. Produktnamen, Kundennamen und Notizen bleiben so, wie sie in Aiku sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia el idioma de la app solo para usted. Los nombres de productos, los nombres de clientes y las notas se mantienen como están en Aiku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Change la langue de l’application pour vous uniquement. Les noms de produits, noms de clients et notes restent tels qu’ils sont dans Aiku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऐप की भाषा केवल आपके लिए बदलता है। उत्पाद नाम, ग्राहक नाम और नोट्स वैसे ही रहते हैं जैसे Aiku में हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mijenja jezik aplikacije samo za vas. Nazivi proizvoda, imena kupaca i bilješke ostaju kakvi su u Aikuu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Csak az Ön számára módosítja az alkalmazás nyelvét. A terméknevek, ügyfélnevek és megjegyzések úgy maradnak, ahogy az Aikuban szerepelnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengubah bahasa aplikasi hanya untuk Anda. Nama produk, nama pelanggan, dan catatan tetap seperti di Aiku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia la lingua dell’app solo per lei. Nomi dei prodotti, nomi dei clienti e note restano come sono in Aiku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのアプリの言語のみを変更します。商品名、顧客名、メモはAikuでの表記のままです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maina lietotnes valodu tikai jums. Produktu nosaukumi, klientu vārdi un piezīmes paliek tādi paši kā Aiku."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एपको भाषा तपाईंका लागि मात्र बदल्छ। उत्पादनका नाम, ग्राहकका नाम र नोटहरू Aiku मा जस्तै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wijzigt de app-taal alleen voor jou. Productnamen, klantnamen en notities blijven zoals ze in Aiku staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmienia język aplikacji tylko dla Ciebie. Nazwy produktów, nazwy klientów i notatki pozostają takie jak w Aiku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altera o idioma da aplicação apenas para si. Os nomes de produtos, os nomes de clientes e as notas ficam como estão no Aiku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schimbă limba aplicației doar pentru tine. Numele produselor, numele clienților și notele rămân așa cum sunt în Aiku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmení jazyk aplikácie len pre vás. Názvy produktov, mená zákazníkov a poznámky zostanú tak, ako sú v Aiku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ändrar appens språk bara för dig. Produktnamn, kundnamn och anteckningar förblir som de är i Aiku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygulama dilini yalnızca sizin için değiştirir. Ürün adları, müşteri adları ve notlar Aiku’daki gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Змінює мову застосунку лише для вас. Назви товарів, імена клієнтів і примітки залишаються такими, як в Aiku."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅为你更改应用语言。产品名称、客户名称和备注保持 Aiku 中的原样。"
          }
        }
      }
    },
