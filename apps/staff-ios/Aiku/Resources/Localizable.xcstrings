    "Unmarked as dispatched. It is back with purchasing.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Маркировката като изпратено е премахната. Отново е при отдел „Покупки“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označení jako odeslané zrušeno. Je zpět u oddělení nákupu."
