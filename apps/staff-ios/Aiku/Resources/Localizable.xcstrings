          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पासवर्ड रिसेट गर्न इन्टरनेट चाहिन्छ — Wi-Fi जाँच गरी फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
