          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autentifikator je na drugom telefonu? Skenirajte ovaj kôd njime ili upišite ključ za postavljanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitelesítő egy másik telefonon? Szkennelje be vele ezt a kódot, vagy írja be a beállítási kulcsot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authenticator ada di ponsel lain? Pindai kode ini dengan ponsel tersebut, atau ketik kunci penyiapannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App di autenticazione su un altro telefono? Scansioni questo codice con quella oppure inserisca la chiave di configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "認証アプリが別のスマートフォンにありますか？このコードをスキャンするか、セットアップキーを入力してください。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplicația de autentificare e pe alt telefon? Scanează acest cod cu ea sau introdu cheia de configurare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máte autentifikátor na inom telefóne? Naskenujte ním tento kód alebo zadajte kľúč nastavenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doğrulama uygulaması başka bir telefonda mı? Bu kodu onunla tarayın veya kurulum anahtarını yazın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "身份验证器在另一部手机上？请用它扫描此二维码，或输入设置密钥。"
