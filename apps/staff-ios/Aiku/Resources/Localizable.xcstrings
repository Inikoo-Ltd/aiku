    "Only shown when your organisation has active shifts. Otherwise the camera opens straight away.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показва се само когато организацията ви има активни смени. В противен случай камерата се отваря веднага."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zobrazí se jen tehdy, když má vaše organizace aktivní směny. Jinak se fotoaparát otevře hned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
