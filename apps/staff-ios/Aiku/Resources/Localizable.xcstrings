          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tie paši skaitļi, kas tīmekļa krājumu informācijas panelī. Pašreizējās SKO, Novirzes, zem minimuma un negatīvie krājumi atver SKO sarakstu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वेबको इन्भेन्टरी ड्यासबोर्ड जस्तै तथ्याङ्क। हालका SKO हरू, असामान्यताहरू, न्यूनतमभन्दा कम र ऋणात्मक स्टकले SKO सूची खोल्छन्।"
          }
