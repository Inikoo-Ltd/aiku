    "Enter the 6-digit code from your authenticator app to finish signing in as %@.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Въведете 6-цифрения код от приложението за удостоверяване, за да завършите влизането като %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadejte 6místný kód z ověřovací aplikace a dokončete přihlášení jako %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geben Sie den 6-stelligen Code aus Ihrer Authenticator-App ein, um die Anmeldung als %@ abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduzca el código de 6 dígitos de su aplicación de autenticación para terminar de iniciar sesión como %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez le code à 6 chiffres de votre application d'authentification pour terminer la connexion en tant que %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ के रूप में साइन इन पूरा करने के लिए अपने ऑथेंटिकेटर ऐप से 6-अंकों का कोड दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unesite 6-znamenkasti kôd iz aplikacije za autentifikaciju kako biste dovršili prijavu kao %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adja meg a hitelesítő alkalmazás 6 jegyű kódját a(z) %@ néven történő bejelentkezés befejezéséhez."
