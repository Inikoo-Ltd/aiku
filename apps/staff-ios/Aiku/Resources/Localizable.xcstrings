    "Scan a pallet label, then the location it goes to. A booked-in pallet can be moved to another location until the delivery is set as booked in.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканирайте етикета на палет, после локацията, в която отива. Заприходен палет може да се премести в друга локация, докато доставката не бъде маркирана като заприходена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenujte štítek palety, pak lokaci, kam patří. Naskladněnou paletu lze přesunout na jinou lokaci, dokud se dodávka nenastaví jako naskladněná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen Sie ein Palettenetikett und dann den Ziel-Lagerplatz. Eine eingebuchte Palette kann auf einen anderen Lagerplatz verschoben werden, bis die Lieferung als eingebucht markiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escanee la etiqueta de un palet y luego la ubicación a la que va. Un palet con entrada registrada se puede mover a otra ubicación hasta que la entrega se marque como entrada registrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannez l'étiquette d'une palette, puis l'emplacement où elle va. Une palette réceptionnée peut être déplacée vers un autre emplacement tant que la livraison n'est pas marquée comme réceptionnée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पैलेट लेबल स्कैन करें, फिर वह लोकेशन जहाँ वह जाएगा। जब तक डिलीवरी बुक इन के रूप में सेट नहीं होती, बुक इन किए गए पैलेट को दूसरी लोकेशन पर ले जाया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenirajte naljepnicu palete, zatim lokaciju na koju ide. Uskladištena paleta može se premjestiti na drugu lokaciju dok isporuka nije označena kao uskladištena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Olvassa be a raklapcímkét, majd azt a raktárhelyet, ahová kerül. A bevételezett raklap másik raktárhelyre helyezhető át, amíg a beszállítás nincs bevételezettnek jelölve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindai label palet, lalu lokasi tujuannya. Palet yang sudah masuk stok dapat dipindahkan ke lokasi lain sampai penerimaan ditandai sudah masuk stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scansioni l'etichetta di un pallet, poi l'ubicazione in cui va. Un pallet registrato può essere spostato in un'altra ubicazione finché la consegna non viene impostata come registrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パレットラベルをスキャンし、次に格納先のロケーションをスキャンしてください。入庫済みのパレットは、入荷が入庫済みになるまで別のロケーションに移動できます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noskenējiet paletes etiķeti, tad vietu, uz kurieni tā jānovieto. Iegrāmatotu paleti var pārvietot uz citu vietu, līdz piegāde tiek atzīmēta kā iegrāmatota."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्यालेट लेबल स्क्यान गर्नुहोस्, त्यसपछि त्यो जाने लोकेसन। डेलिभरी स्टकमा दर्ता गरिएको रूपमा सेट नभएसम्म, दर्ता गरिएको प्यालेटलाई अर्को लोकेसनमा सार्न सकिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scan een palletlabel en daarna de locatie waar hij naartoe gaat. Een ingeboekte pallet kan naar een andere locatie worden verplaatst totdat de levering als ingeboekt is ingesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeskanuj etykietę palety, a potem lokalizację, do której trafia. Przyjętą paletę można przenieść do innej lokalizacji, dopóki dostawa nie zostanie oznaczona jako przyjęta na stan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leia a etiqueta de uma palete e depois a localização para onde vai. Uma palete rececionada pode ser movida para outra localização até a entrega ser definida como rececionada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanați eticheta unui palet, apoi locația în care merge. Un palet recepționat poate fi mutat în altă locație până când livrarea este setată ca recepționată în stoc."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenujte štítok palety, potom lokáciu, kam patrí. Naskladnenú paletu možno presunúť na inú lokáciu, kým sa dodávka nenastaví ako naskladnená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanna en palletikett och sedan lagerplatsen den ska till. En inbokad pall kan flyttas till en annan lagerplats tills leveransen markeras som inbokad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir palet etiketini, ardından gideceği lokasyonu tarayın. Stoğa alınan bir palet, teslimat stoğa alındı olarak işaretlenene kadar başka bir lokasyona taşınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відскануйте етикетку палети, потім комірку, куди вона йде. Оприбутковану палету можна переміщати в іншу комірку, доки доставку не позначено як оприбутковану."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先扫描托盘标签，再扫描其要放置的库位。在入库单设为已入库之前，已入库的托盘可以移至其他库位。"
          }
        }
      }
    },
