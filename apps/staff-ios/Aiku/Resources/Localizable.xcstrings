            "state": "needs_review",
            "value": "すべての納品書が梱包済みで、台車はすべて空いています。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visas piegādes pavadzīmes ir iepakotas, un ratiņi ir brīvi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक डेलिभरी नोट प्याक भएको छ र ट्रलीहरू खाली छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle pakbonnen zijn ingepakt en de trolleys zijn vrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystkie dowody dostawy są zapakowane, a wózki wolne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todas as guias de remessa estão embaladas e os carrinhos estão livres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toate notele de livrare sunt ambalate și cărucioarele sunt libere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všetky dodacie listy sú zabalené a vozíky sú voľné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alla följesedlar är packade och vagnarna är lediga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tüm irsaliyeler paketlendi ve toplama arabaları boş."
          }
        },
        "uk": {
          "stringUnit": {
