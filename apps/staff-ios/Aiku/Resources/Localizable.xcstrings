    "Resetting your password needs internet — check Wi-Fi and try again.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За смяна на паролата е нужен интернет — проверете Wi-Fi и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obnovení hesla vyžaduje internet – zkontrolujte Wi-Fi a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Zurücksetzen Ihres Passworts wird Internet benötigt – prüfen Sie das WLAN und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para restablecer la contraseña se necesita internet: compruebe el wifi e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La réinitialisation du mot de passe nécessite Internet : vérifiez le Wi-Fi et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पासवर्ड रीसेट करने के लिए इंटरनेट चाहिए — Wi-Fi जाँचें और फिर से प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za postavljanje nove lozinke potreban je internet – provjerite Wi-Fi i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A jelszó visszaállításához internet kell – ellenőrizze a Wi-Fit, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengatur ulang kata sandi memerlukan internet — periksa Wi-Fi lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
