          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen vereist internet. Controleer de wifi en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanowanie wymaga internetu. Sprawdź Wi-Fi i spróbuj ponownie."
          }
        },
        "pt": {
