    "Packers appear here while they work.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Опаковчиците се показват тук, докато работят."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Baliči se zde zobrazují, když pracují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Packer erscheinen hier, während sie arbeiten."
          }
        },
        "es": {
          "stringUnit": {
