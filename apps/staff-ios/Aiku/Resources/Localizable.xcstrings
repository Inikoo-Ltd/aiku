    "Select delivery notes to remove. Removed delivery notes leave the session and go back to To do.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изберете стокови разписки за премахване. Премахнатите стокови разписки напускат сесията и се връщат в За вършене."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyberte dodací listy k odebrání. Odebrané dodací listy opustí relaci a vrátí se do K vyřízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wählen Sie Lieferscheine zum Entfernen. Entfernte Lieferscheine verlassen die Sitzung und kehren zu „Zu tun“ zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seleccione los albaranes que quitar. Los albaranes quitados salen de la sesión y vuelven a Por hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sélectionnez les bons de livraison à retirer. Les bons de livraison retirés quittent la session et retournent dans À faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हटाने के लिए डिलीवरी नोट चुनें। हटाए गए डिलीवरी नोट सत्र से निकलकर 'करना है' में वापस चले जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite otpremnice za uklanjanje. Uklonjene otpremnice napuštaju sesiju i vraćaju se u Za napraviti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Válassza ki az eltávolítandó szállítóleveleket. Az eltávolított szállítólevelek kikerülnek a munkamenetből, és visszakerülnek a Teendők közé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih surat jalan yang akan dihapus. Surat jalan yang dihapus keluar dari sesi dan kembali ke Untuk dikerjakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selezioni le bolle di consegna da rimuovere. Le bolle rimosse lasciano la sessione e tornano a Da fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "削除する納品書を選択してください。削除した納品書はセッションから外れ、未着手に戻ります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvēlieties noņemamās piegādes pavadzīmes. Noņemtās piegādes pavadzīmes atstāj sesiju un atgriežas sadaļā Jāizdara."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हटाउन डेलिभरी नोटहरू छान्नुहोस्। हटाइएका डेलिभरी नोटहरू सत्रबाट निस्केर 'गर्नुपर्ने' मा फर्कन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecteer pakbonnen om te verwijderen. Verwijderde pakbonnen verlaten de sessie en gaan terug naar Te doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz dowody dostawy do usunięcia. Usunięte dowody dostawy opuszczą sesję i wrócą do Do zrobienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecione as guias de remessa a remover. As guias removidas saem da sessão e voltam a Por fazer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selectează notele de livrare de eliminat. Notele de livrare eliminate părăsesc sesiunea și revin în De făcut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyberte dodacie listy na odstránenie. Odstránené dodacie listy opustia reláciu a vrátia sa do Na vybavenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
