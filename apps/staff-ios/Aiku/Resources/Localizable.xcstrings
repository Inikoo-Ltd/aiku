          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "शिपमेंट और उसका लेबल प्लेटफ़ॉर्म से आते हैं। अगर यह अभी तक नहीं आया है, तो थोड़ी देर में फिर से कोशिश करें। फिर लेबल प्रिंट करें और हमेशा की तरह अंतिम रूप दें।"
