    "Starting booking in needs the right to edit this fulfilment shop.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За започване на заприхождаването е нужно право за редактиране на този фулфилмънт магазин."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "K zahájení naskladnění potřebujete právo upravovat tento fulfilmentový obchod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Starten der Einbuchung benötigen Sie das Recht, diesen Fulfillment-Shop zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para iniciar el registro de entrada se necesita permiso para editar esta tienda de logística."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour commencer la réception, il faut le droit de modifier cette boutique logistique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बुक इन शुरू करने के लिए इस फ़ुलफ़िलमेंट शॉप को संपादित करने का अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za početak uskladištenja potrebno je pravo uređivanja ove fulfilment trgovine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A bevételezés indításához szerkesztési jog kell ehhez a fulfilment-áruházhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memulai proses masuk stok memerlukan hak untuk mengedit toko fulfillment ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per avviare la registrazione serve il permesso di modificare questo negozio logistica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入庫を開始するには、このフルフィルメントショップの編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lai sāktu iegrāmatošanu, nepieciešamas tiesības labot šo fulfilment veikalu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्टकमा दर्ता सुरु गर्न यो फुलफिलमेन्ट पसल सम्पादन गर्ने अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om het inboeken te starten, heb je het recht nodig om deze fulfilmentshop te bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozpoczęcie przyjmowania na stan wymaga uprawnień do edycji tego sklepu fulfilment."
          }
