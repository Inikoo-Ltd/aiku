          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके नाम और आज की तारीख के साथ घटना रिपोर्ट के रूप में सहेजा गया। पैलेट की लोकेशन हटा दी गई है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
