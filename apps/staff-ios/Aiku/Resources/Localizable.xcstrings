    "When picking finishes with waiting lines, the delivery note moves to Waiting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endet die Kommissionierung mit wartenden Zeilen, wechselt der Lieferschein zu Wartend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando la preparación termina con líneas en espera, el albarán pasa a En espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lorsque la préparation se termine avec des lignes en attente, le bon de livraison passe à En attente."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada branje završi s retcima na čekanju, otpremnica prelazi u Na čekanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha a komissiózás várakozó sorokkal fejeződik be, a szállítólevél Várakozik állapotba kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika picking selesai dengan baris yang menunggu, surat jalan berpindah ke Menunggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando il prelievo termina con righe in attesa, la bolla di consegna passa a In attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保留中の行がある状態でピッキングが終わると、納品書は保留中に移ります。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Când culesul se termină cu linii în așteptare, nota de livrare trece în În așteptare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keď sa vychystávanie skončí s čakajúcimi riadkami, dodací list prejde do stavu Čaká."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplama bekleyen satırlarla biterse irsaliye Bekliyor durumuna geçer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拣货完成但有等待行时，发货单会变为等待中。"
          }
        }
      }
    },
    "When the customer picks it up, set it as collected. That is the collection version of Dispatch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn der Kunde es abholt, setzen Sie es auf abgeholt. Das ist die Abholversion von Versenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando el cliente lo recoja, márquelo como recogido. Es la versión para recogida de Expedir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lorsque le client vient le chercher, marquez-le comme retiré. C'est l'équivalent d'Expédier pour un retrait."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada kupac preuzme, označite kao preuzeto. To je inačica otpreme za osobno preuzimanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Amikor az ügyfél átveszi, jelölje átvettnek. Ez a Feladás személyes átvételes változata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saat pelanggan mengambilnya, tandai sebagai diambil. Itulah versi Kirim untuk pengambilan sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando il cliente lo ritira, lo imposti come ritirato. È la versione per il ritiro di Spedisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顧客が引き取ったら、引き取り済みにしてください。これは出荷の引き取り版です。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Când clientul o ridică, marchează-o ca ridicată. Aceasta este varianta de ridicare a Expedierii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keď si ho zákazník vyzdvihne, nastavte ho ako vyzdvihnuté. Je to verzia Odoslať pre vyzdvihnutie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Müşteri teslim aldığında teslim alındı olarak işaretleyin. Bu, Sevk et işleminin teslim alma karşılığıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "客户提货时，请将其设为已自提。这相当于自提方式的“发货”。"
          }
        }
      }
    },
