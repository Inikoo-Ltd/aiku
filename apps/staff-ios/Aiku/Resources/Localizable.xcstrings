        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パレットが返品済みになり、倉庫から出ます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleții săi sunt marcați ca returnați și părăsesc depozitul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jej palety sa označia ako vrátené a opustia sklad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paletleri iade edildi olarak işaretlenir ve depodan çıkar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其托盘将设为已退回并离开仓库。"
          }
