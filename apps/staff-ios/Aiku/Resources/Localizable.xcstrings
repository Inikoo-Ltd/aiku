    "Pickers appear here while they work.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommissionierer erscheinen hier, während sie arbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los preparadores aparecen aquí mientras trabajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les préparateurs apparaissent ici pendant qu'ils travaillent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berači se ovdje prikazuju dok rade."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózók munka közben jelennek meg itt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Picker muncul di sini saat sedang bekerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli addetti al prelievo compaiono qui mentre lavorano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "作業中のピッカーがここに表示されます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culegătorii apar aici cât timp lucrează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávači sa tu zobrazujú počas práce."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplayıcılar çalışırken burada görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拣货员工作时会显示在这里。"
          }
        }
      }
    },
    "Pickers are sent to the active picking location of the order’s channel.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommissionierer werden zum aktiven Kommissionierort des Kanals der Bestellung geschickt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los preparadores van a la ubicación de preparación activa del canal del pedido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les préparateurs sont envoyés vers l’emplacement de préparation actif du canal de la commande."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berači se upućuju na aktivnu lokaciju za branje prodajnog kanala narudžbe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A komissiózók a rendelés értékesítési csatornájának aktív komissiózási helyére kerülnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Picker diarahkan ke lokasi picking aktif dari kanal pesanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli addetti al prelievo vengono indirizzati all’ubicazione di prelievo attiva del canale dell’ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピッカーは注文のチャネルの有効なピッキングロケーションに案内されます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culegătorii sunt trimiși la locația de cules activă a canalului comenzii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávači sú posielaní do aktívnej lokácie vychystávania kanála objednávky."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toplayıcılar, siparişin kanalının aktif toplama lokasyonuna yönlendirilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拣货员会被引导到订单渠道的当前拣货库位。"
          }
        }
      }
    },
