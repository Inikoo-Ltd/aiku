    "ship it before the light goes.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "изпрати го, преди да се стъмни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "odešli to, než se setmí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "verschick es, bevor das Licht ausgeht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "envíelo antes de que se vaya la luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "expédiez-le avant que la lumière ne baisse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रोशनी जाने से पहले इसे भेज दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "pošalji prije nego što padne mrak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "add fel, mielőtt besötétedik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kirim sebelum hari gelap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lo spedisca prima che cali la luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "日が暮れる前に出荷しよう。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nosūti, pirms satumst."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उज्यालो जानुअघि पठाइदिनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "verzend het voordat het donker wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "wyślij to, zanim zgaśnie światło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "expeça-o antes que a luz se vá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "expediază-l înainte să se întunece."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "odošli to, kým sa zotmie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "skicka det innan det blir mörkt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "hava kararmadan gönder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "відправ, поки не стемніло."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "趁天还亮，把它发出去。"
          }
        }
      }
    },
