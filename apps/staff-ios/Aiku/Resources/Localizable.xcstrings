          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitelesítő egy másik telefonon? Szkennelje be vele ezt a kódot, vagy írja be a beállítási kulcsot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authenticator ada di ponsel lain? Pindai kode ini dengan ponsel tersebut, atau ketik kunci penyiapannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App di autenticazione su un altro telefono? Scansioni questo codice con quella oppure inserisca la chiave di configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "認証アプリが別のスマートフォンにありますか？このコードをスキャンするか、セットアップキーを入力してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autentifikators citā tālrunī? Noskenējiet ar to šo kodu vai ievadiet iestatīšanas atslēgu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authenticator अर्को फोनमा छ? यो कोड त्यसबाट स्क्यान गर्नुहोस्, वा सेटअप कुञ्जी टाइप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authenticator op een andere telefoon? Scan deze code ermee of typ de instelsleutel in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplikacja uwierzytelniająca na innym telefonie? Zeskanuj nią ten kod lub wpisz klucz konfiguracji."
