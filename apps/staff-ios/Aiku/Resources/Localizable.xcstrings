    "The pallet waits for customer service. They must resolve it before the return can be set as picked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Палетът чака обслужване на клиенти. Те трябва да решат въпроса, преди връщането да може да се маркира като комплектовано."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleta čeká na zákaznický servis. Ten to musí vyřešit, než bude možné vratku označit jako vychystanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Palette wartet auf den Kundendienst. Er muss es klären, bevor die Rückgabe als kommissioniert markiert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El palet queda a la espera de servicio al cliente. Deben resolverlo antes de poder marcar la devolución como preparada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La palette attend le service client. Il doit résoudre le problème avant que le retour puisse être marqué comme préparé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पैलेट ग्राहक सेवा की प्रतीक्षा करता है। वापसी को पिक किया गया सेट करने से पहले उन्हें इसे सुलझाना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paleta čeka korisničku službu. Ona to mora riješiti prije nego što se povrat može označiti kao ubran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A raklap az ügyfélszolgálatra vár. Nekik kell rendezniük, mielőtt a visszaküldés komissiózottnak jelölhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palet menunggu layanan pelanggan. Mereka harus menyelesaikannya sebelum pengembalian dapat ditandai sudah diambil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
