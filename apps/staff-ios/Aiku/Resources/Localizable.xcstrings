    "SKO, location, delivery note or stock delivery. Opens the right screen.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO, локация, стокова разписка или доставка на наличности. Отваря правилния екран."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO, umístění, dodací list nebo dodávka zásob. Otevře správnou obrazovku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO, Lagerplatz, Lieferschein oder Lagerlieferung. Öffnet den passenden Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO, ubicación, albarán o entrega de stock. Abre la pantalla correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO, emplacement, bon de livraison ou livraison de stock. Ouvre le bon écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SKO, लोकेशन, डिलीवरी नोट या स्टॉक डिलीवरी। सही स्क्रीन खोलता है।"
          }
