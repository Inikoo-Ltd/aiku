    "Put back %@ on the shelf, then press Parts put back.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Върнете %@ на рафта, след което натиснете Частите са върнати."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraťte %@ do regálu a pak stiskněte Díly vráceny zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legen Sie %@ zurück ins Regal und tippen Sie dann auf „Komponenten zurückgelegt“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devuelva %@ a la estantería y luego pulse Partes devueltas a su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remettez %@ en rayon, puis appuyez sur Composants remis en place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ को शेल्फ़ पर वापस रखें, फिर “भाग वापस रखे गए” दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vratite %@ na policu, a zatim pritisnite Dijelovi vraćeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tegye vissza a polcra: %@, majd nyomja meg a Részek visszatéve gombot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kembalikan %@ ke rak, lalu tekan Komponen yang dikembalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rimetta %@ sullo scaffale, poi prema Parti rimesse a posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@を棚に戻してから「部品を戻しました」を押してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atlieciet %@ atpakaļ plauktā, tad nospiediet Daļas atliktas atpakaļ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ लाई सेल्फमा फिर्ता राख्नुहोस्, त्यसपछि “भागहरू फिर्ता राखिए” थिच्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leg %@ terug in het schap en druk daarna op Onderdelen teruggelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odłóż %@ na półkę, a następnie naciśnij Komponenty odłożone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reponha %@ na prateleira e depois prima Peças repostas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pune %@ înapoi pe raft, apoi apasă Componente repuse la loc."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vráťte %@ na regál a potom stlačte Časti vrátené na miesto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
