            "value": "Může být v relaci vychystávání, nebo ho můžete jen zobrazit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er ist möglicherweise in einer Kommissioniersitzung, oder Sie können ihn nur ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puede que esté en una sesión de picking o que solo pueda verlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est peut-être dans une session de préparation, ou vous pouvez seulement le consulter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह किसी पिकिंग सत्र में हो सकता है या आप इसे केवल देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Možda je u sesiji branja ili je možete samo pregledavati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lehet, hogy egy komissiózási munkamenetben van, vagy csak megtekintheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mungkin sedang dalam sesi picking, atau Anda hanya dapat melihatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potrebbe essere in una sessione di prelievo oppure può solo visualizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ピッキングセッションに含まれているか、閲覧のみ可能な可能性があります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tā var būt komplektēšanas sesijā, vai arī jūs to varat tikai skatīt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो कुनै पिकिङ सत्रमा हुन सक्छ वा तपाईं यसलाई हेर्न मात्र सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mogelijk zit hij in een picksessie, of je kunt hem alleen bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Może być w sesji kompletacji albo możesz go tylko przeglądać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pode estar numa sessão de preparação ou pode apenas consultá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poate fi într-o sesiune de cules sau o poți doar vizualiza."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Môže byť v relácii vychystávania alebo ho môžete len zobraziť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
