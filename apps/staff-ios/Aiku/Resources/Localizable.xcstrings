    "Ask customer services about this delivery note.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попитайте обслужване на клиенти за тази стокова разписка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeptejte se zákaznického servisu na tento dodací list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fragen Sie den Kundendienst zu diesem Lieferschein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consulte a servicio al cliente sobre este albarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contactez le service client au sujet de ce bon de livraison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस डिलीवरी नोट के बारे में ग्राहक सेवा से पूछें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pitajte korisničku službu o ovoj otpremnici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kérdezze az ügyfélszolgálatot erről a szállítólevélről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanyakan surat jalan ini ke layanan pelanggan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Contatti il servizio clienti per questa bolla di consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この納品書についてカスタマーサービスに問い合わせます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jautājiet klientu apkalpošanai par šo piegādes pavadzīmi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो डेलिभरी नोटबारे ग्राहक सेवालाई सोध्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraag de klantenservice naar deze pakbon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapytaj obsługę klienta o ten dowód dostawy."
          }
        },
        "pt": {
