    "Enter length, width and height of every parcel, they are needed to set as packed. Weight starts from the estimated weight of the items.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Въведете дължина, ширина и височина на всеки колет; те са нужни, за да се маркира като опаковано. Теглото започва от прогнозното тегло на артикулите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadejte délku, šířku a výšku každého balíku, jsou potřeba pro označení jako zabalené. Hmotnost vychází z odhadované hmotnosti položek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geben Sie Länge, Breite und Höhe jedes Pakets ein; sie werden zum Setzen auf verpackt benötigt. Das Gewicht beginnt mit dem geschätzten Gewicht der Artikel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduzca el largo, el ancho y el alto de cada paquete; son necesarios para marcarlo como embalado. El peso parte del peso estimado de los artículos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez la longueur, la largeur et la hauteur de chaque colis, elles sont nécessaires pour marquer comme emballé. Le poids part du poids estimé des articles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर पार्सल की लंबाई, चौड़ाई और ऊँचाई दर्ज करें, पैक किया के रूप में सेट करने के लिए ये ज़रूरी हैं। वज़न आइटम के अनुमानित वज़न से शुरू होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unesite duljinu, širinu i visinu svakog paketa; potrebne su za označavanje kao spakirano. Težina polazi od procijenjene težine artikala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adja meg minden csomag hosszát, szélességét és magasságát; ezek szükségesek a becsomagoltként való megjelöléshez. A súly a tételek becsült súlyából indul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masukkan panjang, lebar, dan tinggi setiap paket, data ini diperlukan untuk menandai sudah dikemas. Berat dimulai dari perkiraan berat barang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inserisci lunghezza, larghezza e altezza di ogni pacco: servono per impostarlo come imballato. Il peso parte da quello stimato degli articoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての荷物の長さ、幅、高さを入力してください。梱包済みにするために必要です。重量は商品の推定重量から始まります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ievadiet katras pakas garumu, platumu un augstumu, tie vajadzīgi, lai atzīmētu kā iepakotu. Svars sākotnēji ir preču aptuvenais svars."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक पार्सलको लम्बाइ, चौडाइ र उचाइ प्रविष्ट गर्नुहोस्, प्याक गरिएको रूपमा सेट गर्न यी चाहिन्छन्। तौल वस्तुहरूको अनुमानित तौलबाट सुरु हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voer de lengte, breedte en hoogte van elk pakket in; die zijn nodig om als ingepakt te markeren. Het gewicht begint bij het geschatte gewicht van de artikelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wprowadź długość, szerokość i wysokość każdej paczki – są potrzebne, aby oznaczyć jako zapakowane. Waga początkowo jest szacowaną wagą pozycji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduza o comprimento, a largura e a altura de cada volume; são necessários para marcar como embalado. O peso parte do peso estimado dos artigos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introdu lungimea, lățimea și înălțimea fiecărui colet; sunt necesare pentru a marca drept ambalat. Greutatea pornește de la greutatea estimată a articolelor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadajte dĺžku, šírku a výšku každého balíka, sú potrebné na označenie ako zabalené. Hmotnosť začína od odhadovanej hmotnosti položiek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ange längd, bredd och höjd för varje paket, de behövs för att markera som packat. Vikten utgår från artiklarnas uppskattade vikt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her paketin uzunluğunu, genişliğini ve yüksekliğini girin; paketlendi olarak işaretlemek için gereklidir. Ağırlık, ürünlerin tahmini ağırlığından başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введіть довжину, ширину й висоту кожної посилки, вони потрібні, щоб позначити як упаковане. Вага спершу дорівнює орієнтовній вазі товарів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请输入每个包裹的长、宽、高，设为已打包时需要这些信息。重量初始为货品的预估重量。"
          }
        }
      }
    },
