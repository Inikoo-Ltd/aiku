    "Please enable location permission in your phone settings. You can still open the camera and scan the machine.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Моля, разрешете достъпа до местоположението в настройките на телефона. Все пак можете да отворите камерата и да сканирате машината."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povolte prosím přístup k poloze v nastavení telefonu. Fotoaparát můžete přesto otevřít a zařízení naskenovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bitte aktivieren Sie die Standortberechtigung in den Einstellungen Ihres Telefons. Sie können die Kamera trotzdem öffnen und das Gerät scannen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Active el permiso de ubicación en los ajustes del teléfono. Aun así, puede abrir la cámara y escanear la máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veuillez activer l’autorisation de localisation dans les réglages de votre téléphone. Vous pouvez quand même ouvrir l’appareil photo et scanner la pointeuse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कृपया फ़ोन की सेटिंग्स में लोकेशन अनुमति चालू करें। आप फिर भी कैमरा खोलकर मशीन स्कैन कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućite dopuštenje za lokaciju u postavkama telefona. I dalje možete otvoriti kameru i skenirati uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Engedélyezze a helymeghatározást a telefon beállításaiban. A kamerát így is megnyithatja, és beszkennelheti a gépet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan izin lokasi di pengaturan ponsel Anda. Anda tetap dapat membuka kamera dan memindai mesin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attivi l’autorizzazione alla posizione nelle impostazioni del telefono. Può comunque aprire la fotocamera e scansionare il terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スマートフォンの設定で位置情報の許可をオンにしてください。カメラを開いて打刻機をスキャンすることもできます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lūdzu, ieslēdziet atrašanās vietas atļauju tālruņa iestatījumos. Jūs joprojām varat atvērt kameru un skenēt iekārtu."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कृपया फोनको सेटिङमा स्थान अनुमति सक्रिय गर्नुहोस्। तपाईं अझै पनि क्यामेरा खोलेर मेसिन स्क्यान गर्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel locatietoestemming in via de instellingen van je telefoon. Je kunt de camera nog steeds openen en de machine scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włącz uprawnienie do lokalizacji w ustawieniach telefonu. Nadal możesz otworzyć aparat i zeskanować urządzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative a permissão de localização nas definições do telemóvel. Pode na mesma abrir a câmara e ler a máquina."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activează permisiunea de localizare din setările telefonului. Poți totuși să deschizi camera și să scanezi terminalul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povoľte prístup k polohe v nastaveniach telefónu. Fotoaparát môžete aj tak otvoriť a naskenovať terminál."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivera platsbehörighet i telefonens inställningar. Du kan fortfarande öppna kameran och skanna maskinen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lütfen telefon ayarlarınızdan konum iznini açın. Yine de kamerayı açıp cihazı tarayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть дозвіл на геолокацію в налаштуваннях телефона. Ви все одно можете відкрити камеру та відсканувати пристрій."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在手机设置中开启定位权限。你仍然可以打开相机扫描考勤机。"
          }
        }
      }
    },
