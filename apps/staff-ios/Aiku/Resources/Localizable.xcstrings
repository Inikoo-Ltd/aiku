            "value": "आपके संगठन के लिए अभी कोई हाज़िरी विधि सक्षम नहीं है। कृपया HR से संपर्क करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini tidak ada metode absensi yang diaktifkan untuk organisasi Anda. Silakan hubungi HR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è abilitato alcun metodo di timbratura per la sua organizzazione. Contatti le risorse umane."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको संस्थाका लागि हाल कुनै क्लकिङ विधि सक्षम छैन। कृपया HR लाई सम्पर्क गर्नुहोस्।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Twojej organizacji nie jest obecnie włączona żadna metoda rejestracji czasu pracy. Skontaktuj się z działem HR."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum método de registo de ponto está atualmente ativo para a sua organização. Contacte os RH."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio metodă de pontaj nu este activată în prezent pentru organizația dvs. Vă rugăm să contactați departamentul de resurse umane."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vašu organizáciu nie je momentálne povolený žiadny spôsob zaznamenávania dochádzky. Kontaktujte personálne oddelenie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizasyonunuz için şu anda etkin bir puantaj yöntemi yok. Lütfen İK ile iletişime geçin."
