        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nem komissiózottként jelölve. Az ügyfélszolgálatnak rendeznie kell, mielőtt a visszaküldés komissiózottnak jelölhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditandai tidak diambil. Layanan pelanggan harus menyelesaikannya sebelum pengembalian dapat ditandai sudah diambil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impostato come non prelevato. Il servizio clienti deve risolverlo prima che il reso possa essere impostato come prelevato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未ピッキングにしました。返品をピッキング済みにする前に、カスタマーサービスが解決する必要があります。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marcat ca necules. Serviciul clienți trebuie să rezolve situația înainte ca returul să poată fi marcat ca cules."
          }
        },
        "sk": {
          "stringUnit": {
