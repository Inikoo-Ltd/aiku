    "A Bluetooth scanner types the code and Enter; the screen captures it without tapping a field, like the web. No on-screen keyboard is needed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Bluetooth-Scanner tippt den Code und Enter; der Bildschirm erfasst ihn, ohne dass Sie ein Feld antippen, wie im Web. Keine Bildschirmtastatur nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un escáner Bluetooth escribe el código y Enter; la pantalla lo captura sin tocar ningún campo, como en la web. No hace falta el teclado en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un scanner Bluetooth saisit le code puis Entrée ; l’écran le capte sans toucher de champ, comme sur le web. Aucun clavier à l’écran n’est nécessaire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth skener upisuje kôd i Enter; zaslon ga hvata bez dodirivanja polja, kao na webu. Tipkovnica na zaslonu nije potrebna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A Bluetooth-szkenner beírja a kódot és az Entert; a képernyő mezőre koppintás nélkül rögzíti, mint a weben. Nincs szükség képernyő-billentyűzetre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pemindai Bluetooth mengetik kode lalu Enter; layar menangkapnya tanpa perlu mengetuk kolom, seperti di web. Keyboard layar tidak diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno scanner Bluetooth digita il codice e Invio; la schermata lo acquisisce senza toccare alcun campo, come sul web. Non serve la tastiera su schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetoothスキャナーはコードを入力してEnterを送信します。Webと同様に、入力欄をタップしなくても画面が読み取ります。画面キーボードは不要です。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un scaner Bluetooth tastează codul și Enter; ecranul îl preia fără să atingi un câmp, ca pe web. Nu este nevoie de tastatura de pe ecran."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth skener napíše kód a stlačí Enter; obrazovka ho zachytí bez ťuknutia do poľa, ako na webe. Klávesnica na obrazovke nie je potrebná."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth tarayıcı kodu yazar ve Enter’a basar; ekran, bir alana dokunmanıza gerek kalmadan kodu yakalar, tıpkı web’deki gibi. Ekran klavyesine gerek yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "蓝牙扫描器会输入条码并按回车；无需点击输入框，屏幕即可捕获，与网页版相同。无需屏幕键盘。"
          }
        }
      }
    },
    "A delivery note can have at most 50 parcels.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Lieferschein kann höchstens 50 Pakete haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un albarán puede tener como máximo 50 paquetes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un bon de livraison peut contenir au maximum 50 colis."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otpremnica može imati najviše 50 paketa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Egy szállítólevélhez legfeljebb 50 csomag tartozhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Satu surat jalan maksimal berisi 50 paket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una bolla di consegna può avere al massimo 50 pacchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1枚の納品書に登録できる荷物は最大50個です。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O notă de livrare poate avea cel mult 50 de colete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodací list môže mať najviac 50 balíkov."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir irsaliyede en fazla 50 paket olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一张发货单最多可有 50 个包裹。"
          }
        }
      }
    },
    "A dispatching supervisor can send it back to picking.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Versandaufsicht kann ihn zurück in die Kommissionierung schicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un supervisor de expedición puede devolverlo a preparación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un superviseur de l’expédition peut le renvoyer en préparation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadzornik otpreme može je vratiti na branje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Egy kiszállítási felügyelő visszaküldheti komissiózásra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengawas pengiriman dapat mengembalikannya ke picking."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un supervisore della spedizione può rimandarla al prelievo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "出荷スーパーバイザーがピッキングに戻すことができます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un supervizor de expediere o poate trimite înapoi la cules."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vedúci expedície ho môže vrátiť do vychystávania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir sevkiyat süpervizörü onu toplamaya geri gönderebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发货主管可将其退回拣货。"
          }
        }
      }
    },
    "A failed check needs a note. Purchasing follows up the differences.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine fehlgeschlagene Prüfung braucht eine Notiz. Der Einkauf klärt die Abweichungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una comprobación fallida necesita una nota. Compras hace el seguimiento de las diferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un contrôle échoué nécessite une note. Les achats assurent le suivi des écarts."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neuspjela provjera zahtijeva bilješku. Nabava rješava razlike."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sikertelen ellenőrzéshez megjegyzés szükséges. A beszerzés követi nyomon az eltéréseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pemeriksaan yang gagal memerlukan catatan. Bagian pembelian menindaklanjuti selisihnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un controllo non superato richiede una nota. L’ufficio acquisti segue le differenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不合格のチェックにはメモが必要です。差異は購買が対応します。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O verificare eșuată necesită o notă. Departamentul de achiziții urmărește diferențele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neúspešná kontrola vyžaduje poznámku. Rozdiely rieši nákup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başarısız bir kontrol için not gerekir. Farkları satın alma ekibi takip eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检查未通过时需要填写备注。采购部会跟进差异。"
          }
        }
      }
    },
    "A location with no stock can’t be chosen. To change which location is the picking location, use Change picking location (needs stock edit rights).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Lagerplatz ohne Bestand kann nicht gewählt werden. Um den Kommissionierort zu ändern, nutzen Sie „Kommissionierort ändern“ (erfordert Rechte zum Bearbeiten des Bestands)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede elegir una ubicación sin stock. Para cambiar la ubicación de preparación, use Cambiar ubicación de preparación (requiere permisos para editar stock)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un emplacement sans stock ne peut pas être choisi. Pour changer l’emplacement de préparation, utilisez Changer l’emplacement de préparation (droits de modification du stock requis)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokacija bez zalihe ne može se odabrati. Za promjenu lokacije za branje koristite Promijeni lokaciju za branje (potrebna su prava uređivanja zaliha)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Készlet nélküli hely nem választható. A komissiózási hely módosításához használja a Komissiózási hely módosítása funkciót (készletszerkesztési jog szükséges)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi tanpa stok tidak dapat dipilih. Untuk mengganti lokasi picking, gunakan Ganti lokasi picking (memerlukan hak edit stok)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è possibile scegliere un’ubicazione senza stock. Per cambiare l’ubicazione di prelievo, usi Cambia ubicazione di prelievo (servono i permessi di modifica dello stock)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在庫のないロケーションは選択できません。ピッキングロケーションを変更するには、「ピッキングロケーションを変更」を使用してください（在庫編集権限が必要です）。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O locație fără stoc nu poate fi aleasă. Pentru a schimba locația de cules, folosește Schimbă locația de cules (necesită drepturi de editare a stocului)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokáciu bez zásob nemožno vybrať. Ak chcete zmeniť lokáciu vychystávania, použite Zmeniť lokáciu vychystávania (vyžaduje práva na úpravu zásob)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stoğu olmayan bir lokasyon seçilemez. Toplama lokasyonunu değiştirmek için Toplama lokasyonunu değiştir’i kullanın (stok düzenleme yetkisi gerekir)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无库存的库位无法选择。如需更改拣货库位，请使用“更改拣货库位”（需要库存编辑权限）。"
          }
        }
      }
    },
    "A part of a set sold only complete was not found": {
      "extractionState": "manual",
