          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen pickt alleen terwijl de pakbon wordt gepickt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanowanie kompletuje tylko wtedy, gdy dowód dostawy jest w trakcie kompletacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A leitura só prepara enquanto a guia de remessa está a ser preparada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanarea culege doar cât timp nota de livrare este în curs de cules."
          }
        },
        "sk": {
