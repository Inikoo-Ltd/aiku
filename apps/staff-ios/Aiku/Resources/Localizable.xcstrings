    "1 action from you is waiting; it will be sent when you sign in again on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 ваше действие чака; ще бъде изпратено, когато влезете отново на този телефон."
          }
        },
        "cs": {
          "stringUnit": {
