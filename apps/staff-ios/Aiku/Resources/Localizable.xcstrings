    "Scanning needs internet. Check Wi-Fi and try again.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканирането изисква интернет. Проверете Wi-Fi и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenování vyžaduje internet. Zkontrolujte Wi-Fi a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen braucht Internet. Prüfen Sie das WLAN und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escaneo necesita internet. Compruebe la wifi y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le scan nécessite Internet. Vérifiez le Wi-Fi et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्कैनिंग के लिए इंटरनेट चाहिए। Wi-Fi जाँचें और फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
