          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her kutu numarası 1 ile %lld arasında olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Номер кожної коробки має бути від 1 до %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个箱号必须在 1 到 %lld 之间。"
          }
        }
      }
    },
    "Each difference needs a reason: decreases such as Count shortage or Damaged stock, increases such as Count gain (stock found). A note is optional.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всяка разлика изисква причина: намаления като Липса при преброяване или Повредена наличност, увеличения като Излишък при преброяване (намерена наличност). Бележката е по избор."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý rozdíl potřebuje důvod: snížení jako Manko při počítání nebo Poškozené zásoby, zvýšení jako Přebytek při počítání (nalezené zásoby). Poznámka je nepovinná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Abweichung braucht einen Grund: Verringerungen wie Zählfehlmenge oder Beschädigter Bestand, Erhöhungen wie Zählplus (Bestand gefunden). Eine Notiz ist optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada diferencia necesita un motivo: reducciones como Faltante en recuento o Stock dañado, aumentos como Excedente en recuento (stock encontrado). La nota es opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque écart nécessite un motif : les diminutions comme Comptage en moins ou Stock endommagé, les augmentations comme Comptage en plus (stock trouvé). Une note est facultative."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर अंतर के लिए कारण चाहिए: कमी जैसे 'गिनती में कमी' या 'क्षतिग्रस्त स्टॉक', बढ़त जैसे 'गिनती में बढ़त (स्टॉक मिला)'। नोट वैकल्पिक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaka razlika treba razlog: smanjenja kao što su Manjak pri brojanju ili Oštećena zaliha, povećanja kao što je Višak pri brojanju (pronađena zaliha). Bilješka je neobavezna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden eltéréshez ok szükséges: csökkenésnél pl. Számlálási hiány vagy Sérült készlet, növekedésnél pl. Számlálási többlet (talált készlet). A megjegyzés nem kötelező."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap selisih memerlukan alasan: pengurangan seperti Kekurangan hitungan atau Stok rusak, penambahan seperti Selisih lebih hitungan (stok ditemukan). Catatan bersifat opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni differenza richiede un motivo: diminuzioni come Ammanco al conteggio o Stock danneggiato, aumenti come Eccedenza al conteggio (stock trovato). La nota è facoltativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "差異にはそれぞれ理由が必要です。減少は「棚卸し不足」や「破損在庫」、増加は「棚卸し増（在庫発見）」などです。メモは任意です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katrai atšķirībai vajadzīgs iemesls: samazinājumiem, piemēram, Skaitīšanas iztrūkums vai Bojāti krājumi, palielinājumiem, piemēram, Skaitīšanas pārpalikums (atrasti krājumi). Piezīme nav obligāta."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक फरकका लागि कारण चाहिन्छ: घटाइ जस्तै 'गन्तीमा कमी' वा 'क्षतिग्रस्त स्टक', बढाइ जस्तै 'गन्तीमा बढी (स्टक भेटियो)'। नोट वैकल्पिक हो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elk verschil heeft een reden nodig: afnames zoals Teltekort of Beschadigde voorraad, toenames zoals Teltoename (voorraad gevonden). Een notitie is optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każda różnica wymaga powodu: zmniejszenia, np. Niedobór z liczenia lub Uszkodzone zapasy, zwiększenia, np. Nadwyżka z liczenia (znaleziono zapasy). Notatka jest opcjonalna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada diferença precisa de um motivo: diminuições como Falta na contagem ou Stock danificado, aumentos como Ganho na contagem (stock encontrado). A nota é opcional."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fiecare diferență necesită un motiv: scăderi, precum Lipsă la numărare sau Stoc deteriorat, creșteri, precum Plus la numărare (stoc găsit). Nota este opțională."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý rozdiel potrebuje dôvod: úbytky ako Manko pri inventúre alebo Poškodené zásoby, prírastky ako Prebytok pri inventúre (nájdené zásoby). Poznámka je voliteľná."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje avvikelse behöver en orsak: minskningar som Inventeringsbrist eller Skadat lager, ökningar som Inventeringsöverskott (hittat lager). En anteckning är valfri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her fark için bir neden gerekir: Sayım eksiği veya Hasarlı stok gibi azalışlar, Sayım fazlası (stok bulundu) gibi artışlar. Not isteğe bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожна розбіжність потребує причини: зменшення, як-от Нестача під час підрахунку чи Пошкоджений запас, збільшення, як-от Надлишок під час підрахунку (знайдено запас). Примітка необов’язкова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每处差异都需要原因：减少如盘亏或损坏库存，增加如盘盈（发现库存）。备注可选。"
          }
        }
      }
    },
    "Each differing line offers Mine or Aiku; quantities can also take Both (added up, never above what the line needs). Your choice is shown filled.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всеки различаващ се ред предлага Моето или Aiku; за количествата има и И двете (сборът, никога повече от нужното за реда). Изборът ви е показан запълнен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý odlišný řádek nabízí Moje nebo Aiku; u množství lze zvolit i Obě (sečteno, nikdy více, než řádek potřebuje). Vaše volba je zobrazena vyplněná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede abweichende Zeile bietet Meins oder Aiku; Mengen können auch Beide nehmen (addiert, nie mehr als die Zeile braucht). Ihre Wahl wird ausgefüllt angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada línea con diferencias ofrece Mío o Aiku; las cantidades también admiten Ambos (sumados, nunca por encima de lo que necesita la línea). Su elección se muestra rellena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque ligne qui diffère propose Moi ou Aiku ; les quantités peuvent aussi prendre Les deux (additionnées, jamais au-delà de ce dont la ligne a besoin). Votre choix est affiché en plein."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर अलग लाइन में 'मेरा' या 'Aiku' का विकल्प है; मात्राओं के लिए 'दोनों' भी चुना जा सकता है (जोड़ा जाता है, लाइन की ज़रूरत से कभी ज़्यादा नहीं)। आपका चुनाव भरा हुआ दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki redak koji se razlikuje nudi Moje ili Aiku; količine mogu uzeti i Oboje (zbrojeno, nikad više od onoga što redak treba). Vaš odabir prikazan je ispunjeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden eltérő sornál választható a Saját vagy az Aiku; a mennyiségeknél a Mindkettő is (összeadva, de soha nem több, mint amennyi a sorhoz kell). A választása kitöltve látszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap baris yang berbeda menawarkan Milik saya atau Aiku; kuantitas juga dapat memakai Keduanya (dijumlahkan, tidak pernah melebihi kebutuhan baris). Pilihan Anda ditampilkan terisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni riga diversa offre Mio o Aiku; per le quantità è disponibile anche Entrambi (sommati, mai oltre quanto richiesto dalla riga). La sua scelta è evidenziata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "差異のある各行では「自分」か「Aiku」を選べます。数量では「両方」も選べます（合算され、行の必要数を超えることはありません）。選択した方が塗りつぶしで表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katrai atšķirīgai rindai var izvēlēties Mans vai Aiku; daudzumiem var izvēlēties arī Abi (saskaitīti, nekad vairāk, nekā rindai vajag). Jūsu izvēle ir parādīta aizpildīta."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक फरक लाइनमा 'मेरो' वा 'Aiku' विकल्प हुन्छ; परिमाणमा 'दुवै' पनि छान्न सकिन्छ (जोडिन्छ, लाइनलाई चाहिनेभन्दा कहिल्यै बढी हुँदैन)। तपाईंको छनोट भरिएको देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke afwijkende regel biedt Mijn of Aiku; aantallen kunnen ook Beide gebruiken (opgeteld, nooit meer dan wat de regel nodig heeft). Je keuze wordt gevuld weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każda różniąca się pozycja oferuje Moje lub Aiku; ilości mogą też przyjąć Obydwa (zsumowane, nigdy powyżej potrzeb pozycji). Twój wybór jest wyświetlany jako wypełniony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada linha diferente oferece Meu ou Aiku; as quantidades também podem usar Ambos (somados, nunca acima do que a linha precisa). A sua escolha aparece preenchida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fiecare linie diferită oferă Al meu sau Aiku; cantitățile pot avea și Ambele (adunate, niciodată peste ce necesită linia). Alegerea ta apare plină."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každý odlišný riadok ponúka Moje alebo Aiku; pri množstvách aj Oboje (sčítané, nikdy nad potrebu riadku). Vaša voľba je zobrazená vyplnená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje rad som skiljer sig erbjuder Mitt eller Aiku; antal kan också ta Båda (summerat, aldrig mer än raden behöver). Ditt val visas ifyllt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farklı olan her satırda Benimkiler veya Aiku seçilebilir; miktarlarda Her ikisi de seçilebilir (toplanır, satırın gerektirdiğinden fazla olmaz). Seçiminiz dolu gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для кожного розбіжного рядка можна вибрати Моє або Aiku; для кількостей також доступно Обидва (сума, але не більше, ніж потрібно рядку). Ваш вибір показано заповненим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个有差异的行都可选择“我的”或“Aiku”；数量还可选择“两者”（相加，但不超过该行所需数量）。你的选择以实心显示。"
          }
        }
      }
    },
    "Each return is whole pallets or stored items. Stored item returns from a customer’s shop show the platform.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всяко връщане е от цели палети или съхранени артикули. При връщания на съхранени артикули от магазина на клиента се показва платформата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každé vrácení tvoří celé palety nebo uskladněné položky. U vrácení uskladněných položek z obchodu zákazníka se zobrazuje platforma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Rücksendung besteht aus ganzen Paletten oder eingelagerten Artikeln. Rücksendungen eingelagerter Artikel aus dem Shop eines Kunden zeigen die Plattform an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada devolución son palets completos o artículos almacenados. Las devoluciones de artículos almacenados desde la tienda de un cliente muestran la plataforma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque retour porte sur des palettes entières ou des articles stockés. Les retours d'articles stockés provenant de la boutique d'un client indiquent la plateforme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर वापसी पूरे पैलेट या संग्रहीत आइटम की होती है। ग्राहक की शॉप से आई संग्रहीत आइटम वापसी में प्लेटफ़ॉर्म दिखाया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki povrat čine cijele palete ili pohranjeni artikli. Povrati pohranjenih artikala iz trgovine kupca prikazuju platformu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minden visszaküldés teljes raklapokból vagy tárolt tételekből áll. Az ügyfél webáruházából érkező tárolttétel-visszaküldéseknél a platform is látható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap pengembalian berupa palet utuh atau barang tersimpan. Pengembalian barang tersimpan dari toko pelanggan menampilkan platformnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni reso riguarda pallet interi o articoli in giacenza. I resi di articoli in giacenza dal negozio di un cliente mostrano la piattaforma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "返送はパレット単位または保管品単位です。顧客のショップからの保管品返送にはプラットフォームが表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Katrs atgriezums sastāv no veselām paletēm vai uzglabātiem vienumiem. Uzglabāto vienumu atgriezumiem no klienta veikala ir norādīta platforma."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रत्येक फिर्ता पूरा प्यालेट वा भण्डारण गरिएका वस्तुहरूको हुन्छ। ग्राहकको पसलबाट आएका भण्डारण वस्तु फिर्ताहरूमा प्लेटफर्म देखाइन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elke retour bestaat uit hele pallets of opgeslagen items. Retouren van opgeslagen items uit de shop van een klant tonen het platform."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy zwrot obejmuje całe palety lub przechowywane przedmioty. Przy zwrotach przechowywanych przedmiotów ze sklepu klienta widoczna jest platforma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada devolução é de paletes completas ou de itens armazenados. As devoluções de itens armazenados a partir da loja de um cliente mostram a plataforma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fiecare retur cuprinde paleți întregi sau articole depozitate. Retururile de articole depozitate din magazinul unui client afișează platforma."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Každé vrátenie tvoria celé palety alebo uskladnené položky. Pri vráteniach uskladnených položiek z obchodu zákazníka sa zobrazuje platforma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varje retur består av hela pallar eller lagrade artiklar. Returer av lagrade artiklar från en kunds butik visar plattformen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her iade ya tam paletlerden ya da depolanan ürünlerden oluşur. Müşterinin mağazasından gelen depolanan ürün iadelerinde platform gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожне повернення — це цілі палети або збережені товари. Для повернень збережених товарів із магазину клієнта показано платформу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个退回单为整托盘或存储货品。来自客户店铺的存储货品退回会显示平台。"
          }
        }
      }
    },
    "Each scan adds 1 to the checked quantity": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
