    "An active picking location stays active until another location of this SKO is made the active one, as on the web.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Активната локация за комплектоване остава активна, докато друга локация на този SKO не бъде направена активна, както в уеб версията."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivní vychystávací místo zůstává aktivní, dokud se aktivním nestane jiné umístění tohoto SKO, stejně jako na webu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein aktiver Kommissionierort bleibt aktiv, bis ein anderer Lagerplatz dieser SKO zum aktiven wird, wie im Web."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una ubicación de preparación activa sigue activa hasta que otra ubicación de este SKO pasa a ser la activa, como en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un emplacement de préparation actif le reste jusqu’à ce qu’un autre emplacement de ce SKO devienne l’emplacement actif, comme sur le web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सक्रिय पिकिंग लोकेशन तब तक सक्रिय रहती है जब तक इस SKO की कोई दूसरी लोकेशन सक्रिय नहीं बनाई जाती, वेब की तरह।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivna lokacija za branje ostaje aktivna dok se neka druga lokacija ovog SKO-a ne postavi kao aktivna, kao na webu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az aktív komissiózási hely addig aktív marad, amíg az SKO egy másik helyét nem teszik aktívvá, ahogy a weben is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi picking aktif tetap aktif sampai lokasi lain untuk SKO ini dijadikan aktif, seperti di web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un’ubicazione di prelievo attiva resta tale finché un’altra ubicazione di questo SKO non diventa quella attiva, come sul web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有効なピッキングロケーションは、Webと同様に、このSKOの別のロケーションが有効になるまで有効のままです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktīvā komplektēšanas vieta paliek aktīva, līdz par aktīvo tiek padarīta cita šī SKO vieta, tāpat kā tīmekļa versijā."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सक्रिय पिकिङ लोकेसन यो SKO को अर्को लोकेसन सक्रिय नबनाएसम्म सक्रिय रहन्छ, वेबमा जस्तै।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een actieve picklocatie blijft actief tot een andere locatie van deze SKO de actieve wordt, net als op het web."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywna lokalizacja kompletacji pozostaje aktywna, dopóki inna lokalizacja tego SKO nie zostanie ustawiona jako aktywna, tak jak w wersji webowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma localização de preparação ativa mantém-se ativa até outra localização deste SKO passar a ser a ativa, como na web."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O locație de cules activă rămâne activă până când altă locație a acestui SKO devine cea activă, ca pe web."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktívna lokácia vychystávania zostáva aktívna, kým sa za aktívnu neoznačí iná lokácia tohto SKO, ako na webe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En aktiv plockplats förblir aktiv tills en annan lagerplats för denna SKO görs aktiv, som på webben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktif toplama lokasyonu, bu SKO’nun başka bir lokasyonu aktif yapılana kadar aktif kalır, web’deki gibi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Активна комірка комплектування залишається активною, доки іншу комірку цього SKO не буде зроблено активною, як у вебверсії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当前拣货库位会保持有效，直到此 SKO 的另一个库位被设为当前库位，与网页版相同。"
          }
        }
      }
    },
