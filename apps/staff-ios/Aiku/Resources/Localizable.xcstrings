    "Clock in to start this week’s timesheet.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чекирайте вход, за да започнете часовата ведомост за тази седмица."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaznamenejte příchod a začněte výkaz práce na tento týden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stempeln Sie sich ein, um den Stundenzettel dieser Woche zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fiche la entrada para empezar el registro horario de esta semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pointez votre entrée pour commencer la feuille de temps de cette semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस हफ़्ते की टाइमशीट शुरू करने के लिए क्लॉक इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
