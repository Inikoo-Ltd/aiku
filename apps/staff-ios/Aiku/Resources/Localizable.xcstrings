        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· già stoccato, non conteggiato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· 格納済み、カウント対象外"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· jau novietots, nav saskaitīts"
