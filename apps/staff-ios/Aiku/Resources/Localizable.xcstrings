    "Add at least one parcel before this delivery note can be finalised.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Добавете поне един колет, преди тази стокова разписка да може да се финализира."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Před finalizací tohoto dodacího listu přidejte alespoň jeden balík."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügen Sie mindestens ein Paket hinzu, bevor dieser Lieferschein abgeschlossen werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añada al menos un paquete antes de poder finalizar este albarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez au moins un colis pour pouvoir finaliser ce bon de livraison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस डिलीवरी नोट को अंतिम रूप देने से पहले कम से कम एक पार्सल जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodajte barem jedan paket prije nego što se ova otpremnica može završiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A szállítólevél véglegesítése előtt adjon hozzá legalább egy csomagot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tambahkan minimal satu paket sebelum surat jalan ini dapat difinalisasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aggiunga almeno un pacco prima di poter finalizzare questa bolla di consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この出荷伝票を確定するには、荷物を1つ以上追加してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pievienojiet vismaz vienu paciņu, pirms šo piegādes pavadzīmi var pabeigt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो डेलिभरी नोटलाई अन्तिम रूप दिनुअघि कम्तीमा एउटा पार्सल थप्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voeg minstens één pakket toe voordat deze leveringsbon kan worden afgerond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaj co najmniej jedną paczkę, zanim ten dowód dostawy będzie można zakończyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione pelo menos um volume antes de esta guia de remessa poder ser finalizada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adăugați cel puțin un colet înainte ca această notă de livrare să poată fi finalizată."
          }
        },
        "sk": {
          "stringUnit": {
