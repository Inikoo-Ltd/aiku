    "Scan the QR code on the clocking machine. The machine decides where you clocked.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканирайте QR кода на машината за отчитане. Машината определя къде сте се отчели."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenujte QR kód na docházkovém terminálu. Terminál určí, kde jste zaznamenali docházku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen Sie den QR-Code am Zeiterfassungsgerät. Das Gerät bestimmt, wo Sie gestempelt haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escanee el código QR de la máquina de fichaje. La máquina determina dónde ha fichado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannez le code QR de la pointeuse. La pointeuse détermine où vous avez pointé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हाज़िरी मशीन पर QR कोड स्कैन करें। आपने कहाँ हाज़िरी लगाई, यह मशीन तय करती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skenirajte QR kôd na uređaju za evidentiranje. Uređaj određuje gdje ste se evidentirali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szkennelje be a blokkológépen lévő QR-kódot. A gép határozza meg, hol blokkolt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindai kode QR di mesin absensi. Mesin menentukan tempat Anda absen."
          }
