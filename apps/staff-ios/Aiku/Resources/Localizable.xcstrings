    "Pick each line by hand: tap a delivery note under Put into.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Комплектовайте всеки ред ръчно: докоснете стокова разписка под Постави в."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystávejte každý řádek ručně: klepněte na dodací list pod Vložit do."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommissionieren Sie jede Zeile von Hand: Tippen Sie unter Ablegen in auf einen Lieferschein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepare cada línea a mano: toque un albarán en Meter en."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Préparez chaque ligne à la main : touchez un bon de livraison sous Mettre dans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर लाइन हाथ से पिक करें: 'इसमें डालें' के नीचे किसी डिलीवरी नोट पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berite svaki redak ručno: dodirnite otpremnicu pod Stavi u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komissiózzon minden sort kézzel: koppintson egy szállítólevélre a Ide kerül alatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ambil setiap baris secara manual: ketuk surat jalan di bawah Masukkan ke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prelevi ogni riga manualmente: tocchi una bolla di consegna sotto Metti in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各行を手作業でピッキングします：「入れ先」の下の納品書をタップしてください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komplektējiet katru rindu manuāli: pieskarieties piegādes pavadzīmei zem Ielikt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हरेक लाइन हातैले पिक गर्नुहोस्: 'यसमा राख्नुहोस्' मुनिको डेलिभरी नोटमा ट्याप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pick elke regel handmatig: tik op een pakbon onder In plaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompletuj każdą pozycję ręcznie: dotknij dowodu dostawy w sekcji Włóż do."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prepare cada linha manualmente: toque numa guia de remessa em Colocar em."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Culege fiecare linie manual: atinge o notă de livrare sub Pune în."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vychystajte každý riadok ručne: ťuknite na dodací list v časti Vložiť do."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plocka varje rad manuellt: tryck på en följesedel under Lägg i."
          }
        },
        "tr": {
