            "value": "· deja amplasat, nenumărat"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· už umiestnené, nezapočítané"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "· redan placerad, räknas inte"
          }
