    "Storing locations have a replenishment quantity instead of min and max. Needs stock edit rights.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Локациите за съхранение имат количество за попълване вместо мин. и макс. Изисква права за редакция на наличности."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skladovací umístění mají místo minima a maxima množství k doplnění. Vyžaduje oprávnění upravovat zásoby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einlagerungsplätze haben eine Nachfüllmenge statt Minimum und Maximum. Erfordert Rechte zum Bearbeiten des Bestands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las ubicaciones de almacenamiento tienen una cantidad de reposición en lugar de mínimo y máximo. Requiere permisos de edición de stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les emplacements de stockage ont une quantité de réapprovisionnement au lieu d’un min et d’un max. Nécessite les droits de modification du stock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भंडारण लोकेशन में न्यूनतम और अधिकतम के बजाय पुनःपूर्ति मात्रा होती है। स्टॉक संपादन अधिकार चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokacije za pohranu imaju količinu nadopune umjesto min. i maks. Potrebna su prava uređivanja zaliha."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A tárolási helyeken min. és max. helyett feltöltési mennyiség van. Készletszerkesztési jog szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi penyimpanan memiliki jumlah pengisian ulang, bukan minimum dan maksimum. Memerlukan hak edit stok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le ubicazioni di stoccaggio hanno una quantità di rifornimento invece di minimo e massimo. Servono i permessi di modifica dello stock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保管ロケーションには最小・最大の代わりに補充数量があります。在庫編集権限が必要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzglabāšanas vietām ir papildināšanas daudzums, nevis minimums un maksimums. Nepieciešamas krājumu labošanas tiesības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भण्डारण लोकेसनमा न्यूनतम र अधिकतमको सट्टा पुनःपूर्ति परिमाण हुन्छ। स्टक सम्पादन अधिकार चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opslaglocaties hebben een aanvulhoeveelheid in plaats van min en max. Vereist bewerkrechten voor voorraad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokalizacje przechowywania mają ilość uzupełnienia zamiast minimum i maksimum. Wymaga uprawnień do edycji zapasów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As localizações de armazenamento têm uma quantidade de reposição em vez de mínimo e máximo. Requer permissões de edição de stock."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Locațiile de depozitare au o cantitate de reaprovizionare în loc de minim și maxim. Necesită drepturi de editare a stocului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skladovacie lokácie majú namiesto min. a max. množstvo na doplnenie. Vyžaduje práva na úpravu zásob."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lagringsplatser har ett påfyllningsantal i stället för min och max. Kräver behörighet att redigera lager."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depolama lokasyonlarında min. ve maks. yerine stok yenileme miktarı vardır. Stok düzenleme yetkisi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Комірки зберігання мають кількість поповнення замість мін. і макс. Потрібні права на редагування запасів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "存储库位使用补货数量，而非最小和最大库存。需要库存编辑权限。"
          }
        }
      }
    },
