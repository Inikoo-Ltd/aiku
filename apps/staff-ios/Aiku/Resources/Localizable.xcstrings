    "Clock in to start this week’s timesheet.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чекирайте вход, за да започнете часовата ведомост за тази седмица."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaznamenejte příchod a začněte výkaz práce na tento týden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stempeln Sie sich ein, um den Stundenzettel dieser Woche zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fiche la entrada para empezar el registro horario de esta semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pointez votre entrée pour commencer la feuille de temps de cette semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस हफ़्ते की टाइमशीट शुरू करने के लिए क्लॉक इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prijavite se na posao kako biste započeli evidenciju rada za ovaj tjedan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokkoljon be a heti munkaidő-nyilvántartás elindításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Absen masuk untuk memulai lembar waktu minggu ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Timbri l’entrata per iniziare il foglio presenze di questa settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "出勤すると今週のタイムシートが始まります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atzīmējiet ierašanos, lai sāktu šīs nedēļas darba laika uzskaiti."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो हप्ताको टाइमसिट सुरु गर्न क्लक इन गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klok in om de urenstaat van deze week te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zarejestruj wejście, aby rozpocząć kartę czasu pracy na ten tydzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registe a entrada para iniciar a folha de horas desta semana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pontează intrarea pentru a începe foaia de pontaj a acestei săptămâni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaznamenajte príchod, aby sa začal výkaz hodín na tento týždeň."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stämpla in för att starta veckans tidrapport."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu haftanın puantaj çizelgesini başlatmak için giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відмітьте прихід, щоб почати табель цього тижня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上班打卡以开始本周的工时表。"
          }
        }
      }
    },
