          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この倉庫で台車を使用している場合のみです。それ以外の場合は「ピッキング開始」ですぐに始まります。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doar când acest depozit folosește cărucioare. Altfel, Începe culesul pornește imediat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Len ak tento sklad používa vozíky. Inak sa Začať vychystávanie spustí hneď."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca bu depo toplama arabası kullanıyorsa. Aksi halde Toplamaya başla hemen başlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅当此仓库使用拣货车时适用。否则“开始拣货”会立即开始。"
          }
        }
      }
    },
    "Only while nothing is placed": {
