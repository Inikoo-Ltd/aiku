    "Customer returns arriving at goods in. Each item goes back to stock, or is set as damaged or not returned.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Връщания от клиенти, пристигащи в приемането на стока. Всеки артикул се връща в наличност или се маркира като повреден или невърнат."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrácení od zákazníků přicházející na příjem zboží. Každá položka se vrátí na sklad, nebo se nastaví jako poškozená či nevrácená."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kundenrücksendungen, die im Wareneingang ankommen. Jeder Artikel geht zurück in den Bestand oder wird als beschädigt oder nicht zurückgegeben markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devoluciones de clientes que llegan a recepción de mercancías. Cada artículo vuelve al stock o se marca como dañado o no devuelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retours clients arrivant à la réception. Chaque article est remis en stock, ou marqué comme endommagé ou non retourné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "माल प्राप्ति पर आने वाली ग्राहक वापसी। हर आइटम वापस स्टॉक में जाता है, या क्षतिग्रस्त या वापस नहीं के रूप में सेट होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povrati kupaca koji stižu na ulaz robe. Svaka se stavka vraća na zalihu ili se označava kao oštećena ili nevraćena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az áruátvételre érkező vásárlói visszaküldések. Minden tétel visszakerül a készletbe, vagy sérültnek, illetve vissza nem küldöttnek jelölik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengembalian pelanggan yang tiba di barang masuk. Setiap barang dikembalikan ke stok, atau ditandai rusak atau tidak dikembalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resi dei clienti in arrivo al ricevimento merci. Ogni articolo torna a stock oppure viene impostato come danneggiato o non restituito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "入荷場に届いた顧客からの返品です。各品目は在庫に戻すか、破損または未返品にします。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klientu atgriezumi, kas pienāk preču pieņemšanā. Katra pozīcija atgriežas krājumā vai tiek atzīmēta kā bojāta vai neatgriezta."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सामान प्राप्तिमा आइपुग्ने ग्राहक फिर्ताहरू। प्रत्येक वस्तु स्टकमा फर्कन्छ, वा क्षतिग्रस्त वा फिर्ता नगरिएको रूपमा सेट हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klantretouren die bij de goederenontvangst binnenkomen. Elk item gaat terug naar de voorraad of wordt ingesteld als beschadigd of niet geretourneerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwroty od klientów docierające do przyjęcia towarów. Każdy przedmiot wraca na stan albo zostaje oznaczony jako uszkodzony lub niezwrócony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devoluções de clientes que chegam à receção de mercadorias. Cada item volta ao stock ou é definido como danificado ou não devolvido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retururi ale clienților care sosesc la intrarea de mărfuri. Fiecare articol revine în stoc sau este setat ca deteriorat ori nereturnat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrátenia od zákazníkov prichádzajúce na príjem tovaru. Každá položka sa vráti na sklad alebo sa nastaví ako poškodená či nevrátená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kundreturer som kommer till varumottagningen. Varje artikel går tillbaka till lagret eller markeras som skadad eller ej returnerad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mal kabule gelen müşteri iadeleri. Her ürün stoğa geri döner ya da hasarlı veya iade edilmedi olarak işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повернення від клієнтів, що надходять на приймання товарів. Кожен товар повертається на склад або позначається як пошкоджений чи не повернений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "到达入库区的客户退货。每件货品要么退回库存，要么设为已损坏或未退回。"
          }
        }
      }
    },
    "Customer service needs to decide (substitute, refund…)": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
