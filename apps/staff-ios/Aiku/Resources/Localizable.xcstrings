    "Install an authenticator app, such as Google Authenticator, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Инсталирайте приложение за удостоверяване, например Google Authenticator, и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nainstalujte ověřovací aplikaci, například Google Authenticator, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installieren Sie eine Authenticator-App wie Google Authenticator und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instale una app de autenticación, como Google Authenticator, y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installez une application d’authentification, comme Google Authenticator, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई authenticator ऐप इंस्टॉल करें, जैसे Google Authenticator, फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instalirajte aplikaciju za autentifikaciju, kao što je Google Authenticator, a zatim pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telepítsen egy hitelesítő alkalmazást, például a Google Authenticatort, majd próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasang aplikasi authenticator, seperti Google Authenticator, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installi un’app di autenticazione, come Google Authenticator, poi riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google Authenticatorなどの認証アプリをインストールしてから、もう一度お試しください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instalējiet autentifikatora lietotni, piemēram, Google Authenticator, un mēģiniet vēlreiz."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google Authenticator जस्तो authenticator एप इन्स्टल गर्नुहोस्, त्यसपछि फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installeer een authenticator-app, zoals Google Authenticator, en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zainstaluj aplikację uwierzytelniającą, np. Google Authenticator, i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instale uma aplicação de autenticação, como o Google Authenticator, e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instalează o aplicație de autentificare, cum ar fi Google Authenticator, apoi încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nainštalujte si autentifikačnú aplikáciu, napríklad Google Authenticator, a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Installera en autentiseringsapp, till exempel Google Authenticator, och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google Authenticator gibi bir doğrulama uygulaması yükleyin, ardından tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
