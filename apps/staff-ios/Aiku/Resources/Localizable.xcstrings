    "A Bluetooth scanner types the code and Enter; the screen captures it without tapping a field, like the web. No on-screen keyboard is needed.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth скенерът въвежда кода и Enter; екранът го улавя, без да докосвате поле, както в уеб версията. Не е нужна екранна клавиатура."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth skener napíše kód a Enter; obrazovka ho zachytí bez klepnutí na pole, stejně jako na webu. Klávesnice na obrazovce není potřeba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Bluetooth-Scanner tippt den Code und Enter; der Bildschirm erfasst ihn, ohne dass Sie ein Feld antippen, wie im Web. Keine Bildschirmtastatur nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un escáner Bluetooth escribe el código y Enter; la pantalla lo captura sin tocar ningún campo, como en la web. No hace falta el teclado en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un scanner Bluetooth saisit le code puis Entrée ; l’écran le capte sans toucher de champ, comme sur le web. Aucun clavier à l’écran n’est nécessaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth स्कैनर कोड और Enter टाइप करता है; स्क्रीन बिना किसी फ़ील्ड पर टैप किए उसे पकड़ लेती है, वेब की तरह। ऑन-स्क्रीन कीबोर्ड की ज़रूरत नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth skener upisuje kôd i Enter; zaslon ga hvata bez dodirivanja polja, kao na webu. Tipkovnica na zaslonu nije potrebna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A Bluetooth-szkenner beírja a kódot és az Entert; a képernyő mezőre koppintás nélkül rögzíti, mint a weben. Nincs szükség képernyő-billentyűzetre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pemindai Bluetooth mengetik kode lalu Enter; layar menangkapnya tanpa perlu mengetuk kolom, seperti di web. Keyboard layar tidak diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno scanner Bluetooth digita il codice e Invio; la schermata lo acquisisce senza toccare alcun campo, come sul web. Non serve la tastiera su schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetoothスキャナーはコードを入力してEnterを送信します。Webと同様に、入力欄をタップしなくても画面が読み取ります。画面キーボードは不要です。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth skeneris ievada kodu un Enter; ekrāns to uztver bez pieskāriena laukam, tāpat kā tīmekļa versijā. Ekrāna tastatūra nav vajadzīga."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth स्क्यानरले कोड र Enter टाइप गर्छ; स्क्रिनले कुनै फिल्डमा ट्याप नगरी नै त्यसलाई समात्छ, वेबमा जस्तै। स्क्रिनको किबोर्ड चाहिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een Bluetooth-scanner typt de code en Enter; het scherm vangt die op zonder dat je op een veld tikt, net als op het web. Er is geen schermtoetsenbord nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skaner Bluetooth wpisuje kod i Enter; ekran przechwytuje go bez dotykania pola, tak jak w wersji webowej. Klawiatura ekranowa nie jest potrzebna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um leitor Bluetooth escreve o código e Enter; o ecrã capta-o sem tocar num campo, como na web. Não é preciso teclado no ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un scaner Bluetooth tastează codul și Enter; ecranul îl preia fără să atingi un câmp, ca pe web. Nu este nevoie de tastatura de pe ecran."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth skener napíše kód a stlačí Enter; obrazovka ho zachytí bez ťuknutia do poľa, ako na webe. Klávesnica na obrazovke nie je potrebná."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Bluetooth-skanner skriver koden och Enter; skärmen fångar den utan att du trycker på ett fält, som på webben. Inget skärmtangentbord behövs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth tarayıcı kodu yazar ve Enter’a basar; ekran, bir alana dokunmanıza gerek kalmadan kodu yakalar, tıpkı web’deki gibi. Ekran klavyesine gerek yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth-сканер вводить код і Enter; екран зчитує його без натискання на поле, як у вебверсії. Екранна клавіатура не потрібна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "蓝牙扫描器会输入条码并按回车；无需点击输入框，屏幕即可捕获，与网页版相同。无需屏幕键盘。"
          }
        }
      }
    },
