    "Please enable location permission in your phone settings. You can still open the camera and scan the machine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bitte aktivieren Sie die Standortberechtigung in den Einstellungen Ihres Telefons. Sie können die Kamera trotzdem öffnen und das Gerät scannen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Active el permiso de ubicación en los ajustes del teléfono. Aun así, puede abrir la cámara y escanear la máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veuillez activer l'autorisation de localisation dans les réglages de votre téléphone. Vous pouvez quand même ouvrir l'appareil photo et scanner la pointeuse."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućite dopuštenje za lokaciju u postavkama telefona. I dalje možete otvoriti kameru i skenirati uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Engedélyezze a helymeghatározást a telefon beállításaiban. A kamerát így is megnyithatja, és beszkennelheti a gépet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan izin lokasi di pengaturan ponsel Anda. Anda tetap dapat membuka kamera dan memindai mesin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attivi l’autorizzazione alla posizione nelle impostazioni del telefono. Può comunque aprire la fotocamera e scansionare il terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スマートフォンの設定で位置情報の許可をオンにしてください。カメラを開いて打刻機をスキャンすることもできます。"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activează permisiunea de localizare din setările telefonului. Poți totuși să deschizi camera și să scanezi terminalul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povoľte prístup k polohe v nastaveniach telefónu. Fotoaparát môžete aj tak otvoriť a naskenovať terminál."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lütfen telefon ayarlarınızdan konum iznini açın. Yine de kamerayı açıp cihazı tarayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在手机设置中开启定位权限。你仍然可以打开相机扫描考勤机。"
          }
        }
      }
    },
    "Please explain what happened": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosím, vysvětlete, co se stalo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte erklären Sie, was passiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique lo que ocurrió"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez expliquer ce qui s'est passé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया बताएँ क्या हुआ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Objasnite što se dogodilo"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kérjük, írja le, mi történt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mohon jelaskan apa yang terjadi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spieghi cosa è successo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "何が起きたか説明してください"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया के भयो व्याख्या गर्नुहोस्"
