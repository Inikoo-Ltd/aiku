    "Everything packed on this line goes back to be packed, and the delivery note goes back to packing.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всичко опаковано на този ред отново е за опаковане, а стоковата разписка се връща в опаковане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vše zabalené na tomto řádku se vrátí k zabalení a dodací list se vrátí do balení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles, was auf dieser Position gepackt wurde, ist wieder zu packen, und der Lieferschein geht zurück zu „Wird gepackt“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo lo embalado en esta línea vuelve a estar por embalar y el albarán vuelve a embalaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout ce qui est emballé sur cette ligne repasse à emballer, et le bon de livraison repasse en emballage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस लाइन पर पैक किया गया सब कुछ फिर से पैक होने के लिए लौट जाता है, और डिलीवरी नोट वापस पैकिंग में चला जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve spakirano na ovom retku vraća se na pakiranje, a otpremnica se vraća u pakiranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A soron becsomagolt összes tétel visszakerül csomagolandóba, a szállítólevél pedig vissza csomagolás állapotba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semua yang sudah dikemas di baris ini kembali menjadi perlu dikemas, dan surat jalan kembali ke pengemasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutto ciò che è imballato su questa riga torna da imballare e la bolla di consegna torna in imballaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この明細で梱包したものはすべて梱包待ちに戻り、出荷伝票は梱包中に戻ります。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viss, kas šajā rindā iepakots, atgriežas iepakojamajos, un piegādes pavadzīme atgriežas iepakošanā."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो लाइनमा प्याक गरिएका सबै फेरि प्याक गर्न बाँकीमा फर्कन्छन्, र डेलिभरी नोट फेरि प्याकिङमा फर्कन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles wat op deze regel is ingepakt, moet weer worden ingepakt, en de leveringsbon gaat terug naar inpakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystko spakowane w tym wierszu wraca do pakowania, a dowód dostawy wraca do etapu pakowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tudo o que foi embalado nesta linha volta a estar por embalar e a guia de remessa volta à embalagem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tot ce este ambalat pe această linie revine la ambalare, iar nota de livrare revine la ambalare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všetko zabalené na tomto riadku sa vráti na zabalenie a dodací list sa vráti do balenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allt som packats på den här raden går tillbaka till att packas, och följesedeln går tillbaka till packning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu satırda paketlenen her şey yeniden paketlenecekler arasına döner ve irsaliye paketleme durumuna geri döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усе упаковане в цьому рядку знову потрібно буде упакувати, а накладна повернеться до пакування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此明细行已打包的所有货品将恢复为待打包，发货单也将恢复为打包中。"
          }
        }
      }
    },
