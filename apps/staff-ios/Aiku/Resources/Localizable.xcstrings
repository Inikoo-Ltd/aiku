    "Overtime you request shows here with its approval.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поисканият от вас извънреден труд се показва тук заедно с одобрението му."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zde se zobrazují vámi vyžádané přesčasy i s jejich schválením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Von Ihnen beantragte Überstunden erscheinen hier mit ihrer Genehmigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las horas extra que solicite aparecen aquí con su aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les heures supplémentaires que vous demandez s’affichent ici avec leur approbation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका अनुरोधित ओवरटाइम उसकी स्वीकृति के साथ यहाँ दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prekovremeni rad koji zatražite prikazuje se ovdje s odobrenjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Ön által kért túlóra itt jelenik meg a jóváhagyással együtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lembur yang Anda ajukan muncul di sini beserta persetujuannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli straordinari che richiede compaiono qui con la relativa approvazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "申請した残業は承認状況とともにここに表示されます。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šeit redzamas jūsu pieprasītās virsstundas un to apstiprinājums."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तपाईंले अनुरोध गरेको ओभरटाइम स्वीकृतिसहित यहाँ देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Overwerk dat je aanvraagt, verschijnt hier met de goedkeuring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutaj pojawiają się zgłoszone przez Ciebie nadgodziny wraz z ich zatwierdzeniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
