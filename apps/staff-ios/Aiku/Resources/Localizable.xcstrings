          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salvato come segnalazione di incidente con il suo nome e la data di oggi. L’ubicazione del pallet viene azzerata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
