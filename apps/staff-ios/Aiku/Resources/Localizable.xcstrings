    "This can’t be undone. The carrier is not told: if the label was already booked, cancel it with the carrier yourself.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Това не може да бъде отменено. Превозвачът не се уведомява: ако етикетът вече е заявен, откажете го сами при превозвача."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toto nelze vrátit zpět. Přepravce nebude informován: pokud byl štítek už rezervován, zrušte ho u přepravce sami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies kann nicht rückgängig gemacht werden. Der Versanddienstleister wird nicht benachrichtigt: Wenn das Etikett bereits gebucht wurde, stornieren Sie es selbst beim Versanddienstleister."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto no se puede deshacer. No se avisa al transportista: si la etiqueta ya estaba reservada, cancélela usted mismo con el transportista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette action est irréversible. Le transporteur n’est pas prévenu : si l’étiquette a déjà été réservée, annulez-la vous-même auprès du transporteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे पूर्ववत नहीं किया जा सकता। कूरियर को सूचना नहीं दी जाती: अगर लेबल पहले से बुक है, तो कूरियर के साथ खुद उसे रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovo se ne može poništiti. Prijevoznik nije obaviješten: ako je naljepnica već rezervirana, sami je otkažite kod prijevoznika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ez nem vonható vissza. A fuvarozó nem kap értesítést: ha a címkét már lefoglalták, törölje saját maga a fuvarozónál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini tidak dapat dibatalkan. Kurir tidak diberi tahu: jika label sudah dipesan, batalkan sendiri dengan kurir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è possibile annullarlo. Il corriere non viene avvisato: se l’etichetta era già stata prenotata, la annulli lei stesso presso il corriere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元に戻せません。配送業者には通知されません。ラベルがすでに予約済みの場合は、ご自身で配送業者に取消を依頼してください。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To nevar atsaukt. Pārvadātājam netiek paziņots: ja etiķete jau bija rezervēta, atceliet to pie pārvadātāja pats."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यो पूर्ववत गर्न सकिँदैन। ढुवानीकर्तालाई जानकारी दिइँदैन: लेबल पहिल्यै बुक भइसकेको भए, ढुवानीकर्तासँग आफैं रद्द गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit kan niet ongedaan worden gemaakt. De vervoerder wordt niet ingelicht: als het label al was geboekt, annuleer het dan zelf bij de vervoerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tego nie można cofnąć. Przewoźnik nie zostanie powiadomiony: jeśli etykieta została już zarezerwowana, anuluj ją samodzielnie u przewoźnika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isto não pode ser anulado. A transportadora não é avisada: se a etiqueta já tiver sido reservada, cancele-a junto da transportadora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acest lucru nu poate fi anulat. Transportatorul nu este anunțat: dacă eticheta a fost deja rezervată, anulează-o tu la transportator."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toto nemožno vrátiť späť. Prepravca nie je informovaný: ak už bol štítok zarezervovaný, zrušte ho u prepravcu sami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detta kan inte ångras. Transportören meddelas inte: om etiketten redan var bokad måste du själv avboka den hos transportören."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu işlem geri alınamaz. Kargo firmasına bildirilmez: etiket zaten oluşturulduysa kargo firması üzerinden kendiniz iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це не можна скасувати. Перевізника не повідомляють: якщо етикетку вже замовлено, скасуйте її в перевізника самостійно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作无法撤销。不会通知承运商：如果已预订标签，请自行与承运商取消。"
          }
        }
      }
    },
