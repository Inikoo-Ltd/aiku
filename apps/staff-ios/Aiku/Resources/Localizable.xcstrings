    "Why did you work overtime?": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Защо работихте извънредно?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč jste pracoval/a přesčas?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum haben Sie Überstunden gemacht?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué trabajó horas extra?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi avez-vous fait des heures supplémentaires ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने ओवरटाइम क्यों किया?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zašto ste radili prekovremeno?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miért dolgozott túlórában?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapa Anda bekerja lembur?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché ha fatto gli straordinari?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "残業した理由は何ですか？"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kāpēc jūs strādājāt virsstundas?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले किन ओभरटाइम काम गर्नुभयो?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom heb je overgewerkt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jaki był powód pracy w nadgodzinach?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque fez horas extra?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De ce ai lucrat ore suplimentare?"
          }
        },
        "sk": {
