    "Scan a location label (Code 128) to open it.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сканирайте етикет на локация (Code 128), за да я отворите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naskenujte štítek umístění (Code 128) a otevřete ho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen Sie ein Lagerplatzetikett (Code 128), um es zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escanee una etiqueta de ubicación (Code 128) para abrirla."
          }
        },
        "fr": {
