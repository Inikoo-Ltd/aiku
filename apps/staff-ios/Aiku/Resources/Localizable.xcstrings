    "Stored items are the customer’s own SKOs, counted per pallet. The barcode is usually the manufacturer’s EAN.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Съхранените артикули са собствени SKO на клиента, преброени по палет. Баркодът обикновено е EAN кодът на производителя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uskladněné položky jsou vlastní SKO zákazníka, počítané na každé paletě. Čárový kód je obvykle EAN výrobce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eingelagerte Artikel sind die eigenen SKOs des Kunden, gezählt pro Palette. Der Barcode ist meist die EAN des Herstellers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los artículos almacenados son los propios SKO del cliente, contados por palet. El código de barras suele ser el EAN del fabricante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les articles stockés sont les propres SKO du client, comptés par palette. Le code-barres est généralement l'EAN du fabricant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संग्रहीत आइटम ग्राहक के अपने SKO हैं, जिन्हें प्रति पैलेट गिना जाता है। बारकोड आमतौर पर निर्माता का EAN होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pohranjeni artikli su vlastiti SKO-ovi kupca, brojeni po paleti. Barkod je obično proizvođačev EAN."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A tárolt tételek az ügyfél saját SKO-i, raklaponként számolva. A vonalkód általában a gyártó EAN-kódja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Barang tersimpan adalah SKO milik pelanggan sendiri, dihitung per palet. Barcode-nya biasanya EAN dari produsen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli articoli in giacenza sono gli SKO del cliente, contati per pallet. Il codice a barre è di solito l'EAN del produttore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保管品は顧客自身のSKOで、パレットごとに数えます。バーコードは通常メーカーのEANです。"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzglabātie vienumi ir paša klienta SKO, saskaitīti katrai paletei. Svītrkods parasti ir ražotāja EAN."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भण्डारण गरिएका वस्तुहरू ग्राहककै SKO हुन्, जसलाई प्रति प्यालेट गनिन्छ। बारकोड प्रायः निर्माताको EAN हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opgeslagen items zijn de eigen SKO's van de klant, geteld per pallet. De barcode is meestal de EAN van de fabrikant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przechowywane przedmioty to własne SKO klienta, liczone dla każdej palety. Kod kreskowy to zwykle EAN producenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os itens armazenados são os próprios SKOs do cliente, contados por palete. O código de barras é normalmente o EAN do fabricante."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Articolele depozitate sunt SKO-urile proprii ale clientului, numărate pe fiecare palet. Codul de bare este de obicei EAN-ul producătorului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uskladnené položky sú vlastné SKO zákazníka, počítané na každej palete. Čiarový kód je zvyčajne EAN výrobcu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lagrade artiklar är kundens egna SKO:er, räknade per pall. Streckkoden är oftast tillverkarens EAN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depolanan ürünler müşterinin kendi SKO'larıdır ve palet bazında sayılır. Barkod genellikle üreticinin EAN kodudur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Збережені товари — це власні SKO клієнта, пораховані для кожної палети. Штрих-кодом зазвичай є EAN виробника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "存储货品是客户自己的 SKO，按托盘清点。条形码通常是制造商的 EAN。"
          }
        }
      }
    },
