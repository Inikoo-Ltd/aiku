            "state": "needs_review",
            "value": "Neizdevušai pārbaudei vajadzīga piezīme. Iepirkumu nodaļa izskata atšķirības."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "needs_review",
            "value": "असफल जाँचका लागि नोट चाहिन्छ। फरकहरूको अनुगमन खरिद विभागले गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een afgekeurde controle heeft een notitie nodig. Inkoop volgt de verschillen op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niezaliczona kontrola wymaga notatki. Dział zakupów zajmie się różnicami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma verificação falhada precisa de uma nota. As Compras tratam das diferenças."
