          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bifat implicit când aceasta ar fi singura locație a SKO-ului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
